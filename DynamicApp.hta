<html>
<head>
<meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
<title>HTA Dynamic App</title>
<meta http-equiv="X-UA-Compatible" content="IE=9">
<HTA:APPLICATION
  ID="DynamicApp"
  APPLICATIONNAME="HTA Dynamic App"
  BORDER="thick"
  BORDERSTYLE="normal"
  CAPTION="yes"
  ICON=""
  MAXIMIZEBUTTON="yes"
  MINIMIZEBUTTON="yes"
  SHOWINTASKBAR="yes"
  SINGLEINSTANCE="yes"
  SYSMENU="yes"
  WINDOWSTATE="maximize"
  SCROLL="no"
  SELECTION="yes"
/>
<style>
/* ===== RESET & BASE ===== */
* { margin:0; padding:0; box-sizing:content-box; }
html, body { width:100%; height:100%; overflow:hidden; font-family:"Meiryo UI","Meiryo",sans-serif; font-size:15px; color:#1a1a1a; background:#f0f2f5; }
input,select,textarea,button { font-family:inherit; font-size:15px; }
button { cursor:pointer; }

/* ===== HEADER ===== */
#header { height:42px; line-height:42px; background:#1a237e; color:#fff; padding:0 16px; overflow:hidden; }
#header .app-name { font-size:18px; font-weight:bold; float:left; }
#header .dirty-mark { color:#ff9800; font-weight:bold; margin-left:8px; display:none; float:left; line-height:42px; }
#header .version { float:right; font-size:13px; color:#90caf9; }

/* ===== TAB BAR (LEFT SIDEBAR) ===== */
#app-body { position:absolute; top:42px; left:0; right:0; bottom:28px; overflow:hidden; }
#tab-sidebar { position:absolute; left:0; top:0; bottom:0; width:170px; background:#1a237e; border-right:2px solid #0d1457; overflow-y:auto; overflow-x:hidden; }
#content-col { position:absolute; left:172px; top:0; right:0; bottom:0; overflow:hidden; }
#tabbar { padding:6px 0; }
.tab-btn { display:block; width:auto; height:auto; line-height:1.3; padding:11px 14px; color:#b0bec5; background:transparent; border:none; border-left:3px solid transparent; cursor:pointer; font-size:14px; text-align:left; margin:0; }
.tab-btn:hover { color:#fff; background:rgba(255,255,255,0.1); }
.tab-btn.active { color:#fff; background:#3949ab; border-left:3px solid #ffab40; font-weight:bold; }

/* ===== TOOLBAR ===== */
#toolbar { position:absolute; top:0; left:0; right:0; height:40px; background:#e8eaf6; border-bottom:1px solid #c5cae9; padding:5px 12px; overflow:hidden; }
.tool-btn { display:inline-block; height:30px; line-height:30px; padding:0 12px; margin-right:3px; background:#fff; border:1px solid #9fa8da; color:#283593; cursor:pointer; font-size:13px; vertical-align:middle; }
.tool-btn:hover { background:#c5cae9; }
.tool-btn.active { background:#3949ab; color:#fff; border-color:#3949ab; }
.tool-sep { display:inline-block; width:1px; height:20px; background:#9fa8da; margin:4px 6px; vertical-align:middle; }
.tool-label { display:inline-block; font-size:13px; color:#455a64; margin-right:6px; vertical-align:middle; line-height:30px; }
.tool-select { height:28px; border:1px solid #9fa8da; padding:0 4px; vertical-align:middle; font-size:13px; }

/* ===== DATE NAV ===== */
.date-nav { display:inline-block; vertical-align:middle; }
.date-nav .nav-btn { display:inline-block; width:28px; height:28px; line-height:28px; text-align:center; background:#fff; border:1px solid #9fa8da; cursor:pointer; vertical-align:middle; font-size:13px; }
.date-nav .nav-btn:hover { background:#c5cae9; }
.date-nav .nav-label { display:inline-block; min-width:110px; text-align:center; font-size:13px; color:#283593; font-weight:bold; vertical-align:middle; line-height:28px; }

/* ===== MAIN CONTENT ===== */
#main-area { position:absolute; top:41px; left:0; right:0; bottom:0; overflow:hidden; background:#f0f2f5; }
.pane-container { position:absolute; top:0; left:0; right:0; bottom:0; overflow:hidden; }
.pane { position:absolute; top:0; bottom:0; overflow:auto; background:#fff; border-right:1px solid #c5cae9; }
.pane-header { height:30px; line-height:30px; background:#e8eaf6; padding:0 12px; font-size:14px; font-weight:bold; color:#283593; border-bottom:1px solid #c5cae9; overflow:hidden; }
.pane-splitter { position:absolute; top:0; bottom:0; width:6px; background:#c5cae9; cursor:col-resize; z-index:10; }
.pane-splitter:hover { background:#7986cb; }

/* ===== LIST PANE ===== */
.list-table { width:100%; border-collapse:collapse; table-layout:fixed; }
.list-table th { background:#e8eaf6; color:#283593; font-size:14px; font-weight:bold; padding:6px 8px; border:1px solid #c5cae9; text-align:left; cursor:pointer; white-space:nowrap; overflow:hidden; position:relative; user-select:none; }
.list-table th:hover { background:#c5cae9; }
.list-table th .sort-icon { float:right; color:#9fa8da; font-size:12px; }
.list-table td { padding:5px 8px; border:1px solid #e0e0e0; font-size:14px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; cursor:default; }
.list-table tr:hover td { background:#e3f2fd; }
.list-table tr.selected td { background:#bbdefb; }
.list-table td.active-cell { outline:2px solid #1565c0; outline-offset:-1px; }
.list-table td input, .list-table td select { width:100%; border:1px solid #90caf9; padding:2px 4px; font-size:14px; background:#fff; }
.list-table td input[type="checkbox"] { width:auto; }
.drag-handle { cursor:move; color:#9e9e9e; margin-right:4px; font-size:13px; }

/* filter row */
.filter-row input { width:100%; border:1px solid #c5cae9; padding:3px 5px; font-size:13px; background:#fafafa; }

/* ===== DETAIL PANE ===== */
.detail-form { padding:12px; overflow-y:auto; }
.detail-field { margin-bottom:10px; }
.detail-field label { display:block; font-size:13px; color:#455a64; font-weight:bold; margin-bottom:3px; }
.detail-field input[type="text"], .detail-field input[type="date"], .detail-field select, .detail-field textarea { width:95%; border:1px solid #c5cae9; padding:5px 8px; font-size:15px; background:#fff; }
.detail-field textarea { height:60px; resize:vertical; }
.detail-field input[type="checkbox"] { width:auto; }

/* ===== EDITOR PANE ===== */
.editor-area { width:100%; height:100%; border:none; padding:10px; font-family:"Consolas","MS Gothic",monospace; font-size:15px; line-height:1.7; resize:none; outline:none; }

/* ===== WBS PANE ===== */
.wbs-table { width:100%; border-collapse:collapse; table-layout:fixed; }
.wbs-table th { background:#e8eaf6; color:#283593; font-size:14px; font-weight:bold; padding:6px 8px; border:1px solid #c5cae9; text-align:left; }
.wbs-table td { padding:5px 8px; border:1px solid #e0e0e0; font-size:14px; white-space:nowrap; overflow:hidden; }
.wbs-table tr:hover td { background:#e3f2fd; }
.wbs-table tr.selected td { background:#bbdefb; }
.wbs-toggle { cursor:pointer; display:inline-block; width:18px; text-align:center; color:#455a64; font-size:13px; }
.wbs-indent { display:inline-block; }

/* ===== GANTT PANE ===== */
.gantt-wrapper { width:100%; height:100%; overflow:auto; position:relative; }
.gantt-header { height:50px; position:relative; background:#e8eaf6; border-bottom:1px solid #c5cae9; }
.gantt-header-month { position:absolute; top:0; height:25px; line-height:25px; text-align:center; font-size:13px; font-weight:bold; color:#283593; border-right:1px solid #c5cae9; border-bottom:1px solid #c5cae9; }
.gantt-header-day { position:absolute; top:25px; height:25px; line-height:25px; text-align:center; font-size:12px; color:#455a64; border-right:1px solid #e0e0e0; }
.gantt-header-day.weekend { background:#fff3e0; }
.gantt-header-day.today { background:#bbdefb; font-weight:bold; }
.gantt-row { height:32px; position:relative; border-bottom:1px solid #f0f0f0; }
.gantt-bar { position:absolute; height:22px; top:5px; border-radius:3px; min-width:4px; cursor:pointer; font-size:12px; color:#fff; line-height:22px; padding:0 4px; overflow:hidden; white-space:nowrap; }
.gantt-bar:hover { opacity:0.85; }
.gantt-today-line { position:absolute; top:0; bottom:0; width:2px; background:#e53935; z-index:5; }
.gantt-milestone { position:absolute; top:4px; width:0; height:0; border:10px solid transparent; border-bottom-color:#ff6f00; border-top:none; cursor:pointer; }
.gantt-dep-arrow { position:absolute; z-index:2; }

/* ===== MENU PANE ===== */
.menu-list { list-style:none; padding:4px 0; }
.menu-item { padding:10px 16px; cursor:pointer; color:#37474f; font-size:15px; border-left:3px solid transparent; }
.menu-item:hover { background:#e3f2fd; border-left-color:#42a5f5; }
.menu-item.active { background:#bbdefb; border-left-color:#1565c0; font-weight:bold; color:#0d47a1; }
.menu-group-label { padding:8px 16px; font-size:13px; font-weight:bold; color:#90a4ae; text-transform:uppercase; }

/* ===== SETTINGS PANE ===== */
.settings-panel { padding:16px; overflow-y:auto; }
.settings-section { margin-bottom:20px; border:1px solid #c5cae9; background:#fafafa; }
.settings-section-title { background:#e8eaf6; padding:10px 14px; font-size:15px; font-weight:bold; color:#283593; cursor:pointer; border-bottom:1px solid #c5cae9; }
.settings-section-body { padding:12px; display:none; }
.settings-section.open .settings-section-body { display:block; }
.settings-row { margin-bottom:8px; overflow:hidden; }
.settings-row label { display:inline-block; width:160px; font-size:14px; color:#455a64; font-weight:bold; vertical-align:top; line-height:28px; }
.settings-row input[type="text"], .settings-row select, .settings-row textarea { border:1px solid #c5cae9; padding:4px 8px; font-size:14px; }
.settings-row input[type="text"] { width:280px; }
.settings-row textarea { width:420px; height:60px; }
.settings-btn { display:inline-block; padding:6px 16px; margin:2px; background:#3949ab; color:#fff; border:1px solid #283593; cursor:pointer; font-size:14px; }
.settings-btn:hover { background:#283593; }
.settings-btn.danger { background:#c62828; border-color:#b71c1c; }
.settings-btn.danger:hover { background:#b71c1c; }
.settings-mini-table { border-collapse:collapse; width:100%; margin-top:6px; }
.settings-mini-table th { background:#e0e0e0; padding:6px 8px; border:1px solid #bdbdbd; font-size:13px; text-align:left; }
.settings-mini-table td { padding:5px 8px; border:1px solid #e0e0e0; font-size:13px; }
.settings-mini-table tr:hover td { background:#e3f2fd; }

/* ===== DASHBOARD ===== */
.dashboard { padding:16px; overflow-y:auto; }
.dash-card { display:inline-block; width:240px; vertical-align:top; margin:0 14px 14px 0; border:1px solid #c5cae9; background:#fff; }
.dash-card-title { background:#e8eaf6; padding:10px 14px; font-size:14px; font-weight:bold; color:#283593; border-bottom:1px solid #c5cae9; }
.dash-card-body { padding:14px; font-size:14px; }
.dash-card-num { font-size:32px; font-weight:bold; color:#1a237e; }
.dash-card-sub { font-size:13px; color:#78909c; margin-top:4px; }

/* ===== STATUSBAR ===== */
#statusbar { position:absolute; bottom:0; left:0; right:0; height:28px; line-height:28px; background:#263238; color:#b0bec5; padding:0 14px; font-size:13px; overflow:hidden; }
#statusbar span { margin-right:16px; }
.status-dirty { color:#ff9800; }

/* ===== MODAL ===== */
.modal-overlay { display:none; position:fixed; top:0; left:0; right:0; bottom:0; background:#000; filter:alpha(opacity=50); opacity:0.5; z-index:1000; }
.modal-dialog { display:none; position:fixed; top:50%; left:50%; background:#fff; border:2px solid #1a237e; z-index:1001; padding:0; min-width:380px; }
.modal-title { background:#283593; color:#fff; padding:12px 18px; font-size:16px; font-weight:bold; }
.modal-body { padding:18px; font-size:15px; max-height:400px; overflow-y:auto; }
.modal-footer { padding:12px 18px; text-align:right; border-top:1px solid #e0e0e0; background:#fafafa; }
.modal-footer button { padding:8px 20px; margin-left:8px; cursor:pointer; font-size:14px; border:1px solid #9e9e9e; background:#fff; }
.modal-footer button.primary { background:#3949ab; color:#fff; border-color:#283593; }
.modal-footer button.primary:hover { background:#283593; }
.modal-footer button.danger { background:#c62828; color:#fff; border-color:#b71c1c; }

/* ===== CONTEXT MENU ===== */
.ctx-menu { display:none; position:absolute; background:#fff; border:1px solid #bdbdbd; z-index:999; min-width:160px; box-shadow:2px 2px 6px rgba(0,0,0,0.15); }
.ctx-menu-item { padding:8px 16px; font-size:14px; cursor:pointer; color:#333; }
.ctx-menu-item:hover { background:#e3f2fd; }
.ctx-menu-sep { height:1px; background:#e0e0e0; margin:2px 0; }
.ctx-menu-item.danger { color:#c62828; }

/* ===== TOAST ===== */
.toast-container { position:fixed; bottom:40px; right:20px; z-index:2000; }
.toast { padding:12px 20px; margin-top:6px; color:#fff; font-size:14px; border-radius:3px; opacity:0.95; }
.toast.success { background:#2e7d32; }
.toast.error { background:#c62828; }
.toast.warning { background:#e65100; }
.toast.info { background:#1565c0; }

/* ===== HIGHLIGHT RULES ===== */
.hl-overdue { background-color:#ffcdd2 !important; color:#b71c1c !important; font-weight:bold; }
.hl-due-soon { background-color:#fff9c4 !important; }
.hl-complete { background-color:#e8f5e9 !important; color:#9e9e9e !important; text-decoration:line-through; }
.hl-high-risk { background-color:#ffe0b2 !important; font-weight:bold; }
.hl-critical { background-color:#ffcdd2 !important; }
.hl-milestone { background-color:#e3f2fd !important; }

/* ===== PROGRESS BAR ===== */
.progress-bar { display:inline-block; width:70px; height:14px; background:#e0e0e0; vertical-align:middle; position:relative; }
.progress-fill { height:100%; background:#43a047; }
.progress-text { font-size:12px; margin-left:4px; vertical-align:middle; }

/* ===== SCROLLBAR ===== */
::-webkit-scrollbar { width:8px; height:8px; }
</style>

<!-- ===== VBSCRIPT LAYER ===== -->
<script language="VBScript">
Dim gFSO
Set gFSO = CreateObject("Scripting.FileSystemObject")

Function getAppDir()
  Dim p
  p = Replace(document.location.pathname, "/", "\")
  If Left(p,1) = "\" Then p = Mid(p, 2)
  p = Replace(p, "%20", " ")
  getAppDir = gFSO.GetParentFolderName(p)
  If Right(getAppDir, 1) <> "\" Then getAppDir = getAppDir & "\"
End Function

Sub readUTF8(filePath)
  Dim s, result
  On Error Resume Next
  Set s = CreateObject("ADODB.Stream")
  s.Type = 2
  s.Charset = "UTF-8"
  s.Open
  s.LoadFromFile filePath
  result = s.ReadText
  s.Close
  Set s = Nothing
  If Err.Number <> 0 Then
    result = ""
    Err.Clear
  End If
  On Error GoTo 0
  ' BOM文字が残っている場合は除去
  If Len(result) > 0 Then
    If AscW(Left(result, 1)) = 65279 Then
      result = Mid(result, 2)
    End If
  End If
  document.getElementById("_vbs_result").value = result
End Sub

Sub writeUTF8(filePath, content)
  Dim s
  On Error Resume Next
  Set s = CreateObject("ADODB.Stream")
  s.Type = 2
  s.Charset = "UTF-8"
  s.Open
  s.WriteText content
  s.SaveToFile filePath, 2
  s.Close
  Set s = Nothing
  If Err.Number <> 0 Then
    document.getElementById("_vbs_result").value = "ERROR:" & Err.Description
    Err.Clear
  Else
    document.getElementById("_vbs_result").value = "OK"
  End If
  On Error GoTo 0
End Sub

Sub vbsReadFile()
  Dim fp
  fp = document.getElementById("_vbs_buffer").value
  Call readUTF8(fp)
  window.execScript "jsVbsCallback()", "JavaScript"
End Sub

Sub vbsWriteFile()
  Dim fp, ct
  fp = document.getElementById("_vbs_filepath").value
  ct = document.getElementById("_vbs_buffer").value
  Call writeUTF8(fp, ct)
  window.execScript "jsVbsCallback()", "JavaScript"
End Sub

Sub vbsEnsureDir(dirPath)
  If Not gFSO.FolderExists(dirPath) Then
    gFSO.CreateFolder dirPath
  End If
End Sub

Sub vbsBrowseFile()
  Dim dlg, f
  Set dlg = CreateObject("UserAccounts.CommonDialog")
  dlg.Filter = "All Files|*.*|CSV Files|*.csv|JSON Files|*.json|Text Files|*.txt"
  dlg.FilterIndex = 1
  If dlg.ShowOpen Then
    document.getElementById("_vbs_result").value = dlg.FileName
  Else
    document.getElementById("_vbs_result").value = ""
  End If
  Set dlg = Nothing
  window.execScript "jsVbsCallback()", "JavaScript"
End Sub

Function vbsFileExists(fp)
  vbsFileExists = gFSO.FileExists(fp)
End Function

Function vbsFolderExists(fp)
  vbsFolderExists = gFSO.FolderExists(fp)
End Function
</script>

</head>
<body>

<!-- Hidden buffers for VBS<->JS -->
<input type="hidden" id="_vbs_buffer" />
<input type="hidden" id="_vbs_result" />
<input type="hidden" id="_vbs_filepath" />

<!-- ===== HEADER ===== -->
<div id="header">
  <span class="app-name" id="appName">HTA Dynamic App</span>
  <span class="dirty-mark" id="dirtyMark">● 未保存</span>
  <span class="version" id="appVersion">v1.0.0</span>
</div>

<!-- ===== APP BODY (table layout: left tabs + right content) ===== -->
<div id="app-body">
  <!-- LEFT: Tab Sidebar -->
  <div id="tab-sidebar">
    <div id="tabbar"></div>
  </div>
  <!-- RIGHT: Toolbar + Main -->
  <div id="content-col">
    <!-- ===== TOOLBAR ===== -->
    <div id="toolbar">
      <span class="tool-btn" onclick="saveAllData()">[保存]</span>
      <span class="tool-btn" onclick="exportCSV()">[CSV出力]</span>
      <span class="tool-sep"></span>
      <span class="tool-btn" onclick="addListRow()">[+ 行追加]</span>
      <span class="tool-btn" onclick="deleteListRow()">[- 行削除]</span>
      <span class="tool-sep"></span>
      <span id="dateNavArea" style="display:none;">
        <span class="tool-label">表示:</span>
        <span class="tool-btn" id="btnScaleMonth" onclick="setDateScale('month')">月</span>
        <span class="tool-btn" id="btnScaleWeek" onclick="setDateScale('week')">週</span>
        <span class="tool-btn" id="btnScaleDay" onclick="setDateScale('day')">日</span>
        <span class="tool-sep"></span>
        <span class="date-nav">
          <span class="nav-btn" onclick="navDate(-1)">&lt;</span>
          <span class="nav-label" id="dateNavLabel">-</span>
          <span class="nav-btn" onclick="navDate(0)">今日</span>
          <span class="nav-btn" onclick="navDate(1)">&gt;</span>
        </span>
      </span>
      <span class="tool-sep"></span>
      <span class="tool-label">ビュー:</span>
      <select class="tool-select" id="filterViewSelect" onchange="applyFilterView(this.value)">
        <option value="">すべて</option>
      </select>
      <span style="float:right;">
        <span class="tool-btn" onclick="showSettingsHelp()">[ヘルプ]</span>
      </span>
    </div>
    <!-- ===== MAIN AREA ===== -->
    <div id="main-area"></div>
  </div>
</div>

<!-- ===== STATUSBAR ===== -->
<div id="statusbar">
  <span id="statusTab">-</span>
  <span id="statusRows">行: 0</span>
  <span id="statusDirty"></span>
  <span id="statusSaved">-</span>
  <span style="float:right;" id="statusEncoding">UTF-8 | CRLF</span>
</div>

<!-- ===== MODAL ===== -->
<div class="modal-overlay" id="modalOverlay"></div>
<div class="modal-dialog" id="modalDialog">
  <div class="modal-title" id="modalTitle">確認</div>
  <div class="modal-body" id="modalBody"></div>
  <div class="modal-footer" id="modalFooter"></div>
</div>

<!-- ===== CONTEXT MENU ===== -->
<div class="ctx-menu" id="ctxMenu"></div>

<!-- ===== TOASTS ===== -->
<div class="toast-container" id="toastContainer"></div>

<!-- ===== MAIN JAVASCRIPT ===== -->
<script language="JavaScript">
// ========================================================================
// POLYFILLS (ES5)
// ========================================================================
if (!Array.prototype.indexOf) {
  Array.prototype.indexOf = function(v, s) {
    var i = s || 0;
    for (; i < this.length; i++) { if (this[i] === v) return i; }
    return -1;
  };
}
if (!Array.prototype.forEach) {
  Array.prototype.forEach = function(fn, ctx) {
    for (var i = 0; i < this.length; i++) fn.call(ctx, this[i], i, this);
  };
}
if (!Array.prototype.filter) {
  Array.prototype.filter = function(fn, ctx) {
    var r = [];
    for (var i = 0; i < this.length; i++) { if (fn.call(ctx, this[i], i, this)) r.push(this[i]); }
    return r;
  };
}
if (!Array.prototype.map) {
  Array.prototype.map = function(fn, ctx) {
    var r = [];
    for (var i = 0; i < this.length; i++) r.push(fn.call(ctx, this[i], i, this));
    return r;
  };
}
if (!Array.isArray) {
  Array.isArray = function(a) { return Object.prototype.toString.call(a) === '[object Array]'; };
}
if (!String.prototype.trim) {
  String.prototype.trim = function() { return this.replace(/^\s+|\s+$/g, ''); };
}

// ========================================================================
// GLOBALS
// ========================================================================
var APP_DIR = '';
var CONFIG = null;
var DATA_STORE = {};        // paneId -> array of row objects
var DIRTY_FLAGS = {};       // paneId -> boolean
var ACTIVE_TAB = null;
var ACTIVE_CELL = null;     // {paneId, row, col}
var SELECTED_ROW = {};      // paneId -> row index
var DATE_SCALE = 'week';
var DATE_CURSOR = new Date();
var VBS_CALLBACK = null;
var UNDO_STACKS = {};       // paneId -> [{data snapshot}]
var REDO_STACKS = {};
var EDITOR_CONTENTS = {};   // paneId -> string

// ========================================================================
// UTILITY
// ========================================================================
function uid() {
  return 'id_' + (new Date().getTime()) + '_' + Math.floor(Math.random() * 10000);
}
function escapeHtml(s) {
  if (s == null) return '';
  return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}
function padZero(n) { return n < 10 ? '0' + n : '' + n; }
function formatDate(d) {
  if (!d) return '';
  if (typeof d === 'string') d = parseDate(d);
  if (!d) return '';
  return d.getFullYear() + '-' + padZero(d.getMonth()+1) + '-' + padZero(d.getDate());
}
function parseDate(s) {
  if (!s) return null;
  var m = String(s).match(/^(\d{4})-(\d{1,2})-(\d{1,2})/);
  if (!m) return null;
  return new Date(parseInt(m[1],10), parseInt(m[2],10)-1, parseInt(m[3],10));
}
function todayStr() { return formatDate(new Date()); }
function dateDiffDays(d1, d2) {
  return Math.round((d2 - d1) / 86400000);
}
function getWeekStart(d) {
  var dd = new Date(d.getTime());
  var day = dd.getDay();
  var diff = day === 0 ? 6 : day - 1;
  dd.setDate(dd.getDate() - diff);
  return dd;
}
function deepCopy(obj) {
  return safeParseJSON(JSON.stringify(obj));
}
function safeParseJSON(text) {
  try { return JSON.parse(text); } catch(e) {
    try { return eval('(' + text + ')'); } catch(e2) { return null; }
  }
}

// ========================================================================
// FILE I/O (via VBScript)
// ========================================================================
function readFileSync(filePath) {
  document.getElementById('_vbs_buffer').value = filePath;
  document.getElementById('_vbs_result').value = '';
  window.execScript('vbsReadFile()', 'VBScript');
  return document.getElementById('_vbs_result').value;
}
function writeFileSync(filePath, content) {
  document.getElementById('_vbs_filepath').value = filePath;
  document.getElementById('_vbs_buffer').value = content;
  document.getElementById('_vbs_result').value = '';
  window.execScript('vbsWriteFile()', 'VBScript');
  return document.getElementById('_vbs_result').value;
}
function jsVbsCallback() {
  if (VBS_CALLBACK) { var cb = VBS_CALLBACK; VBS_CALLBACK = null; cb(); }
}
function ensureDir(dirPath) {
  window.execScript('vbsEnsureDir "' + dirPath.replace(/"/g,'""') + '"', 'VBScript');
}
function resolvePath(rel) {
  if (!rel) return '';
  if (rel.indexOf(':') > 0) return rel;
  var r = rel.replace(/\//g, '\\');
  // strip leading .\ or .\\ 
  if (r.indexOf('.\\') === 0) r = r.substring(2);
  return APP_DIR + r;
}

// ========================================================================
// CSV PARSER / GENERATOR (RFC 4180)
// ========================================================================
function parseCSV(text) {
  if (!text || !text.trim()) return { headers: [], rows: [] };
  var lines = text.replace(/\r\n/g,'\n').replace(/\r/g,'\n');
  var result = [];
  var row = [];
  var field = '';
  var inQ = false;
  for (var i = 0; i < lines.length; i++) {
    var c = lines.charAt(i);
    if (inQ) {
      if (c === '"') {
        if (i+1 < lines.length && lines.charAt(i+1) === '"') { field += '"'; i++; }
        else { inQ = false; }
      } else { field += c; }
    } else {
      if (c === '"') { inQ = true; }
      else if (c === ',') { row.push(field); field = ''; }
      else if (c === '\n') { row.push(field); field = ''; result.push(row); row = []; }
      else { field += c; }
    }
  }
  if (field || row.length > 0) { row.push(field); result.push(row); }
  if (result.length === 0) return { headers: [], rows: [] };
  var headers = result[0];
  var rows = [];
  for (var r = 1; r < result.length; r++) {
    if (result[r].length === 1 && result[r][0] === '') continue;
    var obj = {};
    for (var c2 = 0; c2 < headers.length; c2++) {
      obj[headers[c2]] = (c2 < result[r].length) ? result[r][c2] : '';
    }
    rows.push(obj);
  }
  return { headers: headers, rows: rows };
}
function csvQ(s) {
  s = String(s == null ? '' : s);
  if (s.indexOf(',') >= 0 || s.indexOf('"') >= 0 || s.indexOf('\n') >= 0) {
    return '"' + s.replace(/"/g,'""') + '"';
  }
  return s;
}
function generateCSV(headers, rows) {
  var lines = [headers.map(function(h){ return csvQ(h); }).join(',')];
  rows.forEach(function(row) {
    var vals = headers.map(function(h) { return csvQ(row[h] != null ? row[h] : ''); });
    lines.push(vals.join(','));
  });
  return lines.join('\r\n');
}

