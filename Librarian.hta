<html>
<head>
<meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
<meta http-equiv="X-UA-Compatible" content="IE=9">
<title>Librarian</title>
<HTA:APPLICATION
  ID="LibrarianApp"
  APPLICATIONNAME="Librarian"
  BORDER="thick"
  BORDERSTYLE="normal"
  CAPTION="yes"
  MAXIMIZEBUTTON="yes"
  MINIMIZEBUTTON="yes"
  SHOWINTASKBAR="yes"
  SINGLEINSTANCE="yes"
  SYSMENU="yes"
  WINDOWSTATE="maximize"
  SCROLL="no"
  SELECTION="yes"
/>
<style>
*{margin:0;padding:0;box-sizing:border-box;}
html,body{width:100%;height:100%;overflow:hidden;font-family:"Meiryo UI","Meiryo","Segoe UI",sans-serif;font-size:14px;color:#e0e4ef;background:#0f1117;}
input,select,textarea,button{font-family:inherit;font-size:14px;color:#e0e4ef;}
button{cursor:pointer;}
#header{height:48px;line-height:48px;background:#161822;border-bottom:1px solid #2a2d3e;padding:0 20px;overflow:hidden;}
.app-title{font-size:20px;font-weight:800;color:#c8a44e;letter-spacing:4px;float:left;}
.app-subtitle{font-size:12px;color:#6b7190;margin-left:14px;float:left;letter-spacing:1px;line-height:48px;}
.hdr-right{float:right;line-height:48px;}
.hdr-btn{display:inline-block;padding:6px 14px;background:transparent;border:1px solid #363b52;color:#8892a6;cursor:pointer;font-size:13px;margin-left:6px;vertical-align:middle;font-family:inherit;}
.hdr-btn:hover{border-color:#c8a44e;color:#c8a44e;background:rgba(200,164,78,0.06);}
#app-body{position:absolute;top:48px;left:0;right:0;bottom:32px;overflow:hidden;}
#sidebar{position:absolute;left:0;top:0;bottom:0;width:180px;background:#13151e;border-right:1px solid #2a2d3e;overflow-y:auto;}
#content{position:absolute;left:180px;top:0;right:0;bottom:0;overflow:hidden;}
.nav-section{font-size:11px;font-weight:700;color:#6b7190;letter-spacing:2px;text-transform:uppercase;padding:16px 16px 6px;}
.nav-btn{display:block;width:100%;padding:10px 16px;background:transparent;border:none;border-left:3px solid transparent;color:#8892a6;font-size:14px;text-align:left;cursor:pointer;font-family:inherit;}
.nav-btn:hover{background:#1a1d2a;color:#c0c6d6;}
.nav-btn.active{background:rgba(200,164,78,0.08);color:#c8a44e;border-left-color:#c8a44e;font-weight:700;}
.nav-count{float:right;font-size:11px;background:#262a3a;color:#8892a6;padding:2px 8px;display:inline-block;vertical-align:middle;line-height:16px;}
.nav-sep{height:1px;background:#2a2d3e;margin:8px 12px;}
#toolbar{position:absolute;top:0;left:0;right:0;height:44px;background:#161822;border-bottom:1px solid #2a2d3e;padding:7px 16px;overflow:hidden;}
.tool-btn{display:inline-block;padding:6px 14px;background:transparent;border:1px solid #363b52;color:#8892a6;cursor:pointer;font-size:13px;margin-right:4px;vertical-align:middle;font-family:inherit;}
.tool-btn:hover{border-color:#c8a44e;color:#c8a44e;background:rgba(200,164,78,0.06);}
.tool-btn.primary{background:rgba(200,164,78,0.12);border-color:#c8a44e;color:#c8a44e;}
.tool-sep{display:inline-block;width:1px;height:22px;background:#2a2d3e;margin:0 8px;vertical-align:middle;}
.search-box input{background:#0f1117;border:1px solid #363b52;padding:5px 12px;width:220px;color:#e0e4ef;outline:none;display:inline;vertical-align:middle;}
.search-box input:focus{border-color:#c8a44e;}
#main-area{position:absolute;top:44px;left:0;right:0;bottom:0;overflow:hidden;}
#table-wrap{position:absolute;top:0;left:0;right:0;bottom:0;overflow:auto;}
.data-table{width:100%;border-collapse:collapse;table-layout:fixed;}
.data-table th{background:#1a1d28;color:#c8a44e;font-size:12px;font-weight:700;letter-spacing:1px;text-transform:uppercase;padding:10px 12px;border:1px solid #2a2d3e;text-align:left;cursor:pointer;white-space:nowrap;}
.data-table th:hover{background:#22263a;}
.data-table td{padding:9px 12px;border:1px solid #232636;font-size:14px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;cursor:default;background:#13151e;}
.data-table tr:hover td{background:#1a1d2a;}
.data-table tr.selected td{background:rgba(200,164,78,0.10);}
.tag{display:inline-block;font-size:11px;font-weight:600;padding:2px 8px;margin:0 3px 2px 0;background:rgba(200,164,78,0.10);border:1px solid rgba(200,164,78,0.25);color:#c8a44e;}
.link-cell{color:#5b9cf5;text-decoration:underline;cursor:pointer;}
.link-cell:hover{color:#8bc0ff;}
.type-badge{display:inline-block;font-size:10px;font-weight:700;padding:2px 7px;letter-spacing:1px;}
.ficon{display:inline-block;font-size:11px;font-weight:800;padding:3px 6px;margin-right:4px;cursor:pointer;vertical-align:middle;text-align:center;min-width:30px;letter-spacing:0.5px;}
.ficon:hover{opacity:0.75;}
.ficon-doc{background:rgba(66,133,244,0.15);border:1px solid rgba(66,133,244,0.35);color:#4285f4;}
.ficon-xls{background:rgba(52,168,83,0.15);border:1px solid rgba(52,168,83,0.35);color:#34a853;}
.ficon-ppt{background:rgba(234,134,0,0.15);border:1px solid rgba(234,134,0,0.35);color:#ea8600;}
.ficon-pdf{background:rgba(234,67,53,0.15);border:1px solid rgba(234,67,53,0.35);color:#ea4335;}
.ficon-img{background:rgba(160,100,240,0.15);border:1px solid rgba(160,100,240,0.35);color:#a064f0;}
.ficon-txt{background:rgba(128,139,160,0.15);border:1px solid rgba(128,139,160,0.35);color:#808ba0;}
.ficon-file{background:rgba(107,113,144,0.15);border:1px solid rgba(107,113,144,0.35);color:#6b7190;}
.file-name{display:inline-block;vertical-align:middle;font-size:13px;color:#a0a6bc;cursor:pointer;max-width:100px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.file-name:hover{color:#c8a44e;text-decoration:underline;}
#form-panel{display:none;position:absolute;top:0;right:0;width:420px;bottom:0;background:#161822;border-left:1px solid #2a2d3e;overflow-y:auto;z-index:50;}
#form-panel.open{display:block;}
.form-hdr{padding:14px 20px;border-bottom:1px solid #2a2d3e;overflow:hidden;}
.form-title{float:left;font-size:14px;font-weight:700;color:#c8a44e;letter-spacing:2px;text-transform:uppercase;line-height:28px;}
.form-close{float:right;background:none;border:none;color:#6b7190;cursor:pointer;font-size:20px;padding:0 4px;font-family:inherit;}
.form-close:hover{color:#e0e4ef;}
.form-body{padding:20px;}
.fg{margin-bottom:14px;}
.fg label{display:block;font-size:12px;font-weight:600;color:#6b7190;letter-spacing:1px;text-transform:uppercase;margin-bottom:5px;}
.fg input[type="text"],.fg textarea,.fg select{width:100%;background:#0f1117;border:1px solid #363b52;padding:9px 12px;color:#e0e4ef;outline:none;}
.fg input:focus,.fg textarea:focus,.fg select:focus{border-color:#c8a44e;}
.fg textarea{height:80px;resize:vertical;line-height:1.6;}
.fg select option{background:#161822;}
.form-actions{padding:16px 20px;border-top:1px solid #2a2d3e;text-align:right;}
.btn{display:inline-block;padding:9px 20px;border:1px solid;cursor:pointer;font-size:13px;font-weight:700;font-family:inherit;}
.btn-save{background:#c8a44e;border-color:#c8a44e;color:#0f1117;}
.btn-save:hover{background:#dbb960;}
.btn-cancel{background:transparent;border-color:#363b52;color:#8892a6;margin-right:8px;}
.btn-cancel:hover{border-color:#c8a44e;color:#c8a44e;}
.btn-danger{background:transparent;border-color:rgba(240,96,96,0.3);color:#f06060;margin-left:8px;}
.btn-danger:hover{background:rgba(240,96,96,0.08);}
.drop-zone{border:2px dashed #363b52;padding:18px;text-align:center;cursor:pointer;background:#0f1117;margin-bottom:14px;color:#6b7190;font-size:13px;}
.drop-zone.over{border-color:#c8a44e;background:rgba(200,164,78,0.06);color:#c8a44e;}
#settings-screen{display:none;position:absolute;top:0;left:0;right:0;bottom:0;overflow-y:auto;padding:24px;background:#0f1117;z-index:40;}
.s-section{background:#161822;border:1px solid #2a2d3e;margin-bottom:18px;}
.s-section-hdr{padding:14px 20px;border-bottom:1px solid #2a2d3e;font-size:13px;font-weight:700;color:#c8a44e;letter-spacing:2px;text-transform:uppercase;}
.s-section-body{padding:16px 20px;}
.s-table{width:100%;border-collapse:collapse;margin-bottom:12px;}
.s-table th{background:#1a1d28;color:#8892a6;font-size:12px;font-weight:600;padding:8px 10px;border:1px solid #2a2d3e;text-align:left;}
.s-table td{padding:8px 10px;border:1px solid #232636;font-size:13px;background:#13151e;}
.s-table tr:hover td{background:#1a1d2a;}
.s-inline{background:#0f1117;border:1px solid #363b52;padding:5px 8px;color:#e0e4ef;font-size:13px;outline:none;font-family:inherit;}
.s-inline:focus{border-color:#c8a44e;}
.s-btn{display:inline-block;padding:5px 12px;border:1px solid #363b52;background:transparent;color:#8892a6;cursor:pointer;font-size:12px;font-weight:600;margin:2px;font-family:inherit;}
.s-btn:hover{border-color:#c8a44e;color:#c8a44e;}
.s-btn.danger{border-color:rgba(240,96,96,0.3);color:#f06060;}
.s-btn.danger:hover{background:rgba(240,96,96,0.08);}
.color-swatch{display:inline-block;width:16px;height:16px;vertical-align:middle;margin-right:6px;border:1px solid #363b52;}
.modal-bg{display:none;position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.65);z-index:500;}
.modal-bg.open{display:block;}
.modal-box{background:#1a1d28;border:1px solid #363b52;width:600px;max-width:95%;margin:60px auto;}
.modal-hdr{padding:14px 20px;border-bottom:1px solid #2a2d3e;overflow:hidden;}
.modal-body{padding:20px;max-height:400px;overflow-y:auto;}
.modal-foot{padding:14px 20px;border-top:1px solid #2a2d3e;text-align:right;}
#statusbar{position:absolute;bottom:0;left:0;right:0;height:32px;line-height:32px;background:#161822;border-top:1px solid #2a2d3e;padding:0 16px;font-size:12px;color:#6b7190;overflow:hidden;}
#statusbar span{margin-right:18px;}
.toast-area{position:fixed;bottom:44px;right:24px;z-index:9000;}
.toast-msg{padding:12px 22px;margin-top:8px;font-size:14px;font-weight:600;background:#1a1d28;border:1px solid rgba(200,164,78,0.3);color:#c8a44e;}
.toast-msg.ok{border-color:rgba(78,202,122,0.3);color:#4eca7a;}
.toast-msg.err{border-color:rgba(240,96,96,0.3);color:#f06060;}
.empty-state{text-align:center;padding:60px 20px;color:#4a4e62;}
</style>
<script language="VBScript">
Dim gFSO
Set gFSO = CreateObject("Scripting.FileSystemObject")
Function getAppDir()
  Dim p
  p = Replace(document.location.pathname, "/", "\")
  If Left(p,1) = "\" Then p = Mid(p, 2)
  p = Replace(p, "%20", " ")
  getAppDir = gFSO.GetParentFolderName(p)
  If Right(getAppDir, 1) <> "\" Then getAppDir = getAppDir & "\"
End Function

Sub readUTF8(filePath)
  Dim s, result
  On Error Resume Next
  Set s = CreateObject("ADODB.Stream")
  s.Type = 2 : s.Charset = "UTF-8" : s.Open
  s.LoadFromFile filePath : result = s.ReadText : s.Close : Set s = Nothing
  If Err.Number <> 0 Then result = "" : Err.Clear
  On Error GoTo 0
  If Len(result) > 0 Then
    If AscW(Left(result, 1)) = 65279 Then result = Mid(result, 2)
  End If
  document.getElementById("_vbs_result").value = result
End Sub

Sub writeUTF8(filePath, content)
  Dim s
  On Error Resume Next
  Set s = CreateObject("ADODB.Stream")
  s.Type = 2 : s.Charset = "UTF-8" : s.Open
  s.WriteText content
  s.SaveToFile filePath, 2
  s.Close : Set s = Nothing
  If Err.Number <> 0 Then
    document.getElementById("_vbs_result").value = "ERROR:" & Err.Description
    Err.Clear
  Else
    document.getElementById("_vbs_result").value = "OK"
  End If
  On Error GoTo 0
End Sub

' Wrapper: JS sets _vbs_buffer=filepath, calls this, reads _vbs_result
Sub vbsReadFile()
  Dim fp
  fp = document.getElementById("_vbs_buffer").value
  Call readUTF8(fp)
End Sub

' Wrapper: JS sets _vbs_filepath=path, _vbs_buffer=content, calls this
Sub vbsWriteFile()
  Dim fp, ct
  fp = document.getElementById("_vbs_filepath").value
  ct = document.getElementById("_vbs_buffer").value
  Call writeUTF8(fp, ct)
End Sub

Sub vbsRotateBackup(basePath)
  Dim bak1, bak2, bak3
  bak1 = basePath & ".bak1"
  bak2 = basePath & ".bak2"
  bak3 = basePath & ".bak3"
  On Error Resume Next
  If gFSO.FileExists(bak3) Then gFSO.DeleteFile bak3, True
  If gFSO.FileExists(bak2) Then gFSO.MoveFile bak2, bak3
  If gFSO.FileExists(bak1) Then gFSO.MoveFile bak1, bak2
  If gFSO.FileExists(basePath) Then gFSO.CopyFile basePath, bak1, True
  Err.Clear
  On Error GoTo 0
End Sub
</script>
</head>
<body>
<input type="hidden" id="_vbs_buffer" />
<input type="hidden" id="_vbs_result" />
<input type="hidden" id="_vbs_filepath" />
<input type="file" id="_fileInput" style="display:none;" onchange="onFileSelected(this)">
<input type="file" id="_csvFileInput" style="display:none;" accept=".csv,.txt" onchange="onCsvFileSelected(this)">
<div id="header">
  <span class="app-title">LIBRARIAN</span>
  <span class="app-subtitle">Reference &amp; Link Manager</span>
  <span class="hdr-right">
    <span id="hdr-total" style="font-size:12px;color:#6b7190;margin-right:12px;">0</span>
    <button class="hdr-btn" onclick="exportAllCSV()">CSV Export</button>
    <button class="hdr-btn" onclick="toggleSettings()">Settings</button>
  </span>
</div>
<div id="app-body">
  <div id="sidebar"><div id="sidebarInner"></div></div>
  <div id="content">
    <div id="toolbar">
      <button class="tool-btn primary" onclick="openForm('new')">+ New</button>
      <span class="tool-sep"></span>
      <button class="tool-btn" onclick="deleteSelected()">Delete</button>
      <span class="tool-sep"></span>
      <span class="search-box"><input type="text" id="searchInput" placeholder="Search..." onkeyup="onSearch(this.value)"></span>
      <span class="tool-sep"></span>
      <select id="sortSelect" onchange="onSortChange()" style="background:#0f1117;border:1px solid #363b52;padding:4px 8px;font-size:12px;color:#8892a6;vertical-align:middle;">
        <option value="date_desc">Date (Newest)</option>
        <option value="date_asc">Date (Oldest)</option>
        <option value="title_asc">Title (A-Z)</option>
      </select>
    </div>
    <div id="main-area">
      <div id="table-wrap"></div>
      <div id="form-panel">
        <div class="form-hdr"><span class="form-title" id="formTitle">NEW</span><button class="form-close" onclick="closeForm()">&#10005;</button></div>
        <div class="form-body" id="formBody"></div>
        <div class="form-actions"><input type="hidden" id="f-editId" value=""><button class="btn btn-cancel" onclick="closeForm()">Cancel</button><button class="btn btn-save" onclick="saveEntry()">Save</button></div>
      </div>
      <div id="settings-screen"></div>
    </div>
  </div>
</div>
<div id="statusbar"><span id="st-view">All</span><span id="st-count">0</span><span id="st-saved" style="float:right;">-</span></div>
<div class="toast-area" id="toastArea"></div>
<div class="modal-bg" id="csvModal"><div class="modal-box">
  <div class="modal-hdr"><span class="form-title">CSV IMPORT</span><button class="form-close" onclick="closeCsvModal()">&#10005;</button></div>
  <div class="modal-body">
    <div class="fg">
      <label>1. Import as type</label>
      <div id="csvTypeWrap"></div>
    </div>
    <div class="fg">
      <label>2. Select CSV file</label>
      <div style="margin-bottom:8px;">
        <input type="text" id="csvFilePath" readonly="readonly" placeholder="No file selected" style="width:68%;display:inline;background:#0a0c12;cursor:default;">
        <button class="btn btn-cancel" onclick="csvBrowseFile()" style="padding:7px 14px;margin:0 0 0 4px;vertical-align:top;">Browse .csv</button>
      </div>
      <div style="font-size:12px;color:#6b7190;margin-bottom:8px;" id="csvFileInfo"></div>
    </div>
    <div class="fg">
      <label>Preview / Paste CSV</label>
      <textarea id="csvText" style="height:160px;font-family:Consolas,monospace;font-size:12px;line-height:1.5;" placeholder="CSV content will appear here after file selection...&#10;&#10;Or paste CSV directly:&#10;title,link,source,tags,summary"></textarea>
    </div>
    <p style="font-size:12px;color:#6b7190;">Header row auto-detected. Columns matched by name (title, link, source, tags, etc.).</p>
  </div>
  <div class="modal-foot">
    <span id="csvPreviewCount" style="float:left;font-size:12px;color:#6b7190;line-height:36px;"></span>
    <button class="btn btn-cancel" onclick="closeCsvModal()">Cancel</button>
    <button class="btn btn-save" onclick="importCsv()">Import</button>
  </div>
</div></div>

<script language="JavaScript">
if(!Array.prototype.indexOf){Array.prototype.indexOf=function(v,s){for(var i=s||0;i<this.length;i++){if(this[i]===v)return i;}return-1;};}
if(!Array.prototype.forEach){Array.prototype.forEach=function(fn,c){for(var i=0;i<this.length;i++)fn.call(c,this[i],i,this);};}
if(!Array.prototype.filter){Array.prototype.filter=function(fn,c){var r=[];for(var i=0;i<this.length;i++){if(fn.call(c,this[i],i,this))r.push(this[i]);}return r;};}
if(!Array.prototype.map){Array.prototype.map=function(fn,c){var r=[];for(var i=0;i<this.length;i++)r.push(fn.call(c,this[i],i,this));return r;};}
if(!Array.isArray){Array.isArray=function(a){return Object.prototype.toString.call(a)==='[object Array]';};}
if(!String.prototype.trim){String.prototype.trim=function(){return this.replace(/^\s+|\s+$/g,'');};}

var APP_DIR='',DATA_FILE='librarian_data.json';
var DB={config:null,entries:[]};
var VIEW='all',SEARCH_Q='',SORT_KEY='date_desc',SELECTED={},TAG_FILTER='',SETTINGS_OPEN=false;

function getDefaultConfig(){return{configVer:1,types:[{id:'news',label:'News',color:'#5b9cf5'},{id:'guide',label:'Guideline',color:'#4eca7a'}],columns:[{key:'title',label:'Title',type:'text',width:200,show:true,sortable:true},{key:'summary',label:'Summary',type:'textarea',width:200,show:true,sortable:false},{key:'link',label:'Link',type:'url',width:170,show:true,sortable:true},{key:'source',label:'Source',type:'text',width:100,show:true,sortable:true},{key:'filepath',label:'Document',type:'file',width:150,show:true,sortable:false},{key:'tags',label:'Tags',type:'tags',width:150,show:true,sortable:false}]};}
function CFG(){return DB.config;}
function findType(id){var t=CFG().types;for(var i=0;i<t.length;i++){if(t[i].id===id)return t[i];}return null;}
function hexToBg(hex,a){hex=hex.replace('#','');if(hex.length===3)hex=hex[0]+hex[0]+hex[1]+hex[1]+hex[2]+hex[2];var r=parseInt(hex.substring(0,2),16)||0,g=parseInt(hex.substring(2,4),16)||0,b=parseInt(hex.substring(4,6),16)||0;return'rgba('+r+','+g+','+b+','+a+')';}

function readFile(path){
  document.getElementById('_vbs_buffer').value=path;
  document.getElementById('_vbs_result').value='';
  try{window.execScript('vbsReadFile()','VBScript');}catch(e){return'';}
  return document.getElementById('_vbs_result').value;
}
function writeFile(path,content){
  document.getElementById('_vbs_filepath').value=path;
  document.getElementById('_vbs_buffer').value=content;
  document.getElementById('_vbs_result').value='';
  try{window.execScript('vbsWriteFile()','VBScript');}catch(e){return'ERROR:execScript failed';}
  return document.getElementById('_vbs_result').value;
}
function resolvePath(r){if(!r)return'';if(r.indexOf(':')>0)return r;var s=r.replace(/\//g,'\\');if(s.indexOf('.\\')===0)s=s.substring(2);return APP_DIR+s;}
function loadData(){var text=readFile(resolvePath(DATA_FILE));if(text&&text.trim()){try{DB=JSON.parse(text);}catch(e){DB={};}}if(!DB||typeof DB!=='object')DB={};if(!DB.config||!DB.config.configVer)DB.config=getDefaultConfig();if(!DB.entries||!Array.isArray(DB.entries))DB.entries=[];}
function saveData(){
  var path=resolvePath(DATA_FILE);
  var json=JSON.stringify(DB,null,2);
  // Rotate backups
  try{window.execScript('vbsRotateBackup "'+path.replace(/"/g,'""')+'"','VBScript');}catch(e){}
  // Write
  var result=writeFile(path,json);
  if(result&&result.indexOf('ERROR')===0){
    toast('SAVE FAILED: '+result,'err');
    document.getElementById('st-saved').innerText='SAVE ERROR!';
    return;
  }
  // Verify by reading back
  var verify=readFile(path);
  if(!verify||verify.length<10){
    toast('SAVE VERIFY FAILED: file empty after write. Path='+path,'err');
    document.getElementById('st-saved').innerText='VERIFY FAIL!';
    return;
  }
  document.getElementById('st-saved').innerText='Saved: '+timeStr()+' ('+json.length+'bytes)';
}
function fileExists(path){
  try{
    document.getElementById('_vbs_result').value='';
    window.execScript('document.getElementById("_vbs_result").value=CStr(gFSO.FileExists("'+path.replace(/"/g,'""')+'"))','VBScript');
    return document.getElementById('_vbs_result').value==='True';
  }catch(e){return false;}
}
function getBackupInfo(){
  var base=resolvePath(DATA_FILE);
  return{bak1:fileExists(base+'.bak1'),bak2:fileExists(base+'.bak2'),bak3:fileExists(base+'.bak3')};
}
function restoreBackup(gen){
  var base=resolvePath(DATA_FILE);
  var bakPath=base+'.bak'+gen;
  if(!fileExists(bakPath)){toast('Backup file not found','err');return;}
  if(!confirm('Restore from backup '+gen+'? Current data will be overwritten.\n(Current data will be backed up first)'))return;
  // Save current as emergency backup before restore
  try{
    var emergPath=base+'.pre-restore';
    window.execScript('If gFSO.FileExists("'+base.replace(/"/g,'""')+'") Then gFSO.CopyFile "'+base.replace(/"/g,'""')+'", "'+emergPath.replace(/"/g,'""')+'", True','VBScript');
  }catch(e){}
  // Read backup and load
  var text=readFile(bakPath);
  if(text&&text.trim()){
    try{
      var restored=JSON.parse(text);
      if(restored&&typeof restored==='object'){
        DB=restored;
        if(!DB.config||!DB.config.configVer)DB.config=getDefaultConfig();
        if(!DB.entries||!Array.isArray(DB.entries))DB.entries=[];
        writeFile(base,text);
        renderSidebar();renderTable();
        if(SETTINGS_OPEN)renderSettings();
        toast('Restored from backup '+gen+' ('+DB.entries.length+' entries)','ok');
      }else{toast('Invalid backup data','err');}
    }catch(e){toast('Failed to parse backup','err');}
  }else{toast('Backup file is empty','err');}
}

function uid(){return'L'+(new Date().getTime())+'_'+Math.floor(Math.random()*10000);}
function esc(s){return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');}
function pad(n){return n<10?'0'+n:''+n;}
function dateStr(){var d=new Date();return d.getFullYear()+'-'+pad(d.getMonth()+1)+'-'+pad(d.getDate());}
function timeStr(){var d=new Date();return pad(d.getHours())+':'+pad(d.getMinutes())+':'+pad(d.getSeconds());}
function fmtDate(s){if(!s)return'';var m=String(s).match(/^(\d{4})-(\d{1,2})-(\d{1,2})/);if(!m)return s;return parseInt(m[2],10)+'/'+parseInt(m[3],10);}
function toast(m,t){var c=document.getElementById('toastArea'),d=document.createElement('div');d.className='toast-msg'+(t?' '+t:'');d.innerText=m;d.onclick=function(){try{c.removeChild(d);}catch(e){}};c.appendChild(d);setTimeout(function(){try{c.removeChild(d);}catch(e){}},3000);}
function parseCSV(text){if(!text||!text.trim())return[];var lines=text.replace(/\r\n/g,'\n').replace(/\r/g,'\n'),result=[],row=[],field='',inQ=false;for(var i=0;i<lines.length;i++){var c=lines.charAt(i);if(inQ){if(c==='"'){if(i+1<lines.length&&lines.charAt(i+1)==='"'){field+='"';i++;}else{inQ=false;}}else{field+=c;}}else{if(c==='"'){inQ=true;}else if(c===','){row.push(field);field='';}else if(c==='\n'){row.push(field);field='';result.push(row);row=[];}else{field+=c;}}}if(field||row.length>0){row.push(field);result.push(row);}return result;}
function csvQ(s){s=String(s==null?'':s);if(s.indexOf(',')>=0||s.indexOf('"')>=0||s.indexOf('\n')>=0)return'"'+s.replace(/"/g,'""')+'"';return s;}
function getFileExt(f){if(!f)return'';var d=f.lastIndexOf('.');return d<0?'':f.substring(d+1).toLowerCase();}
function getFileIconClass(f){var e=getFileExt(f);if(e==='doc'||e==='docx'||e==='docm')return'ficon-doc';if(e==='xls'||e==='xlsx'||e==='xlsm'||e==='csv')return'ficon-xls';if(e==='ppt'||e==='pptx'||e==='pptm')return'ficon-ppt';if(e==='pdf')return'ficon-pdf';if(e==='png'||e==='jpg'||e==='jpeg'||e==='gif'||e==='bmp'||e==='svg')return'ficon-img';if(e==='txt'||e==='md'||e==='log')return'ficon-txt';return'ficon-file';}
function getFileLabel(f){var e=getFileExt(f);if(e==='doc'||e==='docx'||e==='docm')return'DOC';if(e==='xls'||e==='xlsx'||e==='xlsm')return'XLS';if(e==='csv')return'CSV';if(e==='ppt'||e==='pptx'||e==='pptm')return'PPT';if(e==='pdf')return'PDF';if(e==='png'||e==='jpg'||e==='jpeg'||e==='gif'||e==='bmp')return'IMG';if(e==='txt')return'TXT';if(e)return e.toUpperCase().substring(0,4);return'FILE';}
function openFile(fp){if(!fp)return;try{var s=new ActiveXObject('WScript.Shell');s.Run('"'+fp+'"');}catch(e){toast('Cannot open: '+fp,'err');}}
function openLink(url){if(!url)return;try{var s=new ActiveXObject('WScript.Shell');s.Run(url);}catch(e){try{window.open(url,'_blank');}catch(e2){}}}

// ====== SIDEBAR ======
function renderSidebar(){
  var types=CFG().types,entries=DB.entries;
  var h='<div class="nav-section">CATEGORY</div>';
  h+='<button class="nav-btn'+(VIEW==='all'?' active':'')+'" onclick="setView(\'all\')">All <span class="nav-count">'+entries.length+'</span></button>';
  for(var i=0;i<types.length;i++){var t=types[i],cnt=0;for(var j=0;j<entries.length;j++){if(entries[j].category===t.id)cnt++;}
    h+='<button class="nav-btn'+(VIEW===t.id?' active':'')+'" onclick="setView(\''+esc(t.id)+'\')">'+esc(t.label)+' <span class="nav-count">'+cnt+'</span></button>';}
  h+='<div class="nav-sep"></div><div class="nav-section">TAGS</div><div id="tag-nav" style="padding:4px 12px;"></div>';
  h+='<div class="nav-sep"></div><div class="nav-section">ACTIONS</div>';
  h+='<button class="nav-btn" onclick="openForm(\'new\')">+ New Entry</button>';
  h+='<button class="nav-btn" onclick="openCsvModal()">CSV Import</button>';
  document.getElementById('sidebarInner').innerHTML=h;
  renderTagNav();
}
function renderTagNav(){
  var map={};for(var i=0;i<DB.entries.length;i++){var tg=DB.entries[i].tags;if(!tg)continue;var arr=tg.split(/[,;]/);for(var j=0;j<arr.length;j++){var t=arr[j].trim();if(t){var k=t.toLowerCase();if(!map[k])map[k]={label:t,count:0};map[k].count++;}}}
  var tags=[];for(var k2 in map){if(map.hasOwnProperty(k2))tags.push(map[k2]);}tags.sort(function(a,b){return b.count-a.count;});
  var h='',max=Math.min(tags.length,20);
  for(var ti=0;ti<max;ti++){var tg2=tags[ti],isA=TAG_FILTER&&TAG_FILTER.toLowerCase()===tg2.label.toLowerCase();var st=isA?'border-color:#c8a44e;background:rgba(200,164,78,0.22);':'';
    h+='<button onclick="setTagFilter(\''+esc(tg2.label).replace(/'/g,"\\'")+'\')" style="display:inline-block;font-size:11px;padding:3px 8px;margin:2px 3px 2px 0;background:rgba(200,164,78,0.10);border:1px solid rgba(200,164,78,0.25);color:#c8a44e;cursor:pointer;'+st+'font-family:inherit;">'+esc(tg2.label)+'<span style="color:#6b7190;margin-left:4px;font-size:10px;">'+tg2.count+'</span></button>';}
  if(!tags.length)h='<div style="font-size:12px;color:#4a4e62;padding:4px;">No tags</div>';
  var el=document.getElementById('tag-nav');if(el)el.innerHTML=h;
}
function setView(v){VIEW=v;TAG_FILTER='';document.getElementById('st-view').innerText='View: '+(v==='all'?'All':v);renderSidebar();renderTable();}
function setTagFilter(t){TAG_FILTER=(TAG_FILTER===t)?'':t;renderTagNav();renderTable();}

// ====== FILTER ======
function getFilteredData(){
  var data=DB.entries.slice(0);
  if(VIEW!=='all')data=data.filter(function(e){return e.category===VIEW;});
  if(TAG_FILTER){var tf=TAG_FILTER.toLowerCase();data=data.filter(function(e){var a=(e.tags||'').toLowerCase().split(/[,;]/);for(var i=0;i<a.length;i++){if(a[i].trim()===tf)return true;}return false;});}
  if(SEARCH_Q){var q=SEARCH_Q.toLowerCase();data=data.filter(function(e){for(var k in e){if(e.hasOwnProperty(k)&&typeof e[k]==='string'&&e[k].toLowerCase().indexOf(q)>=0)return true;}return false;});}
  var sk=SORT_KEY;data.sort(function(a,b){if(sk==='date_desc')return(b.created||'')>(a.created||'')?1:-1;if(sk==='date_asc')return(a.created||'')>(b.created||'')?1:-1;if(sk==='title_asc')return(a.title||'').toLowerCase()>(b.title||'').toLowerCase()?1:-1;var m=sk.match(/^col_(.+)_(asc|desc)$/);if(m){var va=(a[m[1]]||'').toLowerCase(),vb=(b[m[1]]||'').toLowerCase();return m[2]==='asc'?(va>vb?1:-1):(vb>va?1:-1);}return 0;});
  return data;
}
function onSearch(q){SEARCH_Q=q.trim();renderTable();}
function onSortChange(){SORT_KEY=document.getElementById('sortSelect').value;renderTable();}
function doSort(key){SORT_KEY='col_'+key+'_asc';renderTable();}

// ====== TABLE ======
function renderTable(){
  var cols=CFG().columns.filter(function(c){return c.show!==false;}),data=getFilteredData(),wrap=document.getElementById('table-wrap');
  var thead='<thead><tr><th style="width:28px;"><input type="checkbox" onclick="toggleAll(this)"></th><th style="width:55px;">Type</th>';
  for(var ci=0;ci<cols.length;ci++){var col=cols[ci];var ck=col.sortable?' onclick="doSort(\''+esc(col.key)+'\')"':'';thead+='<th style="width:'+col.width+'px;"'+ck+'>'+esc(col.label)+'</th>';}
  thead+='<th style="width:80px;" onclick="doSort(\'created\')">Date</th></tr></thead>';
  if(!data.length){wrap.innerHTML='<table class="data-table">'+thead+'<tbody></tbody></table><div class="empty-state"><div style="font-size:48px;opacity:0.3;margin-bottom:12px;">&#128218;</div><div style="font-size:14px;">No items found</div></div>';updateCounts();return;}
  var rows='';
  for(var i=0;i<data.length;i++){
    var e=data[i],sel=SELECTED[e.id]?' selected':'',tp=findType(e.category);
    var tpBg=tp?hexToBg(tp.color,0.12):'#262a3a',tpBd=tp?hexToBg(tp.color,0.25):'#363b52',tpC=tp?tp.color:'#8892a6';
    rows+='<tr class="'+sel+'" onclick="selectRow(\''+e.id+'\',event)" ondblclick="openForm(\'edit\',\''+e.id+'\')">';
    rows+='<td style="text-align:center;"><input type="checkbox" '+(SELECTED[e.id]?'checked':'')+' onclick="toggleCheck(\''+e.id+'\',this,event)"></td>';
    rows+='<td><span class="type-badge" style="background:'+tpBg+';border:1px solid '+tpBd+';color:'+tpC+';">'+esc(tp?tp.label:e.category)+'</span></td>';
    for(var ci2=0;ci2<cols.length;ci2++){
      var col=cols[ci2],val=e[col.key]||'';
      rows+='<td style="'+(col.type==='textarea'||col.type==='tags'?'white-space:normal;overflow:visible;':'')+'">';
      if(col.type==='url'&&val){var dsp=val.length>30?val.substring(0,30)+'...':val;rows+='<span class="link-cell" onclick="openLink(\''+esc(val).replace(/'/g,"\\'")+'\');event.stopPropagation();return false;" title="'+esc(val)+'">'+esc(dsp)+'</span>';}
      else if(col.type==='file'&&val){var fn=val,ls=Math.max(val.lastIndexOf('\\'),val.lastIndexOf('/'));if(ls>=0)fn=val.substring(ls+1);var ep=esc(val).replace(/\\/g,'\\\\').replace(/'/g,"\\'");rows+='<span class="ficon '+getFileIconClass(fn)+'" onclick="openFile(\''+ep+'\');event.stopPropagation();return false;" title="'+esc(val)+'">'+getFileLabel(fn)+'</span><span class="file-name" onclick="openFile(\''+ep+'\');event.stopPropagation();return false;" title="'+esc(val)+'">'+esc(fn)+'</span>';}
      else if(col.type==='tags'&&val){var ar=val.split(/[,;]/);for(var ti=0;ti<ar.length;ti++){var tg=ar[ti].trim();if(tg)rows+='<span class="tag">'+esc(tg)+'</span>';}}
      else if(col.type==='textarea'&&val){var sh=val.length>60?val.substring(0,60)+'...':val;rows+='<span title="'+esc(val)+'" style="color:#a0a6bc;font-size:13px;">'+esc(sh)+'</span>';}
      else if(col.type==='select'){rows+=esc(val);}
      else{rows+=esc(val);}
      rows+='</td>';
    }
    rows+='<td>'+fmtDate(e.created)+'</td></tr>';
  }
  wrap.innerHTML='<table class="data-table">'+thead+'<tbody>'+rows+'</tbody></table>';updateCounts();
}
function updateCounts(){var total=DB.entries.length,filtered=getFilteredData().length;document.getElementById('hdr-total').innerText=total+' items';document.getElementById('st-count').innerText=filtered+(filtered!==total?' / '+total:'');}
function selectRow(id,e){if(e&&(e.target||e.srcElement).tagName==='INPUT')return;SELECTED={};SELECTED[id]=true;renderTable();}
function toggleCheck(id,cb,e){if(e&&e.stopPropagation)e.stopPropagation();if(e)e.cancelBubble=true;SELECTED[id]=cb.checked;if(!cb.checked)delete SELECTED[id];}
function toggleAll(cb){var data=getFilteredData();SELECTED={};if(cb.checked){for(var i=0;i<data.length;i++)SELECTED[data[i].id]=true;}renderTable();}

// ====== DYNAMIC FORM ======
function renderForm(entry){
  var cols=CFG().columns,types=CFG().types;
  var h='<div class="fg"><label>Type</label><select id="f-category">';
  for(var i=0;i<types.length;i++){var sel=(entry&&entry.category===types[i].id)?'selected':'';if(!entry&&VIEW!=='all'&&VIEW===types[i].id)sel='selected';h+='<option value="'+esc(types[i].id)+'" '+sel+'>'+esc(types[i].label)+'</option>';}
  h+='</select></div>';
  for(var ci=0;ci<cols.length;ci++){
    var col=cols[ci],val=entry?entry[col.key]||'':'';h+='<div class="fg"><label>'+esc(col.label)+'</label>';
    if(col.type==='textarea'){h+='<textarea id="f-'+esc(col.key)+'">'+esc(val)+'</textarea>';}
    else if(col.type==='url'){h+='<input type="text" id="f-'+esc(col.key)+'" placeholder="https://..." value="'+esc(val)+'">';}
    else if(col.type==='file'){h+='<input type="text" id="f-'+esc(col.key)+'" value="'+esc(val)+'" readonly="readonly" style="width:68%;display:inline;background:#0a0c12;cursor:default;" onclick="browseFile(\''+esc(col.key)+'\')">';h+=' <button class="btn btn-cancel" onclick="browseFile(\''+esc(col.key)+'\')" style="padding:7px 12px;margin:0;vertical-align:top;">Browse</button>';}
    else if(col.type==='select'&&col.options){h+='<select id="f-'+esc(col.key)+'">';var opts=col.options.split(',');for(var oi=0;oi<opts.length;oi++){var ov=opts[oi].trim();h+='<option'+(ov===val?' selected':'')+'>'+esc(ov)+'</option>';}h+='</select>';}
    else{h+='<input type="text" id="f-'+esc(col.key)+'" value="'+esc(val)+'">';}
    h+='</div>';
  }
  h+='<div class="drop-zone" id="dropZone" onclick="browseFile(\'filepath\')" ondragover="dzOver(event)" ondragleave="dzLeave()" ondrop="dzDrop(event)">Drop file or link here<div style="font-size:12px;color:#4a4e62;margin-top:4px;" id="dropInfo"></div></div>';
  document.getElementById('formBody').innerHTML=h;
}
function openForm(mode,editId){
  if(SETTINGS_OPEN)toggleSettings();
  document.getElementById('form-panel').className='open';document.getElementById('table-wrap').style.right='420px';
  if(mode==='edit'&&editId){document.getElementById('formTitle').innerText='EDIT';document.getElementById('f-editId').value=editId;var entry=null;for(var i=0;i<DB.entries.length;i++){if(DB.entries[i].id===editId){entry=DB.entries[i];break;}}renderForm(entry);}
  else{document.getElementById('formTitle').innerText='NEW';document.getElementById('f-editId').value='';renderForm(null);}
}
function closeForm(){document.getElementById('form-panel').className='';document.getElementById('table-wrap').style.right='0';}
function saveEntry(){
  var editId=document.getElementById('f-editId').value,cols=CFG().columns,cat=document.getElementById('f-category')?document.getElementById('f-category').value:'',data={};
  data.category=cat;for(var i=0;i<cols.length;i++){var el=document.getElementById('f-'+cols[i].key);data[cols[i].key]=el?el.value.trim():'';}
  if(!data.title&&!data.link){toast('Title or Link required','err');return;}
  if(editId){for(var j=0;j<DB.entries.length;j++){if(DB.entries[j].id===editId){for(var k in data){if(data.hasOwnProperty(k))DB.entries[j][k]=data[k];}break;}}toast('Updated','ok');}
  else{data.id=uid();data.created=dateStr();if(!data.title&&data.link)data.title=data.link;DB.entries.push(data);toast('Added','ok');}
  saveData();closeForm();renderTable();renderSidebar();
}
function deleteSelected(){var ids=[];for(var k in SELECTED){if(SELECTED.hasOwnProperty(k)&&SELECTED[k])ids.push(k);}if(!ids.length){toast('No items selected');return;}if(!confirm(ids.length+' item(s) will be deleted?'))return;DB.entries=DB.entries.filter(function(e){return ids.indexOf(e.id)<0;});SELECTED={};saveData();renderTable();renderSidebar();toast(ids.length+' deleted','ok');}

// ====== DROP / BROWSE ======
function dzOver(e){e=e||window.event;if(e.preventDefault)e.preventDefault();e.returnValue=false;document.getElementById('dropZone').className='drop-zone over';}
function dzLeave(){document.getElementById('dropZone').className='drop-zone';}
function dzDrop(e){e=e||window.event;if(e.preventDefault)e.preventDefault();e.returnValue=false;document.getElementById('dropZone').className='drop-zone';try{var dt=e.dataTransfer,text='';try{text=dt.getData('Text')||'';}catch(ex){}if(!text){try{text=dt.getData('URL')||'';}catch(ex2){}}if(text){var path=text;if(path.indexOf('file:///')===0)path=path.substring(8).replace(/\//g,'\\');path=path.replace(/%20/g,' ');if(path.match(/\.[a-zA-Z0-9]{1,5}$/)){var name=path,ls=Math.max(path.lastIndexOf('\\'),path.lastIndexOf('/'));if(ls>=0)name=path.substring(ls+1);var fpEl=document.getElementById('f-filepath');if(fpEl)fpEl.value=path;var ttEl=document.getElementById('f-title');if(ttEl&&!ttEl.value)ttEl.value=name;document.getElementById('dropInfo').innerText='Path: '+path;toast('File: '+name,'ok');}else if(text.indexOf('http')===0){var lnEl=document.getElementById('f-link');if(lnEl)lnEl.value=text;var m=text.match(/^https?:\/\/([^\/]+)/);var srcEl=document.getElementById('f-source');if(m&&srcEl&&!srcEl.value)srcEl.value=m[1];document.getElementById('dropInfo').innerText='Link: '+text;toast('Link captured','ok');}}}catch(ex3){}}
var BROWSE_TARGET_COL='';
function browseFile(colKey){
  BROWSE_TARGET_COL=colKey;
  var inp=document.getElementById('_fileInput');
  // Reset value so onchange fires even for same file
  inp.value='';
  inp.click();
}
function onFileSelected(inp){
  var fp=inp.value;
  if(!fp)return;
  // In HTA, input.value gives full path
  var name=fp;
  var ls=Math.max(fp.lastIndexOf('\\'),fp.lastIndexOf('/'));
  if(ls>=0)name=fp.substring(ls+1);
  var el=document.getElementById('f-'+BROWSE_TARGET_COL);
  if(el)el.value=fp;
  var ttEl=document.getElementById('f-title');
  if(ttEl&&!ttEl.value)ttEl.value=name;
  var info=document.getElementById('dropInfo');
  if(info)info.innerText='Path: '+fp;
}

// ====== CSV ======
function openCsvModal(){
  document.getElementById('csvModal').className='modal-bg open';
  document.getElementById('csvText').value='';
  document.getElementById('csvFilePath').value='';
  document.getElementById('csvFileInfo').innerText='';
  document.getElementById('csvPreviewCount').innerText='';
  // Build type select via DOM (IE9: innerHTML on select is unreliable)
  var wrap=document.getElementById('csvTypeWrap');
  var types=CFG().types;
  var h='<select id="csvType" style="width:auto;background:#0f1117;border:1px solid #363b52;padding:8px 12px;color:#e0e4ef;font-size:14px;">';
  for(var i=0;i<types.length;i++){
    h+='<option value="'+esc(types[i].id)+'">'+esc(types[i].label)+'</option>';
  }
  h+='</select>';
  wrap.innerHTML=h;
}
function closeCsvModal(){document.getElementById('csvModal').className='modal-bg';}
function csvBrowseFile(){
  var inp=document.getElementById('_csvFileInput');
  inp.value='';
  inp.click();
}
function onCsvFileSelected(inp){
  var fp=inp.value;
  if(!fp)return;
  document.getElementById('csvFilePath').value=fp;
  // Read file content via VBScript
  var text=readFile(fp);
  if(text){
    document.getElementById('csvText').value=text;
    var lines=text.replace(/\r\n/g,'\n').split('\n');
    var nonEmpty=0;
    for(var i=0;i<lines.length;i++){if(lines[i].trim())nonEmpty++;}
    var name=fp;
    var ls=Math.max(fp.lastIndexOf('\\'),fp.lastIndexOf('/'));
    if(ls>=0)name=fp.substring(ls+1);
    document.getElementById('csvFileInfo').innerText='File: '+name+' ('+nonEmpty+' rows)';
    document.getElementById('csvPreviewCount').innerText=nonEmpty+' rows detected';
    toast('CSV loaded: '+name,'ok');
  }else{
    toast('File is empty or cannot be read','err');
  }
}
function importCsv(){
  var text=document.getElementById('csvText').value;
  if(!text||!text.trim()){toast('No CSV data. Select a file first.','err');return;}
  var catEl=document.getElementById('csvType');
  var cat=catEl?catEl.value:'';
  if(!cat){toast('Select a Type first','err');return;}
  var rows=parseCSV(text);
  if(!rows.length){toast('No data found','err');return;}
  // Detect header
  var headerMap=null,start=0;
  if(rows[0]){
    var fj=rows[0].join(',').toLowerCase();
    if(fj.indexOf('title')>=0||fj.indexOf('link')>=0){
      headerMap=[];
      for(var hi=0;hi<rows[0].length;hi++){headerMap.push(rows[0][hi].trim().toLowerCase());}
      start=1;
    }
  }
  var added=0;
  for(var i=start;i<rows.length;i++){
    var r=rows[i],empty=true;
    for(var j=0;j<r.length;j++){if(r[j].trim())empty=false;}
    if(empty)continue;
    var entry={id:uid(),category:cat,created:dateStr()};
    if(headerMap){
      for(var ci=0;ci<headerMap.length;ci++){
        var mKey=headerMap[ci];
        for(var ck=0;ck<CFG().columns.length;ck++){
          if(CFG().columns[ck].key.toLowerCase()===mKey||CFG().columns[ck].label.toLowerCase()===mKey){
            entry[CFG().columns[ck].key]=(r[ci]||'').trim();break;
          }
        }
      }
    }else{
      var defaults=['title','link','source','tags','summary'];
      for(var di=0;di<defaults.length&&di<r.length;di++){entry[defaults[di]]=(r[di]||'').trim();}
    }
    if(!entry.title&&!entry.link)continue;
    if(!entry.title)entry.title=entry.link;
    DB.entries.push(entry);added++;
  }
  if(added>0){
    saveData();renderTable();renderSidebar();
    toast(added+' items imported as ['+cat+']','ok');
    closeCsvModal();
  }else{
    toast('No valid rows found','err');
  }
}
function exportAllCSV(){var data=getFilteredData(),cols=CFG().columns;if(!data.length){toast('No data');return;}var hdr=['category'];for(var i=0;i<cols.length;i++)hdr.push(cols[i].key);hdr.push('created');var lines=[hdr.join(',')];for(var j=0;j<data.length;j++){var vals=[];vals.push(csvQ(data[j].category));for(var k=0;k<cols.length;k++)vals.push(csvQ(data[j][cols[k].key]||''));vals.push(csvQ(data[j].created));lines.push(vals.join(','));}var csv=lines.join('\r\n'),fn='librarian_export_'+dateStr().replace(/-/g,'')+'.csv';try{writeFile(resolvePath(fn),csv);toast('Exported: '+fn,'ok');}catch(e){try{if(window.clipboardData){window.clipboardData.setData('Text',csv);toast('CSV copied','ok');}}catch(e2){toast('Export failed','err');}}}

// ====== SETTINGS ======
function toggleSettings(){SETTINGS_OPEN=!SETTINGS_OPEN;var el=document.getElementById('settings-screen');el.style.display=SETTINGS_OPEN?'block':'none';if(SETTINGS_OPEN){closeForm();renderSettings();}}
function renderSettings(){
  var types=CFG().types,cols=CFG().columns;
  var h='<div style="margin-bottom:16px;overflow:hidden;"><span style="font-size:16px;font-weight:800;color:#c8a44e;letter-spacing:3px;float:left;line-height:32px;">SETTINGS</span><button class="s-btn" onclick="toggleSettings()" style="float:right;">Close</button></div>';
  // TYPES
  h+='<div class="s-section"><div class="s-section-hdr">TYPES (Categories)</div><div class="s-section-body">';
  h+='<table class="s-table"><thead><tr><th>ID</th><th>Label</th><th>Color</th><th>Preview</th><th>Actions</th></tr></thead><tbody>';
  for(var i=0;i<types.length;i++){var t=types[i];h+='<tr><td><input class="s-inline" id="st-id-'+i+'" value="'+esc(t.id)+'" style="width:80px;"></td><td><input class="s-inline" id="st-label-'+i+'" value="'+esc(t.label)+'" style="width:120px;"></td><td><input class="s-inline" id="st-color-'+i+'" value="'+esc(t.color)+'" style="width:80px;"> <span class="color-swatch" style="background:'+esc(t.color)+';"></span></td><td><span class="type-badge" style="background:'+hexToBg(t.color,0.12)+';border:1px solid '+hexToBg(t.color,0.25)+';color:'+esc(t.color)+';">'+esc(t.label)+'</span></td><td><button class="s-btn" onclick="updateType('+i+')">Apply</button> <button class="s-btn danger" onclick="removeType('+i+')">Delete</button></td></tr>';}
  h+='</tbody></table>';
  h+='<div style="margin-top:8px;"><input class="s-inline" id="st-new-id" placeholder="id" style="width:80px;margin-right:4px;"><input class="s-inline" id="st-new-label" placeholder="Label" style="width:120px;margin-right:4px;"><input class="s-inline" id="st-new-color" placeholder="#color" value="#c8a44e" style="width:80px;margin-right:4px;"><button class="s-btn" onclick="addType()">+ Add Type</button></div>';
  h+='</div></div>';
  // COLUMNS
  h+='<div class="s-section"><div class="s-section-hdr">COLUMNS (Fields)</div><div class="s-section-body">';
  h+='<table class="s-table"><thead><tr><th>#</th><th>Key</th><th>Label</th><th>Type</th><th>Width</th><th>Options</th><th>Show</th><th>Sort</th><th>Actions</th></tr></thead><tbody>';
  for(var ci=0;ci<cols.length;ci++){var c=cols[ci];
    h+='<tr><td style="text-align:center;color:#6b7190;">'+(ci+1)+'</td>';
    h+='<td><input class="s-inline" id="sc-key-'+ci+'" value="'+esc(c.key)+'" style="width:80px;"></td>';
    h+='<td><input class="s-inline" id="sc-label-'+ci+'" value="'+esc(c.label)+'" style="width:100px;"></td>';
    h+='<td><select class="s-inline" id="sc-type-'+ci+'" style="width:90px;background:#0f1117;border:1px solid #363b52;">';
    var typeOpts=['text','textarea','url','file','tags','select','date'];for(var oi=0;oi<typeOpts.length;oi++){h+='<option'+(c.type===typeOpts[oi]?' selected':'')+'>'+typeOpts[oi]+'</option>';}
    h+='</select></td>';
    h+='<td><input class="s-inline" id="sc-width-'+ci+'" value="'+(c.width||100)+'" style="width:50px;"></td>';
    h+='<td><input class="s-inline" id="sc-opts-'+ci+'" value="'+esc(c.options||'')+'" placeholder="a,b,c" style="width:100px;" title="For select type"></td>';
    h+='<td style="text-align:center;"><input type="checkbox" id="sc-show-'+ci+'"'+(c.show!==false?' checked':'')+'></td>';
    h+='<td style="text-align:center;"><input type="checkbox" id="sc-sort-'+ci+'"'+(c.sortable?' checked':'')+'></td>';
    h+='<td>';if(ci>0)h+='<button class="s-btn" onclick="moveCol('+ci+',-1)">&#9650;</button>';if(ci<cols.length-1)h+='<button class="s-btn" onclick="moveCol('+ci+',1)">&#9660;</button>';
    h+=' <button class="s-btn" onclick="updateCol('+ci+')">Apply</button> <button class="s-btn danger" onclick="removeCol('+ci+')">Del</button></td></tr>';}
  h+='</tbody></table>';
  h+='<div style="margin-top:8px;"><input class="s-inline" id="sc-new-key" placeholder="key" style="width:80px;margin-right:4px;"><input class="s-inline" id="sc-new-label" placeholder="Label" style="width:100px;margin-right:4px;"><select class="s-inline" id="sc-new-type" style="width:90px;margin-right:4px;background:#0f1117;border:1px solid #363b52;"><option>text</option><option>textarea</option><option>url</option><option>file</option><option>tags</option><option>select</option><option>date</option></select><input class="s-inline" id="sc-new-width" placeholder="width" value="120" style="width:50px;margin-right:4px;"><button class="s-btn" onclick="addCol()">+ Add Column</button></div>';
  h+='</div></div>';
  // DATA
  // DATA + BACKUP
  var bakInfo=getBackupInfo();
  h+='<div class="s-section"><div class="s-section-hdr">DATA &amp; BACKUP</div><div class="s-section-body">';
  h+='<button class="s-btn" onclick="exportAllCSV()">CSV Export</button> ';
  h+='<button class="s-btn" onclick="openCsvModal()">CSV Import</button> ';
  h+='<button class="s-btn danger" onclick="resetConfig()">Reset Config</button>';
  h+='<div style="margin-top:12px;font-size:12px;color:#6b7190;">Entries: '+DB.entries.length+' | Types: '+types.length+' | Columns: '+cols.length+'</div>';
  h+='<div style="margin-top:14px;font-size:13px;font-weight:700;color:#c8a44e;margin-bottom:6px;">BACKUP (3 Generations)</div>';
  h+='<table class="s-table"><thead><tr><th>File</th><th>Status</th><th>Action</th></tr></thead><tbody>';
  h+='<tr><td style="color:#a0a6bc;">'+esc(DATA_FILE)+'.bak1</td><td>'+(bakInfo.bak1?'<span style="color:#4eca7a;">Exists</span>':'<span style="color:#6b7190;">None</span>')+'</td><td>'+(bakInfo.bak1?'<button class="s-btn" onclick="restoreBackup(1)">Restore</button>':'')+'</td></tr>';
  h+='<tr><td style="color:#a0a6bc;">'+esc(DATA_FILE)+'.bak2</td><td>'+(bakInfo.bak2?'<span style="color:#4eca7a;">Exists</span>':'<span style="color:#6b7190;">None</span>')+'</td><td>'+(bakInfo.bak2?'<button class="s-btn" onclick="restoreBackup(2)">Restore</button>':'')+'</td></tr>';
  h+='<tr><td style="color:#a0a6bc;">'+esc(DATA_FILE)+'.bak3</td><td>'+(bakInfo.bak3?'<span style="color:#4eca7a;">Exists</span>':'<span style="color:#6b7190;">None</span>')+'</td><td>'+(bakInfo.bak3?'<button class="s-btn" onclick="restoreBackup(3)">Restore</button>':'')+'</td></tr>';
  h+='</tbody></table>';
  h+='<div style="font-size:11px;color:#4a4e62;margin-top:6px;">Backups rotate automatically on every save. bak1=latest, bak3=oldest.</div>';
  h+='</div></div>';
  // DIAGNOSTICS
  h+='<div class="s-section"><div class="s-section-hdr">DIAGNOSTICS</div><div class="s-section-body">';
  h+='<button class="s-btn" onclick="runDiagnostics()">Run Diagnostics</button>';
  h+='<div id="diagResult" style="margin-top:12px;font-family:Consolas,monospace;font-size:12px;color:#a0a6bc;white-space:pre-wrap;"></div>';
  h+='</div></div>';
  document.getElementById('settings-screen').innerHTML=h;
}
function runDiagnostics(){
  var out=[];
  out.push('=== DIAGNOSTICS ===');
  out.push('');
  
  // 1. APP_DIR
  out.push('[1] APP_DIR = "'+APP_DIR+'"');
  out.push('    Length  = '+APP_DIR.length);
  
  // 2. Resolved path
  var dataPath=resolvePath(DATA_FILE);
  out.push('');
  out.push('[2] DATA_FILE = "'+DATA_FILE+'"');
  out.push('    Resolved = "'+dataPath+'"');
  
  // 3. Check data file exists
  var exists=fileExists(dataPath);
  out.push('');
  out.push('[3] File exists = '+exists);
  
  // 4. Try read data file
  var readResult=readFile(dataPath);
  out.push('');
  out.push('[4] Read data file:');
  out.push('    Length = '+(readResult?readResult.length:0));
  out.push('    First 100 chars = "'+(readResult?readResult.substring(0,100):'(empty)')+'"');
  
  // 5. Write test file
  var testPath=resolvePath('_diag_test.txt');
  out.push('');
  out.push('[5] Write test file: "'+testPath+'"');
  var writeResult=writeFile(testPath,'DIAG_TEST_'+new Date().getTime());
  out.push('    writeFile result = "'+writeResult+'"');
  
  // 6. Read test file back
  var readBack=readFile(testPath);
  out.push('');
  out.push('[6] Read test file back:');
  out.push('    Content = "'+(readBack||'(empty)')+'"');
  out.push('    Match   = '+(readBack&&readBack.indexOf('DIAG_TEST_')===0?'YES':'NO <<<< PROBLEM'));
  
  // 7. Check VBScript bridge
  out.push('');
  out.push('[7] VBScript bridge:');
  try{
    document.getElementById('_vbs_result').value='';
    window.execScript('document.getElementById("_vbs_result").value="VBS_OK"','VBScript');
    var vbsResult=document.getElementById('_vbs_result').value;
    out.push('    execScript = "'+vbsResult+'"');
  }catch(e){
    out.push('    execScript = ERROR: '+e.message);
  }
  
  // 8. Check hidden inputs
  out.push('');
  out.push('[8] Hidden inputs:');
  out.push('    _vbs_buffer   exists = '+(!!document.getElementById('_vbs_buffer')));
  out.push('    _vbs_result   exists = '+(!!document.getElementById('_vbs_result')));
  out.push('    _vbs_filepath exists = '+(!!document.getElementById('_vbs_filepath')));
  
  // 9. DB state
  out.push('');
  out.push('[9] DB state:');
  out.push('    DB.config = '+(DB.config?'exists (configVer='+DB.config.configVer+')':'NULL'));
  out.push('    DB.config.types  = '+(DB.config&&DB.config.types?DB.config.types.length+' types':'NULL'));
  out.push('    DB.config.columns = '+(DB.config&&DB.config.columns?DB.config.columns.length+' columns':'NULL'));
  out.push('    DB.entries = '+(DB.entries?DB.entries.length+' entries':'NULL'));
  
  // 10. Try save and verify
  out.push('');
  out.push('[10] Save + Verify test:');
  var json=JSON.stringify(DB,null,2);
  out.push('     JSON size = '+json.length+' chars');
  var saveResult=writeFile(dataPath,json);
  out.push('     writeFile result = "'+saveResult+'"');
  var verifyRead=readFile(dataPath);
  out.push('     Verify read size = '+(verifyRead?verifyRead.length:0)+' chars');
  out.push('     Match = '+(verifyRead&&verifyRead.length===json.length?'YES':'NO <<<< PROBLEM'));
  
  var el=document.getElementById('diagResult');
  if(el)el.innerText=out.join('\n');
}
function addType(){var id=document.getElementById('st-new-id').value.trim(),label=document.getElementById('st-new-label').value.trim(),color=document.getElementById('st-new-color').value.trim()||'#c8a44e';if(!id||!label){toast('ID and Label required','err');return;}for(var i=0;i<CFG().types.length;i++){if(CFG().types[i].id===id){toast('ID exists','err');return;}}CFG().types.push({id:id,label:label,color:color});saveData();renderSettings();renderSidebar();toast('Type added','ok');}
function updateType(idx){var t=CFG().types[idx];if(!t)return;var oldId=t.id;t.id=document.getElementById('st-id-'+idx).value.trim()||t.id;t.label=document.getElementById('st-label-'+idx).value.trim()||t.label;t.color=document.getElementById('st-color-'+idx).value.trim()||t.color;if(oldId!==t.id){for(var i=0;i<DB.entries.length;i++){if(DB.entries[i].category===oldId)DB.entries[i].category=t.id;}}saveData();renderSettings();renderSidebar();toast('Updated','ok');}
function removeType(idx){if(!confirm('Delete type "'+CFG().types[idx].label+'"?'))return;CFG().types.splice(idx,1);saveData();renderSettings();renderSidebar();toast('Removed','ok');}
function addCol(){var key=document.getElementById('sc-new-key').value.trim(),label=document.getElementById('sc-new-label').value.trim(),type=document.getElementById('sc-new-type').value,width=parseInt(document.getElementById('sc-new-width').value,10)||120;if(!key||!label){toast('Key and Label required','err');return;}for(var i=0;i<CFG().columns.length;i++){if(CFG().columns[i].key===key){toast('Key exists','err');return;}}CFG().columns.push({key:key,label:label,type:type,width:width,show:true,sortable:(type==='text'||type==='date')});saveData();renderSettings();renderTable();toast('Column added','ok');}
function updateCol(idx){var c=CFG().columns[idx];if(!c)return;var oldKey=c.key;c.key=document.getElementById('sc-key-'+idx).value.trim()||c.key;c.label=document.getElementById('sc-label-'+idx).value.trim()||c.label;c.type=document.getElementById('sc-type-'+idx).value;c.width=parseInt(document.getElementById('sc-width-'+idx).value,10)||c.width;c.options=document.getElementById('sc-opts-'+idx).value.trim()||'';c.show=document.getElementById('sc-show-'+idx).checked;c.sortable=document.getElementById('sc-sort-'+idx).checked;if(oldKey!==c.key){for(var i=0;i<DB.entries.length;i++){if(DB.entries[i][oldKey]!==undefined){DB.entries[i][c.key]=DB.entries[i][oldKey];delete DB.entries[i][oldKey];}}}saveData();renderSettings();renderTable();toast('Updated','ok');}
function removeCol(idx){if(!confirm('Delete column "'+CFG().columns[idx].label+'"?'))return;CFG().columns.splice(idx,1);saveData();renderSettings();renderTable();toast('Removed','ok');}
function moveCol(idx,dir){var cols=CFG().columns,j=idx+dir;if(j<0||j>=cols.length)return;var tmp=cols[idx];cols[idx]=cols[j];cols[j]=tmp;saveData();renderSettings();renderTable();}
function resetConfig(){if(!confirm('Reset all types and columns to default? Entries preserved.'))return;DB.config=getDefaultConfig();saveData();renderSettings();renderSidebar();renderTable();toast('Config reset','ok');}

// ====== KEYBOARD ======
document.onkeydown=function(e){e=e||window.event;var key=e.keyCode;if(e.ctrlKey&&key===83){if(e.preventDefault)e.preventDefault();e.returnValue=false;saveData();toast('Saved','ok');return false;}if(e.ctrlKey&&key===78){if(e.preventDefault)e.preventDefault();e.returnValue=false;openForm('new');return false;}if(key===27){closeForm();closeCsvModal();if(SETTINGS_OPEN)toggleSettings();}if(key===46&&!e.ctrlKey){var ae=document.activeElement;if(ae&&(ae.tagName==='INPUT'||ae.tagName==='TEXTAREA'||ae.tagName==='SELECT'))return;deleteSelected();}};

// ====== WINDOW DROP ======
document.ondragover=function(e){e=e||window.event;e.returnValue=false;if(e.preventDefault)e.preventDefault();};
document.ondrop=function(e){e=e||window.event;e.returnValue=false;if(e.preventDefault)e.preventDefault();var panel=document.getElementById('form-panel'),isOpen=panel.className.indexOf('open')>=0;try{var dt=e.dataTransfer,text='';try{text=dt.getData('URL')||'';}catch(ex){}if(!text){try{text=dt.getData('Text')||'';}catch(ex2){}}if(text&&(text.indexOf('http')===0||text.indexOf('ftp')===0)){if(!isOpen)openForm('new');var lnk=document.getElementById('f-link');if(lnk)lnk.value=text;var m=text.match(/^https?:\/\/([^\/]+)/);var src=document.getElementById('f-source');if(m&&src&&!src.value)src.value=m[1];toast('Link captured','ok');}else if(text&&text.match(/\.[a-zA-Z0-9]{1,5}$/)){if(!isOpen)openForm('new');var fp=text;if(fp.indexOf('file:///')===0)fp=fp.substring(8).replace(/\//g,'\\');fp=fp.replace(/%20/g,' ');var fn=fp,ls=Math.max(fp.lastIndexOf('\\'),fp.lastIndexOf('/'));if(ls>=0)fn=fp.substring(ls+1);var fpEl=document.getElementById('f-filepath');if(fpEl)fpEl.value=fp;var ttEl=document.getElementById('f-title');if(ttEl&&!ttEl.value)ttEl.value=fn;var info=document.getElementById('dropInfo');if(info)info.innerText='Path: '+fp;toast('File: '+fn,'ok');}}catch(ex3){}};

// ====== INIT ======
function initApp(){
  APP_DIR='';
  try{
    document.getElementById('_vbs_result').value='';
    window.execScript('document.getElementById("_vbs_result").value=getAppDir()','VBScript');
    APP_DIR=document.getElementById('_vbs_result').value;
  }catch(e){}
  if(!APP_DIR)APP_DIR='./';
  loadData();
  renderSidebar();
  renderTable();
  // Show data path in status bar for verification
  document.getElementById('st-saved').innerText='Data: '+resolvePath(DATA_FILE);
}
initApp();
</script>
</body>
</html>
