<html>
<head>
<meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
<meta http-equiv="X-UA-Compatible" content="IE=9">
<title>Librarian</title>
<HTA:APPLICATION
  ID="LibrarianApp"
  APPLICATIONNAME="Librarian"
  BORDER="thick"
  BORDERSTYLE="normal"
  CAPTION="yes"
  MAXIMIZEBUTTON="yes"
  MINIMIZEBUTTON="yes"
  SHOWINTASKBAR="yes"
  SINGLEINSTANCE="yes"
  SYSMENU="yes"
  WINDOWSTATE="maximize"
  SCROLL="no"
  SELECTION="yes"
/>
<style>
*{margin:0;padding:0;box-sizing:border-box;}
html,body{width:100%;height:100%;overflow:hidden;font-family:"Meiryo UI","Meiryo","Segoe UI",sans-serif;font-size:14px;color:#e0e4ef;background:#0f1117;}
input,select,textarea,button{font-family:inherit;font-size:14px;color:#e0e4ef;}
button{cursor:pointer;}

/* === HEADER === */
#header{height:48px;line-height:48px;background:#161822;border-bottom:1px solid #2a2d3e;padding:0 20px;overflow:hidden;}
.app-title{font-size:20px;font-weight:800;color:#c8a44e;letter-spacing:4px;float:left;}
.app-subtitle{font-size:12px;color:#6b7190;margin-left:14px;float:left;letter-spacing:1px;line-height:48px;}
.hdr-right{float:right;line-height:48px;}
.hdr-btn{display:inline-block;padding:6px 14px;background:transparent;border:1px solid #363b52;color:#8892a6;cursor:pointer;font-size:13px;margin-left:6px;vertical-align:middle;}
.hdr-btn:hover{border-color:#c8a44e;color:#c8a44e;background:rgba(200,164,78,0.06);}

/* === BODY LAYOUT === */
#app-body{position:absolute;top:48px;left:0;right:0;bottom:32px;overflow:hidden;}
#sidebar{position:absolute;left:0;top:0;bottom:0;width:180px;background:#13151e;border-right:1px solid #2a2d3e;overflow-y:auto;}
#content{position:absolute;left:180px;top:0;right:0;bottom:0;overflow:hidden;}

/* === SIDEBAR NAV === */
.nav-section{font-size:11px;font-weight:700;color:#6b7190;letter-spacing:2px;text-transform:uppercase;padding:16px 16px 6px;}
.nav-btn{display:block;width:100%;padding:10px 16px;background:transparent;border:none;border-left:3px solid transparent;color:#8892a6;font-size:14px;text-align:left;cursor:pointer;font-family:inherit;}
.nav-btn:hover{background:#1a1d2a;color:#c0c6d6;}
.nav-btn.active{background:rgba(200,164,78,0.08);color:#c8a44e;border-left-color:#c8a44e;font-weight:700;}
.nav-count{float:right;font-size:11px;background:#262a3a;color:#8892a6;padding:2px 8px;display:inline-block;vertical-align:middle;line-height:16px;}
.nav-sep{height:1px;background:#2a2d3e;margin:8px 12px;}

/* === TOOLBAR === */
#toolbar{position:absolute;top:0;left:0;right:0;height:44px;background:#161822;border-bottom:1px solid #2a2d3e;padding:7px 16px;overflow:hidden;}
.tool-btn{display:inline-block;padding:6px 14px;background:transparent;border:1px solid #363b52;color:#8892a6;cursor:pointer;font-size:13px;margin-right:4px;vertical-align:middle;font-family:inherit;}
.tool-btn:hover{border-color:#c8a44e;color:#c8a44e;background:rgba(200,164,78,0.06);}
.tool-btn.primary{background:rgba(200,164,78,0.12);border-color:#c8a44e;color:#c8a44e;}
.tool-sep{display:inline-block;width:1px;height:22px;background:#2a2d3e;margin:0 8px;vertical-align:middle;}
.search-box{display:inline-block;vertical-align:middle;}
.search-box input{background:#0f1117;border:1px solid #363b52;padding:5px 12px;width:240px;color:#e0e4ef;outline:none;}
.search-box input:focus{border-color:#c8a44e;}

/* === MAIN AREA === */
#main-area{position:absolute;top:44px;left:0;right:0;bottom:0;overflow:hidden;}

/* === TABLE === */
#table-wrap{position:absolute;top:0;left:0;right:0;bottom:0;overflow:auto;padding:0;}
.data-table{width:100%;border-collapse:collapse;table-layout:fixed;}
.data-table th{background:#1a1d28;color:#c8a44e;font-size:12px;font-weight:700;letter-spacing:1px;text-transform:uppercase;padding:10px 12px;border:1px solid #2a2d3e;text-align:left;cursor:pointer;white-space:nowrap;position:relative;}
.data-table th:hover{background:#22263a;}
.data-table th .sort-arrow{float:right;color:#4a4e62;font-size:10px;}
.data-table td{padding:9px 12px;border:1px solid #232636;font-size:14px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;cursor:default;background:#13151e;}
.data-table tr:hover td{background:#1a1d2a;}
.data-table tr.selected td{background:rgba(200,164,78,0.10);border-left-color:#c8a44e;}
.data-table .tag{display:inline-block;font-size:11px;font-weight:600;padding:2px 8px;margin:0 3px 2px 0;background:rgba(200,164,78,0.10);border:1px solid rgba(200,164,78,0.25);color:#c8a44e;}
.data-table .link-cell{color:#5b9cf5;text-decoration:underline;cursor:pointer;}
.data-table .link-cell:hover{color:#8bc0ff;}
.data-table .cat-news{display:inline-block;font-size:10px;font-weight:700;padding:2px 7px;background:rgba(91,156,245,0.12);border:1px solid rgba(91,156,245,0.25);color:#5b9cf5;letter-spacing:1px;}
.data-table .cat-guide{display:inline-block;font-size:10px;font-weight:700;padding:2px 7px;background:rgba(78,202,122,0.12);border:1px solid rgba(78,202,122,0.25);color:#4eca7a;letter-spacing:1px;}

/* === FORM PANEL === */
#form-panel{display:none;position:absolute;top:0;right:0;width:420px;bottom:0;background:#161822;border-left:1px solid #2a2d3e;overflow-y:auto;z-index:50;}
#form-panel.open{display:block;}
.form-hdr{padding:14px 20px;border-bottom:1px solid #2a2d3e;overflow:hidden;}
.form-title{float:left;font-size:14px;font-weight:700;color:#c8a44e;letter-spacing:2px;text-transform:uppercase;line-height:28px;}
.form-close{float:right;background:none;border:none;color:#6b7190;cursor:pointer;font-size:20px;padding:0 4px;}
.form-close:hover{color:#e0e4ef;}
.form-body{padding:20px;}
.fg{margin-bottom:14px;}
.fg label{display:block;font-size:12px;font-weight:600;color:#6b7190;letter-spacing:1px;text-transform:uppercase;margin-bottom:5px;}
.fg input[type="text"],.fg textarea,.fg select{width:100%;background:#0f1117;border:1px solid #363b52;padding:9px 12px;color:#e0e4ef;outline:none;}
.fg input:focus,.fg textarea:focus,.fg select:focus{border-color:#c8a44e;}
.fg textarea{height:80px;resize:vertical;line-height:1.6;}
.fg select option{background:#161822;}
.form-actions{padding:16px 20px;border-top:1px solid #2a2d3e;text-align:right;}
.btn{display:inline-block;padding:9px 20px;border:1px solid;cursor:pointer;font-size:13px;font-weight:700;font-family:inherit;}
.btn-save{background:#c8a44e;border-color:#c8a44e;color:#0f1117;}
.btn-save:hover{background:#dbb960;}
.btn-cancel{background:transparent;border-color:#363b52;color:#8892a6;margin-right:8px;}
.btn-cancel:hover{border-color:#c8a44e;color:#c8a44e;}
.btn-danger{background:transparent;border-color:rgba(240,96,96,0.3);color:#f06060;}
.btn-danger:hover{background:rgba(240,96,96,0.08);}

/* === DROP ZONE === */
.drop-zone{border:2px dashed #363b52;padding:20px;text-align:center;cursor:pointer;background:#0f1117;margin-bottom:14px;color:#6b7190;font-size:13px;}
.drop-zone.over{border-color:#c8a44e;background:rgba(200,164,78,0.06);color:#c8a44e;}
.drop-info{font-size:12px;color:#4a4e62;margin-top:6px;}

/* === STATUS BAR === */
#statusbar{position:absolute;bottom:0;left:0;right:0;height:32px;line-height:32px;background:#161822;border-top:1px solid #2a2d3e;padding:0 16px;font-size:12px;color:#6b7190;overflow:hidden;}
#statusbar span{margin-right:18px;}

/* === TOAST === */
.toast-area{position:fixed;bottom:44px;right:24px;z-index:9000;}
.toast-msg{padding:12px 22px;margin-top:8px;font-size:14px;font-weight:600;background:#1a1d28;border:1px solid rgba(200,164,78,0.3);color:#c8a44e;}
.toast-msg.ok{border-color:rgba(78,202,122,0.3);color:#4eca7a;}
.toast-msg.err{border-color:rgba(240,96,96,0.3);color:#f06060;}

/* === MODAL === */
.modal-bg{display:none;position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.65);z-index:500;}
.modal-bg.open{display:block;}
.modal-box{background:#1a1d28;border:1px solid #363b52;width:600px;max-width:95%;margin:60px auto;position:relative;}
.modal-hdr{padding:14px 20px;border-bottom:1px solid #2a2d3e;overflow:hidden;}
.modal-hdr .form-title{float:left;}
.modal-hdr .form-close{float:right;}
.modal-body{padding:20px;max-height:400px;overflow-y:auto;}
.modal-foot{padding:14px 20px;border-top:1px solid #2a2d3e;text-align:right;}

/* === EMPTY STATE === */
.empty-state{text-align:center;padding:60px 20px;color:#4a4e62;}
.empty-icon{font-size:48px;margin-bottom:12px;opacity:0.3;}
.empty-text{font-size:14px;letter-spacing:1px;}
</style>

<!-- ===== VBSCRIPT ===== -->
<script language="VBScript">
Dim gFSO
Set gFSO = CreateObject("Scripting.FileSystemObject")

Function getAppDir()
  Dim p
  p = Replace(document.location.pathname, "/", "\")
  If Left(p,1) = "\" Then p = Mid(p, 2)
  p = Replace(p, "%20", " ")
  getAppDir = gFSO.GetParentFolderName(p)
  If Right(getAppDir, 1) <> "\" Then getAppDir = getAppDir & "\"
End Function

Sub readUTF8(filePath)
  Dim s, result
  On Error Resume Next
  Set s = CreateObject("ADODB.Stream")
  s.Type = 2 : s.Charset = "UTF-8" : s.Open
  s.LoadFromFile filePath
  result = s.ReadText : s.Close : Set s = Nothing
  If Err.Number <> 0 Then result = "" : Err.Clear
  On Error GoTo 0
  If Len(result) > 0 Then
    If AscW(Left(result, 1)) = 65279 Then result = Mid(result, 2)
  End If
  document.getElementById("_vbs_r").value = result
End Sub

Sub writeUTF8(filePath, content)
  Dim s
  On Error Resume Next
  Set s = CreateObject("ADODB.Stream")
  s.Type = 2 : s.Charset = "UTF-8" : s.Open
  s.WriteText content
  s.SaveToFile filePath, 2
  s.Close : Set s = Nothing
  If Err.Number <> 0 Then
    document.getElementById("_vbs_r").value = "ERROR:" & Err.Description : Err.Clear
  Else
    document.getElementById("_vbs_r").value = "OK"
  End If
  On Error GoTo 0
End Sub

Sub vbsEnsureDir(dirPath)
  If Not gFSO.FolderExists(dirPath) Then gFSO.CreateFolder dirPath
End Sub

Function vbsFileExists(fp)
  vbsFileExists = gFSO.FileExists(fp)
End Function
</script>
</head>
<body>
<input type="hidden" id="_vbs_r" />

<!-- HEADER -->
<div id="header">
  <span class="app-title">LIBRARIAN</span>
  <span class="app-subtitle">Reference &amp; Link Manager</span>
  <span class="hdr-right">
    <span id="hdr-total" style="font-size:12px;color:#6b7190;margin-right:12px;">0 items</span>
    <button class="hdr-btn" onclick="exportAllCSV()">CSV Export</button>
  </span>
</div>

<!-- BODY -->
<div id="app-body">
  <!-- SIDEBAR -->
  <div id="sidebar">
    <div class="nav-section">CATEGORY</div>
    <button class="nav-btn active" id="nav-all" onclick="setView('all')">
      All Items <span class="nav-count" id="cnt-all">0</span>
    </button>
    <button class="nav-btn" id="nav-news" onclick="setView('news')">
      News <span class="nav-count" id="cnt-news">0</span>
    </button>
    <button class="nav-btn" id="nav-guide" onclick="setView('guide')">
      Guidelines <span class="nav-count" id="cnt-guide">0</span>
    </button>
    <div class="nav-sep"></div>
    <div class="nav-section">TAGS</div>
    <div id="tag-nav" style="padding:4px 12px;"></div>
    <div class="nav-sep"></div>
    <div class="nav-section">ACTIONS</div>
    <button class="nav-btn" onclick="openForm('new')">+ New Entry</button>
    <button class="nav-btn" onclick="openCsvModal()">CSV Import (News)</button>
  </div>

  <!-- CONTENT -->
  <div id="content">
    <!-- TOOLBAR -->
    <div id="toolbar">
      <button class="tool-btn primary" onclick="openForm('new')">+ New</button>
      <span class="tool-sep"></span>
      <button class="tool-btn" onclick="deleteSelected()">Delete</button>
      <span class="tool-sep"></span>
      <span class="search-box">
        <input type="text" id="searchInput" placeholder="Search title, tags, source..." onkeyup="onSearch(this.value)">
      </span>
      <span class="tool-sep"></span>
      <span style="font-size:12px;color:#6b7190;vertical-align:middle;">Sort:</span>
      <select id="sortSelect" onchange="onSortChange()" style="background:#0f1117;border:1px solid #363b52;padding:4px 8px;font-size:12px;color:#8892a6;vertical-align:middle;">
        <option value="date_desc">Date (Newest)</option>
        <option value="date_asc">Date (Oldest)</option>
        <option value="title_asc">Title (A-Z)</option>
        <option value="source_asc">Source (A-Z)</option>
      </select>
    </div>

    <!-- MAIN TABLE -->
    <div id="main-area">
      <div id="table-wrap">
        <table class="data-table" id="dataTable">
          <thead>
            <tr>
              <th style="width:28px;"><input type="checkbox" id="chkAll" onclick="toggleAll(this)"></th>
              <th style="width:60px;" onclick="doSort('category')">Type</th>
              <th style="width:260px;" onclick="doSort('title')">Title / Summary</th>
              <th style="width:200px;" onclick="doSort('link')">Link</th>
              <th style="width:120px;" onclick="doSort('source')">Source</th>
              <th style="width:120px;">Filename</th>
              <th style="width:180px;">Tags</th>
              <th style="width:100px;" onclick="doSort('created')">Date</th>
            </tr>
          </thead>
          <tbody id="tableBody"></tbody>
        </table>
        <div id="emptyState" class="empty-state" style="display:none;">
          <div class="empty-icon">&#128218;</div>
          <div class="empty-text">No items found</div>
        </div>
      </div>

      <!-- FORM PANEL (slide-in) -->
      <div id="form-panel">
        <div class="form-hdr">
          <span class="form-title" id="formTitle">NEW ENTRY</span>
          <button class="form-close" onclick="closeForm()">&#10005;</button>
        </div>
        <div class="form-body">
          <div class="fg">
            <label>Category</label>
            <select id="f-cat">
              <option value="news">News</option>
              <option value="guide">Guideline</option>
            </select>
          </div>
          <div class="fg">
            <label>Link / URL</label>
            <input type="text" id="f-link" placeholder="https://...">
          </div>
          <div class="fg">
            <label>Title</label>
            <input type="text" id="f-title" placeholder="Enter title or summary headline">
          </div>
          <div class="fg">
            <label>Source</label>
            <input type="text" id="f-source" placeholder="e.g. Nikkei, Internal, Gov...">
          </div>
          <div class="fg">
            <label>Filename</label>
            <input type="text" id="f-file" placeholder="attached file name">
          </div>
          <div class="fg">
            <label>Tags (comma separated)</label>
            <input type="text" id="f-tags" placeholder="e.g. AI, regulation, finance">
          </div>
          <div class="fg">
            <label>Summary / Notes</label>
            <textarea id="f-summary" placeholder="Brief description..."></textarea>
          </div>
          <div class="drop-zone" id="dropZone" onclick="browseFile()" ondragover="dzOver(event)" ondragleave="dzLeave()" ondrop="dzDrop(event)">
            Drop file here or click to browse
            <div class="drop-info" id="dropInfo"></div>
          </div>
        </div>
        <div class="form-actions">
          <input type="hidden" id="f-editId" value="">
          <button class="btn btn-cancel" onclick="closeForm()">Cancel</button>
          <button class="btn btn-save" onclick="saveEntry()">Save</button>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- STATUS BAR -->
<div id="statusbar">
  <span id="st-view">View: All</span>
  <span id="st-count">0 items</span>
  <span id="st-saved" style="float:right;">-</span>
</div>

<!-- TOAST -->
<div class="toast-area" id="toastArea"></div>

<!-- CSV IMPORT MODAL -->
<div class="modal-bg" id="csvModal">
  <div class="modal-box">
    <div class="modal-hdr">
      <span class="form-title">CSV IMPORT (NEWS)</span>
      <button class="form-close" onclick="closeCsvModal()">&#10005;</button>
    </div>
    <div class="modal-body">
      <p style="font-size:13px;color:#8892a6;margin-bottom:14px;">
        CSV format: <code style="color:#c8a44e;">title,link,source,tags,summary</code><br>
        1 row = 1 item. First row treated as header if it contains "title" or "link".
      </p>
      <div class="fg">
        <label>Paste CSV or drop .csv file</label>
        <textarea id="csvText" style="height:180px;font-family:Consolas,monospace;font-size:12px;line-height:1.5;" placeholder="title,link,source,tags,summary&#10;AI regulation update,https://...,Nikkei,AI;regulation,Summary text"></textarea>
      </div>
      <div class="drop-zone" id="csvDropZone" ondragover="csvDzOver(event)" ondragleave="csvDzLeave()" ondrop="csvDzDrop(event)">
        Drop .csv file here
      </div>
      <div style="margin-top:8px;">
        <button class="btn btn-cancel" onclick="csvBrowseFile()" style="margin-right:0;">Browse .csv file...</button>
      </div>
    </div>
    <div class="modal-foot">
      <button class="btn btn-cancel" onclick="closeCsvModal()">Cancel</button>
      <button class="btn btn-save" onclick="importCsv()">Import</button>
    </div>
  </div>
</div>

<!-- ===== JAVASCRIPT ===== -->
<script language="JavaScript">
// ===================== POLYFILLS =====================
if(!Array.prototype.indexOf){Array.prototype.indexOf=function(v,s){for(var i=s||0;i<this.length;i++){if(this[i]===v)return i;}return-1;};}
if(!Array.prototype.forEach){Array.prototype.forEach=function(fn,c){for(var i=0;i<this.length;i++)fn.call(c,this[i],i,this);};}
if(!Array.prototype.filter){Array.prototype.filter=function(fn,c){var r=[];for(var i=0;i<this.length;i++){if(fn.call(c,this[i],i,this))r.push(this[i]);}return r;};}
if(!Array.prototype.map){Array.prototype.map=function(fn,c){var r=[];for(var i=0;i<this.length;i++)r.push(fn.call(c,this[i],i,this));return r;};}
if(!Array.isArray){Array.isArray=function(a){return Object.prototype.toString.call(a)==='[object Array]';};}
if(!String.prototype.trim){String.prototype.trim=function(){return this.replace(/^\s+|\s+$/g,'');};}

// ===================== GLOBALS =====================
var APP_DIR = '';
var DATA_FILE = 'librarian_data.json';
var ENTRIES = [];      // main data array
var VIEW = 'all';      // 'all' | 'news' | 'guide'
var SEARCH_Q = '';
var SORT_KEY = 'date_desc';
var SELECTED = {};     // id -> true
var TAG_FILTER = '';   // '' = no filter

// ===================== FILE I/O =====================
function readFile(path) {
  document.getElementById('_vbs_r').value = '';
  try {
    window.execScript('readUTF8 "' + path.replace(/"/g,'""') + '"', 'VBScript');
  } catch(e) { return ''; }
  return document.getElementById('_vbs_r').value;
}
function writeFile(path, content) {
  try {
    window.execScript('writeUTF8 "' + path.replace(/"/g,'""') + '", document.getElementById("_vbs_r").value', 'VBScript');
  } catch(e) {}
  // alternative direct approach
  document.getElementById('_vbs_r').value = content;
  try {
    var script = 'writeUTF8 "' + path.replace(/"/g,'""') + '", document.getElementById("_vbs_r").value';
    window.execScript(script, 'VBScript');
  } catch(e2) {}
  return document.getElementById('_vbs_r').value;
}
function ensureDir(d) {
  try { window.execScript('vbsEnsureDir "' + d.replace(/"/g,'""') + '"', 'VBScript'); } catch(e) {}
}
function resolvePath(rel) {
  if (!rel) return '';
  if (rel.indexOf(':') > 0) return rel;
  var r = rel.replace(/\//g, '\\');
  if (r.indexOf('.\\') === 0) r = r.substring(2);
  return APP_DIR + r;
}

// ===================== DATA PERSISTENCE =====================
function loadData() {
  var path = resolvePath(DATA_FILE);
  var text = readFile(path);
  if (text && text.trim()) {
    try { ENTRIES = JSON.parse(text); } catch(e) { ENTRIES = []; }
  }
  if (!ENTRIES || !Array.isArray(ENTRIES)) ENTRIES = [];
}
function saveData() {
  var path = resolvePath(DATA_FILE);
  var json = JSON.stringify(ENTRIES, null, 2);
  // Use hidden input as buffer — safe for any content (BUG-03 fix)
  document.getElementById('_vbs_r').value = json;
  try {
    window.execScript('Call writeUTF8("' + path.replace(/"/g,'""') + '", document.getElementById("_vbs_r").value)', 'VBScript');
  } catch(e) {}
  document.getElementById('st-saved').innerText = 'Saved: ' + timeStr();
}

// ===================== UTILITIES =====================
function uid() { return 'L' + (new Date().getTime()) + '_' + Math.floor(Math.random() * 10000); }
function esc(s) { return String(s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
function pad(n) { return n < 10 ? '0' + n : '' + n; }
function dateStr() { var d = new Date(); return d.getFullYear() + '-' + pad(d.getMonth()+1) + '-' + pad(d.getDate()); }
function timeStr() { var d = new Date(); return pad(d.getHours()) + ':' + pad(d.getMinutes()) + ':' + pad(d.getSeconds()); }
function fmtDate(s) {
  if (!s) return '';
  var m = String(s).match(/^(\d{4})-(\d{1,2})-(\d{1,2})/);
  if (!m) return s;
  return parseInt(m[2],10) + '/' + parseInt(m[3],10);
}

// ===================== TOAST =====================
function toast(msg, type) {
  var c = document.getElementById('toastArea');
  var d = document.createElement('div');
  d.className = 'toast-msg' + (type ? ' ' + type : '');
  d.innerText = msg;
  d.onclick = function() { try { c.removeChild(d); } catch(e){} };
  c.appendChild(d);
  setTimeout(function() { try { c.removeChild(d); } catch(e){} }, 3000);
}

// ===================== CSV PARSER =====================
function parseCSV(text) {
  if (!text || !text.trim()) return [];
  var lines = text.replace(/\r\n/g, '\n').replace(/\r/g, '\n');
  var result = [];
  var row = [];
  var field = '';
  var inQ = false;
  for (var i = 0; i < lines.length; i++) {
    var c = lines.charAt(i);
    if (inQ) {
      if (c === '"') {
        if (i+1 < lines.length && lines.charAt(i+1) === '"') { field += '"'; i++; }
        else { inQ = false; }
      } else { field += c; }
    } else {
      if (c === '"') { inQ = true; }
      else if (c === ',') { row.push(field); field = ''; }
      else if (c === '\n') { row.push(field); field = ''; result.push(row); row = []; }
      else { field += c; }
    }
  }
  if (field || row.length > 0) { row.push(field); result.push(row); }
  return result;
}
function csvQ(s) {
  s = String(s == null ? '' : s);
  if (s.indexOf(',') >= 0 || s.indexOf('"') >= 0 || s.indexOf('\n') >= 0) {
    return '"' + s.replace(/"/g, '""') + '"';
  }
  return s;
}

// ===================== VIEW / FILTER =====================
function setView(v) {
  VIEW = v;
  TAG_FILTER = '';
  // update nav buttons
  var btns = ['all','news','guide'];
  for (var i = 0; i < btns.length; i++) {
    var el = document.getElementById('nav-' + btns[i]);
    if (el) el.className = 'nav-btn' + (btns[i] === v ? ' active' : '');
  }
  // clear tag nav active
  var tagBtns = document.getElementById('tag-nav').getElementsByTagName('button');
  for (var j = 0; j < tagBtns.length; j++) {
    tagBtns[j].style.borderColor = 'rgba(200,164,78,0.25)';
    tagBtns[j].style.background = 'rgba(200,164,78,0.10)';
  }
  document.getElementById('st-view').innerText = 'View: ' + (v === 'all' ? 'All' : v === 'news' ? 'News' : 'Guidelines');
  renderTable();
}

function setTagFilter(tag) {
  if (TAG_FILTER === tag) {
    TAG_FILTER = '';
  } else {
    TAG_FILTER = tag;
  }
  renderTable();
  renderTagNav();
}

function getFilteredData() {
  var data = ENTRIES.slice(0);
  // category filter
  if (VIEW === 'news') data = data.filter(function(e) { return e.category === 'news'; });
  else if (VIEW === 'guide') data = data.filter(function(e) { return e.category === 'guide'; });
  // tag filter
  if (TAG_FILTER) {
    data = data.filter(function(e) {
      var tags = (e.tags || '').toLowerCase().split(/[,;，；]/).map(function(t) { return t.trim(); });
      return tags.indexOf(TAG_FILTER.toLowerCase()) >= 0;
    });
  }
  // search
  if (SEARCH_Q) {
    var q = SEARCH_Q.toLowerCase();
    data = data.filter(function(e) {
      return (e.title || '').toLowerCase().indexOf(q) >= 0 ||
             (e.tags || '').toLowerCase().indexOf(q) >= 0 ||
             (e.source || '').toLowerCase().indexOf(q) >= 0 ||
             (e.link || '').toLowerCase().indexOf(q) >= 0 ||
             (e.summary || '').toLowerCase().indexOf(q) >= 0 ||
             (e.filename || '').toLowerCase().indexOf(q) >= 0;
    });
  }
  // sort
  var sk = SORT_KEY || 'date_desc';
  data.sort(function(a, b) {
    if (sk === 'date_desc') return (b.created || '') > (a.created || '') ? 1 : -1;
    if (sk === 'date_asc') return (a.created || '') > (b.created || '') ? 1 : -1;
    if (sk === 'title_asc') return (a.title || '').toLowerCase() > (b.title || '').toLowerCase() ? 1 : -1;
    if (sk === 'source_asc') return (a.source || '').toLowerCase() > (b.source || '').toLowerCase() ? 1 : -1;
    return 0;
  });
  return data;
}

// ===================== RENDER =====================
function buildTableHead() {
  return '<thead><tr>' +
    '<th style="width:28px;"><input type="checkbox" id="chkAll" onclick="toggleAll(this)"></th>' +
    '<th style="width:60px;" onclick="doSort(\'category\')">Type</th>' +
    '<th style="width:260px;" onclick="doSort(\'title\')">Title / Summary</th>' +
    '<th style="width:200px;" onclick="doSort(\'link\')">Link</th>' +
    '<th style="width:120px;" onclick="doSort(\'source\')">Source</th>' +
    '<th style="width:120px;">Filename</th>' +
    '<th style="width:180px;">Tags</th>' +
    '<th style="width:100px;" onclick="doSort(\'created\')">Date</th>' +
    '</tr></thead>';
}

function renderTable() {
  var data = getFilteredData();
  var wrap = document.getElementById('table-wrap');

  if (data.length === 0) {
    // IE9: tbody.innerHTML is read-only — rebuild entire table via parent div
    wrap.innerHTML = '<table class="data-table" id="dataTable">' + buildTableHead() + '<tbody></tbody></table>' +
      '<div id="emptyState" class="empty-state"><div class="empty-icon">&#128218;</div><div class="empty-text">No items found</div></div>';
    updateCounts();
    return;
  }

  var rows = '';
  for (var i = 0; i < data.length; i++) {
    var e = data[i];
    var sel = SELECTED[e.id] ? ' selected' : '';
    var catClass = e.category === 'news' ? 'cat-news' : 'cat-guide';
    var catLabel = e.category === 'news' ? 'NEWS' : 'GUIDE';

    // tags html
    var tagsHtml = '';
    if (e.tags) {
      var tagArr = e.tags.split(/[,;，；]/);
      for (var ti = 0; ti < tagArr.length; ti++) {
        var t = tagArr[ti].trim();
        if (t) tagsHtml += '<span class="tag">' + esc(t) + '</span>';
      }
    }

    // link display
    var linkHtml = '';
    if (e.link) {
      var displayLink = e.link.length > 35 ? e.link.substring(0, 35) + '...' : e.link;
      linkHtml = '<span class="link-cell" onclick="openLink(\'' + esc(e.link).replace(/'/g, "\\'") + '\')" title="' + esc(e.link) + '">' + esc(displayLink) + '</span>';
    }

    // summary tooltip
    var titleHtml = esc(e.title || '(No title)');
    if (e.summary) {
      titleHtml = '<span title="' + esc(e.summary) + '">' + titleHtml + '</span>';
    }

    rows += '<tr class="' + sel + '" onclick="selectRow(\'' + e.id + '\', event)" ondblclick="openForm(\'edit\',\'' + e.id + '\')">';
    rows += '<td style="text-align:center;"><input type="checkbox" ' + (SELECTED[e.id] ? 'checked' : '') + ' onclick="toggleCheck(\'' + e.id + '\', this, event)"></td>';
    rows += '<td><span class="' + catClass + '">' + catLabel + '</span></td>';
    rows += '<td style="white-space:normal;overflow:visible;">' + titleHtml + '</td>';
    rows += '<td>' + linkHtml + '</td>';
    rows += '<td>' + esc(e.source || '') + '</td>';
    rows += '<td title="' + esc(e.filename || '') + '">' + esc(e.filename || '') + '</td>';
    rows += '<td style="white-space:normal;overflow:visible;">' + tagsHtml + '</td>';
    rows += '<td>' + fmtDate(e.created) + '</td>';
    rows += '</tr>';
  }

  // IE9: tbody.innerHTML is READ-ONLY — must rebuild entire table via parent div innerHTML
  wrap.innerHTML = '<table class="data-table" id="dataTable">' + buildTableHead() + '<tbody>' + rows + '</tbody></table>';
  updateCounts();
}

function updateCounts() {
  var all = ENTRIES.length;
  var news = 0, guide = 0;
  for (var i = 0; i < ENTRIES.length; i++) {
    if (ENTRIES[i].category === 'news') news++;
    else guide++;
  }
  document.getElementById('cnt-all').innerText = all;
  document.getElementById('cnt-news').innerText = news;
  document.getElementById('cnt-guide').innerText = guide;
  document.getElementById('hdr-total').innerText = all + ' items';

  var filtered = getFilteredData();
  document.getElementById('st-count').innerText = filtered.length + ' items' + (filtered.length !== all ? ' (filtered from ' + all + ')' : '');
}

function renderTagNav() {
  var tagMap = {};
  for (var i = 0; i < ENTRIES.length; i++) {
    if (ENTRIES[i].tags) {
      var arr = ENTRIES[i].tags.split(/[,;，；]/);
      for (var j = 0; j < arr.length; j++) {
        var t = arr[j].trim();
        if (t) {
          var key = t.toLowerCase();
          if (!tagMap[key]) tagMap[key] = { label: t, count: 0 };
          tagMap[key].count++;
        }
      }
    }
  }
  var tags = [];
  for (var k in tagMap) {
    if (tagMap.hasOwnProperty(k)) tags.push(tagMap[k]);
  }
  tags.sort(function(a, b) { return b.count - a.count; });

  var h = '';
  var max = Math.min(tags.length, 20);
  for (var ti = 0; ti < max; ti++) {
    var tg = tags[ti];
    var isActive = TAG_FILTER && TAG_FILTER.toLowerCase() === tg.label.toLowerCase();
    var style = isActive ? 'border-color:#c8a44e;background:rgba(200,164,78,0.20);color:#c8a44e;' : '';
    h += '<button onclick="setTagFilter(\'' + esc(tg.label).replace(/'/g, "\\'") + '\')" style="display:inline-block;font-size:11px;padding:3px 8px;margin:2px 3px 2px 0;background:rgba(200,164,78,0.10);border:1px solid rgba(200,164,78,0.25);color:#c8a44e;cursor:pointer;' + style + '">' + esc(tg.label) + '<span style="color:#6b7190;margin-left:4px;font-size:10px;">' + tg.count + '</span></button>';
  }
  if (tags.length === 0) h = '<div style="font-size:12px;color:#4a4e62;padding:4px;">No tags yet</div>';
  document.getElementById('tag-nav').innerHTML = h;
}

// ===================== SELECTION =====================
function selectRow(id, e) {
  if (e && (e.target || e.srcElement).tagName === 'INPUT') return;
  if (e && (e.target || e.srcElement).className && (e.target || e.srcElement).className.indexOf('link-cell') >= 0) return;
  SELECTED = {};
  SELECTED[id] = true;
  renderTable();
}
function toggleCheck(id, cb, e) {
  if (e && e.stopPropagation) e.stopPropagation();
  if (e) e.cancelBubble = true;
  SELECTED[id] = cb.checked;
  if (!cb.checked) delete SELECTED[id];
}
function toggleAll(cb) {
  var data = getFilteredData();
  SELECTED = {};
  if (cb.checked) {
    for (var i = 0; i < data.length; i++) SELECTED[data[i].id] = true;
  }
  renderTable();
}

// ===================== FORM =====================
function openForm(mode, editId) {
  var panel = document.getElementById('form-panel');
  panel.className = 'open';
  // Adjust table-wrap width
  document.getElementById('table-wrap').style.right = '420px';

  if (mode === 'edit' && editId) {
    document.getElementById('formTitle').innerText = 'EDIT ENTRY';
    document.getElementById('f-editId').value = editId;
    var entry = findEntry(editId);
    if (entry) {
      document.getElementById('f-cat').value = entry.category || 'news';
      document.getElementById('f-link').value = entry.link || '';
      document.getElementById('f-title').value = entry.title || '';
      document.getElementById('f-source').value = entry.source || '';
      document.getElementById('f-file').value = entry.filename || '';
      document.getElementById('f-tags').value = entry.tags || '';
      document.getElementById('f-summary').value = entry.summary || '';
    }
  } else {
    document.getElementById('formTitle').innerText = 'NEW ENTRY';
    document.getElementById('f-editId').value = '';
    document.getElementById('f-cat').value = VIEW === 'guide' ? 'guide' : 'news';
    document.getElementById('f-link').value = '';
    document.getElementById('f-title').value = '';
    document.getElementById('f-source').value = '';
    document.getElementById('f-file').value = '';
    document.getElementById('f-tags').value = '';
    document.getElementById('f-summary').value = '';
    document.getElementById('dropInfo').innerText = '';
  }
}
function closeForm() {
  document.getElementById('form-panel').className = '';
  document.getElementById('table-wrap').style.right = '0';
}
function saveEntry() {
  var editId = document.getElementById('f-editId').value;
  var title = document.getElementById('f-title').value.trim();
  var link = document.getElementById('f-link').value.trim();
  if (!title && !link) { toast('Title or Link is required', 'err'); return; }

  if (editId) {
    // Update
    for (var i = 0; i < ENTRIES.length; i++) {
      if (ENTRIES[i].id === editId) {
        ENTRIES[i].category = document.getElementById('f-cat').value;
        ENTRIES[i].link = link;
        ENTRIES[i].title = title || link;
        ENTRIES[i].source = document.getElementById('f-source').value.trim();
        ENTRIES[i].filename = document.getElementById('f-file').value.trim();
        ENTRIES[i].tags = document.getElementById('f-tags').value.trim();
        ENTRIES[i].summary = document.getElementById('f-summary').value.trim();
        break;
      }
    }
    toast('Entry updated', 'ok');
  } else {
    // New
    ENTRIES.push({
      id: uid(),
      category: document.getElementById('f-cat').value,
      link: link,
      title: title || link,
      source: document.getElementById('f-source').value.trim(),
      filename: document.getElementById('f-file').value.trim(),
      tags: document.getElementById('f-tags').value.trim(),
      summary: document.getElementById('f-summary').value.trim(),
      created: dateStr()
    });
    toast('Entry added', 'ok');
  }

  saveData();
  closeForm();
  renderTable();
  renderTagNav();
}
function findEntry(id) {
  for (var i = 0; i < ENTRIES.length; i++) {
    if (ENTRIES[i].id === id) return ENTRIES[i];
  }
  return null;
}

// ===================== DELETE =====================
function deleteSelected() {
  var ids = [];
  for (var k in SELECTED) { if (SELECTED.hasOwnProperty(k) && SELECTED[k]) ids.push(k); }
  if (ids.length === 0) { toast('No items selected'); return; }
  if (!confirm(ids.length + ' item(s) will be deleted. Continue?')) return;
  ENTRIES = ENTRIES.filter(function(e) { return ids.indexOf(e.id) < 0; });
  SELECTED = {};
  saveData();
  renderTable();
  renderTagNav();
  toast(ids.length + ' item(s) deleted', 'ok');
}

// ===================== SEARCH / SORT =====================
function onSearch(q) {
  SEARCH_Q = q.trim();
  renderTable();
}
function onSortChange() {
  SORT_KEY = document.getElementById('sortSelect').value;
  renderTable();
}
function doSort(key) {
  if (key === 'date_desc' || key === 'created') {
    SORT_KEY = SORT_KEY === 'date_desc' ? 'date_asc' : 'date_desc';
  } else if (key === 'title') {
    SORT_KEY = 'title_asc';
  } else if (key === 'source') {
    SORT_KEY = 'source_asc';
  } else if (key === 'link') {
    SORT_KEY = 'title_asc';
  } else if (key === 'category') {
    SORT_KEY = 'title_asc';
  }
  document.getElementById('sortSelect').value = SORT_KEY;
  renderTable();
}

// ===================== LINK OPEN =====================
function openLink(url) {
  if (!url) return;
  try {
    var shell = new ActiveXObject('WScript.Shell');
    shell.Run(url);
  } catch(e) {
    try { window.open(url, '_blank'); } catch(e2) {}
  }
}

// ===================== FILE DROP =====================
function dzOver(e) {
  e = e || window.event;
  if (e.preventDefault) e.preventDefault();
  e.returnValue = false;
  document.getElementById('dropZone').className = 'drop-zone over';
}
function dzLeave() {
  document.getElementById('dropZone').className = 'drop-zone';
}
function dzDrop(e) {
  e = e || window.event;
  if (e.preventDefault) e.preventDefault();
  e.returnValue = false;
  document.getElementById('dropZone').className = 'drop-zone';
  // HTA file drop - get file path from dataTransfer
  try {
    var data = e.dataTransfer;
    if (data && data.files && data.files.length > 0) {
      var file = data.files[0];
      var name = file.name || '';
      document.getElementById('f-file').value = name;
      if (!document.getElementById('f-title').value) {
        document.getElementById('f-title').value = name;
      }
      document.getElementById('dropInfo').innerText = 'File: ' + name;
    }
  } catch(ex) {
    // Fallback for HTA
    try {
      var dt = e.dataTransfer;
      var text = dt.getData('Text') || dt.getData('URL') || '';
      if (text) {
        document.getElementById('f-link').value = text;
        document.getElementById('dropInfo').innerText = 'Link: ' + text;
      }
    } catch(ex2) {}
  }
}
function browseFile() {
  // HTA file browse
  try {
    var dlg = new ActiveXObject('UserAccounts.CommonDialog');
    dlg.Filter = 'All Files|*.*';
    dlg.FilterIndex = 1;
    if (dlg.ShowOpen) {
      var fp = dlg.FileName;
      var fso = new ActiveXObject('Scripting.FileSystemObject');
      var name = fso.GetFileName(fp);
      document.getElementById('f-file').value = name;
      if (!document.getElementById('f-title').value) {
        document.getElementById('f-title').value = name;
      }
      document.getElementById('dropInfo').innerText = 'File: ' + fp;
    }
  } catch(e) {
    // CommonDialog may not be available
    toast('File dialog not available on this system');
  }
}

// ===================== CSV IMPORT =====================
function openCsvModal() {
  document.getElementById('csvModal').className = 'modal-bg open';
  document.getElementById('csvText').value = '';
}
function closeCsvModal() {
  document.getElementById('csvModal').className = 'modal-bg';
}
function csvDzOver(e) {
  e = e || window.event;
  if (e.preventDefault) e.preventDefault();
  e.returnValue = false;
  document.getElementById('csvDropZone').className = 'drop-zone over';
}
function csvDzLeave() {
  document.getElementById('csvDropZone').className = 'drop-zone';
}
function csvDzDrop(e) {
  e = e || window.event;
  if (e.preventDefault) e.preventDefault();
  e.returnValue = false;
  document.getElementById('csvDropZone').className = 'drop-zone';
  // HTA: FileReader is NOT available (IE10+). Use dataTransfer text or VBS file dialog.
  try {
    var dt = e.dataTransfer;
    var path = '';
    try { path = dt.getData('Text') || ''; } catch(ex) {}
    if (!path) { try { path = dt.getData('URL') || ''; } catch(ex2) {} }
    if (path && path.indexOf('.csv') >= 0) {
      // Try to read as local file path
      var resolved = path;
      // Strip file:/// prefix if present
      if (resolved.indexOf('file:///') === 0) resolved = resolved.substring(8).replace(/\//g, '\\');
      resolved = resolved.replace(/%20/g, ' ');
      var text = readFile(resolved);
      if (text) {
        document.getElementById('csvText').value = text;
        toast('CSV loaded', 'ok');
        return;
      }
    }
    // If drag text is CSV content itself
    if (path && path.indexOf(',') >= 0 && path.indexOf('\n') >= 0) {
      document.getElementById('csvText').value = path;
      toast('CSV text pasted', 'ok');
      return;
    }
    toast('Please paste CSV text or use file dialog');
  } catch(ex3) {
    toast('Drop not supported. Please paste CSV text directly.');
  }
}
function csvBrowseFile() {
  try {
    var dlg = new ActiveXObject('UserAccounts.CommonDialog');
    dlg.Filter = 'CSV Files|*.csv|All Files|*.*';
    dlg.FilterIndex = 1;
    if (dlg.ShowOpen) {
      var text = readFile(dlg.FileName);
      if (text) {
        document.getElementById('csvText').value = text;
        toast('CSV loaded: ' + dlg.FileName, 'ok');
      }
    }
  } catch(e) {
    toast('File dialog not available. Please paste CSV text.');
  }
}
function importCsv() {
  var text = document.getElementById('csvText').value;
  if (!text || !text.trim()) { toast('No CSV data', 'err'); return; }

  var rows = parseCSV(text);
  if (rows.length === 0) { toast('No data found', 'err'); return; }

  // Detect header row
  var startIdx = 0;
  var firstRow = rows[0].join(',').toLowerCase();
  if (firstRow.indexOf('title') >= 0 || firstRow.indexOf('link') >= 0) {
    startIdx = 1;
  }

  // Expected columns: title, link, source, tags, summary
  var added = 0;
  for (var i = startIdx; i < rows.length; i++) {
    var r = rows[i];
    if (r.length === 0) continue;
    var allEmpty = true;
    for (var j = 0; j < r.length; j++) { if (r[j].trim()) allEmpty = false; }
    if (allEmpty) continue;

    var title = (r[0] || '').trim();
    var link = (r[1] || '').trim();
    var source = (r[2] || '').trim();
    var tags = (r[3] || '').trim();
    var summary = (r[4] || '').trim();

    if (!title && !link) continue;

    ENTRIES.push({
      id: uid(),
      category: 'news',
      title: title || link,
      link: link,
      source: source,
      tags: tags,
      summary: summary,
      filename: '',
      created: dateStr()
    });
    added++;
  }

  if (added > 0) {
    saveData();
    renderTable();
    renderTagNav();
    toast(added + ' news items imported', 'ok');
    closeCsvModal();
  } else {
    toast('No valid rows found', 'err');
  }
}

// ===================== CSV EXPORT =====================
function exportAllCSV() {
  var data = getFilteredData();
  if (data.length === 0) { toast('No data to export'); return; }

  var lines = ['category,title,link,source,filename,tags,summary,created'];
  for (var i = 0; i < data.length; i++) {
    var e = data[i];
    lines.push([
      csvQ(e.category), csvQ(e.title), csvQ(e.link),
      csvQ(e.source), csvQ(e.filename), csvQ(e.tags),
      csvQ(e.summary), csvQ(e.created)
    ].join(','));
  }
  var csv = lines.join('\r\n');
  var fileName = 'librarian_export_' + dateStr().replace(/-/g,'') + '.csv';

  try {
    var path = resolvePath(fileName);
    document.getElementById('_vbs_r').value = csv;
    window.execScript('Call writeUTF8("' + path.replace(/"/g,'""') + '", document.getElementById("_vbs_r").value)', 'VBScript');
    toast('Exported: ' + fileName, 'ok');
  } catch(e) {
    // Fallback: clipboard
    try {
      if (window.clipboardData) {
        window.clipboardData.setData('Text', csv);
        toast('CSV copied to clipboard', 'ok');
      }
    } catch(e2) {
      toast('Export failed', 'err');
    }
  }
}

// ===================== KEYBOARD =====================
document.onkeydown = function(e) {
  e = e || window.event;
  var key = e.keyCode;
  if (e.ctrlKey && key === 83) {
    if (e.preventDefault) e.preventDefault();
    e.returnValue = false;
    saveData();
    toast('Data saved', 'ok');
    return false;
  }
  if (e.ctrlKey && key === 78) {
    if (e.preventDefault) e.preventDefault();
    e.returnValue = false;
    openForm('new');
    return false;
  }
  if (key === 27) {
    closeForm();
    closeCsvModal();
  }
  if (key === 46 && !e.ctrlKey) {
    var ae = document.activeElement;
    if (ae && (ae.tagName === 'INPUT' || ae.tagName === 'TEXTAREA' || ae.tagName === 'SELECT')) return;
    deleteSelected();
  }
};

// ===================== LINK / TEXT DROP ON WINDOW =====================
document.ondragover = function(e) {
  e = e || window.event;
  e.returnValue = false;
  if (e.preventDefault) e.preventDefault();
};
document.ondrop = function(e) {
  e = e || window.event;
  e.returnValue = false;
  if (e.preventDefault) e.preventDefault();

  // If form is not open, open it and populate
  var panel = document.getElementById('form-panel');
  var isOpen = panel.className.indexOf('open') >= 0;

  try {
    var dt = e.dataTransfer;
    var text = '';
    try { text = dt.getData('URL') || ''; } catch(ex) {}
    if (!text) { try { text = dt.getData('Text') || ''; } catch(ex2) {} }

    if (text && (text.indexOf('http') === 0 || text.indexOf('ftp') === 0)) {
      if (!isOpen) openForm('new');
      document.getElementById('f-link').value = text;
      // Try to extract domain as source
      var m = text.match(/^https?:\/\/([^\/]+)/);
      if (m && !document.getElementById('f-source').value) {
        document.getElementById('f-source').value = m[1];
      }
      toast('Link captured', 'ok');
    } else if (dt && dt.files && dt.files.length > 0) {
      if (!isOpen) openForm('new');
      var file = dt.files[0];
      document.getElementById('f-file').value = file.name || '';
      if (!document.getElementById('f-title').value) {
        document.getElementById('f-title').value = file.name || '';
      }
      toast('File captured: ' + (file.name || ''), 'ok');
    }
  } catch(ex3) {}
};

// ===================== INIT =====================
function initApp() {
  APP_DIR = '';
  try {
    window.execScript('document.getElementById("_vbs_r").value = getAppDir()', 'VBScript');
    APP_DIR = document.getElementById('_vbs_r').value;
  } catch(e) {
    APP_DIR = '';
  }
  if (!APP_DIR) APP_DIR = './';

  loadData();
  renderTable();
  renderTagNav();
}

initApp();
</script>
</body>
</html>
