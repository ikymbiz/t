<!-- SEARCH MODAL -->
<div class="modal-overlay" id="search-modal"><div class="modal" style="width:750px">
<div class="modal-hdr"><span class="modal-title">&#128270; 全文検索</span><button class="modal-x" onclick="closeModal('search-modal')">&#10005;</button></div>
<div class="modal-body">
<div style="margin-bottom:14px"><input type="text" id="gs-q" placeholder="キーワード..." style="width:calc(100% - 80px);display:inline;font-size:16px" onkeydown="if(event.keyCode===13)gSearch()"> <button class="btn btn-primary" onclick="gSearch()">検索</button></div>
<div id="gs-results" style="max-height:420px;overflow-y:auto;"><div class="empty" style="padding:24px"><div class="empty-icon">&#128270;</div>キーワードを入力</div></div>
</div></div></div>

<script>
// ============================================================
// STORAGE ENGINE — localStorage for HTML, FileSystemObject for HTA
// ============================================================
var IS_HTA = (typeof ActiveXObject !== 'undefined');
var FSO, WS, BASE_DIR = '';

function lsRead(key) {
  try { var d = localStorage.getItem('ck_' + key); return d ? JSON.parse(d) : []; }
  catch(e) { return []; }
}
function lsWrite(key, arr) {
  try { localStorage.setItem('ck_' + key, JSON.stringify(arr)); } catch(e) {}
}
function lsAppend(key, obj) {
  var arr = lsRead(key); arr.push(obj); lsWrite(key, arr);
}
function readDB(n) { return lsRead(n); }
function writeDB(n, arr) { lsWrite(n, arr); }
function appendDB(n, obj) { lsAppend(n, obj); }
function backupAll() {
  var tables = ['records','task_log','intelligence_inbox','project_master','client_master'];
  var data = {};
  for (var i = 0; i < tables.length; i++) data[tables[i]] = readDB(tables[i]);
  clipCopy(JSON.stringify(data, null, 2));
  toast('バックアップJSONをコピーしました', 'ok');
}
function openDataFolder() { toast('HTML版: localStorageに保存中'); }
function clipCopy(t) {
  try {
    if (navigator.clipboard) { navigator.clipboard.writeText(t); return; }
    var ta = document.createElement('textarea'); ta.value = t;
    document.body.appendChild(ta); ta.select(); document.execCommand('copy');
    document.body.removeChild(ta);
  } catch(e) {}
}

// ============================================================
// UTILITIES
// ============================================================
function pad(n){return String(n).length<2?'0'+n:String(n);}
function nowISO(){return new Date().toISOString();}
function todayISO(){return new Date().toISOString().slice(0,10);}
function fmtDT(iso){if(!iso)return'';var d=new Date(iso);if(isNaN(d.getTime()))return iso.slice(0,16);return(d.getMonth()+1)+'/'+d.getDate()+' '+pad(d.getHours())+':'+pad(d.getMinutes());}
function fmtD(iso){if(!iso)return'';var d=new Date(iso);if(isNaN(d.getTime()))return iso;return(d.getMonth()+1)+'/'+d.getDate();}
function genId(p){return p+String(Date.now()).slice(-8);}
function esc(s){return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}
function updateClock(){var n=new Date();document.getElementById('clock').innerText=pad(n.getHours())+':'+pad(n.getMinutes())+':'+pad(n.getSeconds());}
setInterval(updateClock,1000);updateClock();

// ============================================================
// TEMPLATES
// ============================================================
var TPL={
"議事録":"#議事録\n##会議名\n\n##日時\n\n##場所\n\n##先方参加者\n\n##当方参加者\n\n##決定事項\n\n##Todo\n\n##議事\n",
"タスク":"#タスク\n##内容\n\n##期限\n\n##担当\n\n##関係者\n",
"ディレクション":"#ディレクション\n##担当者\n\n##指示内容\n\n##目的・背景\n\n##期待するアウトプット\n\n##期限\n\n##連絡手段\n",
"折衝記録":"#折衝記録\n##相手先\n\n##日時\n\n##手法\n\n##提案・交渉内容\n\n##ネクストアクション\n",
"3C":"#3C\n##顧客（Customer）\n\n##競合（Competitor）\n\n##自社（Company）\n\n##統合示唆\n",
"SCR":"#SCR\n##状況（Situation）\n\n##課題（Complication）\n\n##解決策（Resolution）\n\n##So What\n",
"SWOT":"#SWOT\n##強み\n\n##弱み\n\n##機会\n\n##脅威\n\n##クロスSWOT示唆\n",
"MECE":"#MECE\n##分解したい問い\n\n##分解軸\n\n##要素\n\n##MECE確認メモ\n",
"仮説思考":"#仮説思考\n##仮説\n\n##根拠\n\n##検証方法\n\n##検証結果\n\n##示唆\n",
"イシューツリー":"#イシューツリー\n##コアイシュー\n\n##サブイシュー①\n\n##サブイシュー②\n\n##サブイシュー③\n\n##So What\n\n##Why So\n",
"4P":"#4P\n##Product\n\n##Price\n\n##Place\n\n##Promotion\n\n##統合示唆\n",
"5Forces":"#5Forces\n##業界内競争\n\n##新規参入の脅威\n\n##代替品の脅威\n\n##買い手の交渉力\n\n##売り手の交渉力\n\n##戦略示唆\n",
"ギャップ分析":"#ギャップ分析\n##現状（As-Is）\n\n##目指す姿（To-Be）\n\n##ギャップ\n\n##根本原因\n\n##施策\n",
"シナリオ分析":"#シナリオ分析\n##主要不確実変数\n\n##楽観シナリオ\n\n##中立シナリオ\n\n##悲観シナリオ\n\n##ロバスト戦略\n",
"ピラミッド":"#ピラミッド\n##結論\n\n##根拠①\n\n##根拠②\n\n##根拠③\n\n##裏付けデータ\n",
"KPIツリー":"#KPIツリー\n##最終目標KPI\n\n##第1階層①\n\n##第1階層②\n\n##第2階層①\n\n##第2階層②\n\n##重要ドライバー\n",
"意思決定":"#意思決定\n##意思決定の問い\n\n##選択肢①\n\n##選択肢②\n\n##判断基準\n\n##選択肢①のリスク\n\n##選択肢②のリスク\n\n##推奨選択肢と理由\n"
};

// ============================================================
// EDITOR CORE — 動的テーブル展開 & シンタックスハイライト
// ============================================================
var editorDirty = false;
var autoSaveTimer = null;

// エディタ内のDOM（DivとTable）をパースして、純粋なMarkdown風のrawTextに復元する
// ブラウザごとのcontenteditable差異（DIV/P/BR/SPAN混在）を吸収
function getEditorPlain() {
  var el = document.getElementById('editor-area');
  var lines = [];
  collectLines(el, lines);
  // フォールバック：DOM走査で空なら innerText を使う
  if (lines.length === 0) {
    var fallback = el.innerText || el.textContent || '';
    return fallback;
  }
  return lines.join('\n');
}

// 再帰的にDOMノードを走査してテキスト行に分解する
function collectLines(parent, lines) {
  for (var i = 0; i < parent.childNodes.length; i++) {
    var node = parent.childNodes[i];

    // 1) インラインテーブル → ||記法に変換
    if (node.nodeName === 'TABLE' && (node.className || '').indexOf('editor-inline-table') >= 0) {
      var rows = node.querySelectorAll('tr');
      for (var r = 0; r < rows.length; r++) {
        var cells = rows[r].querySelectorAll('td');
        var parts = [];
        for (var c = 0; c < 3; c++) {
          parts.push(cells[c] ? (cells[c].innerText || '').replace(/[\n\r]/g, '') : '');
        }
        lines.push('||' + parts.join('|'));
      }
      continue;
    }

    // 2) ブロック要素（DIV, P） → 1行として抽出し、改行を区切りにする
    if (node.nodeName === 'DIV' || node.nodeName === 'P') {
      // 中身がBRだけの空行
      if (node.childNodes.length === 1 && node.childNodes[0].nodeName === 'BR') {
        lines.push('');
        continue;
      }
      // 中身がさらにブロック要素を含む場合は再帰（Chrome等が入れ子DIVを作る場合）
      var hasBlock = false;
      for (var j = 0; j < node.childNodes.length; j++) {
        var cn = node.childNodes[j].nodeName;
        if (cn === 'DIV' || cn === 'P' || cn === 'TABLE') { hasBlock = true; break; }
      }
      if (hasBlock) {
        collectLines(node, lines);
      } else {
        // インライン要素のみ → innerTextで1行抽出
        var txt = (node.innerText || node.textContent || '').replace(/\r/g, '');
        // innerTextが複数行を返す場合（BRが含まれる場合）は分割
        var subLines = txt.split('\n');
        for (var sl = 0; sl < subLines.length; sl++) {
          lines.push(subLines[sl]);
        }
      }
      continue;
    }

    // 3) BR → 改行
    if (node.nodeName === 'BR') {
      lines.push('');
      continue;
    }

    // 4) SPAN等のインライン要素 → テキスト抽出
    if (node.nodeType === 1) {
      var inlineTxt = (node.innerText || node.textContent || '');
      if (inlineTxt) lines.push(inlineTxt);
      continue;
    }

    // 5) テキストノード
    if (node.nodeType === 3) {
      var val = node.nodeValue || '';
      if (val.replace(/\s/g, '') !== '') {
        lines.push(val);
      }
      continue;
    }
  }
}

// rawTextを読み込み、エディタ用のDOM（DivブロックとTable）に変換してレンダリング
function setEditorContent(text) {
  var lines = text.split('\n');
  var html = '';
  var inTable = false;
  for (var i = 0; i < lines.length; i++) {
    var ln = lines[i];
    if (ln.indexOf('||') === 0) {
      if (!inTable) {
        html += '<table class="editor-inline-table"><tbody>';
        inTable = true;
      }
      var parts = ln.substring(2).split('|');
      html += '<tr>';
      for (var c = 0; c < 3; c++) {
        html += '<td>' + esc(parts[c] || '') + '</td>';
      }
      html += '</tr>';
    } else {
      if (inTable) { html += '</tbody></table>'; inTable = false; }
      html += '<div>' + highlightLine(ln) + '</div>';
    }
  }
  if (inTable) html += '</tbody></table>';
  
  document.getElementById('editor-area').innerHTML = html || '<div><br></div>';
  document.getElementById('ed-cnt').innerText = text.length;
}

function highlightLine(ln) {
  if (!ln) return '<br>';
  if (ln.indexOf('#') === 0 && ln.indexOf('##') !== 0) return '<span class="ed-tag">' + esc(ln) + '</span>';
  if (ln.indexOf('##') === 0) return '<span class="ed-field">' + esc(ln) + '</span>';
  if (ln.indexOf('\u2605') >= 0) return '<span class="ed-star">' + esc(ln) + '</span>';
  return esc(ln);
}

// 【魔法のUI】エディタへの入力を監視し、「||」が打たれたらテーブルに変換する
function handleEditorInput(e) {
  editorDirty = true;
  scheduleAutoSave();

  var sel = window.getSelection();
  if (!sel.rangeCount) return;
  var node = sel.focusNode;

  // テキストノードで「||」が入力された瞬間を検知
  if (node.nodeType === 3 && node.nodeValue.endsWith('||')) {
    var pos = sel.focusOffset;
    if (pos >= 2 && node.nodeValue.substring(pos-2, pos) === '||') {
      // 1. 打たれた「||」を削除
      node.nodeValue = node.nodeValue.substring(0, pos-2) + node.nodeValue.substring(pos);

      // 2. 3列のHTMLテーブルを生成
      var tbl = document.createElement('table');
      tbl.className = 'editor-inline-table';
      tbl.innerHTML = '<tbody><tr><td><br></td><td><br></td><td><br></td></tr></tbody>';

      // 3. 現在の行（DIV）の直下にテーブルを挿入
      var block = node.parentNode;
      while(block && block.id !== 'editor-area' && block.nodeName !== 'DIV') {
        block = block.parentNode;
      }
      if (block && block.id !== 'editor-area') {
        block.parentNode.insertBefore(tbl, block.nextSibling);
        // テーブルの下にクリック用の空行(div)を確保
        var emptyDiv = document.createElement('div');
        emptyDiv.innerHTML = '<br>';
        block.parentNode.insertBefore(emptyDiv, tbl.nextSibling);
      } else {
        document.getElementById('editor-area').appendChild(tbl);
      }

      // 4. 生成したテーブルの最初のセルにカーソルを移動
      var newRange = document.createRange();
      newRange.selectNodeContents(tbl.querySelector('td'));
      newRange.collapse(true);
      sel.removeAllRanges();
      sel.addRange(newRange);
    }
  }

  // 右ペイン同期（テーブル変換が起きなかった通常入力時）
  var text = getEditorPlain();
  document.getElementById('ed-cnt').innerText = text.length;
  syncToView();
}

// 【魔法のUI】テーブル内でTabキーを押した時の行追加挙動などを制御
function handleEditorKeydown(e) {
  // Ctrl+Enter で保存
  if ((e.ctrlKey || e.metaKey) && e.keyCode === 13) {
    e.preventDefault(); saveRecord(); return;
  }

  var sel = window.getSelection();
  if (!sel.rangeCount) return;
  var node = sel.focusNode;

  // 現在カーソルがテーブル(TD)の中にいるか判定
  var td = node.nodeType === 3 ? node.parentNode : node;
  while (td && td.nodeName !== 'TD' && td.id !== 'editor-area') {
    td = td.parentNode;
  }

  if (td && td.nodeName === 'TD') {
    var tr = td.parentNode;
    var tbody = tr.parentNode;
    var tbl = tbody.parentNode;
    
    // === Tabキー: セル間移動 + 最終セルで行追加 ===
    if (e.keyCode === 9) {
      e.preventDefault();
      var nextTd = null;

      if (!e.shiftKey) {
        // Tab → 次のセル
        if (td.nextElementSibling) {
          nextTd = td.nextElementSibling;
        } else if (tr.nextElementSibling) {
          nextTd = tr.nextElementSibling.querySelector('td');
        } else {
          // 最終セル → 新しい行を追加
          var newRow = document.createElement('tr');
          newRow.innerHTML = '<td><br></td><td><br></td><td><br></td>';
          tbody.appendChild(newRow);
          nextTd = newRow.querySelector('td');
        }
      } else {
        // Shift+Tab → 前のセル
        if (td.previousElementSibling) {
          nextTd = td.previousElementSibling;
        } else if (tr.previousElementSibling) {
          var prevCells = tr.previousElementSibling.querySelectorAll('td');
          nextTd = prevCells[prevCells.length - 1];
        }
      }

      if (nextTd) {
        var newRange = document.createRange();
        newRange.selectNodeContents(nextTd);
        newRange.collapse(false); // カーソルを末尾に
        sel.removeAllRanges();
        sel.addRange(newRange);
      }
      return;
    }

    // === Backspace: セル内が空＋最初のセル＋行が1つしかない → テーブル全体を削除 ===
    if (e.keyCode === 8) {
      var cellText = (td.innerText || '').replace(/\s/g, '');
      if (cellText === '') {
        // テーブル内の全セルが空かチェック
        var allEmpty = true;
        var allCells = tbl.querySelectorAll('td');
        for (var ci = 0; ci < allCells.length; ci++) {
          if ((allCells[ci].innerText || '').replace(/\s/g, '') !== '') { allEmpty = false; break; }
        }
        if (allEmpty) {
          e.preventDefault();
          // テーブルの次の要素にカーソルを移動してからテーブルを削除
          var nextEl = tbl.nextElementSibling || tbl.previousElementSibling;
          if (!nextEl) {
            var emptyDiv = document.createElement('div');
            emptyDiv.innerHTML = '<br>';
            tbl.parentNode.insertBefore(emptyDiv, tbl);
            nextEl = emptyDiv;
          }
          tbl.parentNode.removeChild(tbl);
          var newRange = document.createRange();
          newRange.selectNodeContents(nextEl);
          newRange.collapse(true);
          sel.removeAllRanges();
          sel.addRange(newRange);
          // 同期
          editorDirty = true;
          var text = getEditorPlain();
          document.getElementById('ed-cnt').innerText = text.length;
          syncToView();
          scheduleAutoSave();
          return;
        }
        // 現在の行の全セルが空 → 行だけ削除（テーブルに複数行ある場合）
        var rowCells = tr.querySelectorAll('td');
        var rowEmpty = true;
        for (var ri = 0; ri < rowCells.length; ri++) {
          if ((rowCells[ri].innerText || '').replace(/\s/g, '') !== '') { rowEmpty = false; break; }
        }
        if (rowEmpty && tbody.querySelectorAll('tr').length > 1) {
          e.preventDefault();
          var prevRow = tr.previousElementSibling;
          tbody.removeChild(tr);
          if (prevRow) {
            var lastCell = prevRow.querySelectorAll('td');
            var focusCell = lastCell[lastCell.length - 1];
            var nr = document.createRange();
            nr.selectNodeContents(focusCell);
            nr.collapse(false);
            sel.removeAllRanges();
            sel.addRange(nr);
          }
          editorDirty = true;
          syncToView();
          scheduleAutoSave();
          return;
        }
      }
    }

    // === Delete: テーブル外の直前位置からテーブルを削除 ===
    // (通常のDelete動作はブラウザに委ねる)
  }

  // テーブル外でBackspaceを押し、直後にテーブルがある場合 → テーブル全体選択
  if (e.keyCode === 46 && !td) { // Deleteキー
    var range = sel.getRangeAt(0);
    var container = range.startContainer;
    var nextSib = null;
    if (container.nodeType === 3) nextSib = container.parentNode.nextSibling;
    else nextSib = container.nextSibling;
    if (nextSib && nextSib.nodeName === 'TABLE' && (nextSib.className||'').indexOf('editor-inline-table') >= 0) {
      var allEmpty2 = true;
      var allCells2 = nextSib.querySelectorAll('td');
      for (var ci2 = 0; ci2 < allCells2.length; ci2++) {
        if ((allCells2[ci2].innerText||'').replace(/\s/g,'') !== '') { allEmpty2 = false; break; }
      }
      if (allEmpty2) {
        e.preventDefault();
        nextSib.parentNode.removeChild(nextSib);
        editorDirty = true;
        syncToView();
        scheduleAutoSave();
      }
    }
  }
}

function insertTpl(name) {
  var t = TPL[name]; if (!t) return;
  var cur = getEditorPlain();
  var next = (cur.replace(/\s/g, '').length > 0) ? cur + '\n' + t : t;
  setEditorContent(next);
  syncToView();
  document.getElementById('editor-area').focus();
  editorDirty = true;
  scheduleAutoSave();
}

// Media paste/drop support — HTMLペーストを排除し、プレーンテキストを強制
function handlePaste(e) {
  var clipData = e.clipboardData || window.clipboardData;
  if (!clipData) return;

  // 1) 画像がある場合 → 画像として挿入
  var items = clipData.items;
  if (items) {
    for (var i = 0; i < items.length; i++) {
      if (items[i].type.indexOf('image') === 0) {
        e.preventDefault();
        var blob = items[i].getAsFile();
        insertMediaBlob(blob);
        return;
      }
    }
  }

  // 2) テキストの場合 → HTMLを排除してプレーンテキストのみ貼り付け
  e.preventDefault();
  var plainText = clipData.getData('text/plain') || clipData.getData('Text') || '';
  if (!plainText) return;

  // プレーンテキストを現在のカーソル位置に挿入
  // ||行はテーブルに変換すべきだが、ここではそのまま挿入して
  // 次回のsetEditorContent呼び出し時に変換される
  var sel = window.getSelection();
  if (!sel.rangeCount) return;
  var range = sel.getRangeAt(0);
  range.deleteContents();

  // 改行を含むテキストの場合、行ごとにDIV要素を作成
  var lines = plainText.split('\n');
  var frag = document.createDocumentFragment();
  for (var li = 0; li < lines.length; li++) {
    if (li > 0) {
      // 2行目以降は新しいDIVとして追加
      var div = document.createElement('div');
      div.textContent = lines[li] || '';
      if (!lines[li]) div.innerHTML = '<br>';
      frag.appendChild(div);
    } else {
      // 1行目はテキストノードとして挿入（現在行に結合）
      frag.appendChild(document.createTextNode(lines[li]));
    }
  }
  range.insertNode(frag);

  // カーソルを挿入したテキストの末尾に移動
  range.collapse(false);
  sel.removeAllRanges();
  sel.addRange(range);

  // 同期
  var text = getEditorPlain();
  document.getElementById('ed-cnt').innerText = text.length;
  syncToView();
  editorDirty = true;
  scheduleAutoSave();
}

function handleDrop(e) {
  var files = (e.dataTransfer || {}).files;
  if (files && files.length) {
    for (var i = 0; i < files.length; i++) {
      if (files[i].type.indexOf('image') === 0 || files[i].type.indexOf('audio') === 0 || files[i].type.indexOf('video') === 0) {
        e.preventDefault();
        insertMediaBlob(files[i]);
        return;
      }
    }
  }
}

function insertMediaBlob(blob) {
  var reader = new FileReader();
  reader.onload = function(ev) {
    var el = document.getElementById('editor-area');
    if (blob.type.indexOf('image') === 0) {
      var img = document.createElement('img');
      img.src = ev.target.result;
      img.className = 'sv-media';
      img.style.maxWidth = '300px';
      el.appendChild(img);
    } else if (blob.type.indexOf('audio') === 0) {
      var aud = document.createElement('audio');
      aud.src = ev.target.result; aud.controls = true;
      el.appendChild(aud);
    } else if (blob.type.indexOf('video') === 0) {
      var vid = document.createElement('video');
      vid.src = ev.target.result; vid.controls = true;
      vid.style.maxWidth = '400px';
      el.appendChild(vid);
    }
    el.appendChild(document.createTextNode('\n'));
    editorDirty = true;
    scheduleAutoSave();
  };
  reader.readAsDataURL(blob);
}

// ============================================================
// AUTO-SAVE: saves every 5s if dirty, without clearing editor
// ============================================================
function scheduleAutoSave() {
  if (autoSaveTimer) clearTimeout(autoSaveTimer);
  autoSaveTimer = setTimeout(function() {
    if (!editorDirty) return;
    // 右ペインから同期されたテキストがあればそれを優先、なければ左ペインから取得
    var text;
    if (window._syncedRawText) {
      text = window._syncedRawText;
      window._syncedRawText = null; // 使い切る
    } else {
      text = getEditorPlain().replace(/^\s+|\s+$/g, '');
    }
    if (!text) return;
    var editId = document.getElementById('ed-edit-id').innerText;
    var parsed = parseText(text);
    if (editId) {
      var recs = readDB('records');
      for (var i = 0; i < recs.length; i++) {
        if (recs[i].id === editId) { recs[i].rawText = text; recs[i].type = parsed.type || 'memo'; }
      }
      writeDB('records', recs);
    } else {
      // First auto-save creates a new record and sets editId
      var newId = genId('RC');
      appendDB('records', { id: newId, datetime: nowISO(), type: parsed.type || 'memo', rawText: text, project: '', status: 'active', ai_data: '' });
      document.getElementById('ed-edit-id').innerText = newId;
      document.getElementById('ed-mode').innerText = '[編集中: ' + newId + ']';
    }
    editorDirty = false;
    var ind = document.getElementById('autosave-ind');
    ind.className = 'autosave-ind show';
    setTimeout(function() { ind.className = 'autosave-ind'; }, 2000);
    updateHdr();
  }, 5000);
}

// ============================================================
// parseText — core parser
// ============================================================
function parseText(raw) {
  var lines = raw.split('\n'), res = {type:'', fields:[], tables:[], freeTexts:[], stars:[]};
  var cf = null, cv = [];
  function flush() { if (cf !== null) { res.fields.push({key:cf, value:cv.join('\n').replace(/^\s+|\s+$/g,'')}); cf=null; cv=[]; } }
  for (var i = 0; i < lines.length; i++) {
    var ln = lines[i], tr = ln.replace(/^\s+|\s+$/g,'');
    if (tr.indexOf('#') === 0 && tr.indexOf('##') !== 0 && !res.type) { flush(); res.type = tr.substr(1).replace(/^\s+|\s+$/g,''); continue; }
    if (tr.indexOf('##') === 0) { flush(); cf = tr.substr(2).replace(/^\s+|\s+$/g,''); continue; }
    if (tr.indexOf('||') === 0) {
      var cells = tr.substr(2).split('|');
      for (var ci = 0; ci < cells.length; ci++) cells[ci] = cells[ci].replace(/^\s+|\s+$/g,'');
      res.tables.push({fk: cf, cells: cells}); continue;
    }
    if (tr.indexOf('\u2605') >= 0) res.stars.push({line: tr, fieldKey: cf});
    if (cf !== null) cv.push(ln);
    else if (res.type && tr) res.freeTexts.push(ln);
  }
  flush(); return res;
}

// ============================================================
// renderSection — structured view builder
// ============================================================
function renderSection(p, editable) {
  var h = '';
  if (p.type) h += '<div style="margin-bottom:14px"><span style="display:inline-block;font-size:14px;font-weight:700;padding:6px 16px;border-radius:6px;background:rgba(232,184,75,0.10);color:#e8b84b;border:1px solid rgba(232,184,75,0.28);letter-spacing:2px">#' + esc(p.type) + '</span></div>';

  var tblMap = {};
  for (var ti = 0; ti < p.tables.length; ti++) {
    var tk = p.tables[ti].fk || '';
    if (!tblMap[tk]) tblMap[tk] = [];
    tblMap[tk].push(p.tables[ti].cells);
  }

  if (p.fields.length) {
    h += '<table class="sv-kv-table">';
    for (var i = 0; i < p.fields.length; i++) {
      var f = p.fields[i];
      if (tblMap[f.key]) {
        h += '</table>';
        h += '<div class="sv-section-label">' + esc(f.key) + '</div>';
        h += '<table class="sv-data-table"><tr><th>項目</th><th>担当</th><th>期限</th></tr>';
        var rows = tblMap[f.key];
        for (var ri = 0; ri < rows.length; ri++) {
          h += '<tr>';
          for (var ci = 0; ci < rows[ri].length; ci++) {
            h += '<td class="sv-editable" contenteditable="' + (editable?'true':'false') + '" data-field="' + esc(f.key) + '" data-row="' + ri + '" data-col="' + ci + '" onblur="syncToEditor()">' + esc(rows[ri][ci]) + '</td>';
          }
          for (var mi = rows[ri].length; mi < 3; mi++) {
            h += '<td class="sv-editable" contenteditable="' + (editable?'true':'false') + '" data-field="' + esc(f.key) + '" data-row="' + ri + '" data-col="' + mi + '" onblur="syncToEditor()"></td>';
          }
          h += '</tr>';
        }
        h += '</table>';
        if (f.value) h += '<div class="sv-freetext">' + esc(f.value).replace(/\n/g,'<br>') + '</div>';
        h += '<table class="sv-kv-table">';
      } else {
        // Render star lines specially within field values
        var val = f.value;
        var valHtml = '';
        var valLines = val.split('\n');
        for (var vl = 0; vl < valLines.length; vl++) {
          if (valLines[vl].indexOf('\u2605') >= 0) {
            valHtml += '<div class="sv-star">' + esc(valLines[vl]) + '</div>';
          } else {
            valHtml += esc(valLines[vl]) + '<br>';
          }
        }
        h += '<tr><td>' + esc(f.key) + '</td><td class="sv-editable" contenteditable="' + (editable?'true':'false') + '" data-field="' + esc(f.key) + '" data-row="-1" data-col="-1" onblur="syncToEditor()">' + valHtml + '</td></tr>';
      }
    }
    h += '</table>';
  }

  // Star summary
  if (p.stars.length) {
    h += '<div class="sv-section-label">&#9733; Todo連動マーカー</div>';
    for (var si = 0; si < p.stars.length; si++) {
      h += '<div class="sv-star">' + esc(p.stars[si].line) + '</div>';
    }
  }

  if (p.freeTexts.length) {
    var ft = '';
    for (var fi = 0; fi < p.freeTexts.length; fi++) {
      var line = p.freeTexts[fi];
      ft += (line.indexOf('\u2605') >= 0) ? '<div class="sv-star">' + esc(line) + '</div>' : esc(line) + '<br>';
    }
    h += '<div class="sv-freetext">' + ft + '</div>';
  }
  return h;
}

// ============================================================
// syncToView — editor → right pane
// ============================================================
function syncToView() {
  var text = getEditorPlain();
  var sv = document.getElementById('sv');
  if (!text.replace(/\s/g,'')) {
    sv.innerHTML = '<div class="empty"><div class="empty-icon">&#9997;</div>左のエディタに入力すると構造化表示されます</div>';
    return;
  }
  sv.innerHTML = renderSection(parseText(text), true);
}

// ============================================================
// syncToEditor — right pane → left editor (BIDIRECTIONAL SYNC)
// ============================================================
function syncToEditor() {
  // 右ペインの編集内容を収集し、rawTextを再構築する
  // ※ 左ペインは再描画しない（カーソル位置を維持するため）
  // 代わりに、再構築したテキストを _syncedRawText に保持し、
  // 次回の自動保存・手動保存時にこちらを優先使用する

  var text = getEditorPlain();
  var lines = text.split('\n');

  // 右ペインのDOM要素から編集値を収集
  var editedFields = {};
  var editedTables = {};
  var svCells = document.querySelectorAll('#sv .sv-editable');
  for (var i = 0; i < svCells.length; i++) {
    var cell = svCells[i];
    var fld = cell.getAttribute('data-field');
    var row = parseInt(cell.getAttribute('data-row'));
    var col = parseInt(cell.getAttribute('data-col'));
    var val = cell.innerText || cell.textContent || '';
    if (row === -1) {
      editedFields[fld] = val;
    } else {
      if (!editedTables[fld]) editedTables[fld] = {};
      if (!editedTables[fld][row]) editedTables[fld][row] = {};
      editedTables[fld][row][col] = val;
    }
  }

  // 元のrawTextの構造を維持しながら、編集箇所だけ差し替える
  var currentField = null;
  var fieldValueStarted = false;
  var result = [];
  var tblCounters = {};

  for (var li = 0; li < lines.length; li++) {
    var ln = lines[li];
    var tr = ln.replace(/^\s+|\s+$/g, '');

    if (tr.indexOf('#') === 0 && tr.indexOf('##') !== 0) {
      result.push(ln); currentField = null; continue;
    }
    if (tr.indexOf('##') === 0) {
      currentField = tr.substr(2).replace(/^\s+|\s+$/g, '');
      result.push(ln); fieldValueStarted = true; continue;
    }
    if (tr.indexOf('||') === 0) {
      var fk = currentField || '';
      if (!tblCounters[fk]) tblCounters[fk] = 0;
      var rowIdx = tblCounters[fk]; tblCounters[fk]++;
      if (editedTables[fk] && editedTables[fk][rowIdx]) {
        var cells = tr.substr(2).split('|');
        var newCells = [];
        for (var ci = 0; ci < cells.length; ci++) {
          newCells.push(editedTables[fk][rowIdx][ci] !== undefined ? editedTables[fk][rowIdx][ci] : cells[ci].replace(/^\s+|\s+$/g,''));
        }
        result.push('||' + newCells.join('|'));
      } else { result.push(ln); }
      continue;
    }

    if (currentField && editedFields[currentField] !== undefined && fieldValueStarted) {
      result.push(editedFields[currentField].replace(/<br\s*\/?>/gi, '\n').replace(/<[^>]*>/g, ''));
      delete editedFields[currentField];
      fieldValueStarted = false;
      continue;
    }
    if (fieldValueStarted && currentField && editedFields[currentField] === undefined) {
      result.push(ln); continue;
    }
    result.push(ln);
  }

  var newText = result.join('\n');

  // 左ペインを再描画せず、内部状態だけ更新してauto-saveに委ねる
  // _syncedRawText に保持しておき、getEditorPlain()の代わりに使えるようにする
  window._syncedRawText = newText;
  editorDirty = true;
  scheduleAutoSave();

  // ステータスバーに同期完了を表示
  var ind = document.getElementById('autosave-ind');
  ind.innerText = '\u2194 右ペイン同期済';
  ind.className = 'autosave-ind show';
  setTimeout(function() { ind.innerText = '\u2713 自動保存済'; ind.className = 'autosave-ind'; }, 2000);
}

// ============================================================
// showDetail — read-only structured view for detail panes
// ============================================================
function showDetail(rec, cid) {
  var el = document.getElementById(cid);
  if (!rec || !rec.rawText) { el.innerHTML = '<div class="empty">データなし</div>'; return; }
  el.innerHTML = '<div style="margin-bottom:12px"><button class="btn btn-primary btn-sm" onclick="editRec(\'' + rec.id + '\')">&#9997; 編集</button> <span style="font-family:Consolas,monospace;font-size:12px;color:#6b7190;margin-left:12px">' + fmtDT(rec.datetime) + '</span></div>' + renderSection(parseText(rec.rawText), false);
}

// ============================================================
// SAVE — does NOT clear editor; stays in edit mode
// ============================================================
function saveRecord() {
  // 右ペインから同期されたテキストがあればそれを優先
  var text;
  if (window._syncedRawText) {
    text = window._syncedRawText;
    window._syncedRawText = null;
  } else {
    text = getEditorPlain();
  }
  text = text.replace(/^\s+|\s+$/g, '');
  if (!text) { toast('内容を入力'); return; }
  var parsed = parseText(text);
  var editId = document.getElementById('ed-edit-id').innerText;

  if (editId) {
    var recs = readDB('records');
    for (var i = 0; i < recs.length; i++) {
      if (recs[i].id === editId) { recs[i].rawText = text; recs[i].type = parsed.type || 'memo'; }
    }
    writeDB('records', recs);
    toast('保存しました (上書き)', 'ok');
  } else {
    var newId = genId('RC');
    appendDB('records', { id: newId, datetime: nowISO(), type: parsed.type || 'memo', rawText: text, project: '', status: 'active', ai_data: '' });
    document.getElementById('ed-edit-id').innerText = newId;
    document.getElementById('ed-mode').innerText = '[編集中: ' + newId + ']';
    toast('新規保存 [#' + (parsed.type || 'memo') + ']', 'ok');
  }

  // Extract tasks from ★ AND from ||table in Todo/ネクストアクション fields
  extractTasks(parsed, editId || document.getElementById('ed-edit-id').innerText);
  editorDirty = false;
  updateHdr();
}

function extractTasks(parsed, srcId) {
  // 1) Table rows in Todo-like fields
  var todoFields = ['Todo', 'ネクストアクション', 'アクションアイテム'];
  for (var i = 0; i < parsed.tables.length; i++) {
    var tbl = parsed.tables[i];
    var isTodo = false;
    for (var tf = 0; tf < todoFields.length; tf++) {
      if (tbl.fk && tbl.fk.indexOf(todoFields[tf]) >= 0) { isTodo = true; break; }
    }
    if (isTodo && tbl.cells.length >= 1) {
      // Check if task already exists to avoid duplicates
      var existing = readDB('task_log');
      var dup = false;
      for (var k = 0; k < existing.length; k++) {
        if (existing[k].title === tbl.cells[0] && existing[k].source_record === srcId) { dup = true; break; }
      }
      if (!dup) {
        appendDB('task_log', { id: genId('TK'), datetime: nowISO(), title: tbl.cells[0], due: tbl.cells[2] || '', owner: tbl.cells[1] || '', project: '', content: '', status: '未着手', progress: '', source_record: srcId });
      }
    }
  }
  // 2) ★ lines → also create tasks
  for (var si = 0; si < parsed.stars.length; si++) {
    var starLine = parsed.stars[si].line.replace(/\u2605/g, '').replace(/^\s+|\s+$/g, '');
    if (!starLine) continue;
    var existing2 = readDB('task_log');
    var dup2 = false;
    for (var k2 = 0; k2 < existing2.length; k2++) {
      if (existing2[k2].title === starLine && existing2[k2].source_record === srcId) { dup2 = true; break; }
    }
    if (!dup2) {
      appendDB('task_log', { id: genId('TK'), datetime: nowISO(), title: starLine, due: '', owner: '', project: '', content: '★マーカーから自動抽出', status: '未着手', progress: '', source_record: srcId });
    }
  }
}

function newRecord() {
  document.getElementById('editor-area').innerHTML = '';
  document.getElementById('ed-edit-id').innerText = '';
  document.getElementById('ed-mode').innerText = '';
  document.getElementById('ed-cnt').innerText = '0';
  syncToView();
  document.getElementById('editor-area').focus();
  editorDirty = false;
}

function editRec(id) {
  var recs = readDB('records'), rec = null;
  for (var i = 0; i < recs.length; i++) { if (recs[i].id === id) rec = recs[i]; }
  if (!rec) return;
  go('editor');
  setEditorContent(rec.rawText);
  document.getElementById('ed-edit-id').innerText = id;
  document.getElementById('ed-mode').innerText = '[編集中: ' + id + ']';
  syncToView();
}

// ============================================================
// MEETINGS
// ============================================================
var curMtg = null;
function renderMtgList(filter) {
  var recs = readDB('records').filter(function(r){return r.type === '議事録';}).reverse();
  document.getElementById('mtg-badge').innerText = recs.length;
  if (filter) { var f = filter.replace(/^\s+|\s+$/g,''); if (f) recs = recs.filter(function(r){return r.rawText.indexOf(f)>=0;}); }
  var el = document.getElementById('mtg-list');
  if (!recs.length) { el.innerHTML = '<div class="empty"><div class="empty-icon">&#128203;</div>議事録なし</div>'; return; }
  var h = '';
  for (var i = 0; i < recs.length; i++) {
    var rec = recs[i], parsed = parseText(rec.rawText), title = '';
    for (var j = 0; j < parsed.fields.length; j++) { if (parsed.fields[j].key === '会議名') { title = parsed.fields[j].value; break; } }
    h += '<div class="list-item' + (rec.id===curMtg?' sel':'') + '" onclick="showMtg(\'' + rec.id + '\')"><div class="list-title">' + esc(title||'(無題)') + '</div><div class="list-meta">' + fmtDT(rec.datetime) + '</div></div>';
  }
  el.innerHTML = h;
}
function showMtg(id) { curMtg = id; var recs = readDB('records'), rec = null; for (var i = 0; i < recs.length; i++) { if (recs[i].id === id) rec = recs[i]; } showDetail(rec, 'mtg-detail'); renderMtgList(''); }

// ============================================================
// TASKS
// ============================================================
var curTk = null;
function renderTkList() {
  var tasks = readDB('task_log'), f = document.getElementById('tk-filter').value, s = document.getElementById('tk-sort').value;
  if (f==='open') tasks = tasks.filter(function(t){return t.status!=='完了' && t.status!=='中止';});
  else if (f==='done') tasks = tasks.filter(function(t){return t.status==='完了';});
  if (s==='due') tasks.sort(function(a,b){return (a.due||'9999')>(b.due||'9999')?1:-1;});
  else tasks.reverse();
  document.getElementById('tk-badge').innerText = tasks.length;
  var el = document.getElementById('tk-list');
  if (!tasks.length) { el.innerHTML = '<div class="empty"><div class="empty-icon">&#9672;</div>タスクなし</div>'; return; }
  var h = '';
  for (var i = 0; i < tasks.length; i++) {
    var t = tasks[i], sc = t.status==='完了'?'ts-done':t.status==='進行中'?'ts-progress':'ts-open';
    h += '<div class="list-item' + (t.id===curTk?' sel':'') + '" onclick="showTk(\'' + t.id + '\')"><div><span class="task-status ' + sc + '">' + t.status + '</span> <span style="vertical-align:middle;margin-left:6px">' + esc(t.title) + '</span></div><div class="list-meta">' + (t.owner||'') + (t.due?' 〆'+t.due:'') + '</div></div>';
  }
  el.innerHTML = h;
}
function showTk(id) {
  curTk = id; var tasks = readDB('task_log'), t = null;
  for (var i = 0; i < tasks.length; i++) { if (tasks[i].id === id) t = tasks[i]; }
  if (!t) return;
  var pe = (t.progress||'').split('|||').filter(function(x){return x.replace(/\s/g,'');}), ph = '';
  for (var pi = 0; pi < pe.length; pi++) { var pts = pe[pi].split(':::'); ph += '<div class="progress-entry"><div class="pe-date">' + (pts[0]||'') + '</div><div>' + esc(pts[1]||'') + '</div></div>'; }
  document.getElementById('tk-detail').innerHTML = '<div class="sec-lbl">TASK DETAIL</div><table class="sv-kv-table"><tr><td>内容</td><td>' + esc(t.title) + '</td></tr><tr><td>期限</td><td>' + esc(t.due||'未設定') + '</td></tr><tr><td>担当</td><td>' + esc(t.owner||'未設定') + '</td></tr><tr><td>ステータス</td><td><select id="tk-st" style="width:auto;padding:4px 8px;font-size:13px;display:inline;background:#12141a;border:1px solid #363b52;color:#a0a6bc;"><option' + (t.status==='未着手'?' selected':'') + '>未着手</option><option' + (t.status==='進行中'?' selected':'') + '>進行中</option><option' + (t.status==='完了'?' selected':'') + '>完了</option><option' + (t.status==='中止'?' selected':'') + '>中止</option></select> <button class="btn btn-ghost btn-xs" onclick="updateTkSt(\'' + t.id + '\')">更新</button></td></tr>' + (t.source_record ? '<tr><td>関連</td><td><button class="btn btn-ghost btn-xs" onclick="editRec(\'' + t.source_record + '\')">元レコードを開く</button></td></tr>' : '') + '</table><div class="sv-section-label">進捗コメント</div>' + (ph || '<div style="color:#6b7190;font-size:13px;padding:8px 0;">なし</div>') + '<div style="margin-top:12px"><textarea id="tk-prog" rows="2" placeholder="進捗コメント..." style="font-size:14px;min-height:60px"></textarea><button class="btn btn-primary btn-sm" onclick="addTkProg(\'' + t.id + '\')" style="margin-top:6px">追加</button></div>';
  renderTkList();
}
function updateTkSt(id) { var st = document.getElementById('tk-st').value, tasks = readDB('task_log'); for (var i = 0; i < tasks.length; i++) { if (tasks[i].id === id) tasks[i].status = st; } writeDB('task_log', tasks); toast('ステータス更新','ok'); showTk(id); updateHdr(); }
function addTkProg(id) { var c = (document.getElementById('tk-prog').value||'').replace(/^\s+|\s+$/g,''); if (!c) { toast('コメントを入力'); return; } var tasks = readDB('task_log'); for (var i = 0; i < tasks.length; i++) { if (tasks[i].id === id) { var ex = tasks[i].progress||''; tasks[i].progress = ex ? (ex+'|||'+fmtDT(nowISO())+':::'+c) : (fmtDT(nowISO())+':::'+c); } } writeDB('task_log', tasks); toast('コメント追加','ok'); showTk(id); }

// ============================================================
// DELEGATION
// ============================================================
var curDl = null;
function renderDlList() {
  var recs = readDB('records').filter(function(r){return r.type === 'ディレクション';}).reverse();
  document.getElementById('dl-badge').innerText = recs.length;
  var el = document.getElementById('dl-list');
  if (!recs.length) { el.innerHTML = '<div class="empty"><div class="empty-icon">&#128228;</div>なし</div>'; return; }
  var h = '';
  for (var i = 0; i < recs.length; i++) {
    var rec = recs[i], parsed = parseText(rec.rawText), assignee = '';
    for (var j = 0; j < parsed.fields.length; j++) { if (parsed.fields[j].key === '担当者') { assignee = parsed.fields[j].value; break; } }
    h += '<div class="list-item' + (rec.id===curDl?' sel':'') + '" onclick="showDl(\'' + rec.id + '\')"><div class="list-title">' + esc(assignee||'(未設定)') + '</div><div class="list-meta">' + fmtDT(rec.datetime) + '</div></div>';
  }
  el.innerHTML = h;
}
function showDl(id) { curDl = id; var recs = readDB('records'), rec = null; for (var i = 0; i < recs.length; i++) { if (recs[i].id === id) rec = recs[i]; } showDetail(rec, 'dl-detail'); renderDlList(); }

// ============================================================
// KNOWLEDGE
// ============================================================
var curKb = null;
function renderKbList(filter) {
  var recs = readDB('records').reverse(), skip = {'議事録':1,'タスク':1,'ディレクション':1};
  recs = recs.filter(function(r){return !skip[r.type];});
  document.getElementById('kb-badge').innerText = recs.length;
  if (filter) { var f = filter.replace(/^\s+|\s+$/g,''); if (f) recs = recs.filter(function(r){return r.rawText.indexOf(f)>=0;}); }
  var el = document.getElementById('kb-list');
  if (!recs.length) { el.innerHTML = '<div class="empty"><div class="empty-icon">&#128214;</div>なし</div>'; return; }
  var h = '';
  for (var i = 0; i < recs.length; i++) { var rec = recs[i]; h += '<div class="list-item' + (rec.id===curKb?' sel':'') + '" onclick="showKb(\'' + rec.id + '\')"><div class="list-title"><span style="font-size:11px;padding:2px 8px;border-radius:4px;background:rgba(232,184,75,0.10);color:#e8b84b;border:1px solid rgba(232,184,75,0.28);margin-right:6px">#' + esc(rec.type) + '</span>' + esc(rec.rawText.slice(0,50)) + '</div><div class="list-meta">' + fmtDT(rec.datetime) + '</div></div>'; }
  el.innerHTML = h;
}
function showKb(id) { curKb = id; var recs = readDB('records'), rec = null; for (var i = 0; i < recs.length; i++) { if (recs[i].id === id) rec = recs[i]; } showDetail(rec, 'kb-detail'); renderKbList(''); }

// ============================================================
// PROJECTS
// ============================================================
function savePj() { var n = document.getElementById('pj-name').value.replace(/^\s+|\s+$/g,''); if (!n) { toast('案件名を入力'); return; } appendDB('project_master', {id:genId('P'),datetime:nowISO(),name:n,client:document.getElementById('pj-client').value,phase:document.getElementById('pj-phase').value,priority:document.getElementById('pj-pri').value,type:document.getElementById('pj-type').value,fee:document.getElementById('pj-fee').value,start:document.getElementById('pj-start').value,end:'',hypothesis:'',risk:'',status:'進行中'}); closeModal('pj-modal'); toast('案件追加','ok'); renderPj(); document.getElementById('pj-name').value=''; document.getElementById('pj-client').value=''; }
function renderPj() { var data = readDB('project_master').filter(function(p){return p.status!=='完了';}), board = document.getElementById('pj-board'); if (!data.length) { board.innerHTML = '<div class="empty"><div class="empty-icon">&#9673;</div>案件なし</div>'; return; } var ph = {}; for (var i = 0; i < data.length; i++) { var p = data[i]; if (!ph[p.phase]) ph[p.phase] = []; ph[p.phase].push(p); } var pc = {S:'pj-s',A:'pj-a',B:'pj-b'}, h = '<div class="row">'; for (var k in ph) { if (!ph.hasOwnProperty(k)) continue; h += '<div class="col3"><div style="font-size:13px;font-weight:700;color:#6b7190;letter-spacing:2px;padding:6px 0;border-bottom:1px solid #2a2e40;margin-bottom:8px">' + k + ' (' + ph[k].length + ')</div>'; for (var j = 0; j < ph[k].length; j++) { var p = ph[k][j]; h += '<div class="pj-card ' + (pc[p.priority]||'') + '"><div class="pj-name">' + esc(p.name) + '</div><div style="font-size:13px;color:#a0a6bc">' + esc(p.client||'') + '</div><div class="pj-meta">' + p.type + (p.fee?' / '+p.fee+'万':'') + '</div></div>'; } h += '</div>'; } h += '</div>'; board.innerHTML = h; }

