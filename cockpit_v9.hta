<html>
<head>
<meta charset="UTF-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<title>COCKPIT v9 — 戦略コンサルタント自律進化型コックピット</title>
<HTA:APPLICATION
  ID="COCKPIT_v9"
  APPLICATIONNAME="COCKPIT v9"
  BORDER="thin"
  BORDERSTYLE="normal"
  CAPTION="yes"
  CONTEXTMENU="no"
  INNERBORDER="no"
  MAXIMIZEBUTTON="yes"
  MINIMIZEBUTTON="yes"
  NAVIGABLE="no"
  SCROLL="no"
  SCROLLFLAT="yes"
  SELECTION="no"
  SHOWINTASKBAR="yes"
  SINGLEINSTANCE="yes"
  SYSMENU="yes"
  WINDOWSTATE="maximize"
/>
<style>
*{margin:0;padding:0;box-sizing:border-box;}
html,body{height:100%;overflow:hidden;background:#12141a;color:#eaecf4;font-family:'Segoe UI','Meiryo',sans-serif;font-size:15px;line-height:1.6;}
#layout-table{width:100%;height:100%;border-collapse:collapse;}
#layout-table td{vertical-align:top;padding:0;}
#ribbon-row td{height:44px;}
#content-row td{height:100%;}
#ribbon{height:44px;background:#1a1d28;border-bottom:1px solid #2a2e40;padding:0 16px;white-space:nowrap;overflow:hidden;}
#ribbon table{height:100%;border-collapse:collapse;}
#ribbon td{vertical-align:middle;padding:0 4px;white-space:nowrap;}
.ribbon-brand{font-size:18px;font-weight:800;color:#e8b84b;letter-spacing:3px;padding-right:12px;}
.ribbon-sep{display:inline-block;width:1px;height:24px;background:#2a2e40;margin:0 4px;vertical-align:middle;}
.ribbon-btn{display:inline-block;padding:6px 12px;border:1px solid transparent;border-radius:6px;background:transparent;color:#a0a6bc;font-size:13px;font-weight:600;cursor:pointer;white-space:nowrap;vertical-align:middle;font-family:'Segoe UI','Meiryo',sans-serif;}
.ribbon-btn:hover{background:#262a3a;border-color:#363b52;color:#eaecf4;}
.ribbon-stat{display:inline-block;vertical-align:middle;font-size:13px;color:#a0a6bc;margin-left:12px;}
.ribbon-dot{display:inline-block;width:8px;height:8px;border-radius:50%;background:#4eca7a;box-shadow:0 0 6px #4eca7a;vertical-align:middle;margin-right:6px;}
.ribbon-dot.warn{background:#e8b84b;box-shadow:0 0 6px #e8b84b;}
#clock{font-family:Consolas,monospace;font-size:16px;color:#e8b84b;font-weight:700;letter-spacing:2px;margin-left:14px;}
#sidebar-cell{width:200px;background:#151820;border-right:1px solid #2a2e40;overflow:hidden;}
#sidebar-cell.collapsed{width:44px;}
#sidebar{height:100%;overflow-y:auto;overflow-x:hidden;padding:8px 0;}
#sidebar-toggle{display:block;width:100%;padding:8px 12px;cursor:pointer;border:none;background:transparent;color:#6b7190;font-size:16px;text-align:right;font-family:'Segoe UI','Meiryo',sans-serif;outline:none;}
#sidebar-toggle:hover{color:#e8b84b;background:#1e2230;}
.nav-group-label{font-size:11px;font-weight:700;letter-spacing:2px;color:#6b7190;text-transform:uppercase;padding:12px 16px 4px;overflow:hidden;white-space:nowrap;}
.nav-btn{width:100%;display:block;padding:10px 16px;cursor:pointer;border:none;border-left:3px solid transparent;background:transparent;color:#8892a6;font-family:'Segoe UI','Meiryo',sans-serif;font-size:14px;text-align:left;outline:none;overflow:hidden;white-space:nowrap;}
.nav-btn:hover{background:#1e2230;color:#c0c6d6;}
.nav-btn.active{background:rgba(232,184,75,0.08);color:#e8b84b;border-left-color:#e8b84b;}
.nav-icon{display:inline-block;width:22px;font-size:18px;text-align:center;vertical-align:middle;margin-right:8px;}
.nav-label{display:inline;font-size:14px;font-weight:500;vertical-align:middle;}
.nav-sep{height:1px;background:#2a2e40;margin:6px 12px;}
#sidebar-cell.collapsed .nav-label,#sidebar-cell.collapsed .nav-group-label{display:none;}
#sidebar-cell.collapsed .nav-btn{padding:10px 0;text-align:center;}
#sidebar-cell.collapsed .nav-icon{margin:0;width:100%;}
#tree-cell{width:220px;background:#161820;border-right:1px solid #2a2e40;overflow:hidden;}
#tree-cell.hidden{width:0;border:none;overflow:hidden;}
#folder-tree{height:100%;overflow-y:auto;overflow-x:hidden;padding:8px 0;}
.tree-hdr{padding:10px 14px;border-bottom:1px solid #2a2e40;font-size:12px;font-weight:700;letter-spacing:2px;color:#6b7190;text-transform:uppercase;}
.tree-hdr button{float:right;background:none;border:none;color:#6b7190;cursor:pointer;font-size:14px;padding:0 4px;}
.tree-hdr button:hover{color:#e8b84b;}
.tree-item{display:block;width:100%;padding:7px 14px 7px 24px;border:none;background:transparent;color:#8892a6;font-family:'Segoe UI','Meiryo',sans-serif;font-size:13px;text-align:left;cursor:pointer;outline:none;white-space:nowrap;overflow:hidden;}
.tree-item:hover{background:#1e2230;color:#c0c6d6;}
.tree-folder{padding-left:14px;font-weight:700;color:#a0a6bc;}
#main-cell{background:#12141a;}
#main{width:100%;height:100%;overflow:hidden;position:relative;}
.screen{display:none;width:100%;height:100%;overflow-y:auto;overflow-x:hidden;padding:24px;}
.screen.active{display:block;}
.panel{background:#1f2230;border:1px solid #2a2e40;border-radius:10px;margin-bottom:14px;}
.panel-hdr{padding:14px 20px;border-bottom:1px solid #2a2e40;}
.panel-hdr:after{content:'';display:block;clear:both;}
.panel-title{float:left;font-size:13px;font-weight:700;letter-spacing:2px;color:#e8b84b;text-transform:uppercase;line-height:28px;}
.panel-hdr .badge{float:left;margin-left:10px;}
.panel-hdr-right{float:right;}
.badge{display:inline-block;font-family:'Consolas','MS Gothic',monospace;font-size:12px;font-weight:700;background:rgba(232,184,75,0.10);color:#e8b84b;border:1px solid rgba(232,184,75,0.28);padding:2px 10px;border-radius:4px;line-height:22px;}
.fg{margin-bottom:10px;}
label.lbl{display:block;font-size:12px;font-weight:600;letter-spacing:1px;color:#6b7190;text-transform:uppercase;margin-bottom:4px;}
input[type=text],input[type=date],input[type=datetime-local],input[type=url],input[type=number],textarea,select{background:#161820;border:1px solid #363b52;border-radius:6px;color:#eaecf4;font-family:'Segoe UI','Meiryo',sans-serif;font-size:15px;padding:10px 14px;outline:none;width:100%;}
input:focus,textarea:focus,select:focus{border-color:#c9982e;box-shadow:0 0 0 3px rgba(232,184,75,0.10);}
textarea{resize:vertical;min-height:80px;line-height:1.7;}
select option{background:#1f2230;}
.btn{display:inline-block;padding:10px 20px;border:1px solid;border-radius:6px;font-family:'Segoe UI','Meiryo',sans-serif;font-size:13px;font-weight:700;letter-spacing:.5px;cursor:pointer;white-space:nowrap;vertical-align:middle;}
.btn-primary{background:#e8b84b;border-color:#e8b84b;color:#12141a;}
.btn-primary:hover{background:#f5d78e;border-color:#f5d78e;}
.btn-ghost{background:transparent;border-color:#363b52;color:#a0a6bc;}
.btn-ghost:hover{border-color:#c9982e;color:#e8b84b;}
.btn-blue{background:rgba(91,156,245,0.10);border-color:rgba(91,156,245,0.25);color:#5b9cf5;}
.btn-danger{background:transparent;border-color:rgba(240,96,96,0.28);color:#f06060;}
.btn-sm{padding:7px 14px;font-size:12px;}
.btn-xs{padding:5px 12px;font-size:11px;}
.row{margin:0 -6px;}.row:after{content:'';display:block;clear:both;}
.col2{float:left;width:50%;padding:0 6px;margin-bottom:12px;}
.col3{float:left;width:33.333%;padding:0 6px;margin-bottom:12px;}
.col4{float:left;width:25%;padding:0 6px;margin-bottom:12px;}
.col-full{float:left;width:100%;padding:0 6px;margin-bottom:12px;}
.tag{display:inline-block;font-size:12px;font-weight:600;padding:4px 12px;border-radius:4px;background:#262a3a;border:1px solid #363b52;color:#a0a6bc;cursor:pointer;margin:0 4px 4px 0;}
.tag:hover,.tag.active{border-color:rgba(232,184,75,0.28);color:#e8b84b;background:rgba(232,184,75,0.10);}
#toast{position:absolute;bottom:28px;right:28px;z-index:9999;}
.toast-msg{background:#262a3a;border:1px solid rgba(232,184,75,0.28);color:#e8b84b;font-size:14px;font-weight:600;padding:14px 22px;border-radius:10px;box-shadow:0 8px 30px rgba(0,0,0,.4);margin-top:10px;}
.toast-msg.ok{border-color:rgba(78,202,122,0.28);color:#4eca7a;}
.toast-msg.cy{border-color:rgba(91,156,245,0.25);color:#5b9cf5;}
.toast-msg.err{border-color:rgba(240,96,96,0.28);color:#f06060;}
.sec-lbl{font-size:13px;font-weight:700;letter-spacing:2.5px;color:#6b7190;text-transform:uppercase;margin-bottom:12px;padding-bottom:8px;border-bottom:1px solid #2a2e40;}
.empty{text-align:center;padding:48px 20px;color:#6b7190;font-size:14px;letter-spacing:1px;}
.empty-icon{font-size:40px;opacity:.25;margin-bottom:12px;}
.search-row{padding:10px 16px;border-bottom:1px solid #2a2e40;background:#181b23;}
.search-row input{background:transparent;border:none;padding:4px 0;font-size:15px;color:#eaecf4;width:calc(100% - 30px);display:inline;vertical-align:middle;outline:none;}
.list-item{padding:14px 18px;border-bottom:1px solid #2a2e40;cursor:pointer;}
.list-item:hover{background:#2e3348;}
.list-item.sel{background:rgba(232,184,75,0.10);border-left:3px solid #e8b84b;}
.list-title{font-size:15px;margin-bottom:4px;}
.list-meta{font-size:13px;color:#6b7190;}
.stat-card{background:#262a3a;border:1px solid #2a2e40;border-radius:10px;padding:20px;position:relative;overflow:hidden;}
.stat-card:before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:#e8b84b;border-radius:10px 10px 0 0;}
.stat-card.blue:before{background:#5b9cf5;}
.stat-card.green:before{background:#4eca7a;}
.stat-card.red:before{background:#f06060;}
.stat-lbl{font-size:12px;font-weight:700;letter-spacing:2px;color:#6b7190;text-transform:uppercase;margin-bottom:10px;}
.stat-val{font-size:42px;font-weight:800;line-height:1;color:#eaecf4;}
.stat-sub{font-size:13px;color:#a0a6bc;margin-top:8px;}
.split-tbl{width:100%;height:100%;border-collapse:collapse;}
.split-tbl td{vertical-align:top;padding:0;}
.split-left{border-right:1px solid #2a2e40;overflow-y:auto;}
.split-right{overflow-y:auto;}
.tpl-bar{padding:6px 12px;border-bottom:1px solid #2a2e40;background:#181b23;white-space:nowrap;overflow-x:auto;}
.tpl-btn{display:inline-block;padding:5px 10px;border:1px solid #363b52;border-radius:5px;background:#1f2230;color:#a0a6bc;font-size:12px;font-weight:600;cursor:pointer;margin:2px 3px;font-family:'Segoe UI','Meiryo',sans-serif;white-space:nowrap;}
.tpl-btn:hover{border-color:rgba(232,184,75,0.28);color:#e8b84b;background:rgba(232,184,75,0.10);}
.tpl-sep{display:inline-block;width:1px;height:20px;background:#2a2e40;margin:0 4px;vertical-align:middle;}

/* === EDITOR with syntax highlight === */
#editor-area{width:100%;height:100%;background:#12141a;color:#eaecf4;font-family:'Consolas','MS Gothic','Meiryo',monospace;font-size:16px;line-height:1.9;padding:24px 28px;overflow-y:auto;outline:none;white-space:pre-wrap;word-wrap:break-word;}
#editor-area .ed-tag{color:#e8b84b;font-weight:700;}
#editor-area .ed-field{color:#5b9cf5;font-weight:700;}
#editor-area .ed-table{color:#4eca7a;}
#editor-area .ed-star{color:#e8b84b;font-weight:700;background:rgba(232,184,75,0.08);}
.autosave-ind{display:inline-block;font-size:11px;color:#4eca7a;margin-left:10px;opacity:0;transition:opacity 0.3s;}
.autosave-ind.show{opacity:1;}

/* エディタ内動的テーブルのスタイル */
.editor-inline-table {
  width: 100%;
  border-collapse: collapse;
  margin: 10px 0;
  background: #1a1d28;
}
.editor-inline-table td {
  border: 1px solid #363b52;
  padding: 8px 12px;
  color: #c0c6d6;
  vertical-align: top;
}
.editor-inline-table td:focus {
  outline: 2px solid rgba(232,184,75,0.40);
  background: #262a3a;
}

/* === STRUCTURED VIEW === */
.sv-kv-table{width:100%;border-collapse:collapse;margin-bottom:12px;}
.sv-kv-table td{padding:10px 14px;border:1px solid #2a2e40;font-size:14px;vertical-align:top;}
.sv-kv-table td:first-child{width:130px;font-weight:700;color:#e8b84b;background:#1a1d28;white-space:nowrap;}
.sv-kv-table td:last-child{background:#1f2230;color:#c0c6d6;}
.sv-kv-table td.sv-editable:focus{outline:2px solid rgba(232,184,75,0.40);background:#262a3a;}
.sv-data-table{width:100%;border-collapse:collapse;margin-bottom:12px;}
.sv-data-table th{padding:8px 12px;border:1px solid #2a2e40;background:#1a1d28;font-size:12px;font-weight:700;color:#e8b84b;letter-spacing:1px;text-align:left;}
.sv-data-table td{padding:8px 12px;border:1px solid #2a2e40;background:#1f2230;font-size:14px;color:#c0c6d6;}
.sv-data-table td.sv-editable:focus{outline:2px solid rgba(232,184,75,0.40);background:#262a3a;}
.sv-section-label{font-size:13px;font-weight:700;color:#e8b84b;letter-spacing:2px;margin:16px 0 8px;padding-bottom:6px;border-bottom:1px solid #2a2e40;text-transform:uppercase;}
.sv-freetext{font-size:14px;line-height:1.7;color:#a0a6bc;padding:10px 14px;background:#1f2230;border:1px solid #2a2e40;border-radius:6px;margin-bottom:12px;white-space:pre-wrap;}
.sv-star{color:#e8b84b;font-weight:700;padding:4px 8px;background:rgba(232,184,75,0.06);border-left:3px solid #e8b84b;margin:4px 0;}
.sv-media{max-width:100%;border-radius:6px;margin:8px 0;border:1px solid #2a2e40;}
.pj-card{background:#262a3a;border:1px solid #2a2e40;border-radius:6px;padding:14px 16px;cursor:pointer;margin-bottom:8px;}
.pj-card:hover{border-color:#363b52;}
.pj-s{border-left:3px solid #f06060;}.pj-a{border-left:3px solid #e8b84b;}.pj-b{border-left:3px solid #5b9cf5;}
.pj-name{font-size:15px;font-weight:600;margin-bottom:4px;}
.pj-meta{font-size:13px;color:#6b7190;}
.pj-bar{height:3px;background:#2a2e40;border-radius:2px;margin-top:8px;}
.pj-fill{height:100%;background:#e8b84b;border-radius:2px;}
.inbox-item{padding:14px 18px;border-bottom:1px solid #2a2e40;cursor:pointer;}
.inbox-item:hover{background:#2e3348;}
.inbox-title{display:inline;font-size:14px;line-height:1.4;}
.inbox-meta{font-size:13px;color:#6b7190;}
.drop-zone{border:2px dashed #363b52;border-radius:10px;padding:32px 20px;text-align:center;cursor:pointer;background:#161820;margin-bottom:14px;}
.drop-zone.over{border-color:#e8b84b;background:rgba(232,184,75,0.10);}
.filepath-box{background:#161820;border:1px solid #363b52;border-radius:6px;padding:12px 14px;font-family:'Consolas','MS Gothic',monospace;font-size:13px;color:#a0a6bc;word-break:break-all;}
.modal-overlay{position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,.7);z-index:500;display:none;overflow-y:auto;}
.modal-overlay.open{display:block;}
.modal{background:#1f2230;border:1px solid #363b52;border-radius:10px;width:680px;max-width:95%;margin:40px auto;box-shadow:0 8px 60px rgba(0,0,0,.6);position:relative;}
.modal-hdr{padding:16px 24px;border-bottom:1px solid #2a2e40;}.modal-hdr:after{content:'';display:block;clear:both;}
.modal-title{float:left;font-size:15px;font-weight:700;letter-spacing:2px;color:#e8b84b;text-transform:uppercase;}
.modal-x{float:right;background:none;border:none;color:#6b7190;cursor:pointer;font-size:20px;padding:4px 8px;}.modal-x:hover{color:#eaecf4;}
.modal-body{padding:24px;overflow:visible;}
.modal-foot{padding:16px 24px;border-top:1px solid #2a2e40;text-align:right;}.modal-foot .btn{margin-left:10px;}
.progress-entry{padding:10px 14px;border-left:2px solid #363b52;margin:6px 0 6px 8px;font-size:13px;color:#a0a6bc;}
.progress-entry .pe-date{font-family:Consolas,monospace;font-size:12px;color:#6b7190;margin-bottom:4px;}
.setting-section{background:#1f2230;border:1px solid #2a2e40;border-radius:10px;padding:20px;margin-bottom:16px;}
.setting-title{font-size:14px;font-weight:700;color:#e8b84b;letter-spacing:1px;margin-bottom:12px;text-transform:uppercase;}
.setting-row{padding:8px 0;border-bottom:1px solid #2a2e40;font-size:14px;color:#a0a6bc;}.setting-row:last-child{border-bottom:none;}
.setting-label{display:inline-block;width:180px;color:#6b7190;font-weight:600;}
.sr-item{background:#262a3a;border:1px solid #2a2e40;border-radius:6px;padding:14px;margin-bottom:8px;}
.sr-source{font-family:'Consolas','MS Gothic',monospace;font-size:11px;color:#e8b84b;letter-spacing:1px;margin-bottom:6px;}
.sr-body{font-size:14px;line-height:1.6;color:#a0a6bc;}
.task-status{display:inline-block;font-size:11px;font-weight:700;padding:3px 10px;border-radius:4px;}
.ts-open{background:rgba(240,96,96,0.10);color:#f06060;border:1px solid rgba(240,96,96,0.28);}
.ts-progress{background:rgba(232,184,75,0.10);color:#e8b84b;border:1px solid rgba(232,184,75,0.28);}
.ts-done{background:rgba(78,202,122,0.10);color:#4eca7a;border:1px solid rgba(78,202,122,0.28);}
</style>
</head>
<body>
<table id="layout-table">
<tr id="ribbon-row"><td colspan="3"><div id="ribbon"><table style="width:100%;height:100%;border-collapse:collapse"><tr>
<td style="width:auto"><span class="ribbon-brand">COCKPIT</span><span class="ribbon-sep"></span>
<button class="ribbon-btn" onclick="go('editor')">&#9997; エディタ</button>
<button class="ribbon-btn" onclick="go('inbox')">&#128229; 情報収集</button>
<button class="ribbon-btn" onclick="go('meetings')">&#128203; 議事録</button>
<span class="ribbon-sep"></span>
<button class="ribbon-btn" onclick="openModal('search-modal')">&#128270; 全文検索</button>
<button class="ribbon-btn" onclick="backupAll()">&#128190; バックアップ</button>
<button class="ribbon-btn" onclick="openDataFolder()">&#128194; フォルダ</button></td>
<td style="width:1px;white-space:nowrap;text-align:right">
<span class="ribbon-stat"><span class="ribbon-dot"></span><span id="hd-records">0 REC</span></span>
<span class="ribbon-stat"><span class="ribbon-dot warn"></span><span id="hd-tasks">0 TASKS</span></span>
<span id="clock">--:--:--</span></td>
</tr></table></div></td></tr>
<tr id="content-row">
<td id="sidebar-cell"><div id="sidebar">
<button id="sidebar-toggle" onclick="toggleSidebar()">&#9664;</button>
<div class="nav-group-label">入力</div>
<button class="nav-btn active" id="nav-editor" onclick="go('editor')"><span class="nav-icon">&#9997;</span><span class="nav-label">エディタ</span></button>
<button class="nav-btn" id="nav-inbox" onclick="go('inbox')"><span class="nav-icon">&#128229;</span><span class="nav-label">情報収集</span></button>
<div class="nav-sep"></div>
<div class="nav-group-label">管理</div>
<button class="nav-btn" id="nav-meetings" onclick="go('meetings')"><span class="nav-icon">&#128203;</span><span class="nav-label">議事録</span></button>
<button class="nav-btn" id="nav-tasks" onclick="go('tasks')"><span class="nav-icon">&#9672;</span><span class="nav-label">タスク管理</span></button>
<button class="nav-btn" id="nav-delegate" onclick="go('delegate')"><span class="nav-icon">&#128228;</span><span class="nav-label">ディレクション</span></button>
<button class="nav-btn" id="nav-projects" onclick="go('projects')"><span class="nav-icon">&#9673;</span><span class="nav-label">案件ボード</span></button>
<button class="nav-btn" id="nav-clients" onclick="go('clients')"><span class="nav-icon">&#128100;</span><span class="nav-label">顧客カルテ</span></button>
<div class="nav-sep"></div>
<div class="nav-group-label">参照</div>
<button class="nav-btn" id="nav-knowledge" onclick="go('knowledge')"><span class="nav-icon">&#128214;</span><span class="nav-label">ナレッジ</span></button>
<button class="nav-btn" id="nav-home" onclick="go('home')"><span class="nav-icon">&#8862;</span><span class="nav-label">ダッシュボード</span></button>
<button class="nav-btn" id="nav-settings" onclick="go('settings')"><span class="nav-icon">&#9881;</span><span class="nav-label">設定</span></button>
</div></td>
<td id="tree-cell" class="hidden"><div id="folder-tree"><div class="tree-hdr">DATA TREE <button onclick="toggleTree()">&#10005;</button><button onclick="refreshTree()" style="margin-right:4px">&#8635;</button></div><div id="tree-items"></div></div></td>
<td id="main-cell"><div id="main">

<!-- HOME -->
<div class="screen" id="screen-home">
<div class="sec-lbl">DASHBOARD <span style="float:right"><button class="btn btn-primary btn-sm" onclick="go('editor')">&#9997; エディタを開く</button></span></div>
<div class="row">
<div class="col4"><div class="stat-card"><div class="stat-lbl">RECORDS</div><div class="stat-val" id="st-records">0</div><div class="stat-sub" id="st-records2"></div></div></div>
<div class="col4"><div class="stat-card blue"><div class="stat-lbl">OPEN TASKS</div><div class="stat-val" id="st-tasks">0</div><div class="stat-sub" id="st-tasks2"></div></div></div>
<div class="col4"><div class="stat-card green"><div class="stat-lbl">MEETINGS</div><div class="stat-val" id="st-mtg">0</div><div class="stat-sub" id="st-mtg2"></div></div></div>
<div class="col4"><div class="stat-card red"><div class="stat-lbl">INBOX</div><div class="stat-val" id="st-inbox">0</div><div class="stat-sub" id="st-inbox2"></div></div></div>
</div>
