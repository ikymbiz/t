// CLIENTS
// ============================================================
function saveCl() { var n = document.getElementById('cl-name').value.replace(/^\s+|\s+$/g,''); if (!n) { toast('顧客名を入力'); return; } appendDB('client_master', {id:genId('C'),datetime:nowISO(),name:n,division:document.getElementById('cl-div').value,key_person:document.getElementById('cl-kp').value,key_title:document.getElementById('cl-title').value,email:document.getElementById('cl-email').value,tel:document.getElementById('cl-tel').value,industry:document.getElementById('cl-industry').value,relation_score:document.getElementById('cl-relation').value,sales_phase:'',revenue_scale:'',pain_summary:document.getElementById('cl-pain').value,memo:document.getElementById('cl-memo').value}); closeModal('cl-modal'); toast('顧客追加','ok'); renderCl(''); document.getElementById('cl-name').value=''; }
function renderCl(filter) { var d = readDB('client_master'); document.getElementById('cl-badge').innerText = d.length; if (filter) d = d.filter(function(c){return c.name.indexOf(filter)>=0||(c.key_person||'').indexOf(filter)>=0;}); var l = document.getElementById('cl-list'); if (!d.length) { l.innerHTML = '<div class="empty"><div class="empty-icon">&#128100;</div>顧客なし</div>'; return; } l.innerHTML = d.map(function(c){return '<div class="list-item" onclick="showCl(\''+c.id+'\')"><div class="list-title">'+esc(c.name)+'</div><div class="list-meta">'+(c.industry||'')+' / '+(c.key_person||'')+'</div></div>';}).join(''); }
function showCl(id) { var d = readDB('client_master'), c = null; for (var i = 0; i < d.length; i++) { if (d[i].id === id) c = d[i]; } if (!c) return; var pjs = readDB('project_master').filter(function(p){return p.client === c.name;}); var mtgs = readDB('records').filter(function(r){return r.type === '議事録' && r.rawText.indexOf(c.name) >= 0;}); document.getElementById('cl-detail').innerHTML = '<div class="sec-lbl">' + esc(c.name) + '</div><table class="sv-kv-table"><tr><td>キーパーソン</td><td>' + esc(c.key_person||'') + ' / ' + esc(c.key_title||'') + '</td></tr><tr><td>業種</td><td>' + esc(c.industry||'') + '</td></tr><tr><td>Email</td><td>' + esc(c.email||'') + '</td></tr><tr><td>TEL</td><td>' + esc(c.tel||'') + '</td></tr><tr><td>関係性</td><td>' + c.relation_score + '</td></tr><tr><td>課題</td><td>' + esc(c.pain_summary||'') + '</td></tr></table><div class="sv-section-label">関連案件 (' + pjs.length + ')</div>' + (pjs.length ? pjs.map(function(p){return '<div class="pj-card"><div class="pj-name">'+esc(p.name)+'</div><div class="pj-meta">'+p.phase+' / '+p.type+'</div></div>';}).join('') : '<div style="color:#6b7190;padding:12px">なし</div>') + '<div class="sv-section-label">関連議事録 (' + mtgs.length + ')</div>' + (mtgs.length ? mtgs.slice(0,5).map(function(m){return '<div class="list-item" onclick="go(\'meetings\');showMtg(\''+m.id+'\')"><div class="list-meta">' + fmtDT(m.datetime) + '</div></div>';}).join('') : '<div style="color:#6b7190;padding:12px">なし</div>'); }

// ============================================================
// INBOX
// ============================================================
var pendingFile = null;
function fetchUrl() { toast('HTML版ではURL取得は制限されます'); }
function dzOver(e) { e.preventDefault(); document.getElementById('drop-zone').className = 'drop-zone over'; }
function dzLeave() { document.getElementById('drop-zone').className = 'drop-zone'; }
function dzDrop(e) { e.preventDefault(); document.getElementById('drop-zone').className = 'drop-zone'; if (e.dataTransfer.files && e.dataTransfer.files.length) handleFiles(e.dataTransfer.files); }
function handleFiles(files) { for (var i = 0; i < files.length; i++) { if (i===0) { document.getElementById('ib-title').value = files[i].name; pendingFile = {name:files[i].name, type:files[i].type}; } } document.getElementById('dropped-files').style.display='block'; document.getElementById('dropped-paths').innerText = files.length + ' ファイル'; }
function saveInbox() { var title = document.getElementById('ib-title').value.replace(/^\s+|\s+$/g,''), url = document.getElementById('ib-url').value.replace(/^\s+|\s+$/g,''); if (!title && !url) { toast('タイトルかURLを入力'); return; } appendDB('intelligence_inbox', {id:genId('II'),datetime:nowISO(),source_type:url?'URL':'file',title:title||url,url:url,url_summary:document.getElementById('ib-summary').value,project:document.getElementById('ib-pj').value,category:document.getElementById('ib-cat').value,tags:document.getElementById('ib-tags').value,memo:document.getElementById('ib-memo').value,status:'未読'}); toast('保存','ok'); var c = ['ib-url','ib-title','ib-summary','ib-pj','ib-tags','ib-memo']; for (var i = 0; i < c.length; i++) document.getElementById(c[i]).value = ''; pendingFile = null; document.getElementById('dropped-files').style.display = 'none'; renderInbox(''); updateHdr(); }
function renderInbox(filter) { var data = readDB('intelligence_inbox').reverse(); document.getElementById('ib-badge').innerText = data.length; if (filter) data = data.filter(function(r){return r.title.indexOf(filter)>=0||(r.tags||'').indexOf(filter)>=0;}); var list = document.getElementById('ib-list'); if (!data.length) { list.innerHTML = '<div class="empty"><div class="empty-icon">&#128229;</div>なし</div>'; return; } list.innerHTML = data.map(function(item){return '<div class="inbox-item"><div><span class="inbox-title">'+esc(item.title.slice(0,55))+'</span></div><div class="inbox-meta">'+item.category+' / '+fmtDT(item.datetime)+'</div></div>';}).join(''); }

// ============================================================
// DASHBOARD
// ============================================================
function renderHome() {
  var recs = readDB('records'), tasks = readDB('task_log'), ib = readDB('intelligence_inbox');
  var mtgs = recs.filter(function(r){return r.type==='議事録';}), open = tasks.filter(function(t){return t.status!=='完了'&&t.status!=='中止';});
  document.getElementById('st-records').innerText = recs.length;
  document.getElementById('st-records2').innerText = '今日: ' + recs.filter(function(r){return r.datetime.indexOf(todayISO())===0;}).length;
  document.getElementById('st-tasks').innerText = open.length;
  document.getElementById('st-tasks2').innerText = '未着手: ' + tasks.filter(function(t){return t.status==='未着手';}).length;
  document.getElementById('st-mtg').innerText = mtgs.length;
  document.getElementById('st-inbox').innerText = ib.length;
  document.getElementById('st-inbox2').innerText = '未読: ' + ib.filter(function(i){return i.status==='未読';}).length;
  var dtE = document.getElementById('dash-tasks');
  dtE.innerHTML = open.length ? open.slice(0,6).map(function(t){return '<div style="padding:10px 18px;border-bottom:1px solid #2a2e40;font-size:14px;cursor:pointer" onclick="go(\'tasks\')">'+esc(t.title)+'<span style="float:right;font-size:13px;color:#6b7190">'+fmtD(t.due)+'</span></div>';}).join('') : '<div class="empty" style="padding:20px"><div class="empty-icon">&#9672;</div>なし</div>';
  var recent = recs.slice().reverse().slice(0,5);
  document.getElementById('dash-records').innerHTML = recent.length ? recent.map(function(r){return '<div style="padding:10px 18px;border-bottom:1px solid #2a2e40;font-size:14px;cursor:pointer" onclick="editRec(\''+r.id+'\')"><span style="font-size:10px;padding:2px 6px;border-radius:3px;background:rgba(232,184,75,0.10);color:#e8b84b;margin-right:6px">#'+esc(r.type)+'</span>'+esc(r.rawText.slice(0,50))+'</div>';}).join('') : '<div class="empty" style="padding:20px">なし</div>';
  var pjs = readDB('project_master').filter(function(p){return p.status!=='完了';});
  document.getElementById('dash-projects').innerHTML = pjs.length ? pjs.slice(0,6).map(function(p){return '<div style="padding:10px 18px;border-bottom:1px solid #2a2e40;font-size:14px;cursor:pointer" onclick="go(\'projects\')"><b>'+esc(p.name)+'</b><span style="float:right;font-size:13px;color:#6b7190">'+p.phase+'</span></div>';}).join('') : '<div class="empty" style="padding:20px">なし</div>';
  updateHdr();
}
function updateHdr() { document.getElementById('hd-records').innerText = readDB('records').length + ' REC'; document.getElementById('hd-tasks').innerText = readDB('task_log').filter(function(t){return t.status!=='完了'&&t.status!=='中止';}).length + ' TASKS'; }

// ============================================================
// SEARCH
// ============================================================
function gSearch() { var q = document.getElementById('gs-q').value.replace(/^\s+|\s+$/g,''); if (!q) return; var results = []; readDB('records').forEach(function(r){if ((r.rawText||'').indexOf(q)>=0) results.push({src:'#'+(r.type||'memo'),text:r.rawText.slice(0,200),dt:r.datetime});}); readDB('intelligence_inbox').forEach(function(ib){if ((ib.title||'').indexOf(q)>=0) results.push({src:'Inbox',text:ib.title,dt:ib.datetime});}); var el = document.getElementById('gs-results'); if (!results.length) { el.innerHTML = '<div class="empty" style="padding:24px">見つかりません</div>'; return; } el.innerHTML = '<div style="font-size:13px;color:#6b7190;margin-bottom:10px">' + results.length + ' 件</div>' + results.map(function(r){return '<div class="sr-item"><div class="sr-source">'+r.src+' / '+fmtDT(r.dt)+'</div><div class="sr-body">'+esc(r.text)+'</div></div>';}).join(''); }

// ============================================================
// SETTINGS
// ============================================================
function renderSettings() { var tables = ['records','task_log','intelligence_inbox','project_master','client_master']; var h = ''; for (var i = 0; i < tables.length; i++) h += '<div class="setting-row"><span class="setting-label">'+tables[i]+'</span> '+readDB(tables[i]).length+' 件</div>'; document.getElementById('set-stats').innerHTML = h; }
function exportAll() { var tables = ['records','task_log','intelligence_inbox','project_master','client_master']; var data = {}; for (var i = 0; i < tables.length; i++) data[tables[i]] = readDB(tables[i]); clipCopy(JSON.stringify(data,null,2)); toast('全データJSONコピー','ok'); }

// ============================================================
// NAV
// ============================================================
function go(name) {
  var s = document.querySelectorAll('.screen'); for (var i = 0; i < s.length; i++) s[i].className = 'screen';
  var n = document.querySelectorAll('.nav-btn'); for (var j = 0; j < n.length; j++) n[j].className = n[j].className.replace(' active','');
  var sc = document.getElementById('screen-' + name); if (sc) sc.className = 'screen active';
  var nb = document.getElementById('nav-' + name); if (nb) nb.className += ' active';
  if (name==='home') renderHome();
  if (name==='editor') syncToView();
  if (name==='inbox') renderInbox('');
  if (name==='meetings') renderMtgList('');
  if (name==='tasks') renderTkList();
  if (name==='delegate') renderDlList();
  if (name==='projects') renderPj();
  if (name==='clients') renderCl('');
  if (name==='knowledge') renderKbList('');
  if (name==='settings') renderSettings();
}
function toast(msg,type) { var t = document.getElementById('toast'), el = document.createElement('div'); el.className = 'toast-msg' + (type?' '+type:''); el.innerText = msg; t.appendChild(el); setTimeout(function(){if(el.parentNode)el.parentNode.removeChild(el);},2900); }
function openModal(id) { document.getElementById(id).className = 'modal-overlay open'; }
function closeModal(id) { document.getElementById(id).className = 'modal-overlay'; }
function toggleSidebar() { var c = document.getElementById('sidebar-cell'), b = document.getElementById('sidebar-toggle'); if (c.className.indexOf('collapsed')>=0) { c.className = ''; b.innerText = '\u25C0'; } else { c.className = 'collapsed'; b.innerText = '\u25B6'; } }
function toggleTree() { var c = document.getElementById('tree-cell'); c.className = c.className.indexOf('hidden')>=0?'':'hidden'; }
function refreshTree() { document.getElementById('tree-items').innerHTML = '<div style="padding:12px;font-size:13px;color:#6b7190">localStorage使用中</div>'; }

// ============================================================
// KEYBOARD SHORTCUTS
// ============================================================
document.onkeydown = function(e) {
  if ((e.ctrlKey||e.metaKey) && e.keyCode === 13) {
    var sc = document.querySelector('.screen.active');
    if (sc && sc.id === 'screen-editor') { e.preventDefault(); saveRecord(); }
  }
  if (e.keyCode === 27) { var m = document.querySelectorAll('.modal-overlay.open'); for (var i = 0; i < m.length; i++) m[i].className = 'modal-overlay'; }
};

// ============================================================
// INIT
// ============================================================
function init() {
  updateHdr();
  setTimeout(function() { toast('COCKPIT v9.0 起動 | 5秒ごとに自動保存'); document.getElementById('editor-area').focus(); }, 500);
}
window.onload = init;
</script>
</body>
</html>
