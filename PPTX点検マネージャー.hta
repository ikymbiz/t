<HTA:APPLICATION
  ID="PPTXChecker"
  APPLICATIONNAME="PPTX形式点検マネージャー"
  SCROLL="yes"
  SINGLEINSTANCE="yes"
  WINDOWSTATE="maximize"
  BORDER="normal"
  CAPTION="yes"
/>
<html>
<head>
<meta http-equiv="X-UA-Compatible" content="IE=9">
<meta charset="UTF-8">
<title>PPTX 形式点検マネージャー</title>
<style>
* { box-sizing: border-box; margin: 0; padding: 0; }
body { font-family: "Meiryo","MS Gothic",sans-serif; background: #eef2f7; font-size: 13px; color: #1a1a2e; padding-bottom: 40px; }

/* ヘッダー */
#hdr { background: #1a1a2e; color: #fff; padding: 0 20px; }
#hdr h1 { font-size: 16px; font-weight: bold; padding: 14px 0 0; letter-spacing: 1px; }
#hdr .sub { font-size: 10px; color: #8899bb; padding: 2px 0 10px; }

/* タブ */
#tabs { background: #1a1a2e; padding: 0 20px; }
.tab { display: inline-block; padding: 9px 16px; font-size: 12px; font-weight: bold;
       cursor: pointer; color: #8899bb; border-top: 3px solid transparent;
       border-left: 1px solid transparent; border-right: 1px solid transparent;
       background: transparent; margin-right: 2px; }
.tab.on { background: #eef2f7; color: #1a1a2e; border-top: 3px solid #4f86f7;
           border-left: 1px solid #cdd; border-right: 1px solid #cdd; }
.tab:hover { color: #fff; }

/* ツールバー */
#toolbar { background: #fff; border-bottom: 2px solid #dde4f0; padding: 8px 20px; }
.btn { display: inline-block; padding: 6px 14px; font-size: 12px; font-weight: bold;
       border: none; cursor: pointer; border-radius: 4px; margin-right: 6px; font-family: inherit; }
.btn-blue  { background: #4f86f7; color: #fff; }
.btn-green { background: #27ae60; color: #fff; }
.btn-gray  { background: #e8edf5; color: #333; border: 1px solid #bcc; }
.btn-red   { background: #e74c3c; color: #fff; }
.btn-orange{ background: #e67e22; color: #fff; }
.sep { display: inline-block; width: 1px; height: 22px; background: #dde; margin: 0 8px; vertical-align: middle; }
#fileLabel { font-size: 11px; color: #888; vertical-align: middle; }

/* メイン */
#main { padding: 18px 20px; }
.panel { display: none; }
.panel.on { display: block; }

/* カード */
.card { background: #fff; border: 1px solid #dde4f0; border-radius: 6px; margin-bottom: 14px; }
.card-hdr { background: #f4f7fd; border-bottom: 1px solid #dde4f0; padding: 10px 14px;
             font-weight: bold; font-size: 13px; border-radius: 6px 6px 0 0; cursor: pointer; }
.card-hdr:hover { background: #e8eef8; }
.card-body { padding: 14px; }

/* テーブル */
table { width: 100%; border-collapse: collapse; }
th { background: #2c3e6b; color: #fff; padding: 8px 10px; font-size: 12px; text-align: left; }
td { padding: 7px 10px; border-bottom: 1px solid #eef; vertical-align: middle; }
tr:last-child td { border-bottom: none; }
tr:hover td { background: #f8faff; }

/* フォーム */
input[type=text], select, textarea {
  border: 1px solid #c0cce0; border-radius: 4px; padding: 5px 8px;
  font-size: 12px; font-family: inherit; width: 100%;
}
input[type=text]:focus, select:focus, textarea:focus { border-color: #4f86f7; outline: none; }
textarea { resize: vertical; }

/* ボタン小 */
.del { background: #fde; color: #c00; border: 1px solid #fbb; border-radius: 4px; padding: 2px 8px; cursor: pointer; font-size: 11px; }
.add { background: #4f86f7; color: #fff; border: none; border-radius: 4px; padding: 5px 14px; cursor: pointer; font-size: 12px; font-family: inherit; }

/* 点検 */
.chk-item { padding: 10px 0; border-bottom: 1px solid #f0f2f8; }
.chk-item:last-child { border-bottom: none; }
.chk-no { font-size: 11px; color: #aaa; font-weight: bold; display: inline-block; width: 36px; }
.chk-txt { font-size: 13px; }
.sbtn { display: inline-block; padding: 3px 10px; border-radius: 12px; font-size: 11px; font-weight: bold;
         cursor: pointer; margin: 4px 4px 0 0; border: 2px solid; font-family: inherit; }
.sbtn-ok   { border-color: #27ae60; color: #27ae60; background: #fff; }
.sbtn-warn { border-color: #e67e22; color: #e67e22; background: #fff; }
.sbtn-ng   { border-color: #e74c3c; color: #e74c3c; background: #fff; }
.sbtn-ok.on   { background: #27ae60; color: #fff; }
.sbtn-warn.on { background: #e67e22; color: #fff; }
.sbtn-ng.on   { background: #e74c3c; color: #fff; }

/* 原文修正案 */
.diff-box { display: none; margin-top: 8px; background: #f8faff; border: 1px solid #dde4f0; border-radius: 4px; padding: 10px; }
.diff-box.on { display: block; }
.diff-lbl { font-size: 10px; font-weight: bold; padding: 2px 6px; border-radius: 3px; display: inline-block; margin-bottom: 3px; }
.lbl-b { background: #fde; color: #c00; }
.lbl-a { background: #dfd; color: #060; }
.lbl-l { background: #def; color: #006; }

/* サマリー */
.sum-box { display: inline-block; width: 100px; text-align: center; padding: 10px; border-radius: 6px; margin-right: 10px; margin-bottom: 10px; vertical-align: top; }
.sum-num { font-size: 28px; font-weight: bold; }
.sum-lbl { font-size: 11px; margin-top: 2px; }
.s-ok   { background: #dff0e8; color: #27ae60; }
.s-warn { background: #fef6e4; color: #e67e22; }
.s-ng   { background: #fdecea; color: #e74c3c; }
.s-none { background: #eef0f5; color: #888; }

/* ステータスバー */
#statusbar { position: fixed; bottom: 0; left: 0; right: 0; background: #1a1a2e; color: #8899bb; font-size: 11px; padding: 5px 18px; }

/* カテゴリバッジ */
.cat-badge { display: inline-block; background: #e8eef8; color: #2c3e6b; font-size: 11px; font-weight: bold; padding: 2px 8px; border-radius: 3px; margin-bottom: 8px; }

/* アコーディオン矢印 */
.arr { font-size: 11px; margin-right: 6px; }

/* ガイドボックス */
.guide { background: #f0f5ff; border: 1px solid #c0d0f0; border-radius: 6px; padding: 12px 14px; margin-bottom: 14px; }
.guide-step { display: inline-block; background: #4f86f7; color: #fff; border-radius: 50%; width: 22px; height: 22px; text-align: center; line-height: 22px; font-weight: bold; font-size: 12px; margin-right: 6px; }

/* プロンプト出力 */
#promptOut { width: 100%; font-size: 12px; font-family: "Courier New",monospace; line-height: 1.6;
              border: 1px solid #c0cce0; border-radius: 4px; padding: 12px; background: #f8faff;
              resize: vertical; }
</style>
</head>
<body>

<div id="hdr">
  <div class="sub">戦略コンサルタント向け</div>
  <h1>&#128203; PPTX 形式点検マネージャー</h1>
</div>
<div id="tabs">
  <span class="tab on"  onclick="sw(0)">A-1 表記揺れ</span>
  <span class="tab"     onclick="sw(1)">A-2 禁止キーワード</span>
  <span class="tab"     onclick="sw(2)">A-3 禁止オブジェクト</span>
  <span class="tab"     onclick="sw(3)">&#10003; 点検リスト</span>
  <span class="tab"     onclick="sw(4)">&#128202; レポート</span>
  <span class="tab"     onclick="sw(5)">&#129302; AIプロンプト生成</span>
</div>

<div id="toolbar">
  <input type="button" class="btn btn-blue"   value="&#128190; 保存"       onclick="doSave()">
  <input type="button" class="btn btn-gray"   value="&#128194; 読込"       onclick="doLoad()">
  <span class="sep"></span>
  <input type="button" class="btn btn-green"  value="&#128196; レポート出力" onclick="doExport()">
  <input type="button" class="btn btn-orange" value="&#128260; リセット"    onclick="doReset()">
  <span class="sep"></span>
  <span id="fileLabel">（未保存）</span>
</div>

<div id="main">

<!-- ===== TAB 0: A-1 表記揺れ ===== -->
<div class="panel on" id="p0">
  <div class="card">
    <div class="card-hdr">&#128260; A-1 &nbsp;表記揺れ注意ワードリスト</div>
    <div class="card-body">
      <p style="font-size:11px;color:#666;margin-bottom:10px">同じ意味だが複数の表現が混在しやすいワードを登録してください。AIプロンプトに自動反映されます。</p>
      <table>
        <thead><tr><th style="width:35%">正式表記（統一後）</th><th>使用禁止の表記（/ 区切りで複数可）</th><th style="width:44px"></th></tr></thead>
        <tbody id="tbW"></tbody>
      </table>
      <div style="margin-top:10px">
        <table><tr>
          <td style="width:35%;padding:0 6px 0 0"><input type="text" id="nWC" placeholder="例）顧客"></td>
          <td style="padding:0 6px 0 0"><input type="text" id="nWW" placeholder="例）お客様 / クライアント / Client"></td>
          <td style="width:60px;padding:0"><input type="button" class="add" value="+ 追加" onclick="addW()"></td>
        </tr></table>
      </div>
    </div>
  </div>
</div>

<!-- ===== TAB 1: A-2 禁止キーワード ===== -->
<div class="panel" id="p1">
  <div id="bannedWrap"></div>
  <div class="card">
    <div class="card-body">
      <table><tr>
        <td style="width:200px;padding:0 6px 0 0">
          <select id="nBCat">
            <option>社外秘・機密</option>
            <option>不適切・品位を損なう表現</option>
            <option>過度な断言表現</option>
            <option>作業中痕跡</option>
          </select>
        </td>
        <td style="padding:0 6px 0 0"><input type="text" id="nBKw" placeholder="追加するキーワード・表現"></td>
        <td style="width:60px;padding:0"><input type="button" class="add" value="+ 追加" onclick="addB()"></td>
      </tr></table>
    </div>
  </div>
</div>

<!-- ===== TAB 2: A-3 禁止オブジェクト ===== -->
<div class="panel" id="p2">
  <div id="objWrap"></div>
  <div class="card">
    <div class="card-body">
      <table><tr>
        <td style="width:200px;padding:0 6px 0 0">
          <select id="nOCat"><option>禁止オブジェクト</option><option>禁止デザイン</option></select>
        </td>
        <td style="padding:0 6px 0 0"><input type="text" id="nOItem" placeholder="追加する要素"></td>
        <td style="width:60px;padding:0"><input type="button" class="add" value="+ 追加" onclick="addO()"></td>
      </tr></table>
    </div>
  </div>
</div>

<!-- ===== TAB 3: 点検リスト ===== -->
<div class="panel" id="p3">
  <div id="sumBar" style="margin-bottom:14px"></div>
  <div id="chkWrap"></div>
</div>

<!-- ===== TAB 4: レポート ===== -->
<div class="panel" id="p4">
  <div id="repWrap"></div>
</div>

<!-- ===== TAB 5: AIプロンプト生成 ===== -->
<div class="panel" id="p5">
  <div class="guide">
    <b>&#128204; 使い方</b><br><br>
    <span class="guide-step">1</span> A-1〜A-3タブでリストを登録<br>
    <span class="guide-step" style="margin-top:6px;display:inline-block">2</span> 下の「プロンプト生成」ボタンを押す<br>
    <span class="guide-step" style="margin-top:6px;display:inline-block">3</span> 「コピー」してClaudeに貼り付け＋PPTXを添付して送信
  </div>

  <div class="card" style="margin-bottom:12px">
    <div class="card-hdr" style="cursor:default">&#9881; 生成オプション</div>
    <div class="card-body">
      <b style="font-size:12px">モード：</b><br>
      <label style="display:inline-block;margin:6px 16px 0 0"><input type="radio" name="mode" value="full" checked> 全項目点検（完全版）</label>
      <label style="display:inline-block;margin:6px 16px 0 0"><input type="radio" name="mode" value="fmt"> 表記・書式のみ</label>
      <label style="display:inline-block;margin:6px 16px 0 0"><input type="radio" name="mode" value="cnt"> コンテンツ品質のみ</label>
      <label style="display:inline-block;margin:6px 0 0 0">  <input type="radio" name="mode" value="ng"> NG・要確認の再点検</label>
      <br><br>
      <b style="font-size:12px">対象スライド：</b>
      <input type="text" id="scope" placeholder="例）全スライド　または　スライド3〜15のみ" style="width:360px;margin-left:8px">
    </div>
  </div>

  <input type="button" class="btn btn-blue" value="&#9889; プロンプト生成" onclick="genPrompt()" style="font-size:13px;padding:8px 20px">
  <input type="button" class="btn btn-green" id="cpBtn" value="&#128203; コピー" onclick="cpPrompt()" style="display:none;font-size:13px;padding:8px 20px">
  <span id="cpMsg" style="font-size:12px;color:#27ae60;font-weight:bold;display:none">&#10003; コピーしました！</span>

  <div class="card" id="promptCard" style="display:none;margin-top:12px">
    <div class="card-hdr" style="cursor:default">生成されたプロンプト <span id="charCnt" style="font-size:11px;color:#888;font-weight:normal"></span></div>
    <div class="card-body" style="padding:0">
      <textarea id="promptOut" rows="30"></textarea>
    </div>
  </div>
</div>

</div><!-- /main -->

<div id="statusbar"><span id="stMsg">準備完了</span></div>

<!-- VBScript: ファイルI/O -->
<script language="VBScript">
Dim gSavePath

Sub doSave()
  Dim fso, f, p, d
  Set fso = CreateObject("Scripting.FileSystemObject")
  If gSavePath = "" Then
    p = InputBox("保存先ファイルパスを入力（例: C:\Users\user\PPTX点検.json）", "保存先", "")
  Else
    p = InputBox("保存先ファイルパスを入力", "保存先", gSavePath)
  End If
  If p = "" Then Exit Sub
  If Right(p,5) <> ".json" Then p = p & ".json"
  d = getJSON()
  Set f = fso.OpenTextFile(p, 2, True, -1)
  f.Write d
  f.Close
  gSavePath = p
  document.getElementById("fileLabel").innerText = p
  setSt "保存しました: " & p
End Sub

Sub doLoad()
  Dim fso, f, p, d
  Set fso = CreateObject("Scripting.FileSystemObject")
  p = InputBox("読み込むファイルパスを入力", "読み込み", "")
  If p = "" Then Exit Sub
  If Not fso.FileExists(p) Then
    MsgBox "ファイルが見つかりません: " & p, 16, "エラー"
    Exit Sub
  End If
  Set f = fso.OpenTextFile(p, 1, False, -1)
  d = f.ReadAll
  f.Close
  setJSON(d)
  gSavePath = p
  document.getElementById("fileLabel").innerText = p
  setSt "読み込みました: " & p
End Sub

Sub doExport()
  Dim fso, f, p, h
  Set fso = CreateObject("Scripting.FileSystemObject")
  p = InputBox("レポートの保存先を入力（例: C:\Users\user\点検レポート.html）", "レポート出力", "")
  If p = "" Then Exit Sub
  If InStr(p, ".htm") = 0 Then p = p & ".html"
  h = getReportHTML()
  Set f = fso.OpenTextFile(p, 2, True, -1)
  f.Write h
  f.Close
  setSt "レポートを出力しました: " & p
  If MsgBox("ブラウザで開きますか？", 4, "確認") = 6 Then
    CreateObject("WScript.Shell").Run p
  End If
End Sub

Sub setSt(msg)
  document.getElementById("stMsg").innerText = msg
End Sub
</script>

<!-- JavaScript: アプリロジック -->
<script language="JavaScript">

/* ===== データ ===== */
var D = {
  wording: [
    {id:1, c:"顧客",   w:"お客様 / クライアント / Client"},
    {id:2, c:"売上高", w:"売上 / Revenue / 売上金額"},
    {id:3, c:"DX",    w:"D.X. / デジタルトランスフォーメーション"}
  ],
  banned: [
    {id:1, cat:"社外秘・機密",   kw:"プロジェクトコードネーム"},
    {id:2, cat:"作業中痕跡",     kw:"TBD / TODO / 要確認 / ○○を入れる"},
    {id:3, cat:"作業中痕跡",     kw:"Lorem ipsum / サンプル / ダミー"},
    {id:4, cat:"過度な断言表現", kw:"必ず〜できる / 絶対に〜 / 簡単に"}
  ],
  objects: [
    {id:1, cat:"禁止オブジェクト", item:"アニメーション・スライドトランジション"},
    {id:2, cat:"禁止オブジェクト", item:"承認されていないロゴ・商標"},
    {id:3, cat:"禁止デザイン",     item:"影・グラデーション・3D効果"},
    {id:4, cat:"禁止デザイン",     item:"WordArt・テキスト装飾エフェクト"}
  ],
  st:{}, bef:{}, aft:{}, loc:{}
};

var CL = [
  {id:1, t:"顧客名・部署名の正確性", items:[
    "顧客の会社名が全スライドで正式名称と一致している（略称・旧社名の混在がない）",
    "法人格表記（株式会社・（株）等）が必要な箇所で統一されている",
    "顧客の部署名・組織名が現在の正式名称と一致している（旧組織名が残っていない）",
    "顧客の担当者名・役職名が最新情報と一致している",
    "自社の部署名・チーム名・役職名が正式名称と一致している",
    "自社の担当者名に異動・退職者の名前が残っていない",
    "他社（競合・パートナー等）の社名が現在の正式名称と一致している"
  ]},
  {id:2, t:"キーワード・用語の表記揺れ", items:[
    "A-1の表記揺れ注意ワードがすべて正式表記で統一されている",
    "同じ指標・KPIの名称が統一されている",
    "同じ製品・サービス名の表記が統一されている",
    "カタカナ語の表記揺れがない（例：マネージャー/マネジャー）",
    "英語表記の揺れがない（例：DX / D.X. / Digital Transformation）",
    "略語と正式名称が混在していない、または初出時に説明がある"
  ]},
  {id:3, t:"スライド間の記載揺れ・不整合", items:[
    "目次・アジェンダのタイトルと本編の各スライドタイトルが一致している",
    "同じフェーズ・ステップの名称がスライドをまたいで統一されている",
    "同じ数値がスライドを横断して出てくる場合、すべて一致している",
    "施策・アクションの名称が複数スライドにわたって一貫している",
    "前提条件・仮定の記述がスライドをまたいで矛盾していない"
  ]},
  {id:4, t:"不適切・要注意な記載内容", items:[
    "A-2の使用禁止キーワード・表現が含まれていない",
    "A-3の使用禁止オブジェクト・デザイン要素が含まれていない",
    "休日・祝日・曜日の記載が提示日時点で正確か（来週月曜・GW明け等）",
    "日付が古くなっていない",
    "TBD・TODO・要確認など作業中の痕跡が残っていない",
    "テンプレートのサンプルテキスト・ダミーデータが残っていない",
    "コピー元資料の社名・案件名が残っていない（使い回しの確認）"
  ]},
  {id:5, t:"句読点・文末表記", items:[
    "箇条書きの文末「。」あり・なしが全体で統一されている",
    "「です・ます調」と「だ・である調」が混在していない",
    "箇条書きの語尾の形が同一スライド内で統一されている",
    "メッセージライン（タイトル行）の文体が全スライドで統一されている"
  ]},
  {id:6, t:"数字・単位・日付", items:[
    "数字が全角・半角で混在していない（原則：半角統一）",
    "桁区切りカンマの有無が統一されている",
    "単位表記が統一されている（百万円・M円・百万が混在しない）",
    "パーセント表記が統一されている（%か％かで統一）",
    "日付・年度の表記形式が統一されている"
  ]},
  {id:7, t:"表・グラフ内の数値整合性", items:[
    "表の合計行・合計列が各セルの合計と一致している",
    "構成比（%）の合計が100%になっている",
    "前年比・増減率の計算値が元の数値から正しく導出されている",
    "グラフのデータラベルの数値が凡例・軸の値と整合している",
    "「うち○○」「内訳」の合計が上位の集計値と一致している",
    "CAGRや平均値などの二次計算値が正しく算出されている"
  ]},
  {id:8, t:"前後スライドとの整合性", items:[
    "エグゼクティブサマリーの数値・結論が本編の詳細スライドと矛盾していない",
    "「前スライドで述べたとおり」などの参照表現が実際の内容と対応している",
    "前スライドで「3つの課題」と述べた場合、後続で過不足なく展開されている",
    "アペンディックスの参照先が実際に存在し、内容が対応している",
    "ロードマップのマイルストーンが他スライドのスケジュールと一致している"
  ]},
  {id:9, t:"Citation（出典・引用）の記載揺れ", items:[
    "出典の記載形式が全スライドで統一されている（出典：/Source:/※○○よりが混在しない）",
    "出典の記載位置・フォントサイズ・色が統一されている",
    "調査会社・レポート名の表記が統一されている",
    "Citationが必要な図・グラフ・数値で出典が抜けていない"
  ]},
  {id:10, t:"キーメッセージの記載揺れ", items:[
    "エグゼクティブサマリーのキーメッセージ文言が本編と一字一句一致している",
    "目次・アジェンダでの章タイトルと各章の扉スライドのタイトルが完全に一致している",
    "同一の提言・施策名が複数スライドに登場する場合、表現が統一されている",
    "結論・提言で示されたアクション数・施策数が本編の展開数と一致している",
    "メッセージラインの数値・割合が本文・図表の数値と一致している"
  ]},
  {id:11, t:"カラー（色）の使用揺れ", items:[
    "同じ意味・カテゴリを表す要素が全スライドで同一の色で表現されている",
    "強調色（アクセントカラー）が全スライドで統一されている",
    "同一の系列・セグメントが異なるスライドで異なる色になっていない",
    "ブランドカラーパレット外の色が使用されていない"
  ]},
  {id:12, t:"1スライド1メッセージの原則", items:[
    "各スライドにSo What（主張・結論）が1文で書かれているか",
    "メッセージラインが動詞を含む完全文になっているか（体言止めになっていないか）",
    "1枚のスライドに複数の独立したメッセージが混在していないか",
    "ボディがメッセージラインを証明・補足する構成になっているか"
  ]},
  {id:13, t:"デッキ全体のストーリー性", items:[
    "全スライドのメッセージラインを順番に読んだとき、論理的なストーリーとして通じるか",
    "デッキの冒頭で課題・問いが明確に設定されており、最後の提言がそれに答えているか",
    "各章・セクションの役割が明確で、章の順序が自然か",
    "論点が脱線・散漫になっているスライドがないか",
    "エグゼクティブサマリーだけで全体の主張・提言が自己完結して理解できるか"
  ]},
  {id:14, t:"各スライドの結論明確性", items:[
    "スライドの結論が何かが一目で明確か（事実の羅列に終わっていないか）",
    "データや図が示唆（So What）まで落とし込まれているか",
    "図・グラフのタイトルがデータの説明でなく示唆・メッセージになっているか"
  ]}
];

var openSec = {1:true};

/* ===== タブ切替 ===== */
function sw(n) {
  var ps = document.getElementsByTagName('div');
  for (var i=0; i<ps.length; i++) {
    if (ps[i].id && ps[i].id.charAt(0)==='p' && ps[i].id.length===2) {
      ps[i].className = (ps[i].id === 'p'+n) ? 'panel on' : 'panel';
    }
  }
  var ts = document.getElementsByTagName('span');
  for (var i=0; i<ts.length; i++) {
    if (ts[i].className && ts[i].className.indexOf('tab')>=0) {
      var idx = ts[i].getAttribute('onclick');
      if (idx) ts[i].className = (idx === 'sw('+n+')') ? 'tab on' : 'tab';
    }
  }
  if (n===3) { renderSum(); renderChk(); }
  if (n===4) renderRep();
}

/* ===== A-1 表記揺れ ===== */
function renderW() {
  var h = '';
  for (var i=0; i<D.wording.length; i++) {
    var r = D.wording[i];
    h += '<tr><td><input type="text" value="'+xe(r.c)+'" onchange="updW('+r.id+',\'c\',this.value)"></td>' +
         '<td><input type="text" value="'+xe(r.w)+'" onchange="updW('+r.id+',\'w\',this.value)"></td>' +
         '<td style="text-align:center"><input type="button" class="del" value="削除" onclick="delW('+r.id+')"></td></tr>';
  }
  document.getElementById('tbW').innerHTML = h;
}
function addW() {
  var c = document.getElementById('nWC').value;
  var w = document.getElementById('nWW').value;
  if (!trim(c)) { alert('正式表記を入力してください'); return; }
  D.wording.push({id:now(), c:trim(c), w:trim(w)});
  document.getElementById('nWC').value='';
  document.getElementById('nWW').value='';
  renderW();
}
function delW(id) { D.wording=D.wording.filter(function(r){return r.id!==id;}); renderW(); }
function updW(id,f,v) { for(var i=0;i<D.wording.length;i++){if(D.wording[i].id===id)D.wording[i][f]=v;} }

/* ===== A-2 禁止キーワード ===== */
var BCATS = ["社外秘・機密","不適切・品位を損なう表現","過度な断言表現","作業中痕跡"];
function renderB() {
  var h = '';
  for (var ci=0; ci<BCATS.length; ci++) {
    var cat = BCATS[ci];
    var items = D.banned.filter(function(r){return r.cat===cat;});
    h += '<div class="card"><div class="card-body"><div class="cat-badge">'+cat+'</div><table><tbody>';
    if (items.length===0) {
      h += '<tr><td style="color:#aaa;font-size:12px">（未登録）</td></tr>';
    } else {
      for (var i=0; i<items.length; i++) {
        var r=items[i];
        h += '<tr><td><input type="text" value="'+xe(r.kw)+'" onchange="updB('+r.id+',this.value)"></td>' +
             '<td style="width:44px;text-align:center"><input type="button" class="del" value="削除" onclick="delB('+r.id+')"></td></tr>';
      }
    }
    h += '</tbody></table></div></div>';
  }
  document.getElementById('bannedWrap').innerHTML = h;
}
function addB() {
  var cat = document.getElementById('nBCat').value;
  var kw  = document.getElementById('nBKw').value;
  if (!trim(kw)) { alert('キーワードを入力してください'); return; }
  D.banned.push({id:now(), cat:cat, kw:trim(kw)});
  document.getElementById('nBKw').value='';
  renderB();
}
function delB(id) { D.banned=D.banned.filter(function(r){return r.id!==id;}); renderB(); }
function updB(id,v) { for(var i=0;i<D.banned.length;i++){if(D.banned[i].id===id)D.banned[i].kw=v;} }

/* ===== A-3 禁止オブジェクト ===== */
var OCATS = ["禁止オブジェクト","禁止デザイン"];
function renderO() {
  var h = '';
  for (var ci=0; ci<OCATS.length; ci++) {
    var cat = OCATS[ci];
    var items = D.objects.filter(function(r){return r.cat===cat;});
    h += '<div class="card"><div class="card-body"><div class="cat-badge">'+cat+'</div><table><tbody>';
    if (items.length===0) {
      h += '<tr><td style="color:#aaa;font-size:12px">（未登録）</td></tr>';
    } else {
      for (var i=0; i<items.length; i++) {
        var r=items[i];
        h += '<tr><td><input type="text" value="'+xe(r.item)+'" onchange="updO('+r.id+',this.value)"></td>' +
             '<td style="width:44px;text-align:center"><input type="button" class="del" value="削除" onclick="delO('+r.id+')"></td></tr>';
      }
    }
    h += '</tbody></table></div></div>';
  }
  document.getElementById('objWrap').innerHTML = h;
}
function addO() {
  var cat  = document.getElementById('nOCat').value;
  var item = document.getElementById('nOItem').value;
  if (!trim(item)) { alert('要素を入力してください'); return; }
  D.objects.push({id:now(), cat:cat, item:trim(item)});
  document.getElementById('nOItem').value='';
  renderO();
}
function delO(id) { D.objects=D.objects.filter(function(r){return r.id!==id;}); renderO(); }
function updO(id,v) { for(var i=0;i<D.objects.length;i++){if(D.objects[i].id===id)D.objects[i].item=v;} }

/* ===== 点検リスト ===== */
function renderSum() {
  var c = {ok:0,warn:0,ng:0,none:0};
  for (var si=0; si<CL.length; si++) {
    for (var ii=0; ii<CL[si].items.length; ii++) {
      var k = CL[si].id+'-'+ii;
      c[D.st[k]||'none']++;
    }
  }
  document.getElementById('sumBar').innerHTML =
    '<div class="sum-box s-ok"><div class="sum-num">'+c.ok+'</div><div class="sum-lbl">&#10003; OK</div></div>' +
    '<div class="sum-box s-warn"><div class="sum-num">'+c.warn+'</div><div class="sum-lbl">&#9888; 要確認</div></div>' +
    '<div class="sum-box s-ng"><div class="sum-num">'+c.ng+'</div><div class="sum-lbl">&#10007; NG</div></div>' +
    '<div class="sum-box s-none"><div class="sum-num">'+c.none+'</div><div class="sum-lbl">未評価</div></div>';
}

function renderChk() {
  var h = '';
  for (var si=0; si<CL.length; si++) {
    var sec = CL[si];
    var ngc=0, wc=0;
    for (var ii=0; ii<sec.items.length; ii++) {
      var k=sec.id+'-'+ii;
      if(D.st[k]==='ng')   ngc++;
      if(D.st[k]==='warn') wc++;
    }
    var badge = (ngc?'<span style="color:#e74c3c;font-weight:bold;font-size:11px;margin-left:8px">&#10007; '+ngc+'</span>':'')+
                (wc?'<span style="color:#e67e22;font-weight:bold;font-size:11px;margin-left:4px">&#9888; '+wc+'</span>':'');
    var isOpen = openSec[sec.id] ? true : false;
    var itemsH = '';
    for (var ii=0; ii<sec.items.length; ii++) {
      var k = sec.id+'-'+ii;
      var st = D.st[k]||'none';
      var showDiff = (st==='warn'||st==='ng') ? 'diff-box on' : 'diff-box';
      itemsH +=
        '<div class="chk-item">' +
        '<span class="chk-no">'+sec.id+'-'+(ii+1)+'</span>' +
        '<span class="chk-txt">'+sec.items[ii]+'</span><br>' +
        '<div style="padding-left:36px;margin-top:4px">' +
          mkSBtn(k,'ok',st)+ mkSBtn(k,'warn',st)+ mkSBtn(k,'ng',st) +
          '<div class="'+showDiff+'" id="df_'+k+'">' +
            '<table style="margin-bottom:6px"><tr>' +
              '<td style="width:50%;padding-right:8px;vertical-align:top">' +
                '<div class="diff-lbl lbl-b">&#128308; 原文</div>' +
                '<textarea rows="2" style="border-color:#faa" onchange="D.bef[\''+k+'\']=this.value">'+xe(D.bef[k]||'')+'</textarea>' +
              '</td>' +
              '<td style="width:50%;vertical-align:top">' +
                '<div class="diff-lbl lbl-a">&#9989; 修正案</div>' +
                '<textarea rows="2" style="border-color:#9c9" onchange="D.aft[\''+k+'\']=this.value">'+xe(D.aft[k]||'')+'</textarea>' +
              '</td>' +
            '</tr></table>' +
            '<div class="diff-lbl lbl-l">&#128205; 該当箇所</div>' +
            '<input type="text" value="'+xe(D.loc[k]||'')+'" placeholder="例）スライド8｜メッセージライン" onchange="D.loc[\''+k+'\']=this.value">' +
          '</div>' +
        '</div>' +
        '</div>';
    }
    h += '<div class="card">' +
         '<div class="card-hdr" onclick="togSec('+sec.id+')">' +
           '<span class="arr" id="arr'+sec.id+'">'+(isOpen?'&#9660;':'&#9654;')+'</span>' +
           '【'+sec.id+'】'+sec.t + badge +
         '</div>' +
         '<div id="sb'+sec.id+'" style="display:'+(isOpen?'block':'none')+'">' +
           '<div class="card-body">'+itemsH+'</div>' +
         '</div>' +
         '</div>';
  }
  document.getElementById('chkWrap').innerHTML = h;
}

function mkSBtn(k, s, cur) {
  var labels = {ok:'&#10003; OK', warn:'&#9888; 要確認', ng:'&#10007; NG'};
  var on = (cur===s) ? ' on' : '';
  return '<input type="button" class="sbtn sbtn-'+s+on+'" value="'+labels[s]+'" onclick="setSt(\''+k+'\',\''+s+'\')">';
}

function setSt(k, s) {
  D.st[k] = (D.st[k]===s) ? 'none' : s;
  renderSum();
  renderChk();
}

function togSec(id) {
  openSec[id] = !openSec[id];
  document.getElementById('sb'+id).style.display = openSec[id] ? 'block' : 'none';
  document.getElementById('arr'+id).innerHTML = openSec[id] ? '&#9660;' : '&#9654;';
}

/* ===== レポート ===== */
function renderRep() {
  var issues = getIssues();
  if (issues.length===0) {
    document.getElementById('repWrap').innerHTML =
      '<div class="card"><div class="card-body" style="color:#27ae60;font-weight:bold;padding:20px">&#127881; NG・要確認の項目はありません。</div></div>';
    return;
  }
  var h = '<p style="font-weight:bold;margin-bottom:12px">指摘件数：'+issues.length+' 件</p>';
  for (var i=0; i<issues.length; i++) {
    var iss = issues[i];
    var stLabel = iss.st==='ng' ? '&#10007; NG' : '&#9888; 要確認';
    var stColor = iss.st==='ng' ? '#e74c3c' : '#e67e22';
    h += '<div class="card" style="border-left:5px solid '+stColor+';margin-bottom:12px">' +
         '<div class="card-body">' +
           '<div style="margin-bottom:8px"><b style="color:'+stColor+'">['+(i+1<10?'0'+(i+1):(i+1))+'] '+stLabel+'</b>' +
             '<span style="font-size:11px;color:#888;margin-left:10px">項目 '+iss.secId+'</span></div>' +
           '<div style="font-weight:bold;margin-bottom:8px">'+iss.item+'</div>' +
           (iss.loc ? '<p style="font-size:12px;margin-bottom:8px"><span class="diff-lbl lbl-l">&#128205; 該当箇所</span> '+xe2(iss.loc)+'</p>' : '') +
           '<table style="border:1px solid #dde4f0"><tr>' +
             '<td style="width:80px;background:#fde;color:#c00;font-weight:bold;font-size:12px;padding:8px;vertical-align:top">&#128308; 原文</td>' +
             '<td style="padding:8px;white-space:pre-wrap;font-size:12px">'+(xe2(iss.bef)||'<span style="color:#aaa">（未記入）</span>')+'</td>' +
           '</tr><tr style="border-top:1px solid #dde4f0">' +
             '<td style="width:80px;background:#dfd;color:#060;font-weight:bold;font-size:12px;padding:8px;vertical-align:top">&#9989; 修正案</td>' +
             '<td style="padding:8px;white-space:pre-wrap;font-size:12px">'+(xe2(iss.aft)||'<span style="color:#aaa">（未記入）</span>')+'</td>' +
           '</tr></table>' +
         '</div></div>';
  }
  document.getElementById('repWrap').innerHTML = h;
}

function getIssues() {
  var res = [];
  for (var si=0; si<CL.length; si++) {
    for (var ii=0; ii<CL[si].items.length; ii++) {
      var k = CL[si].id+'-'+ii;
      var st = D.st[k];
      if (st==='ng'||st==='warn') {
        res.push({st:st, secId:CL[si].id, item:CL[si].items[ii],
                  bef:D.bef[k]||'', aft:D.aft[k]||'', loc:D.loc[k]||''});
      }
    }
  }
  return res;
}

/* ===== AIプロンプト生成 ===== */
function getMode() {
  var rs = document.getElementsByName('mode');
  for (var i=0; i<rs.length; i++) { if (rs[i].checked) return rs[i].value; }
  return 'full';
}

function genPrompt() {
  var mode  = getMode();
  var scope = trim(document.getElementById('scope').value) || '全スライド';

  var wList = '';
  for (var i=0; i<D.wording.length; i++) {
    wList += '  - 正式表記「'+D.wording[i].c+'」← 使用禁止：'+D.wording[i].w+'\n';
  }
  if (!wList) wList = '  （未登録）\n';

  var bList = '';
  for (var ci=0; ci<BCATS.length; ci++) {
    var items = D.banned.filter(function(r){return r.cat===BCATS[ci];});
    if (items.length) {
      bList += '  【'+BCATS[ci]+'】\n';
      for (var i=0; i<items.length; i++) bList += '    - '+items[i].kw+'\n';
    }
  }
  if (!bList) bList = '  （未登録）\n';

  var oList = '';
  for (var ci=0; ci<OCATS.length; ci++) {
    var items = D.objects.filter(function(r){return r.cat===OCATS[ci];});
    if (items.length) {
      oList += '  【'+OCATS[ci]+'】\n';
      for (var i=0; i<items.length; i++) oList += '    - '+items[i].item+'\n';
    }
  }
  if (!oList) oList = '  （未登録）\n';

  var ngList = '';
  var ngCnt = 0;
  if (mode === 'ng') {
    var issues = getIssues();
    for (var i=0; i<issues.length; i++) {
      ngCnt++;
      var iss = issues[i];
      ngList += '  No.'+(ngCnt<10?'0'+ngCnt:ngCnt)+' ['+(iss.st==='ng'?'NG':'要確認')+'] '+iss.item+'\n';
      if (iss.loc)  ngList += '    該当箇所：'+iss.loc+'\n';
      if (iss.bef)  ngList += '    原文：「'+iss.bef+'」\n';
      if (iss.aft)  ngList += '    修正案：「'+iss.aft+'」\n';
    }
    if (!ngList) ngList = '  （前回の点検結果なし。まず全項目点検を実行してください）\n';
  }

  var p = '';
  p += '# PowerPoint スライド 形式点検依頼\n\n';
  p += '添付のPowerPointスライドを、以下の基準に従って点検してください。\n';
  p += '対象範囲：' + scope + '\n\n';
  p += '================================================================\n';
  p += '【カスタマイズ基準（必ず遵守してください）】\n';
  p += '================================================================\n\n';
  p += '▼ A-1 表記揺れ注意ワード（以下の正式表記に統一してください）\n';
  p += wList + '\n';
  p += '▼ A-2 使用禁止キーワード・表現（含まれていればNGとして報告してください）\n';
  p += bList + '\n';
  p += '▼ A-3 使用禁止オブジェクト・デザイン要素（含まれていればNGとして報告してください）\n';
  p += oList + '\n';
  p += '================================================================\n';
  p += '【点検内容】\n';
  p += '================================================================\n\n';

  if (mode === 'ng') {
    p += '以下は前回の点検でNG・要確認と判定された項目です。\n';
    p += '修正後のスライドが正しく修正されているか確認してください。\n\n';
    p += ngList + '\n';
  } else {
    p += '各項目を ✅OK / ⚠️要確認 / ❌NG の3段階で評価してください。\n\n';

    if (mode==='full' || mode==='fmt') {
      p += '--- SECTION 1：表記・書式チェック ---\n\n';
      p += '【1】顧客名・部署名の正確性\n';
      p += '  1-1. 顧客の会社名が正式名称と一致している（略称・旧社名の混在がない）\n';
      p += '  1-2. 法人格表記が必要な箇所で統一されている\n';
      p += '  1-3. 顧客の部署名・組織名が現在の正式名称と一致している\n';
      p += '  1-4. 顧客の担当者名・役職名が最新情報と一致している\n';
      p += '  1-5. 自社の部署名・チーム名・役職名が正式名称と一致している\n';
      p += '  1-6. 他社（競合・パートナー等）の社名が現在の正式名称と一致している\n\n';
      p += '【2】キーワード・用語の表記揺れ\n';
      p += '  2-1. A-1の表記揺れ注意ワードがすべて正式表記で統一されている\n';
      p += '  2-2. 同じ指標・KPIの名称が統一されている\n';
      p += '  2-3. カタカナ語の表記揺れがない（マネージャー/マネジャー等）\n';
      p += '  2-4. 英語表記の揺れがない（DX/D.X./Digital Transformation等）\n';
      p += '  2-5. 略語と正式名称が混在していない、または初出時に説明がある\n\n';
      p += '【3】スライド間の記載揺れ・不整合\n';
      p += '  3-1. 目次・アジェンダのタイトルと本編の各スライドタイトルが一致している\n';
      p += '  3-2. 同じフェーズ・ステップの名称がスライドをまたいで統一されている\n';
      p += '  3-3. 同じ数値がスライドを横断して出てくる場合、すべて一致している\n';
      p += '  3-4. 施策・アクションの名称が複数スライドにわたって一貫している\n\n';
      p += '【4】不適切・要注意な記載内容\n';
      p += '  4-1. A-2の使用禁止キーワード・表現が含まれていない\n';
      p += '  4-2. A-3の使用禁止オブジェクト・デザイン要素が含まれていない\n';
      p += '  4-3. 休日・祝日・曜日の記載が提示日時点で正確か（来週月曜・GW明け等）\n';
      p += '  4-4. TBD・TODO・要確認など作業中の痕跡が残っていない\n';
      p += '  4-5. コピー元資料の社名・案件名が残っていない（使い回しの確認）\n\n';
      p += '【5】句読点・文末表記\n';
      p += '  5-1. 箇条書きの文末「。」あり・なしが全体で統一されている\n';
      p += '  5-2. 「です・ます調」と「だ・である調」が混在していない\n';
      p += '  5-3. 箇条書きの語尾の形が同一スライド内で統一されている\n\n';
      p += '【6】数字・単位・日付\n';
      p += '  6-1. 数字が全角・半角で混在していない（原則：半角統一）\n';
      p += '  6-2. 桁区切りカンマの有無が統一されている\n';
      p += '  6-3. 単位表記が統一されている（百万円・M円が混在しない）\n';
      p += '  6-4. パーセント表記が統一されている（%か％かで統一）\n';
      p += '  6-5. 日付・年度の表記形式が統一されている\n\n';
      p += '【7】表・グラフ内の数値整合性\n';
      p += '  7-1. 表の合計行・合計列が各セルの合計と一致している\n';
      p += '  7-2. 構成比（%）の合計が100%になっている\n';
      p += '  7-3. 前年比・増減率の計算値が元の数値から正しく導出されている\n';
      p += '  7-4. グラフのデータラベルの数値が凡例・軸の値と整合している\n\n';
      p += '【8】前後スライドとの整合性\n';
      p += '  8-1. エグゼクティブサマリーの数値・結論が本編の詳細スライドと矛盾していない\n';
      p += '  8-2. 「前スライドで述べたとおり」などの参照表現が実際の内容と対応している\n';
      p += '  8-3. 前のスライドで「3つの課題」と述べた場合、後続で過不足なく展開されている\n\n';
      p += '【9】Citation（出典・引用）の記載揺れ\n';
      p += '  9-1. 出典の記載形式が全スライドで統一されている（出典：/Source:/※○○よりが混在しない）\n';
      p += '  9-2. 出典の記載位置・フォントサイズ・色が統一されている\n';
      p += '  9-3. Citationが必要な図・グラフ・数値で出典が抜けていない\n\n';
      p += '【10】キーメッセージの記載揺れ\n';
      p += '  10-1. エグゼクティブサマリーのキーメッセージ文言が本編と一字一句一致している\n';
      p += '  10-2. 目次・アジェンダでの章タイトルと各章の扉スライドのタイトルが完全に一致している\n';
      p += '  10-3. 結論・提言で示されたアクション数・施策数が本編の展開数と一致している\n';
      p += '  10-4. メッセージラインの数値・割合が本文・図表の数値と一致している\n\n';
      p += '【11】カラー（色）の使用揺れ\n';
      p += '  11-1. 同じ意味・カテゴリを表す要素が全スライドで同一の色で表現されている\n';
      p += '  11-2. 強調色（アクセントカラー）が全スライドで統一されている\n';
      p += '  11-3. 同一の系列・セグメントが異なるスライドで異なる色になっていない\n\n';
    }

    if (mode==='full' || mode==='cnt') {
      p += '--- SECTION 2：コンテンツ品質チェック ---\n\n';
      p += '【12】1スライド1メッセージの原則\n';
      p += '  12-1. 各スライドにSo What（主張・結論）が1文で書かれているか\n';
      p += '  12-2. メッセージラインが動詞を含む完全文になっているか（体言止めになっていないか）\n';
      p += '  12-3. 1枚のスライドに複数の独立したメッセージが混在していないか\n';
      p += '  12-4. ボディがメッセージラインを証明・補足する構成になっているか\n\n';
      p += '【13】デッキ全体のストーリー性\n';
      p += '  13-1. 全スライドのメッセージラインを順番に読んだとき、論理的なストーリーとして通じるか\n';
      p += '  13-2. デッキの冒頭で課題・問いが明確に設定されており、最後の提言がそれに答えているか\n';
      p += '  13-3. 各章・セクションの役割が明確で、章の順序が自然か\n';
      p += '  13-4. 論点が脱線・散漫になっているスライドがないか\n\n';
      p += '【14】各スライドの結論明確性\n';
      p += '  14-1. スライドの結論が何かが一目で明確か（事実の羅列に終わっていないか）\n';
      p += '  14-2. データや図が示唆（So What）まで落とし込まれているか\n';
      p += '  14-3. 図・グラフのタイトルがデータの説明でなく示唆・メッセージになっているか\n\n';
    }
  }

  p += '================================================================\n';
  p += '【出力形式】\n';
  p += '================================================================\n\n';
  p += '指摘は以下のブロック形式で出力してください。\n';
  p += 'スライド番号だけでなく「スライド内のどこか」まで必ず明記し、\n';
  p += '問題のある文字列・数値は「」で引用してください。\n\n';
  p += '位置の表記形式：\n';
  p += '  スライドN｜メッセージライン\n';
  p += '  スライドN｜本文 箇条書きX行目\n';
  p += '  スライドN｜図表「○○」タイトル\n';
  p += '  スライドN｜表「○○」X行Y列目\n';
  p += '  スライドN｜注釈・Citation欄\n\n';
  p += '--- 指摘ブロック形式 ---\n\n';
  p += '### [No.XX] ❌NG または ⚠️要確認｜項目番号：XX-X\n\n';
  p += '**箇所①** スライドN｜位置\n';
  p += '| | テキスト・数値 |\n';
  p += '|---|---|\n';
  p += '| 🔴 原文 | 「問題のある文章・数値」 |\n';
  p += '| ✅ 修正案 | 「修正後の文章・数値」 |\n\n';
  p += '**問題の説明：** 問題の内容と修正理由\n\n';
  p += '---\n\n';

  if (mode==='full' || mode==='cnt') {
    p += '最後に全スライドのメッセージラインを以下の表形式で一覧出力してください：\n\n';
    p += '| スライド | メッセージライン | 評価 |\n';
    p += '|---|---|---|\n';
    p += '| 1 | ○○ | ✅ |\n';
    p += '| 2 | ○○ | ⚠️ 体言止め |\n';
    p += '（以降同様）\n\n';
  }
  p += '最後に「総合コメント」として、全体の完成度・特に注意すべき傾向・最優先の改善アクションを記載してください。\n';

  document.getElementById('promptOut').value = p;
  document.getElementById('promptCard').style.display = 'block';
  document.getElementById('cpBtn').style.display = 'inline-block';
  document.getElementById('cpMsg').style.display = 'none';
  document.getElementById('charCnt').innerText = '（' + p.length + '文字）';
  setSt('プロンプトを生成しました（' + p.length + '文字）');
}

function cpPrompt() {
  var ta = document.getElementById('promptOut');
  ta.select();
  document.execCommand('copy');
  document.getElementById('cpMsg').style.display = 'inline';
  setSt('クリップボードにコピーしました');
  setTimeout(function(){ document.getElementById('cpMsg').style.display='none'; }, 3000);
}

/* ===== ファイルI/O（VBScript橋渡し） ===== */
function getJSON() { return JSON.stringify(D); }
function setJSON(s) {
  try {
    var d = eval('('+s+')');
    D.wording = d.wording || D.wording;
    D.banned  = d.banned  || D.banned;
    D.objects = d.objects || D.objects;
    D.st  = d.st  || {};
    D.bef = d.bef || {};
    D.aft = d.aft || {};
    D.loc = d.loc || {};
    renderAll();
  } catch(e) { alert('読み込みエラー: '+e.message); }
}

function getReportHTML() {
  var issues = getIssues();
  var now = new Date();
  var ds = now.getFullYear()+'/'+(now.getMonth()+1)+'/'+now.getDate();
  var rows = '';
  for (var i=0; i<issues.length; i++) {
    var iss = issues[i];
    rows += '<tr>' +
      '<td style="color:'+(iss.st==='ng'?'#c00':'#e67e22')+';font-weight:bold;padding:7px 10px;border:1px solid #dde">'+(iss.st==='ng'?'NG':'要確認')+'</td>' +
      '<td style="padding:7px 10px;border:1px solid #dde">'+iss.secId+'</td>' +
      '<td style="padding:7px 10px;border:1px solid #dde">'+xe2(iss.item)+'</td>' +
      '<td style="padding:7px 10px;border:1px solid #dde">'+xe2(iss.loc)+'</td>' +
      '<td style="padding:7px 10px;border:1px solid #dde;background:#ffeee">'+xe2(iss.bef)+'</td>' +
      '<td style="padding:7px 10px;border:1px solid #dde;background:#efeee">'+xe2(iss.aft)+'</td>' +
    '</tr>';
  }
  return '<!DOCTYPE html><html><head><meta charset="UTF-8"><title>PPTX点検レポート</title>' +
    '<style>body{font-family:Meiryo,sans-serif;padding:20px}h1{font-size:16px;margin-bottom:4px}' +
    'table{border-collapse:collapse;width:100%}th{background:#2c3e6b;color:#fff;padding:8px 10px;font-size:12px;text-align:left;border:1px solid #2c3e6b}' +
    'td{font-size:12px}tr:nth-child(even) td{background:#f8f9ff}</style></head><body>' +
    '<h1>PPTX 点検レポート</h1><p style="color:#888;margin-bottom:16px">作成日：'+ds+' / 指摘件数：'+issues.length+'件</p>' +
    '<table><thead><tr><th style="width:70px">評価</th><th style="width:44px">項目</th><th style="width:260px">点検項目</th>' +
    '<th style="width:160px">該当箇所</th><th style="width:180px">原文</th><th style="width:180px">修正案</th></tr></thead>' +
    '<tbody>'+rows+'</tbody></table></body></html>';
}

function doReset() {
  if (!confirm('点検リストの評価・原文・修正案をすべてリセットしますか？\nA-1〜A-3のリストは保持されます。')) return;
  D.st={}; D.bef={}; D.aft={}; D.loc={};
  renderSum(); renderChk();
  setSt('点検リストをリセットしました');
}

/* ===== ユーティリティ ===== */
function xe(s) {
  s = s||'';
  s = s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  return s;
}
function xe2(s) {
  s = s||'';
  return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
}
function trim(s) { return (s||'').replace(/^\s+|\s+$/g,''); }
function now() { return new Date().getTime(); }
function setSt(msg) { document.getElementById('stMsg').innerText = msg; }

function renderAll() {
  renderW();
  renderB();
  renderO();
  renderSum();
  renderChk();
}

/* ===== 初期描画 ===== */
renderAll();
setSt('準備完了');
</script>
</body>
</html>
