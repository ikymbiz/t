    { id: "fw_dt_r1", label: "選択肢①のリスク", rows: 2 },
    { id: "fw_dt_r2", label: "選択肢②のリスク", rows: 2 },
    { id: "fw_dt_vrd", label: "推奨選択肢と理由", rows: 2, full: true }] }
};

function renderFW() {
  var fw = document.getElementById("c-fw").value;
  var area = document.getElementById("fw-area");
  if (!fw || !FW_DEF[fw]) { area.innerHTML = ""; return; }
  var def = FW_DEF[fw];
  var html = '<div class="fw-panel"><div class="fw-panel-hdr">◆ ' + def.label + '</div>';
  html += '<div style="padding:10px 12px;display:grid;grid-template-columns:1fr 1fr;gap:8px;">';
  for (var fi = 0; fi < def.fields.length; fi++) {
    var f = def.fields[fi];
    var span = f.full ? "grid-column:1/-1;" : "";
    html += '<div class="fg" style="' + span + '"><label class="lbl">' + f.label + '</label>';
    html += '<textarea id="' + f.id + '" rows="' + f.rows + '" placeholder="' + f.label + 'を入力..."></textarea></div>';
  }
  html += "</div></div>";
  area.innerHTML = html;
}

function getFWData(fw) {
  if (!fw || !FW_DEF[fw]) return "";
  var data = {};
  var flds = FW_DEF[fw].fields;
  for (var i = 0; i < flds.length; i++) {
    var el = document.getElementById(flds[i].id);
    if (el && el.value) data[flds[i].id] = el.value;
  }
  return JSON.stringify(data);
}

// ═══════════════════════════════════════════
// QUICK TAGS
// ═══════════════════════════════════════════
function getTagPool() {
  var tags = {};
  var pjs = readCSV("project_master");
  for (var i = 0; i < pjs.length; i++) { if (pjs[i].id) tags[pjs[i].id] = 1; if (pjs[i].client) tags[pjs[i].client] = 1; }
  var tbls = ["thought_log", "intelligence_inbox", "meeting_minutes"];
  for (var ti = 0; ti < tbls.length; ti++) {
    var rows = readCSV(tbls[ti]);
    for (var ri = 0; ri < rows.length; ri++) {
      if (rows[ri].tags) { var tg = rows[ri].tags.split(";"); for (var k = 0; k < tg.length; k++) { if (tg[k].replace(/\s/g,"")) tags[tg[k].replace(/^\s+|\s+$/g,"")] = 1; } }
    }
  }
  var arr = [];
  for (var key in tags) { if (tags.hasOwnProperty(key)) arr.push(key); }
  arr = arr.slice(0, 12);
  if (!arr.length) arr = ["DX", "コスト削減", "競合", "リスク", "提言"];
  return arr;
}

function renderQuickTags(containerId) {
  var el = document.getElementById(containerId);
  if (!el) return;
  var tags = getTagPool();
  var inputId = containerId === "q-tags-cap" ? "c-tags" : "ib-tags";
  var html = "";
  for (var i = 0; i < tags.length; i++) {
    html += '<span class="tag" onclick="appendTag(\'' + tags[i].replace(/'/g, "\\'") + '\',\'' + inputId + '\')">' + tags[i] + '</span>';
  }
  el.innerHTML = html;
}

function appendTag(tag, inputId) {
  var el = document.getElementById(inputId);
  var cur = el.value;
  if (cur && cur.charAt(cur.length - 1) !== ";") el.value = cur + ";" + tag;
  else el.value = cur + tag;
}

// ═══════════════════════════════════════════
// THOUGHT LOG
// ═══════════════════════════════════════════
function saveThought() {
  var body = document.getElementById("c-body").value.replace(/^\s+|\s+$/g,"");
  if (!body) { toast("内容を入力してください"); return; }
  var fw = document.getElementById("c-fw").value;
  var row = {
    id: genId("TL"), datetime: nowISO(), type: document.getElementById("c-type").value,
    framework: fw, urgency: document.getElementById("c-urgency").value,
    context: document.getElementById("c-ctx").value, content_raw: body,
    framework_data: getFWData(fw), tags: document.getElementById("c-tags").value,
    project: document.getElementById("c-pj").value, status: "未処理",
    ai_summary: "", ai_action: "", ai_deep: "", ai_link: ""
  };
  appendCSV("thought_log", row);
  toast("⚡ 記録しました → thought_log.csv", "ok");
  clearCap();
  renderLogs("");
  updateHdr();
}

function clearCap() {
  var ids = ["c-body", "c-tags", "c-pj"];
  for (var i = 0; i < ids.length; i++) document.getElementById(ids[i]).value = "";
  document.getElementById("c-fw").value = "";
  document.getElementById("fw-area").innerHTML = "";
  document.getElementById("c-cnt").innerText = "0";
}

function renderLogs(filter) {
  var data = readCSV("thought_log");
  document.getElementById("log-badge").innerText = data.length;
  if (filter) {
    data = data.filter(function(r) {
      return r.content_raw.indexOf(filter) >= 0 || (r.tags || "").indexOf(filter) >= 0 || (r.type || "").indexOf(filter) >= 0;
    });
  }
  data = data.reverse();
  var list = document.getElementById("log-list");
  if (!data.length) { list.innerHTML = '<div class="empty"><div class="empty-icon">⚡</div>思考を記録してください</div>'; return; }
  list.innerHTML = data.map(function(t) {
    var tags = t.tags ? t.tags.split(";").filter(Boolean) : [];
    var tagHtml = tags.map(function(tg) { return '<span class="tag" style="font-size:8px;padding:1px 5px">' + tg + '</span>'; }).join("");
    return '<div class="log-item' + (t.ai_summary ? ' has-ai' : '') + '">' +
      '<div class="log-hdr">' +
        '<span class="type-badge type-' + t.type + '">' + t.type + '</span>' +
        (t.framework ? '<span class="fw-badge">' + t.framework + '</span>' : '') +
        '<span style="font-family:var(--font-mono);font-size:8px;padding:1px 6px;border-radius:2px;background:var(--bg-card);border:1px solid var(--border);color:var(--text-secondary)">' + t.urgency + '</span>' +
        '<span class="log-time">' + fmtDT(t.datetime) + '</span>' +
      '</div>' +
      '<div class="log-body">' + esc(t.content_raw.slice(0, 120)) + (t.content_raw.length > 120 ? "..." : "") + '</div>' +
      (t.ai_summary ? '<div class="log-ai">🤖 ' + esc(t.ai_summary.slice(0, 60)) + '...</div>' : '') +
      (tagHtml ? '<div class="log-tags">' + tagHtml + '</div>' : '') +
    '</div>';
  }).join("");
}

// ═══════════════════════════════════════════
// INTELLIGENCE INBOX
// ═══════════════════════════════════════════
var pendingFile = null;

function fetchUrlMeta() {
  var url = document.getElementById("ib-url").value.replace(/^\s+|\s+$/g,"");
  if (!url) { toast("URLを入力してください"); return; }
  try {
    var xhr = new ActiveXObject("Msxml2.XMLHTTP");
    xhr.open("GET", url, false);
    xhr.send(null);
    var html = xhr.responseText;
    var titleMatch = html.match(/<title[^>]*>([^<]*)<\/title>/i);
    var desc = html.match(/<meta[^>]*name=["\']description["\'][^>]*content=["\']([^"\']*)["\'][^>]*>/i);
    if (titleMatch) document.getElementById("ib-title").value = titleMatch[1].replace(/^\s+|\s+$/g,"");
    if (desc) document.getElementById("ib-summary").value = desc[1].replace(/^\s+|\s+$/g,"");
    toast("タイトルを取得しました", "ok");
  } catch(e) {
    toast("自動取得できませんでした。手入力してください。", "");
  }
}

function dzOver(e) { e.returnValue = false; document.getElementById("drop-zone").className += " over"; }
function dzLeave() { document.getElementById("drop-zone").className = document.getElementById("drop-zone").className.replace(" over", ""); }
function dzDrop(e) {
  e.returnValue = false;
  document.getElementById("drop-zone").className = document.getElementById("drop-zone").className.replace(" over", "");
  var files = e.dataTransfer.files;
  if (files && files.length) handleFiles(files);
}

function handleFiles(files) {
  var info = [];
  var exts = { pdf: "PDF", xlsx: "Excel", xls: "Excel", csv: "CSV", pptx: "PowerPoint", ppt: "PowerPoint", docx: "Word", doc: "Word" };
  for (var i = 0; i < files.length; i++) {
    var f = files[i];
    var ext = f.name.split(".").pop().toLowerCase();
    var ftype = exts[ext] || "その他";
    var fsize = (f.size / 1024).toFixed(1) + " KB";
    info.push({ name: f.name, type: ftype, size: fsize, path: f.name });
    if (i === 0) {
      document.getElementById("ib-title").value = f.name;
      document.getElementById("ib-summary").value = "[" + ftype + "] " + f.name + " (" + fsize + ")";
      pendingFile = { name: f.name, type: ftype, size: fsize, path: f.name };
    }
  }
  document.getElementById("dropped-files").style.display = "block";
  document.getElementById("dropped-paths").innerText = info.map(function(f) { return f.type + ": " + f.name + " (" + f.size + ")"; }).join("\n");
  toast("📁 " + files.length + "ファイルを読み込みました", "ok");
}

function saveInbox() {
  var title = document.getElementById("ib-title").value.replace(/^\s+|\s+$/g,"");
  var url = document.getElementById("ib-url").value.replace(/^\s+|\s+$/g,"");
  if (!title && !url) { toast("タイトルまたはURLを入力してください"); return; }
  var pf = pendingFile || {};
  var row = {
    id: genId("II"), datetime: nowISO(), source_type: url ? "URL" : (pf.type || "その他"),
    title: title || url, url: url, url_summary: document.getElementById("ib-summary").value,
    file_path: pf.path || "", file_type: pf.type || "", file_size: pf.size || "",
    project: document.getElementById("ib-pj").value, category: document.getElementById("ib-cat").value,
    tags: document.getElementById("ib-tags").value, memo: document.getElementById("ib-memo").value,
    status: "未読", ai_summary: "", ai_implication: ""
  };
  appendCSV("intelligence_inbox", row);
  toast("📥 保存しました → intelligence_inbox.csv", "ok");
  var clrIds = ["ib-url", "ib-title", "ib-summary", "ib-pj", "ib-tags", "ib-memo"];
  for (var i = 0; i < clrIds.length; i++) document.getElementById(clrIds[i]).value = "";
  pendingFile = null;
  document.getElementById("dropped-files").style.display = "none";
  renderInbox("");
  updateHdr();
}

function renderInbox(filter) {
  var data = readCSV("intelligence_inbox").reverse();
  document.getElementById("ib-badge").innerText = data.length;
  if (filter) data = data.filter(function(r) { return r.title.indexOf(filter) >= 0 || (r.tags || "").indexOf(filter) >= 0; });
  var list = document.getElementById("ib-list");
  if (!data.length) { list.innerHTML = '<div class="empty"><div class="empty-icon">📥</div>情報がありません</div>'; return; }
  var iconMap = { PDF: "📄", Excel: "📊", CSV: "📊", PowerPoint: "📑", Word: "📝", URL: "🔗" };
  list.innerHTML = data.map(function(item) {
    var icon = iconMap[item.source_type] || "📁";
    var tags = item.tags ? item.tags.split(";").filter(Boolean) : [];
    return '<div class="inbox-item">' +
      '<div class="inbox-hdr">' +
        '<span style="font-size:13px">' + icon + '</span>' +
        '<span class="inbox-title">' + esc(item.title.slice(0, 50)) + (item.title.length > 50 ? "..." : "") + '</span>' +
        '<span class="st-badge st-' + item.status + '">' + item.status + '</span>' +
      '</div>' +
      '<div class="inbox-meta">' + item.category + ' · ' + fmtDT(item.datetime) + (item.project ? ' · ' + item.project : "") + '</div>' +
      (tags.length ? '<div class="log-tags" style="margin-top:3px">' + tags.map(function(t) { return '<span class="tag" style="font-size:8px;padding:1px 4px">' + t + '</span>'; }).join("") + '</div>' : '') +
    '</div>';
  }).join("");
}

// ═══════════════════════════════════════════
// TASKS
// ═══════════════════════════════════════════
function saveTask() {
  var title = document.getElementById("tk-title").value.replace(/^\s+|\s+$/g,"");
  if (!title) { toast("タスク名を入力してください"); return; }
  var row = {
    id: genId("TK"), datetime: nowISO(), title: title,
    priority: document.getElementById("tk-pri").value, type: document.getElementById("tk-type").value,
    due: document.getElementById("tk-due").value, hours: document.getElementById("tk-h").value,
    owner: document.getElementById("tk-owner").value || "自分", project: document.getElementById("tk-pj").value,
    content: document.getElementById("tk-body").value, status: "未着手", result: ""
  };
  appendCSV("task_log", row);
  closeModal("task-modal");
  toast("◈ タスクを追加しました", "ok");
  renderMatrix();
  updateHdr();
  var clrIds = ["tk-title", "tk-due", "tk-h", "tk-owner", "tk-pj", "tk-body"];
  for (var i = 0; i < clrIds.length; i++) document.getElementById(clrIds[i]).value = "";
}

function renderMatrix() {
  var data = readCSV("task_log");
  var open = data.filter(function(t) { return t.status !== "完了" && t.status !== "中止"; });
  var qMap = { S: "mq1", A: "mq2", B: "mq3", C: "mq4" };
  var priorities = ["S", "A", "B", "C"];
  for (var pi = 0; pi < priorities.length; pi++) {
    var p = priorities[pi];
    var el = document.getElementById(qMap[p]);
    if (!el) continue;
    var tasks = open.filter(function(t) { return t.priority === p; });
    if (!tasks.length) { el.innerHTML = '<div class="empty" style="padding:16px;font-size:9px">なし</div>'; continue; }
    el.innerHTML = tasks.map(function(t) {
      var over = t.due && t.due < todayISO();
      return '<div class="m-task">' +
        '<div class="done-btn" onclick="doneTask(\'' + t.id + '\')">✓</div>' +
        '<span style="flex:1;font-size:11px">' + esc(t.title) + '</span>' +
        (t.due ? '<span style="font-family:var(--font-mono);font-size:9px;color:' + (over ? "var(--red)" : "var(--text-muted)") + '">' + fmtD(t.due) + '</span>' : '') +
      '</div>';
    }).join("");
  }
  updateHdr();
}

function doneTask(id) {
  var data = readCSV("task_log");
  for (var i = 0; i < data.length; i++) { if (data[i].id === id) data[i].status = "完了"; }
  writeCSV("task_log", data);
  toast("✓ 完了しました", "ok");
  renderMatrix();
}

// ═══════════════════════════════════════════
// PROJECTS
// ═══════════════════════════════════════════
function saveProject() {
  var name = document.getElementById("pj-name").value.replace(/^\s+|\s+$/g,"");
  if (!name) { toast("案件名を入力してください"); return; }
  var row = {
    id: genId("P"), datetime: nowISO(), name: name,
    client: document.getElementById("pj-client").value, phase: document.getElementById("pj-phase").value,
    priority: document.getElementById("pj-pri").value, type: document.getElementById("pj-type").value,
    fee: document.getElementById("pj-fee").value, start: document.getElementById("pj-start").value,
    end: document.getElementById("pj-end").value, hypothesis: document.getElementById("pj-hyp").value,
    risk: document.getElementById("pj-risk").value, status: "進行中"
  };
  appendCSV("project_master", row);
  closeModal("pj-modal");
  toast("◉ 案件を追加しました", "ok");
  renderProjects();
  var clrIds = ["pj-name", "pj-client", "pj-fee", "pj-start", "pj-end", "pj-hyp", "pj-risk"];
  for (var i = 0; i < clrIds.length; i++) document.getElementById(clrIds[i]).value = "";
}

function renderProjects() {
  var data = readCSV("project_master").filter(function(p) { return p.status !== "完了" && p.status !== "中止"; });
  var board = document.getElementById("pj-board");
  if (!data.length) { board.innerHTML = '<div class="empty"><div class="empty-icon">◉</div>案件がありません</div>'; return; }
  var phases = {};
  for (var i = 0; i < data.length; i++) {
    var p = data[i];
    if (!phases[p.phase]) phases[p.phase] = [];
    phases[p.phase].push(p);
  }
  var priCls = { S: "pj-s", A: "pj-a", B: "pj-b", C: "" };
  var html = '<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:8px;">';
  for (var ph in phases) {
    if (!phases.hasOwnProperty(ph)) continue;
    html += '<div><div style="font-family:var(--font-mono);font-size:9px;color:var(--text-muted);letter-spacing:1.5px;text-transform:uppercase;padding:4px 8px;border-bottom:1px solid var(--border);margin-bottom:6px;">' + ph + ' (' + phases[ph].length + ')</div>';
    for (var j = 0; j < phases[ph].length; j++) {
      var p = phases[ph][j];
      html += '<div class="pj-card ' + (priCls[p.priority] || '') + '">' +
        '<div class="pj-name">' + esc(p.name) + '</div>' +
        '<div style="font-size:10px;color:var(--text-secondary)">' + esc(p.client || "—") + '</div>' +
        '<div class="pj-meta">' + p.type + (p.fee ? ' · ' + p.fee + '万円' : '') + '</div>' +
        '<div class="pj-bar"><div class="pj-fill" style="width:' + getPhaseProgress(p.phase) + '%"></div></div>' +
      '</div>';
    }
    html += '</div>';
  }
  html += '</div>';
  board.innerHTML = html;
}

function getPhaseProgress(phase) {
  var phases = ["提案前", "Dペーパー作成", "提案書作成", "提案済", "契約交渉", "契約締結", "キックオフ", "調査分析", "仮説検証", "提言作成", "最終プレゼン", "実行支援", "完了"];
  var idx = -1;
  for (var i = 0; i < phases.length; i++) { if (phases[i] === phase) { idx = i; break; } }
  return idx < 0 ? 0 : Math.round(idx / (phases.length - 1) * 100);
}

// ═══════════════════════════════════════════
// MEETINGS
// ═══════════════════════════════════════════
var curMtgId = null;

function newMtg() {
  curMtgId = null;
  var ids = ["m-title", "m-in", "m-out", "m-pj", "m-purpose", "m-disc", "m-dec", "m-todo"];
  for (var i = 0; i < ids.length; i++) document.getElementById(ids[i]).value = "";
  document.getElementById("m-dt").value = new Date().toISOString().slice(0, 16);
  document.getElementById("mtg-form-title").innerText = "NEW MEETING";
}

function saveMtg() {
  var title = document.getElementById("m-title").value.replace(/^\s+|\s+$/g,"");
  if (!title) { toast("会議名を入力してください"); return; }
  if (curMtgId) {
    var data = readCSV("meeting_minutes");
    for (var i = 0; i < data.length; i++) {
      if (data[i].id === curMtgId) {
        data[i].title = title; data[i].datetime = document.getElementById("m-dt").value;
        data[i].attendees_in = document.getElementById("m-in").value;
        data[i].attendees_out = document.getElementById("m-out").value;
        data[i].project = document.getElementById("m-pj").value;
        data[i].purpose = document.getElementById("m-purpose").value;
        data[i].discussion_raw = document.getElementById("m-disc").value;
        data[i].decisions = document.getElementById("m-dec").value;
        data[i].todos = document.getElementById("m-todo").value;
      }
    }
    writeCSV("meeting_minutes", data);
    toast("📋 議事録を更新しました", "ok");
  } else {
    appendCSV("meeting_minutes", {
      id: genId("MT"), datetime: document.getElementById("m-dt").value || nowISO(),
      title: title, attendees_in: document.getElementById("m-in").value,
      attendees_out: document.getElementById("m-out").value, project: document.getElementById("m-pj").value,
      purpose: document.getElementById("m-purpose").value, discussion_raw: document.getElementById("m-disc").value,
      decisions: document.getElementById("m-dec").value, todos: document.getElementById("m-todo").value,
      status: "未処理", ai_summary: "", ai_teams: "", ai_email: ""
    });
    toast("📋 議事録を保存しました", "ok");
  }
  renderMtgList();
  updateHdr();
}

function renderMtgList() {
  var data = readCSV("meeting_minutes").reverse();
  document.getElementById("mtg-badge").innerText = data.length;
  var list = document.getElementById("mtg-list");
  if (!data.length) { list.innerHTML = '<div class="empty"><div class="empty-icon">📋</div>議事録なし</div>'; return; }
  list.innerHTML = data.map(function(m) {
    return '<div class="mtg-item' + (m.id === curMtgId ? " sel" : "") + '" onclick="loadMtg(\'' + m.id + '\')">' +
      '<div class="mtg-name">' + esc(m.title) + '</div>' +
      '<div class="mtg-meta">' + fmtDT(m.datetime) + (m.project ? " · " + m.project : "") + '</div>' +
    '</div>';
  }).join("");
}

function loadMtg(id) {
  var data = readCSV("meeting_minutes");
  var m = null;
  for (var i = 0; i < data.length; i++) { if (data[i].id === id) m = data[i]; }
  if (!m) return;
  curMtgId = id;
  document.getElementById("m-title").value = m.title || "";
  document.getElementById("m-dt").value = (m.datetime || "").slice(0, 16);
  document.getElementById("m-in").value = m.attendees_in || "";
  document.getElementById("m-out").value = m.attendees_out || "";
  document.getElementById("m-pj").value = m.project || "";
  document.getElementById("m-purpose").value = m.purpose || "";
  document.getElementById("m-disc").value = m.discussion_raw || "";
  document.getElementById("m-dec").value = m.decisions || "";
  document.getElementById("m-todo").value = m.todos || "";
  document.getElementById("mtg-form-title").innerText = "EDIT: " + m.title;
  renderMtgList();
}

