var curDlId = null;

function newDelegation() {
  curDlId = null;
  var ids = ["dl-assignee", "dl-pj", "dl-due", "dl-followup", "dl-instruction", "dl-purpose", "dl-output"];
  for (var i = 0; i < ids.length; i++) document.getElementById(ids[i]).value = "";
  document.getElementById("dl-form-title").innerText = "NEW DELEGATION";
}

function saveDelegation() {
  var instr = document.getElementById("dl-instruction").value.replace(/^\s+|\s+$/g,"");
  if (!instr) { toast("指示内容を入力してください"); return; }
  if (curDlId) {
    var data = readCSV("delegation_log");
    for (var i = 0; i < data.length; i++) {
      if (data[i].id === curDlId) {
        data[i].assignee = document.getElementById("dl-assignee").value;
        data[i].project = document.getElementById("dl-pj").value;
        data[i].priority = document.getElementById("dl-pri").value;
        data[i].due = document.getElementById("dl-due").value;
        data[i].channel = document.getElementById("dl-channel").value;
        data[i].followup = document.getElementById("dl-followup").value;
        data[i].instruction_raw = instr;
        data[i].purpose = document.getElementById("dl-purpose").value;
        data[i].output_image = document.getElementById("dl-output").value;
      }
    }
    writeCSV("delegation_log", data);
    toast("📤 指示を更新しました", "ok");
  } else {
    appendCSV("delegation_log", {
      id: genId("DL"), datetime: nowISO(), assignee: document.getElementById("dl-assignee").value,
      project: document.getElementById("dl-pj").value, priority: document.getElementById("dl-pri").value,
      due: document.getElementById("dl-due").value, channel: document.getElementById("dl-channel").value,
      followup: document.getElementById("dl-followup").value, instruction_raw: instr,
      purpose: document.getElementById("dl-purpose").value, output_image: document.getElementById("dl-output").value,
      status: "未送信", ai_message: ""
    });
    toast("📤 指示を保存しました", "ok");
  }
  renderDelegationList();
}

function renderDelegationList() {
  var data = readCSV("delegation_log").reverse();
  document.getElementById("dl-badge").innerText = data.length;
  var list = document.getElementById("dl-list");
  if (!data.length) { list.innerHTML = '<div class="empty"><div class="empty-icon">📤</div>指示なし</div>'; return; }
  var stClr = { "未送信": "var(--red)", "送信済": "var(--amber)", "進行中": "var(--cyan)", "完了": "var(--green)" };
  list.innerHTML = data.map(function(d) {
    return '<div class="list-item' + (d.id === curDlId ? " sel" : "") + '" onclick="loadDelegation(\'' + d.id + '\')">' +
      '<div style="display:flex;align-items:center;gap:6px">' +
        '<span style="width:6px;height:6px;border-radius:50%;background:' + (stClr[d.status] || "var(--text-muted)") + '"></span>' +
        '<span class="list-title">' + esc(d.assignee || "?") + ' — ' + esc(d.instruction_raw.slice(0, 30)) + '</span>' +
      '</div>' +
      '<div class="list-meta">' + d.status + ' · ' + fmtDT(d.datetime) + (d.due ? ' · 〆' + fmtD(d.due) : '') + '</div>' +
    '</div>';
  }).join("");
}

function loadDelegation(id) {
  var data = readCSV("delegation_log");
  var d = null;
  for (var i = 0; i < data.length; i++) { if (data[i].id === id) d = data[i]; }
  if (!d) return;
  curDlId = id;
  document.getElementById("dl-assignee").value = d.assignee || "";
  document.getElementById("dl-pj").value = d.project || "";
  document.getElementById("dl-pri").value = d.priority || "A";
  document.getElementById("dl-due").value = d.due || "";
  document.getElementById("dl-channel").value = d.channel || "Teams_DM";
  document.getElementById("dl-followup").value = d.followup || "";
  document.getElementById("dl-instruction").value = d.instruction_raw || "";
  document.getElementById("dl-purpose").value = d.purpose || "";
  document.getElementById("dl-output").value = d.output_image || "";
  document.getElementById("dl-form-title").innerText = "EDIT: " + d.assignee;
  renderDelegationList();
}

