function renderClients(filter) {
  var data = readCSV("client_master");
  document.getElementById("cl-badge").innerText = data.length;
  if (filter) data = data.filter(function(c) { return c.name.indexOf(filter) >= 0 || (c.key_person || "").indexOf(filter) >= 0; });
  var list = document.getElementById("cl-list");
  if (!data.length) { list.innerHTML = '<div class="empty"><div class="empty-icon">👤</div>顧客なし</div>'; return; }
  var relClr = { "1": "var(--text-muted)", "2": "var(--text-secondary)", "3": "var(--cyan)", "4": "var(--amber)", "5": "var(--green)" };
  list.innerHTML = data.map(function(c) {
    return '<div class="list-item" onclick="showClient(\'' + c.id + '\')">' +
      '<div style="display:flex;align-items:center;gap:6px">' +
        '<span style="width:6px;height:6px;border-radius:50%;background:' + (relClr[c.relation_score] || "var(--text-muted)") + '"></span>' +
        '<span class="list-title">' + esc(c.name) + '</span>' +
      '</div>' +
      '<div class="list-meta">' + (c.industry || "") + ' · ' + (c.key_person || "") + ' · ' + (c.sales_phase || "") + '</div>' +
    '</div>';
  }).join("");
}

function showClient(id) {
  var data = readCSV("client_master");
  var c = null;
  for (var i = 0; i < data.length; i++) { if (data[i].id === id) c = data[i]; }
  if (!c) return;
  // 関連案件・会議・タスクを取得
  var pjs = readCSV("project_master").filter(function(p) { return p.client === c.name; });
  var mtgs = readCSV("meeting_minutes").filter(function(m) { return m.project && pjs.some(function(p) { return p.id === m.project; }); });
  var det = document.getElementById("cl-detail");
  det.innerHTML =
    '<div class="sec-lbl">' + esc(c.name) + ' — CUSTOMER CARD</div>' +
    '<div class="g2" style="margin-top:8px">' +
      '<div class="stat-card"><div class="stat-lbl">KEY PERSON</div><div style="font-size:14px;font-weight:500">' + esc(c.key_person || "—") + '</div><div class="stat-sub">' + esc(c.key_title || "") + ' · ' + esc(c.division || "") + '</div></div>' +
      '<div class="stat-card cy"><div class="stat-lbl">RELATION SCORE</div><div class="stat-val">' + (c.relation_score || "?") + '</div><div class="stat-sub">' + esc(c.sales_phase || "") + '</div></div>' +
    '</div>' +
    '<div class="g2" style="margin-top:8px">' +
      '<div class="panel" style="padding:12px"><div class="panel-title" style="margin-bottom:6px">基本情報</div>' +
        '<div style="font-size:11px;color:var(--text-secondary);line-height:1.8">' +
          '業種: ' + esc(c.industry || "") + '<br>' +
          '売上規模: ' + esc(c.revenue_scale || "") + '<br>' +
          'Email: ' + esc(c.email || "") + '<br>' +
          'TEL: ' + esc(c.tel || "") +
        '</div></div>' +
      '<div class="panel" style="padding:12px"><div class="panel-title" style="margin-bottom:6px">課題サマリー</div>' +
        '<div style="font-size:11px;color:var(--text-secondary);line-height:1.6">' + esc(c.pain_summary || "未記入") + '</div></div>' +
    '</div>' +
    (c.memo ? '<div class="panel" style="padding:12px;margin-top:8px"><div class="panel-title" style="margin-bottom:6px">関係者メモ</div><div style="font-size:11px;color:var(--text-secondary);line-height:1.6">' + esc(c.memo) + '</div></div>' : '') +
    '<div class="sec-lbl" style="margin-top:12px">関連案件 (' + pjs.length + ')</div>' +
    (pjs.length ? pjs.map(function(p) {
      return '<div class="pj-card" style="margin-top:4px"><div class="pj-name">' + esc(p.name) + '</div><div class="pj-meta">' + p.phase + ' · ' + p.type + (p.fee ? ' · ' + p.fee + '万円' : '') + '</div></div>';
    }).join("") : '<div style="color:var(--text-muted);font-size:11px;padding:8px">なし</div>');
}

// ═══════════════════════════════════════════
// RISK LOG
// ═══════════════════════════════════════════
function saveRisk() {
  var title = document.getElementById("rk-title").value.replace(/^\s+|\s+$/g,"");
  if (!title) { toast("リスク名を入力してください"); return; }
  appendCSV("risk_log", {
    id: genId("RK"), datetime: nowISO(), project: document.getElementById("rk-pj").value,
    title: title, category: document.getElementById("rk-cat").value,
    probability: document.getElementById("rk-prob").value, impact: document.getElementById("rk-impact").value,
    description: document.getElementById("rk-desc").value, countermeasure: document.getElementById("rk-counter").value,
    status: "監視中"
  });
  closeModal("risk-modal");
  toast("⚠ リスクを追加しました", "ok");
  renderRisks();
  var clrIds = ["rk-title", "rk-pj", "rk-desc", "rk-counter"];
  for (var i = 0; i < clrIds.length; i++) document.getElementById(clrIds[i]).value = "";
}

function renderRisks() {
  var data = readCSV("risk_log").filter(function(r) { return r.status !== "クローズ"; });
  document.getElementById("rk-badge").innerText = data.length;
  var list = document.getElementById("rk-list");
  if (!data.length) { list.innerHTML = '<div class="empty"><div class="empty-icon">⚠</div>リスクなし</div>'; return; }
  var probClr = { "高": "var(--red)", "中": "var(--amber)", "低": "var(--green)" };
  list.innerHTML = data.map(function(r) {
    return '<div class="list-item" onclick="showRisk(\'' + r.id + '\')">' +
      '<div style="display:flex;align-items:center;gap:6px">' +
        '<span style="width:6px;height:6px;border-radius:50%;background:' + (probClr[r.probability] || "var(--text-muted)") + '"></span>' +
        '<span class="list-title">' + esc(r.title) + '</span>' +
      '</div>' +
      '<div class="list-meta">' + r.category + ' · 確率:' + r.probability + ' · 影響:' + r.impact + (r.project ? ' · ' + r.project : '') + '</div>' +
    '</div>';
  }).join("");
}

function showRisk(id) {
  var data = readCSV("risk_log");
  var r = null;
  for (var i = 0; i < data.length; i++) { if (data[i].id === id) r = data[i]; }
  if (!r) return;
  var probClr = { "高": "var(--red)", "中": "var(--amber)", "低": "var(--green)" };
  var impClr = { "致命的": "var(--red)", "大": "var(--amber)", "中": "var(--cyan)", "小": "var(--green)" };
  var det = document.getElementById("rk-detail");
  det.innerHTML =
    '<div class="sec-lbl">⚠ ' + esc(r.title) + '</div>' +
    '<div class="g3" style="margin-top:8px">' +
      '<div class="stat-card"><div class="stat-lbl">発生確率</div><div class="stat-val" style="color:' + (probClr[r.probability] || "") + '">' + r.probability + '</div></div>' +
      '<div class="stat-card"><div class="stat-lbl">影響度</div><div class="stat-val" style="color:' + (impClr[r.impact] || "") + '">' + r.impact + '</div></div>' +
      '<div class="stat-card"><div class="stat-lbl">ステータス</div><div style="font-size:16px;font-weight:bold;margin-top:8px">' + r.status + '</div></div>' +
    '</div>' +
    '<div class="panel" style="padding:12px;margin-top:8px"><div class="panel-title" style="margin-bottom:6px">リスク詳細</div><div style="font-size:12px;line-height:1.6;color:var(--text-secondary)">' + esc(r.description || "未記入") + '</div></div>' +
    '<div class="panel" style="padding:12px;margin-top:8px"><div class="panel-title" style="margin-bottom:6px">対応策</div><div style="font-size:12px;line-height:1.6;color:var(--text-secondary)">' + esc(r.countermeasure || "未記入") + '</div></div>' +
    '<div style="margin-top:12px;display:flex;gap:6px">' +
      '<button class="btn btn-ghost btn-sm" onclick="updateRiskStatus(\'' + r.id + '\',\'対応中\')">対応中にする</button>' +
      '<button class="btn btn-ghost btn-sm" onclick="updateRiskStatus(\'' + r.id + '\',\'軽減済\')">軽減済</button>' +
      '<button class="btn btn-danger btn-sm" onclick="updateRiskStatus(\'' + r.id + '\',\'クローズ\')">クローズ</button>' +
    '</div>';
}

function updateRiskStatus(id, status) {
  var data = readCSV("risk_log");
  for (var i = 0; i < data.length; i++) { if (data[i].id === id) data[i].status = status; }
  writeCSV("risk_log", data);
  toast("⚠ ステータスを更新しました", "ok");
  renderRisks();
  showRisk(id);
}

// ═══════════════════════════════════════════
// KNOWLEDGE BASE
// ═══════════════════════════════════════════
function saveKnowledge() {
  var title = document.getElementById("kb-title").value.replace(/^\s+|\s+$/g,"");
  var content = document.getElementById("kb-content").value.replace(/^\s+|\s+$/g,"");
  if (!title || !content) { toast("タイトルと内容を入力してください"); return; }
  appendCSV("knowledge_base", {
    id: genId("KB"), datetime: nowISO(), category: document.getElementById("kb-cat").value,
    title: title, project: document.getElementById("kb-pj").value,
    content: content, source: document.getElementById("kb-source").value,
    tags: document.getElementById("kb-tags").value, ai_summary: ""
  });
  toast("📖 ナレッジを保存しました", "ok");
  var clrIds = ["kb-title", "kb-pj", "kb-content", "kb-source", "kb-tags"];
  for (var i = 0; i < clrIds.length; i++) document.getElementById(clrIds[i]).value = "";
  renderKnowledge("");
}

function renderKnowledge(filter) {
  var data = readCSV("knowledge_base").reverse();
  document.getElementById("kb-badge").innerText = data.length;
  if (filter) data = data.filter(function(k) { return k.title.indexOf(filter) >= 0 || k.content.indexOf(filter) >= 0 || (k.tags || "").indexOf(filter) >= 0; });
  var list = document.getElementById("kb-list");
  if (!data.length) { list.innerHTML = '<div class="empty"><div class="empty-icon">📖</div>ナレッジなし</div>'; return; }
  list.innerHTML = data.map(function(k) {
    var tags = k.tags ? k.tags.split(";").filter(Boolean) : [];
    return '<div class="log-item">' +
      '<div class="log-hdr">' +
        '<span class="fw-badge">' + k.category + '</span>' +
        '<span style="flex:1;font-size:12px;font-weight:500">' + esc(k.title) + '</span>' +
        '<span class="log-time">' + fmtDT(k.datetime) + '</span>' +
      '</div>' +
      '<div class="log-body">' + esc(k.content.slice(0, 150)) + (k.content.length > 150 ? "..." : "") + '</div>' +
      (k.source ? '<div style="font-family:var(--font-mono);font-size:9px;color:var(--text-muted);margin-top:3px">📌 ' + esc(k.source) + '</div>' : '') +
      (tags.length ? '<div class="log-tags">' + tags.map(function(t) { return '<span class="tag" style="font-size:8px;padding:1px 4px">' + t + '</span>'; }).join("") + '</div>' : '') +
    '</div>';
  }).join("");
}

// ═══════════════════════════════════════════
// WEEKLY REVIEW
// ═══════════════════════════════════════════
function generateWeeklyReport() {
  var now = new Date();
  var weekAgo = new Date(now.getTime() - 7 * 24 * 60 * 60 * 1000);
  var weekAgoISO = weekAgo.toISOString();

  var thoughts = readCSV("thought_log").filter(function(t) { return t.datetime >= weekAgoISO; });
  var tasks = readCSV("task_log");
  var completedTasks = tasks.filter(function(t) { return t.status === "完了" && t.datetime >= weekAgoISO; });
  var openTasks = tasks.filter(function(t) { return t.status !== "完了" && t.status !== "中止"; });
  var mtgs = readCSV("meeting_minutes").filter(function(m) { return m.datetime >= weekAgoISO; });
  var inbox = readCSV("intelligence_inbox").filter(function(i) { return i.datetime >= weekAgoISO; });
  var risks = readCSV("risk_log").filter(function(r) { return r.status !== "クローズ"; });

  // 思考の種類別カウント
  var typeCounts = {};
  for (var i = 0; i < thoughts.length; i++) {
    var tp = thoughts[i].type || "その他";
    typeCounts[tp] = (typeCounts[tp] || 0) + 1;
  }
  var typeHtml = "";
  for (var tp2 in typeCounts) {
    if (typeCounts.hasOwnProperty(tp2)) typeHtml += '<span class="type-badge type-' + tp2 + '" style="margin-right:4px">' + tp2 + ': ' + typeCounts[tp2] + '</span>';
  }

  var el = document.getElementById("weekly-content");
  el.innerHTML =
    '<div class="g4">' +
      '<div class="stat-card"><div class="stat-lbl">今週の思考</div><div class="stat-val">' + thoughts.length + '</div></div>' +
      '<div class="stat-card cy"><div class="stat-lbl">完了タスク</div><div class="stat-val">' + completedTasks.length + '</div></div>' +
      '<div class="stat-card gn"><div class="stat-lbl">MTG数</div><div class="stat-val">' + mtgs.length + '</div></div>' +
      '<div class="stat-card rd"><div class="stat-lbl">アクティブリスク</div><div class="stat-val">' + risks.length + '</div></div>' +
    '</div>' +
    '<div class="wr-section"><div class="wr-title">思考の種類分布</div>' + (typeHtml || '<span style="color:var(--text-muted)">データなし</span>') + '</div>' +
    '<div class="wr-section"><div class="wr-title">残タスク (' + openTasks.length + '件)</div>' +
      (openTasks.length ? openTasks.slice(0, 10).map(function(t) {
        var pClr = { S: "var(--red)", A: "var(--amber)", B: "var(--cyan)", C: "var(--text-muted)" };
        return '<div style="display:flex;align-items:center;gap:8px;padding:4px 0;font-size:11px">' +
          '<span style="width:6px;height:6px;border-radius:50%;background:' + (pClr[t.priority] || "") + '"></span>' +
          '<span style="flex:1">' + esc(t.title) + '</span>' +
          '<span style="font-family:var(--font-mono);font-size:9px;color:var(--text-muted)">' + fmtD(t.due) + '</span></div>';
      }).join("") : '<div style="color:var(--text-muted);font-size:11px">なし</div>') +
    '</div>' +
    '<div class="wr-section"><div class="wr-title">今週の議事録</div>' +
      (mtgs.length ? mtgs.map(function(m) {
        return '<div style="padding:4px 0;font-size:11px">' + fmtDT(m.datetime) + ' — ' + esc(m.title) + '</div>';
      }).join("") : '<div style="color:var(--text-muted);font-size:11px">なし</div>') +
    '</div>' +
    '<div class="wr-section"><div class="wr-title">今週収集した情報 (' + inbox.length + '件)</div>' +
      (inbox.length ? inbox.slice(0, 8).map(function(item) {
        return '<div style="padding:3px 0;font-size:11px">' + esc(item.title.slice(0, 50)) + ' (' + item.category + ')</div>';
      }).join("") : '<div style="color:var(--text-muted);font-size:11px">なし</div>') +
    '</div>';
}

function copyWeeklyReport() {
  var el = document.getElementById("weekly-content");
  clipCopy(el.innerText);
  toast("📋 週次レポートをコピーしました", "cy");
}

// ═══════════════════════════════════════════
// GLOBAL SEARCH
// ═══════════════════════════════════════════
function globalSearch() {
  var q = document.getElementById("gs-q").value.replace(/^\s+|\s+$/g,"");
  if (!q) return;
  var results = [];
  var tables = [
    { name: "thought_log", label: "思考ログ", fields: ["content_raw", "tags", "type", "ai_summary"] },
    { name: "meeting_minutes", label: "議事録", fields: ["title", "discussion_raw", "decisions", "todos"] },
    { name: "intelligence_inbox", label: "インボックス", fields: ["title", "url_summary", "memo", "tags"] },
    { name: "task_log", label: "タスク", fields: ["title", "content"] },
    { name: "project_master", label: "案件", fields: ["name", "client", "hypothesis", "risk"] },
    { name: "client_master", label: "顧客", fields: ["name", "key_person", "pain_summary", "memo"] },
    { name: "delegation_log", label: "部下指示", fields: ["assignee", "instruction_raw", "purpose"] },
    { name: "risk_log", label: "リスク", fields: ["title", "description", "countermeasure"] },
    { name: "knowledge_base", label: "ナレッジ", fields: ["title", "content", "tags"] }
  ];
  for (var ti = 0; ti < tables.length; ti++) {
    var tbl = tables[ti];
    var rows = readCSV(tbl.name);
    for (var ri = 0; ri < rows.length; ri++) {
      var row = rows[ri];
      for (var fi = 0; fi < tbl.fields.length; fi++) {
        var val = row[tbl.fields[fi]] || "";
        if (val.indexOf(q) >= 0) {
          results.push({ source: tbl.label, id: row.id || "", text: val.slice(0, 200), dt: row.datetime || "" });
          break;
        }
      }
    }
  }
  var el = document.getElementById("gs-results");
  if (!results.length) { el.innerHTML = '<div class="empty" style="padding:20px"><div class="empty-icon">🔍</div>「' + esc(q) + '」が見つかりませんでした</div>'; return; }
  el.innerHTML = '<div style="font-family:var(--font-mono);font-size:9px;color:var(--text-muted);margin-bottom:8px">' + results.length + ' 件の結果</div>' +
    results.map(function(r) {
      var highlighted = esc(r.text).replace(new RegExp(esc(q), "gi"), '<span style="background:var(--amber-glow);color:var(--amber);padding:0 2px">$&</span>');
      return '<div class="sr-item"><div class="sr-source">' + r.source + (r.id ? ' · ' + r.id : '') + (r.dt ? ' · ' + fmtDT(r.dt) : '') + '</div><div class="sr-body">' + highlighted + '</div></div>';
    }).join("");
}

// ═══════════════════════════════════════════
// HOME DASHBOARD
// ═══════════════════════════════════════════
function renderHome() {
  var thoughts = readCSV("thought_log");
  var tasks = readCSV("task_log");
  var inbox = readCSV("intelligence_inbox");
  var risks = readCSV("risk_log").filter(function(r) { return r.status !== "クローズ"; });

  var todayPfx = todayISO();
  var todayLogs = thoughts.filter(function(t) { return t.datetime.indexOf(todayPfx) === 0; });
  var open = tasks.filter(function(t) { return t.status !== "完了" && t.status !== "中止"; });
  var sOpen = open.filter(function(t) { return t.priority === "S"; });
  var unread = inbox.filter(function(i) { return i.status === "未読"; });
  var highRisk = risks.filter(function(r) { return r.probability === "高"; });

  document.getElementById("st-logs").innerText = thoughts.length;
  document.getElementById("st-logs2").innerText = "今日: " + todayLogs.length + " 件";
  document.getElementById("st-tasks").innerText = open.length;
  document.getElementById("st-tasks2").innerText = "S優先: " + sOpen.length + " 件";
  document.getElementById("st-inbox").innerText = inbox.length;
  document.getElementById("st-inbox2").innerText = "未読: " + unread.length + " 件";
  document.getElementById("st-risks").innerText = risks.length;
  document.getElementById("st-risks2").innerText = "高: " + highRisk.length + " 件";

  // Tasks
  var sorted = open.slice().sort(function(a, b) { var p = { S: 0, A: 1, B: 2, C: 3 }; return (p[a.priority] || 3) - (p[b.priority] || 3); }).slice(0, 8);
  var dtEl = document.getElementById("dash-tasks");
  if (!sorted.length) { dtEl.innerHTML = '<div class="empty" style="padding:20px"><div class="empty-icon">◈</div>タスクなし</div>'; }
  else {
    var pClr = { S: "var(--red)", A: "var(--amber)", B: "var(--cyan)", C: "var(--text-muted)" };
    dtEl.innerHTML = sorted.map(function(t) {
      return '<div style="display:flex;align-items:center;gap:10px;padding:9px 14px;border-bottom:1px solid var(--border);cursor:pointer" onclick="go(\'tasks\')">' +
        '<div style="width:6px;height:6px;border-radius:50%;background:' + (pClr[t.priority] || "var(--text-muted)") + '"></div>' +
        '<span style="flex:1;font-size:12px">' + esc(t.title) + '</span>' +
        '<span style="font-family:var(--font-mono);font-size:10px;color:var(--text-muted)">' + fmtD(t.due) + '</span>' +
      '</div>';
    }).join("");
  }

  // Thoughts
  var recent = thoughts.slice().reverse().slice(0, 5);
  var thEl = document.getElementById("dash-thoughts");
  if (!recent.length) { thEl.innerHTML = '<div class="empty" style="padding:20px"><div class="empty-icon">⚡</div>思考ログなし</div>'; }
  else {
    thEl.innerHTML = recent.map(function(t) {
      return '<div style="display:flex;align-items:center;gap:10px;padding:9px 14px;border-bottom:1px solid var(--border);cursor:pointer" onclick="go(\'capture\')">' +
        '<span class="type-badge type-' + t.type + '" style="font-size:8px;padding:1px 5px">' + t.type + '</span>' +
        '<span style="flex:1;font-size:11px">' + esc(t.content_raw.slice(0, 60)) + (t.content_raw.length > 60 ? "..." : "") + '</span>' +
        '<span style="font-family:var(--font-mono);font-size:9px;color:var(--text-muted)">' + fmtDT(t.datetime) + '</span>' +
      '</div>';
    }).join("");
  }

  // Projects overview
  var pjs = readCSV("project_master").filter(function(p) { return p.status !== "完了" && p.status !== "中止"; });
  var dpEl = document.getElementById("dash-projects");
  if (!pjs.length) { dpEl.innerHTML = '<div class="empty" style="padding:16px"><div class="empty-icon">◉</div>案件なし</div>'; }
  else {
    dpEl.innerHTML = pjs.slice(0, 6).map(function(p) {
      var priCls = { S: "pj-s", A: "pj-a", B: "pj-b" };
      return '<div style="display:flex;align-items:center;gap:10px;padding:9px 14px;border-bottom:1px solid var(--border);cursor:pointer" onclick="go(\'projects\')">' +
        '<span style="width:3px;height:24px;border-radius:1px;background:' + (p.priority === "S" ? "var(--red)" : p.priority === "A" ? "var(--amber)" : "var(--cyan)") + '"></span>' +
        '<span style="flex:1;font-size:12px">' + esc(p.name) + '</span>' +
        '<span style="font-family:var(--font-mono);font-size:9px;color:var(--text-muted)">' + p.phase + '</span>' +
        '<span style="font-family:var(--font-mono);font-size:9px;color:var(--text-secondary)">' + (p.fee ? p.fee + '万' : '') + '</span>' +
      '</div>';
    }).join("");
  }

  updateHdr();
}

function updateHdr() {
  var thoughts = readCSV("thought_log");
  var tasks = readCSV("task_log");
  var open = tasks.filter(function(t) { return t.status !== "完了" && t.status !== "中止"; });
  document.getElementById("hd-logs").innerText = thoughts.length + " LOGS";
  document.getElementById("hd-tasks").innerText = open.length + " TASKS";
  try { document.getElementById("hd-datapath").innerText = getRawDir(); } catch(e) {}
}

// ═══════════════════════════════════════════
// AI CONSOLE
// ═══════════════════════════════════════════
function updateFlow() {
  var aOk = document.getElementById("ck-a").checked;
  var bOk = document.getElementById("ck-b").checked;

  document.getElementById("arr-ab").className = "agent-arrow" + (aOk ? " ready" : "");
  document.getElementById("card-b").style.opacity = aOk ? "1" : "0.5";
  document.getElementById("badge-b").className = "ag-badge " + (aOk ? (bOk ? "bg-done" : "bg-ready") : "bg-wait");
  document.getElementById("badge-b").innerText = aOk ? (bOk ? "DONE" : "READY") : "WAITING";
  document.getElementById("btn-b-prev").disabled = !aOk;
  document.getElementById("btn-b-copy").disabled = !aOk;
  document.getElementById("ck-b").disabled = !aOk;

  document.getElementById("arr-bc").className = "agent-arrow" + (bOk ? " ready" : "");
  document.getElementById("card-c").style.opacity = bOk ? "1" : "0.5";
  document.getElementById("badge-c").className = "ag-badge " + (bOk ? "bg-ready" : "bg-wait");
  document.getElementById("badge-c").innerText = bOk ? "READY" : "WAITING";
  document.getElementById("btn-c-prev").disabled = !bOk;
  document.getElementById("btn-c-copy").disabled = !bOk;
  document.getElementById("ck-c").disabled = !bOk;
  document.getElementById("btn-final").disabled = !bOk;

  if (aOk) previewCSV("b");
  if (bOk) previewCSV("c");
}

function previewCSV(agent) {
  var el = document.getElementById("prev-" + agent);
  if (agent === "a") {
    var cnt = parseInt(document.getElementById("a-cnt").value) || 10;
    var txt = "# AGENT A INPUT\n";
    if (document.getElementById("a-logs").checked) {
      txt += "\n## thought_log_raw.csv（直近" + cnt + "件）\n";
      txt += "id,datetime,type,framework,urgency,context,content_raw,tags,project\n";
      var logs = readCSV("thought_log").slice(-cnt);
      for (var i = 0; i < logs.length; i++) {
        var r = logs[i];
        txt += '"' + r.id + '","' + r.datetime + '","' + r.type + '","' + (r.framework || "") + '","' + (r.urgency || "") + '","' + (r.context || "") + '","' + (r.content_raw || "").replace(/\n/g, "\\n") + '","' + (r.tags || "") + '","' + (r.project || "") + '"\n';
      }
    }
    if (document.getElementById("a-mtg").checked) {
      var unp = readCSV("meeting_minutes").filter(function(m) { return !m.ai_summary; });
      if (unp.length) {
        txt += "\n## meeting_minutes_raw.csv\n";
        for (var j = 0; j < unp.length; j++) {
          var m = unp[j];
          txt += '"' + m.id + '","' + m.datetime + '","' + m.title + '","' + (m.discussion_raw || "").replace(/\n/g, "\\n") + '","' + (m.decisions || "") + '","' + (m.todos || "") + '"\n';
        }
      }
    }
    if (document.getElementById("a-ib").checked) {
      var unpi = readCSV("intelligence_inbox").filter(function(ii) { return !ii.ai_summary; });
      if (unpi.length) {
        txt += "\n## intelligence_inbox.csv\n";
        for (var k = 0; k < unpi.length; k++) {
          var ii = unpi[k];
          txt += '"' + ii.id + '","' + ii.source_type + '","' + ii.title + '","' + (ii.url || "") + '","' + (ii.url_summary || "") + '","' + ii.category + '","' + (ii.tags || "") + '"\n';
        }
      }
    }
    el.innerText = txt.slice(0, 800) + (txt.length > 800 ? "\n...(省略)" : "");
    return txt;
  }
  if (agent === "b") {
    var aIn = document.getElementById("b-in").value;
    var txt2 = "# AGENT B INPUT\n" + aIn + "\n\n## framework_log（フレームワーク付きログ）\n";
    var fwLogs = readCSV("thought_log").filter(function(t) { return t.framework; }).slice(0, 5);
    for (var fi = 0; fi < fwLogs.length; fi++) {
      txt2 += '"' + fwLogs[fi].id + '","' + fwLogs[fi].framework + '","' + (fwLogs[fi].framework_data || "") + '"\n';
    }
    el.innerText = txt2.slice(0, 600);
    return txt2;
  }
  if (agent === "c") {
    var cIn = document.getElementById("c-in").value;
    var txt3 = "# AGENT C INPUT\n" + cIn;
    el.innerText = txt3.slice(0, 600);
    return txt3;
  }
}

function copyForAgent(agent) {
  var csv = previewCSV(agent);
  var prompt = document.getElementById("prompt-" + agent).value;
  var full = "【システムプロンプト】\n" + prompt + "\n\n【入力データ】\n" + csv;
  clipCopy(full);
  toast("📋 Agent " + agent.toUpperCase() + " へのプロンプト＋CSVをコピーしました", "cy");
}

function copyFinal() {
  var content = document.getElementById("c-in").value;
  clipCopy(content);
  toast("📋 最終出力をコピーしました", "ok");
}

function pCount(agent) {
  var ta = document.getElementById("prompt-" + agent);
  var badge = document.getElementById("pc-" + agent);
  if (!ta || !badge) return;
  var n = ta.value.length;
  badge.innerText = n + "/8000";
  badge.style.color = n > 7000 ? "var(--red)" : n > 6000 ? "var(--amber)" : "";
}

// ═══════════════════════════════════════════
// CSV COPY / CLIPBOARD
// ═══════════════════════════════════════════
function copyCSV(name) {
  var content = readCSVRaw(name);
  clipCopy(content);
  toast("📋 " + name + ".csv をコピーしました", "cy");
}

function clipCopy(text) {
  try {
    window.clipboardData.setData("Text", text);
  } catch(e) {
    try {
      var ta = document.createElement("textarea");
      ta.value = text;
      document.body.appendChild(ta);
      ta.select();
      document.execCommand("copy");
      document.body.removeChild(ta);
    } catch(e2) { toast("コピーに失敗しました", "err"); }
  }
}

// ═══════════════════════════════════════════
// UTIL
// ═══════════════════════════════════════════
function esc(s) {
  return String(s || "").replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
}

// ═══════════════════════════════════════════
// KEYBOARD
// ═══════════════════════════════════════════
document.onkeydown = function(e) {
  if ((e.ctrlKey || e.metaKey) && e.keyCode === 13) {
    var sc = document.querySelector(".screen.active");
    if (sc && sc.id === "screen-capture") saveThought();
  }
  if (e.keyCode === 27) {
    var modals = document.querySelectorAll(".modal-overlay.open");
    for (var i = 0; i < modals.length; i++) modals[i].className = modals[i].className.replace(" open", "");
  }
};

// ═══════════════════════════════════════════
// INIT
// ═══════════════════════════════════════════
function init() {
  try { getDataDir(); getRawDir(); getAiDir(); } catch(e) { toast("データフォルダ作成エラー: " + e.message, "err"); }
  try { document.getElementById("hd-datapath").innerText = getRawDir(); } catch(e) {}

  renderHome();
  newMtg();
  newDelegation();
  pCount("a"); pCount("b"); pCount("c");

  setTimeout(function() { toast("⚡ Ctrl+Enter で即時記録 | データ: " + getRawDir()); }, 2000);
}

window.onload = init;
</script>
</body>
</html>
