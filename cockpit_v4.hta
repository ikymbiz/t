<html>
<head>
<meta charset="UTF-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<title>COCKPIT — 戦略コンサルタント統合管理システム</title>
<HTA:APPLICATION
  APPLICATIONNAME="COCKPIT"
  ID="COCKPIT"
  VERSION="4.0"
  BORDER="thin"
  BORDERSTYLE="normal"
  WINDOWSTATE="maximize"
  SCROLL="no"
  SINGLEINSTANCE="yes"
  SHOWINTASKBAR="yes"
/>
<style>
:root {
  --bg-void:#080a0e; --bg-base:#0d1117; --bg-panel:#111720;
  --bg-card:#161d2a; --bg-hover:#1c2535; --bg-input:#0a0e15;
  --amber:#f0a500; --amber-dim:#c88800; --amber-glow:rgba(240,165,0,0.15);
  --cyan:#00c8ff; --cyan-glow:rgba(0,200,255,0.12);
  --green:#00e676; --green-dim:#00b85a; --red:#ff3d5a;
  --text-primary:#e8edf5; --text-secondary:#8892a4;
  --text-muted:#4a5568; --text-amber:#f0a500; --text-cyan:#00c8ff;
  --border:#1e2d42; --border-bright:#2a3d57;
  --border-amber:rgba(240,165,0,0.3); --border-cyan:rgba(0,200,255,0.25);
  --sidebar-w:64px; --header-h:48px;
  --font-mono:'Consolas','MS Gothic',monospace;
  --font-ui:'Meiryo','Segoe UI',sans-serif;
  --font-display:'Segoe UI',sans-serif;
  --radius:3px;
}
*{margin:0;padding:0;box-sizing:border-box;}
body{background:var(--bg-void);color:var(--text-primary);font-family:var(--font-ui);font-size:13px;height:100vh;overflow:hidden;display:flex;flex-direction:column;}
#header{height:var(--header-h);background:var(--bg-base);border-bottom:1px solid var(--border);display:flex;align-items:center;padding:0 16px 0 0;flex-shrink:0;z-index:100;}
.logo-wrap{width:var(--sidebar-w);height:100%;display:flex;align-items:center;justify-content:center;border-right:1px solid var(--border);flex-shrink:0;}
.logo-mark{font-family:var(--font-display);font-size:22px;letter-spacing:2px;color:var(--amber);font-weight:bold;}
.header-title{padding:0 20px;display:flex;align-items:baseline;gap:10px;flex:1;}
.header-title h1{font-family:var(--font-display);font-size:18px;letter-spacing:3px;font-weight:bold;}
.header-sub{font-family:var(--font-mono);font-size:10px;color:var(--text-muted);letter-spacing:2px;}
.header-right{display:flex;align-items:center;gap:16px;margin-left:auto;}
.status-item{display:flex;align-items:center;gap:6px;font-family:var(--font-mono);font-size:10px;color:var(--text-secondary);}
.dot{width:6px;height:6px;border-radius:50%;background:var(--green);box-shadow:0 0 8px var(--green);animation:pulse 2s infinite;}
.dot.amber{background:var(--amber);box-shadow:0 0 8px var(--amber);}
@keyframes pulse{0%,100%{opacity:1;}50%{opacity:.4;}}
#clock{font-family:var(--font-mono);font-size:11px;color:var(--amber);letter-spacing:1px;}
#app{display:flex;flex:1;overflow:hidden;}
#sidebar{width:var(--sidebar-w);background:var(--bg-base);border-right:1px solid var(--border);display:flex;flex-direction:column;align-items:center;padding:8px 0;gap:4px;flex-shrink:0;overflow-y:auto;}
.nav-btn{width:44px;height:44px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;cursor:pointer;border-radius:var(--radius);border:1px solid transparent;background:transparent;color:var(--text-muted);transition:all .15s;}
.nav-btn:hover{background:var(--bg-hover);color:var(--text-secondary);border-color:var(--border);}
.nav-btn.active{background:var(--amber-glow);color:var(--amber);border-color:var(--border-amber);}
.nav-icon{font-size:16px;line-height:1;}
.nav-label{font-family:var(--font-mono);font-size:7px;letter-spacing:.5px;}
.nav-sep{width:32px;height:1px;background:var(--border);margin:4px 0;}
#main{flex:1;display:flex;flex-direction:column;overflow:hidden;}
.screen{display:none;flex:1;overflow:hidden;}
.screen.active{display:flex;}
.panel{background:var(--bg-panel);border:1px solid var(--border);border-radius:var(--radius);}
.panel-hdr{padding:10px 14px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:8px;}
.panel-title{font-family:var(--font-mono);font-size:10px;letter-spacing:2px;color:var(--text-amber);text-transform:uppercase;}
.badge{font-family:var(--font-mono);font-size:9px;background:var(--amber-glow);color:var(--amber);border:1px solid var(--border-amber);padding:1px 6px;border-radius:2px;}
.fg{display:flex;flex-direction:column;gap:4px;}
label.lbl{font-family:var(--font-mono);font-size:9px;letter-spacing:1.5px;color:var(--text-muted);text-transform:uppercase;}
input[type=text],input[type=date],input[type=datetime-local],input[type=url],input[type=number],textarea,select{background:var(--bg-input);border:1px solid var(--border);border-radius:var(--radius);color:var(--text-primary);font-family:var(--font-ui);font-size:13px;padding:7px 10px;outline:none;transition:border-color .15s;width:100%;}
input:focus,textarea:focus,select:focus{border-color:var(--amber-dim);box-shadow:0 0 0 2px var(--amber-glow);}
textarea{resize:vertical;min-height:70px;line-height:1.6;}
select option{background:var(--bg-panel);}
.btn{display:inline-flex;align-items:center;gap:6px;padding:7px 14px;border:1px solid;border-radius:var(--radius);font-family:var(--font-mono);font-size:10px;letter-spacing:1px;cursor:pointer;transition:all .15s;text-transform:uppercase;white-space:nowrap;}
.btn-primary{background:var(--amber);border-color:var(--amber);color:var(--bg-void);font-weight:700;}
.btn-primary:hover{background:#ffc030;}
.btn-ghost{background:transparent;border-color:var(--border-bright);color:var(--text-secondary);}
.btn-ghost:hover{border-color:var(--amber-dim);color:var(--amber);}
.btn-cyan{background:var(--cyan-glow);border-color:var(--border-cyan);color:var(--cyan);}
.btn-danger{background:transparent;border-color:rgba(255,61,90,.3);color:var(--red);}
.btn-sm{padding:4px 10px;font-size:9px;}
.btn-xs{padding:3px 8px;font-size:9px;}
.tag{font-family:var(--font-mono);font-size:9px;padding:2px 8px;border-radius:2px;background:var(--bg-card);border:1px solid var(--border);color:var(--text-secondary);cursor:pointer;transition:all .1s;display:inline-block;}
.tag:hover,.tag.active{border-color:var(--border-amber);color:var(--amber);background:var(--amber-glow);}
#toast{position:fixed;bottom:24px;right:24px;z-index:9999;display:flex;flex-direction:column;gap:8px;pointer-events:none;}
.toast-msg{background:var(--bg-card);border:1px solid var(--border-amber);color:var(--text-amber);font-family:var(--font-mono);font-size:11px;padding:10px 16px;border-radius:var(--radius);animation:tIn .2s ease,tOut .3s ease 2.5s forwards;}
.toast-msg.ok{border-color:rgba(0,230,118,.4);color:var(--green);}
.toast-msg.cy{border-color:var(--border-cyan);color:var(--cyan);}
.toast-msg.err{border-color:rgba(255,61,90,.4);color:var(--red);}
@keyframes tIn{from{opacity:0;transform:translateX(20px);}to{opacity:1;transform:none;}}
@keyframes tOut{to{opacity:0;transform:translateX(20px);}}
.sec-lbl{font-family:var(--font-mono);font-size:9px;letter-spacing:2px;color:var(--text-muted);text-transform:uppercase;display:flex;align-items:center;gap:8px;}
.sec-lbl::after{content:'';flex:1;height:1px;background:var(--border);}
.empty{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;padding:40px;color:var(--text-muted);font-family:var(--font-mono);font-size:10px;letter-spacing:1px;}
.empty-icon{font-size:32px;opacity:.3;}
.search-row{display:flex;align-items:center;gap:6px;padding:6px 10px;border-bottom:1px solid var(--border);background:var(--bg-base);}
.search-row input{flex:1;background:transparent;border:none;padding:0;font-size:12px;}
.search-row input:focus{box-shadow:none;}
::-webkit-scrollbar{width:4px;height:4px;}
::-webkit-scrollbar-track{background:transparent;}
::-webkit-scrollbar-thumb{background:var(--border-bright);border-radius:2px;}
.log-item{background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);padding:10px 12px;cursor:pointer;transition:border-color .1s;margin-bottom:6px;}
.log-item:hover{border-color:var(--border-bright);background:var(--bg-hover);}
.log-item.has-ai{border-left:2px solid var(--cyan);}
.log-hdr{display:flex;align-items:center;gap:6px;margin-bottom:5px;}
.type-badge{font-family:var(--font-mono);font-size:8px;letter-spacing:1px;padding:1px 6px;border-radius:2px;text-transform:uppercase;}
.type-仮説,.type-学び{background:rgba(0,200,255,.1);color:var(--cyan);border:1px solid var(--border-cyan);}
.type-違和感,.type-リスク{background:rgba(255,61,90,.1);color:var(--red);border:1px solid rgba(255,61,90,.3);}
.type-閃き,.type-アイデア{background:rgba(240,165,0,.12);color:var(--amber);border:1px solid var(--border-amber);}
.type-問い,.type-決断{background:rgba(0,230,118,.1);color:var(--green);border:1px solid rgba(0,230,118,.3);}
.type-観察,.type-愚痴・ストレス{background:rgba(100,116,139,.15);color:var(--text-secondary);border:1px solid var(--border);}
.fw-badge{font-family:var(--font-mono);font-size:8px;padding:1px 5px;border-radius:2px;background:var(--amber-glow);color:var(--amber);border:1px solid var(--border-amber);}
.log-time{font-family:var(--font-mono);font-size:9px;color:var(--text-muted);margin-left:auto;}
.log-body{font-size:12px;line-height:1.5;}
.log-ai{font-family:var(--font-mono);font-size:9px;color:var(--cyan);margin-top:4px;}
.log-tags{margin-top:5px;display:flex;flex-wrap:wrap;gap:3px;}
.fw-panel{border:1px solid var(--border-amber);border-radius:var(--radius);background:var(--amber-glow);overflow:hidden;animation:fadeIn .2s ease;}
.fw-panel-hdr{padding:8px 12px;background:rgba(240,165,0,.08);border-bottom:1px solid var(--border-amber);font-family:var(--font-mono);font-size:9px;letter-spacing:2px;color:var(--amber);text-transform:uppercase;}
@keyframes fadeIn{from{opacity:0;transform:translateY(-4px);}to{opacity:1;transform:none;}}
.g2{display:grid;grid-template-columns:1fr 1fr;gap:8px;}
.g3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;}
.g4{display:grid;grid-template-columns:1fr 1fr 1fr 1fr;gap:8px;}
.span2{grid-column:1/-1;}
.matrix-grid{display:grid;grid-template-columns:1fr 1fr;grid-template-rows:1fr 1fr;gap:8px;flex:1;overflow:hidden;}
.m-cell{background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);overflow:hidden;display:flex;flex-direction:column;}
.m-hdr{padding:6px 10px;border-bottom:1px solid var(--border);font-family:var(--font-mono);font-size:9px;letter-spacing:1px;text-transform:uppercase;display:flex;align-items:center;gap:6px;}
.c-q1 .m-hdr{color:var(--red);}
.c-q2 .m-hdr{color:var(--amber);}
.c-q3 .m-hdr{color:var(--cyan);}
.c-q4 .m-hdr{color:var(--text-secondary);}
.m-body{flex:1;overflow-y:auto;padding:6px;display:flex;flex-direction:column;gap:4px;}
.m-task{background:var(--bg-panel);border:1px solid var(--border);border-radius:var(--radius);padding:6px 8px;font-size:11px;cursor:pointer;display:flex;align-items:center;gap:6px;}
.m-task:hover{background:var(--bg-hover);}
.done-btn{width:18px;height:18px;border:1px solid var(--border);border-radius:2px;cursor:pointer;background:transparent;flex-shrink:0;display:flex;align-items:center;justify-content:center;color:transparent;font-size:11px;transition:all .1s;}
.done-btn:hover{border-color:var(--green);color:var(--green);}
.done-btn.done{background:var(--green-dim);border-color:var(--green);color:white;}
.stat-card{background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);padding:14px;position:relative;overflow:hidden;}
.stat-card::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:var(--amber);}
.stat-card.cy::before{background:var(--cyan);}
.stat-card.gn::before{background:var(--green);}
.stat-card.rd::before{background:var(--red);}
.stat-lbl{font-family:var(--font-mono);font-size:9px;letter-spacing:2px;color:var(--text-muted);text-transform:uppercase;margin-bottom:8px;}
.stat-val{font-family:var(--font-display);font-size:36px;line-height:1;font-weight:bold;}
.stat-sub{font-family:var(--font-mono);font-size:9px;color:var(--text-secondary);margin-top:4px;}
.agent-flow{display:grid;grid-template-columns:1fr 40px 1fr 40px 1fr;align-items:start;gap:0;}
.agent-card{background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);overflow:hidden;transition:opacity .3s;}
.agent-hdr{padding:10px 14px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:8px;}
.agent-id{font-family:var(--font-display);font-size:20px;color:var(--amber);font-weight:bold;}
.agent-name .n{font-size:12px;font-weight:500;}
.agent-name .r{font-family:var(--font-mono);font-size:9px;color:var(--text-muted);letter-spacing:1px;}
.agent-body{padding:12px 14px;display:flex;flex-direction:column;gap:8px;}
.ab-lbl{font-family:var(--font-mono);font-size:8px;color:var(--text-muted);letter-spacing:1px;margin-bottom:3px;}
.io-chips{display:flex;flex-wrap:wrap;gap:3px;}
.chip{font-family:var(--font-mono);font-size:8px;padding:2px 6px;border-radius:2px;background:var(--bg-panel);border:1px solid var(--border);color:var(--text-secondary);}
.chip.out{border-color:rgba(0,230,118,.3);color:var(--green);background:rgba(0,230,118,.05);}
.ag-badge{font-family:var(--font-mono);font-size:8px;padding:2px 7px;border-radius:2px;}
.bg-wait{background:rgba(100,116,139,.15);color:var(--text-secondary);border:1px solid var(--border);}
.bg-ready{background:var(--amber-glow);color:var(--amber);border:1px solid var(--border-amber);}
.bg-done{background:rgba(0,230,118,.1);color:var(--green);border:1px solid rgba(0,230,118,.3);}
.agent-arrow{display:flex;align-items:center;justify-content:center;font-size:20px;color:var(--border-bright);padding-top:40px;}
.agent-arrow.ready{color:var(--amber);}
.step-check{display:flex;align-items:center;gap:8px;padding:8px 10px;background:var(--bg-panel);border:1px solid var(--border);border-radius:var(--radius);}
.step-check input[type=checkbox]{width:16px;height:16px;accent-color:var(--amber);}
.csv-box{background:var(--bg-input);border:1px solid var(--border);border-radius:var(--radius);padding:6px 8px;font-family:var(--font-mono);font-size:8px;color:var(--text-muted);line-height:1.5;max-height:100px;overflow-y:auto;white-space:pre;}
.modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,.75);z-index:500;display:none;align-items:center;justify-content:center;}
.modal-overlay.open{display:flex;}
.modal{background:var(--bg-panel);border:1px solid var(--border-bright);border-radius:var(--radius);width:640px;max-width:95vw;max-height:85vh;display:flex;flex-direction:column;box-shadow:0 4px 40px rgba(0,0,0,.8);}
.modal-hdr{padding:12px 16px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;}
.modal-title{font-family:var(--font-mono);font-size:11px;letter-spacing:2px;color:var(--amber);text-transform:uppercase;}
.modal-x{background:none;border:none;color:var(--text-muted);cursor:pointer;font-size:16px;padding:4px;}
.modal-x:hover{color:var(--text-primary);}
.modal-body{padding:16px;overflow-y:auto;flex:1;display:flex;flex-direction:column;gap:10px;}
.modal-foot{padding:12px 16px;border-bottom:none;border-top:1px solid var(--border);display:flex;gap:8px;justify-content:flex-end;}
.filepath-box{background:var(--bg-input);border:1px solid var(--border-bright);border-radius:var(--radius);padding:8px 10px;font-family:var(--font-mono);font-size:10px;color:var(--text-secondary);word-break:break-all;}
.mtg-item{padding:10px 14px;border-bottom:1px solid var(--border);cursor:pointer;transition:background .1s;}
.mtg-item:hover{background:var(--bg-hover);}
.mtg-item.sel{background:var(--amber-glow);border-left:2px solid var(--amber);}
.mtg-name{font-size:12px;margin-bottom:3px;}
.mtg-meta{font-family:var(--font-mono);font-size:9px;color:var(--text-muted);}
.inbox-item{padding:10px 14px;border-bottom:1px solid var(--border);cursor:pointer;transition:background .1s;}
.inbox-item:hover{background:var(--bg-hover);}
.inbox-item.sel{background:var(--amber-glow);border-left:2px solid var(--amber);}
.inbox-hdr{display:flex;align-items:center;gap:6px;margin-bottom:3px;}
.inbox-title{font-size:12px;flex:1;line-height:1.3;}
.inbox-meta{font-family:var(--font-mono);font-size:9px;color:var(--text-muted);}
.st-badge{font-family:var(--font-mono);font-size:8px;padding:1px 5px;border-radius:2px;}
.st-未読{background:rgba(255,61,90,.1);color:var(--red);border:1px solid rgba(255,61,90,.3);}
.st-読了{background:rgba(100,116,139,.15);color:var(--text-secondary);border:1px solid var(--border);}
.st-AI処理済{background:var(--cyan-glow);color:var(--cyan);border:1px solid var(--border-cyan);}
.drop-zone{border:2px dashed var(--border-bright);border-radius:var(--radius);padding:24px 16px;text-align:center;cursor:pointer;transition:all .2s;background:var(--bg-input);}
.drop-zone.over{border-color:var(--amber);background:var(--amber-glow);}
.drop-icon{font-size:28px;margin-bottom:8px;opacity:.6;}
.drop-txt{font-family:var(--font-mono);font-size:10px;color:var(--text-muted);letter-spacing:1px;}
.char-cnt{font-family:var(--font-mono);font-size:9px;color:var(--text-muted);text-align:right;}
.pj-card{background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);padding:10px 12px;cursor:pointer;transition:all .15s;margin-bottom:6px;}
.pj-card:hover{border-color:var(--border-bright);}
.pj-s{border-left:2px solid var(--red);}
.pj-a{border-left:2px solid var(--amber);}
.pj-b{border-left:2px solid var(--cyan);}
.pj-name{font-size:12px;font-weight:500;margin-bottom:3px;}
.pj-meta{font-family:var(--font-mono);font-size:9px;color:var(--text-muted);}
.pj-bar{height:2px;background:var(--border);border-radius:1px;margin-top:6px;}
.pj-fill{height:100%;background:var(--amber);border-radius:1px;}
.qtags{display:flex;flex-wrap:wrap;gap:4px;margin-top:4px;}
/* LIST ITEM generic */
.list-item{padding:10px 14px;border-bottom:1px solid var(--border);cursor:pointer;transition:background .1s;}
.list-item:hover{background:var(--bg-hover);}
.list-item.sel{background:var(--amber-glow);border-left:2px solid var(--amber);}
.list-title{font-size:12px;margin-bottom:3px;}
.list-meta{font-family:var(--font-mono);font-size:9px;color:var(--text-muted);}
/* RISK COLORS */
.risk-high{color:var(--red);}
.risk-mid{color:var(--amber);}
.risk-low{color:var(--green);}
/* SEARCH RESULTS */
.sr-item{background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);padding:10px;margin-bottom:6px;}
.sr-source{font-family:var(--font-mono);font-size:8px;color:var(--amber);letter-spacing:1px;margin-bottom:4px;}
.sr-body{font-size:11px;line-height:1.5;color:var(--text-secondary);}
/* WEEKLY REVIEW */
.wr-section{background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);padding:14px;margin-bottom:8px;}
.wr-title{font-family:var(--font-mono);font-size:10px;color:var(--amber);letter-spacing:1.5px;margin-bottom:8px;text-transform:uppercase;}
</style>
</head>
<body>

<div id="header">
  <div class="logo-wrap"><div class="logo-mark">CPT</div></div>
  <div class="header-title">
    <h1>COCKPIT</h1>
    <span class="header-sub">STRATEGIC CONSULTANT SYSTEM v4.0</span>
  </div>
  <div class="header-right">
    <div class="status-item"><div class="dot"></div><span id="hd-logs">0 LOGS</span></div>
    <div class="status-item"><div class="dot amber"></div><span id="hd-tasks">0 TASKS</span></div>
    <button class="btn btn-ghost btn-xs" onclick="openModal('search-modal')" style="margin-left:8px">🔍 全文検索</button>
    <div class="status-item"><div class="dot"></div><span id="hd-datapath" style="font-size:9px;max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap"></span></div>
    <div id="clock">--:--:--</div>
  </div>
</div>

<div id="app">
  <div id="sidebar">
    <div class="nav-btn active" id="nav-home" onclick="go('home')" title="ダッシュボード"><div class="nav-icon">⊞</div><div class="nav-label">HOME</div></div>
    <div class="nav-btn" id="nav-capture" onclick="go('capture')" title="思考キャプチャ"><div class="nav-icon">⚡</div><div class="nav-label">THINK</div></div>
    <div class="nav-sep"></div>
    <div class="nav-btn" id="nav-inbox" onclick="go('inbox')" title="情報インボックス"><div class="nav-icon">📥</div><div class="nav-label">INBOX</div></div>
    <div class="nav-btn" id="nav-meetings" onclick="go('meetings')" title="議事録"><div class="nav-icon">📋</div><div class="nav-label">MTG</div></div>
    <div class="nav-btn" id="nav-delegate" onclick="go('delegate')" title="部下指示"><div class="nav-icon">📤</div><div class="nav-label">指示</div></div>
    <div class="nav-sep"></div>
    <div class="nav-btn" id="nav-tasks" onclick="go('tasks')" title="タスク管理"><div class="nav-icon">◈</div><div class="nav-label">TASKS</div></div>
    <div class="nav-btn" id="nav-projects" onclick="go('projects')" title="案件管理"><div class="nav-icon">◉</div><div class="nav-label">PJ</div></div>
    <div class="nav-btn" id="nav-clients" onclick="go('clients')" title="顧客カルテ"><div class="nav-icon">👤</div><div class="nav-label">顧客</div></div>
    <div class="nav-btn" id="nav-risks" onclick="go('risks')" title="リスク管理"><div class="nav-icon">⚠</div><div class="nav-label">RISK</div></div>
    <div class="nav-sep"></div>
    <div class="nav-btn" id="nav-knowledge" onclick="go('knowledge')" title="ナレッジ"><div class="nav-icon">📖</div><div class="nav-label">知識</div></div>
    <div class="nav-btn" id="nav-review" onclick="go('review')" title="週次レビュー"><div class="nav-icon">📊</div><div class="nav-label">週次</div></div>
    <div class="nav-sep"></div>
    <div class="nav-btn" id="nav-ai" onclick="go('ai')" title="AIコンソール"><div class="nav-icon">🤖</div><div class="nav-label">AI</div></div>
    <div style="margin-top:auto"></div>
    <div class="nav-btn" onclick="openDataFolder()" title="データフォルダを開く"><div class="nav-icon">📂</div><div class="nav-label">DATA</div></div>
    <div class="nav-btn" onclick="backupAll()" title="バックアップ"><div class="nav-icon">💾</div><div class="nav-label">BKP</div></div>
  </div>

  <div id="main">

    <!-- ═══ HOME ═══ -->
    <div class="screen active" id="screen-home" style="flex-direction:column;padding:16px;gap:12px;overflow-y:auto;">
      <div style="display:flex;align-items:center;gap:8px">
        <div class="sec-lbl" style="flex:1">TODAY'S STATUS</div>
        <button class="btn btn-primary btn-sm" onclick="go('capture')">＋ 思考を記録</button>
        <button class="btn btn-ghost btn-sm" onclick="go('tasks')">＋ タスク追加</button>
      </div>
      <div class="g4">
        <div class="stat-card"><div class="stat-lbl">THOUGHT LOGS</div><div class="stat-val" id="st-logs">0</div><div class="stat-sub" id="st-logs2">今日: 0 件</div></div>
        <div class="stat-card cy"><div class="stat-lbl">OPEN TASKS</div><div class="stat-val" id="st-tasks">0</div><div class="stat-sub" id="st-tasks2">S優先: 0 件</div></div>
        <div class="stat-card gn"><div class="stat-lbl">INBOX ITEMS</div><div class="stat-val" id="st-inbox">0</div><div class="stat-sub" id="st-inbox2">未読: 0 件</div></div>
        <div class="stat-card rd"><div class="stat-lbl">ACTIVE RISKS</div><div class="stat-val" id="st-risks">0</div><div class="stat-sub" id="st-risks2">高: 0 件</div></div>
      </div>
      <div class="g2">
        <div>
          <div class="sec-lbl">TODAY'S TASKS</div>
          <div id="dash-tasks" class="panel" style="overflow:hidden;margin-top:6px"><div class="empty"><div class="empty-icon">◈</div>タスクなし</div></div>
        </div>
        <div>
          <div class="sec-lbl">RECENT THOUGHTS</div>
          <div id="dash-thoughts" class="panel" style="overflow:hidden;margin-top:6px"><div class="empty"><div class="empty-icon">⚡</div>思考ログなし</div></div>
        </div>
      </div>
      <div class="sec-lbl">PROJECT OVERVIEW</div>
      <div id="dash-projects" class="panel" style="overflow:hidden"><div class="empty"><div class="empty-icon">◉</div>案件なし</div></div>
    </div>

    <!-- ═══ CAPTURE ═══ -->
    <div class="screen" id="screen-capture" style="flex-direction:row;overflow:hidden;">
      <div style="flex:1;display:flex;flex-direction:column;padding:16px;gap:10px;overflow-y:auto;border-right:1px solid var(--border);">
        <div style="display:flex;align-items:center;gap:8px">
          <div class="sec-lbl" style="flex:1">THOUGHT CAPTURE</div>
          <span style="font-family:var(--font-mono);font-size:10px;color:var(--amber)" id="cap-now"></span>
        </div>
        <div class="g2">
          <div class="fg"><label class="lbl">思考の種類</label>
            <select id="c-type"><option>仮説</option><option>違和感</option><option>閃き</option><option>リスク</option><option>問い</option><option>愚痴・ストレス</option><option>観察</option><option>学び</option><option>アイデア</option><option>決断</option></select>
          </div>
          <div class="fg"><label class="lbl">緊急度</label>
            <select id="c-urgency"><option>今すぐ行動</option><option>今週中に深堀</option><option>記録だけ</option><option>アーカイブ</option></select>
          </div>
          <div class="fg"><label class="lbl">コンテキスト</label>
            <select id="c-ctx"><option>会議中</option><option>移動中</option><option>朝の整理</option><option>深夜</option><option>資料作成中</option><option>会食</option><option>その他</option></select>
          </div>
          <div class="fg"><label class="lbl">フレームワーク</label>
            <select id="c-fw" onchange="renderFW()">
              <option value="">なし</option><option value="3C">3C分析</option><option value="SCR">SCR（状況・課題・解決策）</option>
              <option value="MECE">MECE分解</option><option value="仮説思考">仮説思考</option>
              <option value="イシューツリー">イシューツリー/So What</option><option value="SWOT">SWOT分析</option>
              <option value="4P">4P分析</option><option value="5Forces">5Forces分析</option>
              <option value="ギャップ分析">ギャップ分析（As-Is/To-Be）</option><option value="シナリオ">シナリオ分析</option>
              <option value="ピラミッド">ピラミッドストラクチャー</option><option value="KPIツリー">KPIツリー</option>
              <option value="意思決定">意思決定ツリー</option>
            </select>
          </div>
        </div>
        <div class="fg">
          <label class="lbl">内容（生の言葉で） — 原本・絶対に変えない</label>
          <textarea id="c-body" rows="4" placeholder="思ったまま書く。整形はAIがやる。" oninput="document.getElementById('c-cnt').textContent=this.value.length"></textarea>
          <div class="char-cnt"><span id="c-cnt">0</span> 文字</div>
        </div>
        <div id="fw-area"></div>
        <div class="fg">
          <label class="lbl">タグ（;区切り）</label>
          <input type="text" id="c-tags" placeholder="例: P001;DX;競合">
          <div class="qtags" id="q-tags-cap"></div>
        </div>
        <div class="fg"><label class="lbl">関連案件ID</label><input type="text" id="c-pj" placeholder="P001"></div>
        <div style="display:flex;gap:8px;flex-wrap:wrap;">
          <button class="btn btn-primary" onclick="saveThought()">⚡ 記録する (Ctrl+Enter)</button>
          <button class="btn btn-ghost btn-sm" onclick="clearCap()">クリア</button>
        </div>
      </div>
      <div style="width:340px;display:flex;flex-direction:column;overflow:hidden;flex-shrink:0;">
        <div class="panel-hdr">
          <div class="panel-title">THOUGHT LOG</div><span class="badge" id="log-badge">0</span>
          <div style="margin-left:auto;display:flex;gap:6px;">
            <button class="btn btn-ghost btn-xs" onclick="copyCSV('thought_log')">📋 CSV</button>
          </div>
        </div>
        <div class="search-row"><span>🔍</span><input type="text" placeholder="検索..." oninput="renderLogs(this.value)" id="log-search"></div>
        <div style="flex:1;overflow-y:auto;padding:10px;" id="log-list"><div class="empty"><div class="empty-icon">⚡</div>思考を記録してください</div></div>
      </div>
    </div>

    <!-- ═══ INBOX ═══ -->
    <div class="screen" id="screen-inbox" style="flex-direction:row;overflow:hidden;">
      <div style="width:380px;flex-shrink:0;border-right:1px solid var(--border);display:flex;flex-direction:column;padding:16px;gap:10px;overflow-y:auto;">
        <div class="sec-lbl">INTELLIGENCE INBOX</div>
        <div class="panel" style="padding:12px;display:flex;flex-direction:column;gap:8px;">
          <div class="panel-title" style="font-size:9px">URL 収集</div>
          <div style="display:flex;gap:6px;"><input type="text" id="ib-url" placeholder="https://..."><button class="btn btn-cyan btn-sm" onclick="fetchUrlMeta()">取得</button></div>
          <input type="text" id="ib-title" placeholder="タイトル（自動取得 or 手入力）">
          <textarea id="ib-summary" rows="2" placeholder="要約・メモ（自動取得 or 手入力）"></textarea>
        </div>
        <div class="drop-zone" id="drop-zone" onclick="document.getElementById('file-in').click()" ondragover="dzOver(event)" ondragleave="dzLeave()" ondrop="dzDrop(event)">
          <div class="drop-icon">📁</div>
          <div class="drop-txt">ファイルをドロップ、またはクリックして選択</div>
          <div style="font-size:10px;color:var(--text-muted);margin-top:4px">PDF · Excel · PowerPoint · Word</div>
          <input type="file" id="file-in" style="display:none" multiple onchange="handleFiles(this.files)">
        </div>
        <div id="dropped-files" style="display:none">
          <div class="filepath-box" id="dropped-paths"></div>
        </div>
        <div class="fg"><label class="lbl">関連案件ID</label><input type="text" id="ib-pj" placeholder="P001"></div>
        <div class="fg"><label class="lbl">カテゴリ</label>
          <select id="ib-cat"><option>業界動向</option><option>競合動向</option><option>規制・政策</option><option>技術トレンド</option><option>M&A情報</option><option>人事動向</option><option>経済指標</option><option>調査レポート</option><option>提案書</option><option>契約書</option><option>議事録</option><option>その他</option></select>
        </div>
        <div class="fg"><label class="lbl">タグ（;区切り）</label><input type="text" id="ib-tags" placeholder="DX;製造業;競合"><div class="qtags" id="q-tags-ib"></div></div>
        <div class="fg"><label class="lbl">自分のメモ</label><textarea id="ib-memo" rows="2" placeholder="なぜ保存したか。気になったポイント。"></textarea></div>
        <button class="btn btn-primary" onclick="saveInbox()">📥 インボックスに保存</button>
      </div>
      <div style="flex:1;display:flex;flex-direction:column;overflow:hidden;">
        <div class="panel-hdr">
          <div class="panel-title">SAVED ITEMS</div><span class="badge" id="ib-badge">0</span>
          <div style="margin-left:auto"><button class="btn btn-ghost btn-xs" onclick="copyCSV('intelligence_inbox')">📋 CSV</button></div>
        </div>
        <div class="search-row"><span>🔍</span><input type="text" placeholder="検索..." oninput="renderInbox(this.value)"></div>
        <div style="flex:1;overflow-y:auto;" id="ib-list"><div class="empty"><div class="empty-icon">📥</div>情報がありません</div></div>
      </div>
    </div>

    <!-- ═══ MEETINGS ═══ -->
    <div class="screen" id="screen-meetings" style="flex-direction:row;overflow:hidden;">
      <div style="width:300px;border-right:1px solid var(--border);display:flex;flex-direction:column;overflow:hidden;flex-shrink:0;">
        <div class="panel-hdr">
          <div class="panel-title">MEETINGS</div><span class="badge" id="mtg-badge">0</span>
          <div style="margin-left:auto"><button class="btn btn-primary btn-xs" onclick="newMtg()">＋ 新規</button></div>
        </div>
        <div style="overflow-y:auto;flex:1" id="mtg-list"><div class="empty"><div class="empty-icon">📋</div>議事録なし</div></div>
      </div>
      <div style="flex:1;padding:16px;overflow-y:auto;display:flex;flex-direction:column;gap:10px;">
        <div class="sec-lbl" id="mtg-form-title">NEW MEETING</div>
        <div class="g2">
          <div class="fg"><label class="lbl">会議名</label><input type="text" id="m-title" placeholder="○○社 第3回進捗MTG"></div>
          <div class="fg"><label class="lbl">会議日時</label><input type="datetime-local" id="m-dt"></div>
          <div class="fg"><label class="lbl">自社参加者（;区切り）</label><input type="text" id="m-in" placeholder="山田;鈴木"></div>
          <div class="fg"><label class="lbl">顧客側参加者（;区切り）</label><input type="text" id="m-out" placeholder="田中部長;佐藤課長"></div>
        </div>
        <div class="fg"><label class="lbl">関連案件ID</label><input type="text" id="m-pj" placeholder="P001"></div>
        <div class="fg"><label class="lbl">会議の目的（1行）</label><input type="text" id="m-purpose" placeholder="何のための会議か"></div>
        <div class="fg"><label class="lbl">議論内容（生） — 殴り書きOK。原本。</label><textarea id="m-disc" rows="5" placeholder="思ったまま。整形はAIに任せる。"></textarea></div>
        <div class="fg"><label class="lbl">決定事項</label><textarea id="m-dec" rows="3" placeholder="1. ○○を進める&#10;2. ○○を確認する"></textarea></div>
        <div class="fg"><label class="lbl">宿題・アクションアイテム [担当] 内容 (期限)</label><textarea id="m-todo" rows="3" placeholder="[山田] 提案書v2作成 (6/30)&#10;[佐藤] 予算確認 (7/3)"></textarea></div>
        <div style="display:flex;gap:8px;flex-wrap:wrap;">
          <button class="btn btn-primary" onclick="saveMtg()">📋 保存する</button>
          <button class="btn btn-cyan btn-sm" onclick="copyCSV('meeting_minutes')">📋 AIへCSV</button>
          <button class="btn btn-ghost btn-sm" onclick="newMtg()">クリア</button>
        </div>
      </div>
    </div>

    <!-- ═══ DELEGATION ═══ -->
    <div class="screen" id="screen-delegate" style="flex-direction:row;overflow:hidden;">
      <div style="width:300px;border-right:1px solid var(--border);display:flex;flex-direction:column;overflow:hidden;flex-shrink:0;">
        <div class="panel-hdr">
          <div class="panel-title">DELEGATION LOG</div><span class="badge" id="dl-badge">0</span>
          <div style="margin-left:auto"><button class="btn btn-primary btn-xs" onclick="newDelegation()">＋ 新規</button></div>
        </div>
        <div style="overflow-y:auto;flex:1" id="dl-list"><div class="empty"><div class="empty-icon">📤</div>指示なし</div></div>
      </div>
      <div style="flex:1;padding:16px;overflow-y:auto;display:flex;flex-direction:column;gap:10px;">
        <div class="sec-lbl" id="dl-form-title">NEW DELEGATION</div>
        <div class="g2">
          <div class="fg"><label class="lbl">担当者</label><input type="text" id="dl-assignee" placeholder="田中"></div>
          <div class="fg"><label class="lbl">関連案件ID</label><input type="text" id="dl-pj" placeholder="P001"></div>
          <div class="fg"><label class="lbl">優先度</label>
            <select id="dl-pri"><option value="S">S — 最優先</option><option value="A" selected>A — 高</option><option value="B">B — 中</option><option value="C">C — 低</option></select>
          </div>
          <div class="fg"><label class="lbl">期限</label><input type="date" id="dl-due"></div>
          <div class="fg"><label class="lbl">連絡手段</label>
            <select id="dl-channel"><option>Teams_DM</option><option>Teams_チャネル</option><option>メール</option><option>口頭</option></select>
          </div>
          <div class="fg"><label class="lbl">フォローアップ日</label><input type="date" id="dl-followup"></div>
        </div>
        <div class="fg"><label class="lbl">指示内容（生） — 原本</label><textarea id="dl-instruction" rows="4" placeholder="やってほしいことをそのまま書く"></textarea></div>
        <div class="fg"><label class="lbl">指示の目的・背景</label><textarea id="dl-purpose" rows="2" placeholder="なぜこのタスクが必要か"></textarea></div>
        <div class="fg"><label class="lbl">期待するアウトプット</label><textarea id="dl-output" rows="2" placeholder="どんな形で返してほしいか"></textarea></div>
        <div style="display:flex;gap:8px;flex-wrap:wrap;">
          <button class="btn btn-primary" onclick="saveDelegation()">📤 保存する</button>
          <button class="btn btn-cyan btn-sm" onclick="copyCSV('delegation_log')">📋 AIへCSV</button>
          <button class="btn btn-ghost btn-sm" onclick="newDelegation()">クリア</button>
        </div>
      </div>
    </div>

    <!-- ═══ TASKS ═══ -->
    <div class="screen" id="screen-tasks" style="flex-direction:column;padding:16px;gap:12px;overflow:hidden;">
      <div style="display:flex;align-items:center;gap:8px;flex-shrink:0;">
        <div class="sec-lbl" style="flex:1">TASK MATRIX — 重要度 × 緊急度</div>
        <button class="btn btn-primary btn-sm" onclick="openModal('task-modal')">＋ タスク追加</button>
        <button class="btn btn-ghost btn-xs" onclick="copyCSV('task_log')">📋 CSV</button>
      </div>
      <div class="matrix-grid">
        <div class="m-cell c-q1"><div class="m-hdr"><span style="color:var(--red)">●</span>Q1 — 緊急×重要</div><div class="m-body" id="mq1"></div></div>
        <div class="m-cell c-q2"><div class="m-hdr"><span style="color:var(--amber)">●</span>Q2 — 重要（計画的に）</div><div class="m-body" id="mq2"></div></div>
        <div class="m-cell c-q3"><div class="m-hdr"><span style="color:var(--cyan)">●</span>Q3 — 緊急（委譲検討）</div><div class="m-body" id="mq3"></div></div>
        <div class="m-cell c-q4"><div class="m-hdr"><span style="color:var(--text-muted)">●</span>Q4 — 通常</div><div class="m-body" id="mq4"></div></div>
      </div>
    </div>

    <!-- ═══ PROJECTS ═══ -->
    <div class="screen" id="screen-projects" style="flex-direction:column;padding:16px;gap:12px;overflow-y:auto;">
      <div style="display:flex;align-items:center;gap:8px;flex-shrink:0;">
        <div class="sec-lbl" style="flex:1">PROJECT BOARD</div>
        <button class="btn btn-primary btn-sm" onclick="openModal('pj-modal')">＋ 案件追加</button>
        <button class="btn btn-ghost btn-xs" onclick="copyCSV('project_master')">📋 CSV</button>
      </div>
      <div id="pj-board"><div class="empty"><div class="empty-icon">◉</div>案件がありません</div></div>
    </div>

    <!-- ═══ CLIENTS ═══ -->
    <div class="screen" id="screen-clients" style="flex-direction:row;overflow:hidden;">
      <div style="width:300px;border-right:1px solid var(--border);display:flex;flex-direction:column;overflow:hidden;flex-shrink:0;">
        <div class="panel-hdr">
          <div class="panel-title">CLIENT MASTER</div><span class="badge" id="cl-badge">0</span>
          <div style="margin-left:auto"><button class="btn btn-primary btn-xs" onclick="openModal('cl-modal')">＋ 新規</button></div>
        </div>
        <div class="search-row"><span>🔍</span><input type="text" placeholder="顧客名で検索..." oninput="renderClients(this.value)"></div>
        <div style="overflow-y:auto;flex:1" id="cl-list"><div class="empty"><div class="empty-icon">👤</div>顧客なし</div></div>
      </div>
      <div style="flex:1;padding:16px;overflow-y:auto;" id="cl-detail">
        <div class="empty"><div class="empty-icon">👤</div>顧客を選択してください</div>
      </div>
    </div>

    <!-- ═══ RISKS ═══ -->
    <div class="screen" id="screen-risks" style="flex-direction:row;overflow:hidden;">
      <div style="width:300px;border-right:1px solid var(--border);display:flex;flex-direction:column;overflow:hidden;flex-shrink:0;">
        <div class="panel-hdr">
          <div class="panel-title">RISK LOG</div><span class="badge" id="rk-badge">0</span>
          <div style="margin-left:auto"><button class="btn btn-primary btn-xs" onclick="openModal('risk-modal')">＋ 新規</button></div>
        </div>
        <div style="overflow-y:auto;flex:1" id="rk-list"><div class="empty"><div class="empty-icon">⚠</div>リスクなし</div></div>
      </div>
      <div style="flex:1;padding:16px;overflow-y:auto;" id="rk-detail">
        <div class="empty"><div class="empty-icon">⚠</div>リスクを選択してください</div>
      </div>
    </div>

    <!-- ═══ KNOWLEDGE ═══ -->
    <div class="screen" id="screen-knowledge" style="flex-direction:row;overflow:hidden;">
      <div style="width:360px;flex-shrink:0;border-right:1px solid var(--border);display:flex;flex-direction:column;padding:16px;gap:10px;overflow-y:auto;">
        <div class="sec-lbl">KNOWLEDGE BASE</div>
        <div class="fg"><label class="lbl">カテゴリ</label>
          <select id="kb-cat"><option>業界知識</option><option>フレームワーク</option><option>成功パターン</option><option>失敗からの教訓</option><option>交渉術</option><option>プレゼン術</option><option>ツール活用</option><option>その他</option></select>
        </div>
        <div class="fg"><label class="lbl">タイトル</label><input type="text" id="kb-title" placeholder="学んだこと・気づき"></div>
        <div class="fg"><label class="lbl">関連案件ID（任意）</label><input type="text" id="kb-pj" placeholder="P001"></div>
        <div class="fg"><label class="lbl">内容（原文）</label><textarea id="kb-content" rows="6" placeholder="具体的な知識・ノウハウを記録"></textarea></div>
        <div class="fg"><label class="lbl">情報源</label><input type="text" id="kb-source" placeholder="書籍名・URL・経験など"></div>
        <div class="fg"><label class="lbl">タグ（;区切り）</label><input type="text" id="kb-tags" placeholder="交渉;製造業"></div>
        <button class="btn btn-primary" onclick="saveKnowledge()">📖 保存する</button>
      </div>
      <div style="flex:1;display:flex;flex-direction:column;overflow:hidden;">
        <div class="panel-hdr">
          <div class="panel-title">SAVED KNOWLEDGE</div><span class="badge" id="kb-badge">0</span>
          <div style="margin-left:auto"><button class="btn btn-ghost btn-xs" onclick="copyCSV('knowledge_base')">📋 CSV</button></div>
        </div>
        <div class="search-row"><span>🔍</span><input type="text" placeholder="ナレッジ検索..." oninput="renderKnowledge(this.value)"></div>
        <div style="flex:1;overflow-y:auto;padding:10px;" id="kb-list"><div class="empty"><div class="empty-icon">📖</div>ナレッジなし</div></div>
      </div>
    </div>

    <!-- ═══ WEEKLY REVIEW ═══ -->
    <div class="screen" id="screen-review" style="flex-direction:column;padding:16px;gap:12px;overflow-y:auto;">
      <div style="display:flex;align-items:center;gap:8px;flex-shrink:0;">
        <div class="sec-lbl" style="flex:1">WEEKLY REVIEW</div>
        <button class="btn btn-cyan btn-sm" onclick="generateWeeklyReport()">📊 今週のレポートを生成</button>
        <button class="btn btn-ghost btn-sm" onclick="copyWeeklyReport()">📋 コピー</button>
      </div>
      <div id="weekly-content">
        <div class="empty"><div class="empty-icon">📊</div>「今週のレポートを生成」をクリック</div>
      </div>
    </div>

    <!-- ═══ AI CONSOLE ═══ -->
    <div class="screen" id="screen-ai" style="flex-direction:column;padding:16px;gap:12px;overflow-y:auto;">
      <div style="display:flex;align-items:center;gap:8px;">
        <div class="sec-lbl" style="flex:1">AI CONSOLE — 3 AGENT WORKFLOW</div>
        <div class="status-item"><div class="dot amber"></div><span style="font-family:var(--font-mono);font-size:9px;">毎ステップ人間が確認→次へ</span></div>
      </div>
      <div class="agent-flow">
        <!-- Agent A -->
        <div class="agent-card" id="card-a">
          <div class="agent-hdr">
            <div class="agent-id">A</div>
            <div class="agent-name"><div class="n">記録整理エージェント</div><div class="r">RAW → STRUCTURED</div></div>
            <div class="ag-badge bg-ready" id="badge-a">READY</div>
          </div>
          <div class="agent-body">
            <div><div class="ab-lbl">INPUT CSV</div><div class="io-chips"><span class="chip">thought_log_raw</span><span class="chip">meeting_minutes</span><span class="chip">intelligence_inbox</span></div></div>
            <div><div class="ab-lbl">OUTPUT</div><div class="io-chips"><span class="chip out">ai_summary</span><span class="chip out">ai_tags</span><span class="chip out">ai_action</span></div></div>
            <div>
              <div class="ab-lbl">データ選択</div>
              <label style="display:flex;align-items:center;gap:6px;font-size:11px;color:var(--text-secondary);margin-top:4px;cursor:pointer"><input type="checkbox" id="a-logs" checked style="accent-color:var(--amber)">思考ログ（直近 <input type="number" id="a-cnt" value="10" style="width:40px;padding:1px 4px;font-size:11px;display:inline"> 件）</label>
              <label style="display:flex;align-items:center;gap:6px;font-size:11px;color:var(--text-secondary);margin-top:4px;cursor:pointer"><input type="checkbox" id="a-mtg" checked style="accent-color:var(--amber)">未処理の議事録</label>
              <label style="display:flex;align-items:center;gap:6px;font-size:11px;color:var(--text-secondary);margin-top:4px;cursor:pointer"><input type="checkbox" id="a-ib" checked style="accent-color:var(--amber)">未処理のインボックス</label>
            </div>
            <div class="csv-box" id="prev-a">CSVプレビュー...</div>
            <div style="display:flex;gap:6px;">
              <button class="btn btn-ghost btn-sm" onclick="previewCSV('a')" style="flex:1">プレビュー</button>
              <button class="btn btn-cyan btn-sm" onclick="copyForAgent('a')" style="flex:1">📋 Agent Aへ</button>
            </div>
            <div class="step-check"><input type="checkbox" id="ck-a" onchange="updateFlow()"><label style="font-size:11px;color:var(--text-secondary);cursor:pointer" for="ck-a">Agent A 出力を確認・承認した</label></div>
          </div>
        </div>
        <div class="agent-arrow" id="arr-ab">→</div>
        <!-- Agent B -->
        <div class="agent-card" id="card-b" style="opacity:.5">
          <div class="agent-hdr">
            <div class="agent-id" style="color:var(--cyan)">B</div>
            <div class="agent-name"><div class="n">思考深化エージェント</div><div class="r">STRUCTURED → INSIGHTS</div></div>
            <div class="ag-badge bg-wait" id="badge-b">WAITING</div>
          </div>
          <div class="agent-body">
            <div><div class="ab-lbl">INPUT</div><div class="io-chips"><span class="chip">Agent_A_output</span><span class="chip">framework_data</span></div></div>
            <div><div class="ab-lbl">OUTPUT</div><div class="io-chips"><span class="chip out">deep_analysis</span><span class="chip out">fw_critique</span><span class="chip out">implications</span></div></div>
            <div class="fg"><div class="ab-lbl">Agent A の出力を貼り付け</div><textarea id="b-in" rows="3" style="font-size:11px" placeholder="Agent AのCSV出力をここに貼り付け"></textarea></div>
            <div class="csv-box" id="prev-b">Agent A承認後にプレビュー可能</div>
            <div style="display:flex;gap:6px;">
              <button class="btn btn-ghost btn-sm" onclick="previewCSV('b')" style="flex:1" id="btn-b-prev" disabled>プレビュー</button>
              <button class="btn btn-cyan btn-sm" onclick="copyForAgent('b')" style="flex:1" id="btn-b-copy" disabled>📋 Agent Bへ</button>
            </div>
            <div class="step-check"><input type="checkbox" id="ck-b" onchange="updateFlow()" disabled><label style="font-size:11px;color:var(--text-secondary);cursor:pointer" for="ck-b">Agent B 出力を確認・承認した</label></div>
          </div>
        </div>
        <div class="agent-arrow" id="arr-bc">→</div>
        <!-- Agent C -->
        <div class="agent-card" id="card-c" style="opacity:.5">
          <div class="agent-hdr">
            <div class="agent-id" style="color:var(--green)">C</div>
            <div class="agent-name"><div class="n">実行出力エージェント</div><div class="r">INSIGHTS → ACTIONS</div></div>
            <div class="ag-badge bg-wait" id="badge-c">WAITING</div>
          </div>
          <div class="agent-body">
            <div><div class="ab-lbl">出力タイプ</div>
              <div style="display:flex;flex-wrap:wrap;gap:4px;margin-top:4px;">
                <label class="tag"><input type="checkbox" checked style="display:none" id="c-teams"> Teams文</label>
                <label class="tag"><input type="checkbox" checked style="display:none" id="c-email"> メール</label>
                <label class="tag"><input type="checkbox" style="display:none" id="c-instruct"> 指示文</label>
                <label class="tag"><input type="checkbox" style="display:none" id="c-slide"> スライド案</label>
              </div>
            </div>
            <div class="fg"><div class="ab-lbl">Agent B の出力を貼り付け</div><textarea id="c-in" rows="3" style="font-size:11px" placeholder="Agent BのCSV出力をここに貼り付け"></textarea></div>
            <div class="csv-box" id="prev-c">Agent B承認後にプレビュー可能</div>
            <div style="display:flex;gap:6px;">
              <button class="btn btn-ghost btn-sm" onclick="previewCSV('c')" style="flex:1" id="btn-c-prev" disabled>プレビュー</button>
              <button class="btn btn-cyan btn-sm" onclick="copyForAgent('c')" style="flex:1" id="btn-c-copy" disabled>📋 Agent Cへ</button>
            </div>
            <div class="step-check"><input type="checkbox" id="ck-c" disabled><label style="font-size:11px;color:var(--text-secondary);cursor:pointer" for="ck-c">最終出力を確認・承認した</label></div>
            <button class="btn btn-primary btn-sm" onclick="copyFinal()" id="btn-final" disabled style="width:100%">📋 Teams貼付用コピー</button>
          </div>
        </div>
      </div>
      <div class="sec-lbl">SYSTEM PROMPTS（8000文字制限）</div>
      <div class="g3">
        <div class="panel">
          <div class="panel-hdr"><div class="panel-title">AGENT A</div><span class="badge" id="pc-a">0/8000</span></div>
          <textarea style="width:100%;height:120px;padding:8px;background:var(--bg-input);border:none;font-family:var(--font-mono);font-size:9px;color:var(--text-secondary);resize:none;outline:none;line-height:1.5" id="prompt-a" oninput="pCount('a')">あなたは戦略コンサルタントの専属「記録整理AI」です。rawデータを構造化・要約・タグ提案します。

【絶対ルール】
1. *_raw フィールドには絶対に書き込まない
2. 出力は *_ai フィールドに書く
3. 不確かな情報は「（要確認）」とラベリング
4. 推測と事実を区別する

【思考ログ整理】入力:thought_log_raw
- フレームワーク構造に沿って整理
- 関連ログIDを紐づけ(tl_ai_link)
- タグ候補3〜5個提案
出力: tl_ai_summary(3行以内), tl_ai_action(緊急度付き)

【議事録整理】入力:meeting_minutes
- 決定事項・アクションアイテム抽出
- 担当者・期限不明ToDoをフラグ
出力: mt_ai_summary(300字以内)

【情報タグ提案】入力:intelligence_inbox
出力: ii_ai_summary(200字), ii_tag_suggest(;区切り)

【出力形式】CSV行形式。"で囲む。</textarea>
        </div>
        <div class="panel">
          <div class="panel-hdr"><div class="panel-title">AGENT B</div><span class="badge" id="pc-b">0/8000</span></div>
          <textarea style="width:100%;height:120px;padding:8px;background:var(--bg-input);border:none;font-family:var(--font-mono);font-size:9px;color:var(--text-secondary);resize:none;outline:none;line-height:1.5" id="prompt-b" oninput="pCount('b')">あなたは戦略コンサルタントの専属「思考深化AI」です。Agent Aの整理済みデータを受け取り戦略的洞察を深めます。

【絶対ルール】
1. rawデータは参照のみ
2. Agent Aのai層を入力として使う
3. 推測は推測として明記
4. 「反論」「死角」を必ず1つ以上提示する

【思考クラスタリング】
- 関連思考をテーマ別にクラスタリング
- 各クラスターから「本質的な問い」を1文抽出
- 矛盾・盲点を特定
出力: deep_analysis, core_question, blind_spots

【フレームワーク評価】
- MECE性・論理整合性チェック
- 抜け漏れ・補強提案
出力: fw_critique, fw_suggestion

【情報分析】
- 収集情報と案件仮説の整合性チェック
出力: ii_implication, ii_slide_use

【出力形式】CSV行形式。</textarea>
        </div>
        <div class="panel">
          <div class="panel-hdr"><div class="panel-title">AGENT C</div><span class="badge" id="pc-c">0/8000</span></div>
          <textarea style="width:100%;height:120px;padding:8px;background:var(--bg-input);border:none;font-family:var(--font-mono);font-size:9px;color:var(--text-secondary);resize:none;outline:none;line-height:1.5" id="prompt-c" oninput="pCount('c')">あなたは戦略コンサルタントの専属「実行出力AI」です。深化データを受け取り、そのまま使えるアウトプットを生成します。

【絶対ルール】
1. 出力は「そのまま使える」品質
2. Teams文: 簡潔・箇条書き・絵文字あり・300字以内
3. メール: 敬語・ビジネスメール・件名付き
4. 指示文: 5W1H明確
5. 全出力に「（要確認）」箇所を明記

【Teams投稿文生成】
構成: 会議名/日時/決定事項/次回アクション

【部下への指示文生成】
①背景・目的 ②依頼内容 ③成果物イメージ ④期限 ⑤確認期限

【スライド設計支援】
①So What(1文) ②ナレーション案(200字) ③根拠データ活用提案

【出力形式】CSV行形式。各タスクを明確にラベリング。</textarea>
        </div>
      </div>
    </div>

  </div><!-- /main -->
</div><!-- /app -->

<!-- TASK MODAL -->
<div class="modal-overlay" id="task-modal">
  <div class="modal">
    <div class="modal-hdr"><div class="modal-title">TASK — タスク追加</div><button class="modal-x" onclick="closeModal('task-modal')">✕</button></div>
    <div class="modal-body">
      <div class="g2">
        <div class="fg span2"><label class="lbl">タスク名</label><input type="text" id="tk-title" placeholder="何をするか具体的に"></div>
        <div class="fg"><label class="lbl">優先度</label>
          <select id="tk-pri"><option value="S">S — 緊急×重要</option><option value="A" selected>A — 重要</option><option value="B">B — 緊急</option><option value="C">C — 通常</option></select>
        </div>
        <div class="fg"><label class="lbl">種別</label>
          <select id="tk-type"><option>思考・分析</option><option>資料作成</option><option>顧客対応</option><option>社内調整</option><option>確認・レビュー</option><option>情報収集</option><option>その他</option></select>
        </div>
        <div class="fg"><label class="lbl">期限</label><input type="date" id="tk-due"></div>
        <div class="fg"><label class="lbl">見積もり工数(h)</label><input type="text" id="tk-h" placeholder="2"></div>
        <div class="fg"><label class="lbl">担当者</label><input type="text" id="tk-owner" placeholder="自分"></div>
        <div class="fg"><label class="lbl">関連案件ID</label><input type="text" id="tk-pj" placeholder="P001"></div>
        <div class="fg span2"><label class="lbl">内容・目的</label><textarea id="tk-body" rows="3" placeholder="何のためにやるか・完了基準"></textarea></div>
      </div>
    </div>
    <div class="modal-foot"><button class="btn btn-ghost" onclick="closeModal('task-modal')">キャンセル</button><button class="btn btn-primary" onclick="saveTask()">◈ タスクを追加</button></div>
  </div>
</div>

<!-- PROJECT MODAL -->
<div class="modal-overlay" id="pj-modal">
  <div class="modal">
    <div class="modal-hdr"><div class="modal-title">PROJECT — 案件追加</div><button class="modal-x" onclick="closeModal('pj-modal')">✕</button></div>
    <div class="modal-body">
      <div class="g2">
        <div class="fg span2"><label class="lbl">案件名</label><input type="text" id="pj-name" placeholder="○○社 中期経営計画策定支援"></div>
        <div class="fg"><label class="lbl">顧客名</label><input type="text" id="pj-client" placeholder="株式会社○○"></div>
        <div class="fg"><label class="lbl">優先度</label>
          <select id="pj-pri"><option value="S">S — 最重要</option><option value="A" selected>A — 高</option><option value="B">B — 中</option><option value="C">C — 低</option></select>
        </div>
        <div class="fg"><label class="lbl">フェーズ</label>
          <select id="pj-phase"><option>提案前</option><option>Dペーパー作成</option><option>提案書作成</option><option>提案済</option><option>契約交渉</option><option>契約締結</option><option>キックオフ</option><option>調査分析</option><option>仮説検証</option><option>提言作成</option><option>最終プレゼン</option><option>実行支援</option><option>完了</option></select>
        </div>
        <div class="fg"><label class="lbl">PJタイプ</label>
          <select id="pj-type"><option>戦略策定</option><option>業務改革</option><option>M&A支援</option><option>マーケティング</option><option>組織変革</option><option>IT導入</option><option>その他</option></select>
        </div>
        <div class="fg"><label class="lbl">想定フィー（万円）</label><input type="text" id="pj-fee" placeholder="500"></div>
        <div class="fg"><label class="lbl">開始日</label><input type="date" id="pj-start"></div>
        <div class="fg"><label class="lbl">終了予定日</label><input type="date" id="pj-end"></div>
        <div class="fg span2"><label class="lbl">中心仮説</label><textarea id="pj-hyp" rows="2" placeholder="このPJで証明・否定しようとしている仮説"></textarea></div>
        <div class="fg span2"><label class="lbl">主要リスク</label><textarea id="pj-risk" rows="2" placeholder="現時点で認識しているリスク"></textarea></div>
      </div>
    </div>
    <div class="modal-foot"><button class="btn btn-ghost" onclick="closeModal('pj-modal')">キャンセル</button><button class="btn btn-primary" onclick="saveProject()">◉ 案件を追加</button></div>
  </div>
</div>

<!-- CLIENT MODAL -->
<div class="modal-overlay" id="cl-modal">
  <div class="modal">
    <div class="modal-hdr"><div class="modal-title">CLIENT — 顧客追加</div><button class="modal-x" onclick="closeModal('cl-modal')">✕</button></div>
    <div class="modal-body">
      <div class="g2">
        <div class="fg span2"><label class="lbl">顧客名（法人）</label><input type="text" id="cl-name" placeholder="株式会社○○"></div>
        <div class="fg"><label class="lbl">事業部・部署</label><input type="text" id="cl-div" placeholder="経営企画部"></div>
        <div class="fg"><label class="lbl">キーパーソン名</label><input type="text" id="cl-kp" placeholder="田中太郎"></div>
        <div class="fg"><label class="lbl">役職</label><input type="text" id="cl-title" placeholder="部長"></div>
        <div class="fg"><label class="lbl">Email</label><input type="text" id="cl-email" placeholder="tanaka@example.com"></div>
        <div class="fg"><label class="lbl">TEL</label><input type="text" id="cl-tel" placeholder="03-1234-5678"></div>
        <div class="fg"><label class="lbl">業種</label>
          <select id="cl-industry"><option>製造</option><option>金融</option><option>商社</option><option>小売</option><option>IT</option><option>医療</option><option>官公庁</option><option>その他</option></select>
        </div>
        <div class="fg"><label class="lbl">関係性スコア</label>
          <select id="cl-relation"><option value="1">1_初対面</option><option value="2">2_面識あり</option><option value="3" selected>3_信頼構築</option><option value="4">4_相談相手</option><option value="5">5_パートナー</option></select>
        </div>
        <div class="fg"><label class="lbl">営業フェーズ</label>
          <select id="cl-phase"><option>未接触</option><option>ファーストコンタクト</option><option>ニーズヒアリング</option><option>提案書作成中</option><option>提案済</option><option>交渉中</option><option>受注</option><option>失注</option><option>保留</option></select>
        </div>
        <div class="fg"><label class="lbl">売上規模</label>
          <select id="cl-rev"><option>不明</option><option>〜10億</option><option>10〜100億</option><option>100〜500億</option><option>500億〜</option></select>
        </div>
        <div class="fg span2"><label class="lbl">課題サマリー</label><textarea id="cl-pain" rows="2" placeholder="顧客が抱える課題"></textarea></div>
        <div class="fg span2"><label class="lbl">関係者メモ（人柄・趣味・注意点）</label><textarea id="cl-memo" rows="2" placeholder="会食で使える情報など"></textarea></div>
      </div>
    </div>
    <div class="modal-foot"><button class="btn btn-ghost" onclick="closeModal('cl-modal')">キャンセル</button><button class="btn btn-primary" onclick="saveClient()">👤 顧客を追加</button></div>
  </div>
</div>

<!-- RISK MODAL -->
<div class="modal-overlay" id="risk-modal">
  <div class="modal">
    <div class="modal-hdr"><div class="modal-title">RISK — リスク追加</div><button class="modal-x" onclick="closeModal('risk-modal')">✕</button></div>
    <div class="modal-body">
      <div class="g2">
        <div class="fg span2"><label class="lbl">リスク名</label><input type="text" id="rk-title" placeholder="スコープ拡大のリスク"></div>
        <div class="fg"><label class="lbl">関連案件ID</label><input type="text" id="rk-pj" placeholder="P001"></div>
        <div class="fg"><label class="lbl">カテゴリ</label>
          <select id="rk-cat"><option>顧客関係</option><option>スコープ拡大</option><option>リソース不足</option><option>品質</option><option>競合</option><option>契約</option><option>技術</option><option>その他</option></select>
        </div>
        <div class="fg"><label class="lbl">発生確率</label>
          <select id="rk-prob"><option>高</option><option selected>中</option><option>低</option></select>
        </div>
        <div class="fg"><label class="lbl">影響度</label>
          <select id="rk-impact"><option>致命的</option><option selected>大</option><option>中</option><option>小</option></select>
        </div>
        <div class="fg span2"><label class="lbl">リスク詳細</label><textarea id="rk-desc" rows="3" placeholder="具体的にどんなリスクか"></textarea></div>
        <div class="fg span2"><label class="lbl">対応策</label><textarea id="rk-counter" rows="3" placeholder="どう対処するか"></textarea></div>
      </div>
    </div>
    <div class="modal-foot"><button class="btn btn-ghost" onclick="closeModal('risk-modal')">キャンセル</button><button class="btn btn-primary" onclick="saveRisk()">⚠ リスクを追加</button></div>
  </div>
</div>

<!-- SEARCH MODAL -->
<div class="modal-overlay" id="search-modal">
  <div class="modal" style="width:700px">
    <div class="modal-hdr"><div class="modal-title">🔍 CROSS-TABLE SEARCH — 全文検索</div><button class="modal-x" onclick="closeModal('search-modal')">✕</button></div>
    <div class="modal-body">
      <div style="display:flex;gap:8px;">
        <input type="text" id="gs-q" placeholder="キーワードを入力..." style="flex:1" onkeydown="if(event.keyCode===13)globalSearch()">
        <button class="btn btn-primary" onclick="globalSearch()">検索</button>
      </div>
      <div id="gs-results" style="max-height:400px;overflow-y:auto;"><div class="empty" style="padding:20px"><div class="empty-icon">🔍</div>キーワードを入力してください</div></div>
    </div>
  </div>
</div>

<div id="toast"></div>

<script language="javascript">
// ═══════════════════════════════════════════
// FILE SYSTEM
// ═══════════════════════════════════════════
var FSO = new ActiveXObject("Scripting.FileSystemObject");
var WS  = new ActiveXObject("WScript.Shell");
var BASE_DIR = "";

function getBaseDir() {
  if (BASE_DIR) return BASE_DIR;
  var path = window.location.pathname;
  path = decodeURIComponent(path).replace(/\//g, "\\");
  if (path.charAt(0) === "\\") path = path.substr(1);
  BASE_DIR = FSO.GetParentFolderName(path);
  return BASE_DIR;
}

function getDataDir() {
  var base = getBaseDir();
  var dataDir = base + "\\cockpit_data";
  if (!FSO.FolderExists(dataDir)) FSO.CreateFolder(dataDir);
  return dataDir;
}

function getRawDir() {
  var d = getDataDir() + "\\raw";
  if (!FSO.FolderExists(d)) FSO.CreateFolder(d);
  return d;
}

function getAiDir() {
  var d = getDataDir() + "\\ai";
  if (!FSO.FolderExists(d)) FSO.CreateFolder(d);
  return d;
}

function getBackupDir() {
  var d = getDataDir() + "\\backup";
  if (!FSO.FolderExists(d)) FSO.CreateFolder(d);
  var today = todayStr();
  var dd = d + "\\" + today;
  if (!FSO.FolderExists(dd)) FSO.CreateFolder(dd);
  return dd;
}

// CSV定義
var CSV_HEADERS = {
  thought_log:        "id,datetime,type,framework,urgency,context,content_raw,framework_data,tags,project,status,ai_summary,ai_action,ai_deep,ai_link",
  task_log:           "id,datetime,title,priority,type,due,hours,owner,project,content,status,result",
  intelligence_inbox: "id,datetime,source_type,title,url,url_summary,file_path,file_type,file_size,project,category,tags,memo,status,ai_summary,ai_implication",
  meeting_minutes:    "id,datetime,title,attendees_in,attendees_out,project,purpose,discussion_raw,decisions,todos,status,ai_summary,ai_teams,ai_email",
  project_master:     "id,datetime,name,client,phase,priority,type,fee,start,end,hypothesis,risk,status",
  client_master:      "id,datetime,name,division,key_person,key_title,email,tel,industry,relation_score,sales_phase,revenue_scale,pain_summary,memo",
  delegation_log:     "id,datetime,assignee,project,priority,due,channel,followup,instruction_raw,purpose,output_image,status,ai_message",
  risk_log:           "id,datetime,project,title,category,probability,impact,description,countermeasure,status",
  knowledge_base:     "id,datetime,category,title,project,content,source,tags,ai_summary"
};

function csvPath(name) {
  return getRawDir() + "\\" + name + ".csv";
}

function readCSV(name) {
  var path = csvPath(name);
  if (!FSO.FileExists(path)) return [];
  try {
    var f = FSO.OpenTextFile(path, 1, false, -1);
    var content = f.ReadAll();
    f.Close();
    return parseCSV(content);
  } catch(e) {
    toast("CSVの読み込みエラー: " + name + " - " + e.message, "err");
    return [];
  }
}

function appendCSV(name, rowObj) {
  var path = csvPath(name);
  var headers = CSV_HEADERS[name].split(",");

  try {
    if (!FSO.FileExists(path)) {
      // 新規ファイル: ヘッダーと行を書き込み
      var fNew = FSO.CreateTextFile(path, true, true);
      fNew.WriteLine(CSV_HEADERS[name]);
      var rowCols = [];
      for (var i = 0; i < headers.length; i++) rowCols.push(csvEscape(rowObj[headers[i]] || ""));
      fNew.WriteLine(rowCols.join(","));
      fNew.Close();
    } else {
      // 既存ファイル: 追記
      var f = FSO.OpenTextFile(path, 8, false, -1);
      var rowCols2 = [];
      for (var j = 0; j < headers.length; j++) rowCols2.push(csvEscape(rowObj[headers[j]] || ""));
      f.WriteLine(rowCols2.join(","));
      f.Close();
    }
  } catch(e) {
    toast("CSV書き込みエラー: " + name + " - " + e.message, "err");
  }
}

function writeCSV(name, rows) {
  var path = csvPath(name);
  var headers = CSV_HEADERS[name].split(",");
  try {
    var f = FSO.CreateTextFile(path, true, true);
    f.WriteLine(CSV_HEADERS[name]);
    for (var ri = 0; ri < rows.length; ri++) {
      var row = rows[ri];
      var cols = [];
      for (var hi = 0; hi < headers.length; hi++) cols.push(csvEscape(row[headers[hi]] || ""));
      f.WriteLine(cols.join(","));
    }
    f.Close();
  } catch(e) {
    toast("CSV書き込みエラー: " + name, "err");
  }
}

function csvEscape(val) {
  var s = String(val).replace(/\r?\n/g, "\\n");
  if (s.indexOf(",") >= 0 || s.indexOf('"') >= 0) {
    return '"' + s.replace(/"/g, '""') + '"';
  }
  return '"' + s + '"';
}

function parseCSV(text) {
  var lines = text.split(/\r?\n/);
  if (!lines.length || !lines[0]) return [];
  var headers = parseCSVLine(lines[0]);
  var result = [];
  for (var i = 1; i < lines.length; i++) {
    if (!lines[i].replace(/\s/g,"")) continue;
    var vals = parseCSVLine(lines[i]);
    var obj = {};
    for (var h = 0; h < headers.length; h++) {
      var v = vals[h] || "";
      obj[headers[h]] = v.replace(/\\n/g, "\n");
    }
    result.push(obj);
  }
  return result;
}

function parseCSVLine(line) {
  var result = [];
  var cur = "";
  var inQ = false;
  for (var i = 0; i < line.length; i++) {
    var c = line.charAt(i);
    if (inQ) {
      if (c === '"' && line.charAt(i+1) === '"') { cur += '"'; i++; }
      else if (c === '"') inQ = false;
      else cur += c;
    } else {
      if (c === '"') inQ = true;
      else if (c === ',') { result.push(cur); cur = ""; }
      else cur += c;
    }
  }
  result.push(cur);
  return result;
}

function readCSVRaw(name) {
  var path = csvPath(name);
  if (!FSO.FileExists(path)) return CSV_HEADERS[name] + "\n(データなし)";
  try {
    var f = FSO.OpenTextFile(path, 1, false, -1);
    var content = f.ReadAll();
    f.Close();
    return content;
  } catch(e) { return "読み込みエラー"; }
}

function backupAll() {
  var bkDir = getBackupDir();
  var rawDir = getRawDir();
  try {
    var files = FSO.GetFolder(rawDir).Files;
    var e = new Enumerator(files);
    var count = 0;
    for (; !e.atEnd(); e.moveNext()) {
      var f = e.item();
      FSO.CopyFile(f.Path, bkDir + "\\" + f.Name, true);
      count++;
    }
    toast("💾 バックアップ完了 (" + count + "ファイル) → " + bkDir, "ok");
  } catch(ex) {
    toast("バックアップエラー: " + ex.message, "err");
  }
}

function openDataFolder() {
  try { WS.Run('explorer "' + getDataDir() + '"'); } catch(e) { toast("フォルダを開けませんでした", "err"); }
}

// ═══════════════════════════════════════════
// CLOCK & HELPERS
// ═══════════════════════════════════════════
function pad(n) { return String(n).length < 2 ? "0" + n : String(n); }
function nowISO() { return new Date().toISOString(); }
function todayStr() { return new Date().toISOString().slice(0, 10).replace(/-/g, ""); }
function todayISO() { return new Date().toISOString().slice(0, 10); }
function fmtDT(iso) {
  if (!iso) return "";
  var d = new Date(iso);
  if (isNaN(d.getTime())) return iso.slice(0, 16);
  return (d.getMonth() + 1) + "/" + d.getDate() + " " + pad(d.getHours()) + ":" + pad(d.getMinutes());
}
function fmtD(iso) {
  if (!iso) return "";
  var d = new Date(iso);
  if (isNaN(d.getTime())) return iso;
  return (d.getMonth() + 1) + "/" + d.getDate();
}
function genId(prefix) { return prefix + String(Date.now()).slice(-8); }

function updateClock() {
  var n = new Date();
  var s = pad(n.getHours()) + ":" + pad(n.getMinutes()) + ":" + pad(n.getSeconds());
  document.getElementById("clock").innerText = s;
  var cn = document.getElementById("cap-now");
  if (cn) cn.innerText = s;
}
setInterval(updateClock, 1000);
updateClock();

// ═══════════════════════════════════════════
// NAVIGATION
// ═══════════════════════════════════════════
function go(name) {
  var screens = document.querySelectorAll(".screen");
  for (var i = 0; i < screens.length; i++) screens[i].className = screens[i].className.replace(" active", "");
  var navs = document.querySelectorAll(".nav-btn");
  for (var j = 0; j < navs.length; j++) navs[j].className = navs[j].className.replace(" active", "");

  var sc = document.getElementById("screen-" + name);
  if (sc) sc.className += " active";
  var nb = document.getElementById("nav-" + name);
  if (nb) nb.className += " active";

  if (name === "home") renderHome();
  if (name === "capture") { renderLogs(""); renderQuickTags("q-tags-cap"); }
  if (name === "inbox") { renderInbox(""); renderQuickTags("q-tags-ib"); }
  if (name === "tasks") renderMatrix();
  if (name === "projects") renderProjects();
  if (name === "meetings") renderMtgList();
  if (name === "delegate") renderDelegationList();
  if (name === "clients") renderClients("");
  if (name === "risks") renderRisks();
  if (name === "knowledge") renderKnowledge("");
  if (name === "review") {} // manual trigger
  if (name === "ai") { pCount("a"); pCount("b"); pCount("c"); previewCSV("a"); }
}

// ═══════════════════════════════════════════
// TOAST / MODAL
// ═══════════════════════════════════════════
function toast(msg, type) {
  var t = document.getElementById("toast");
  var el = document.createElement("div");
  el.className = "toast-msg" + (type ? " " + type : "");
  el.innerText = msg;
  t.appendChild(el);
  setTimeout(function() { if (el.parentNode) el.parentNode.removeChild(el); }, 2900);
}

function openModal(id) { document.getElementById(id).className += " open"; }
function closeModal(id) { document.getElementById(id).className = document.getElementById(id).className.replace(" open", ""); }

// ═══════════════════════════════════════════
// FRAMEWORK RENDERER
// ═══════════════════════════════════════════
var FW_DEF = {
  "3C": { label: "3C 分析", fields: [
    { id: "fw_3c_customer", label: "顧客（Customer）", rows: 3 },
    { id: "fw_3c_competitor", label: "競合（Competitor）", rows: 3 },
    { id: "fw_3c_company", label: "自社（Company）", rows: 3 },
    { id: "fw_3c_insight", label: "統合示唆（So What）", rows: 2, full: true }] },
  "SCR": { label: "SCR — 状況・課題・解決策", fields: [
    { id: "fw_scr_situation", label: "状況（聴衆が既知の事実）", rows: 2 },
    { id: "fw_scr_complication", label: "課題（状況の変化・問題）", rows: 2 },
    { id: "fw_scr_resolution", label: "解決策（我々の提言）", rows: 2 },
    { id: "fw_scr_sowhat", label: "So What — だから何か", rows: 1, full: true }] },
  "MECE": { label: "MECE 分解", fields: [
    { id: "fw_mece_question", label: "分解したい問い", rows: 1, full: true },
    { id: "fw_mece_axis", label: "分解軸（例:地域別・機能別）", rows: 1 },
    { id: "fw_mece_elements", label: "要素（;区切り）", rows: 2 },
    { id: "fw_mece_check", label: "MECE確認メモ", rows: 1 }] },
  "仮説思考": { label: "仮説思考", fields: [
    { id: "fw_hyp_hypothesis", label: "仮説（〜ではないか）", rows: 2, full: true },
    { id: "fw_hyp_basis", label: "仮説の根拠", rows: 2 },
    { id: "fw_hyp_method", label: "検証方法", rows: 2 },
    { id: "fw_hyp_result", label: "検証結果", rows: 2 },
    { id: "fw_hyp_insight", label: "示唆", rows: 2 }] },
  "イシューツリー": { label: "イシューツリー / So What・Why So", fields: [
    { id: "fw_issue_core", label: "コアイシュー", rows: 1, full: true },
    { id: "fw_issue_sub1", label: "サブイシュー①", rows: 1 },
    { id: "fw_issue_sub2", label: "サブイシュー②", rows: 1 },
    { id: "fw_issue_sub3", label: "サブイシュー③", rows: 1 },
    { id: "fw_issue_sowhat", label: "So What（上位への示唆）", rows: 2 },
    { id: "fw_issue_whyso", label: "Why So（下位の根拠）", rows: 2 }] },
  "SWOT": { label: "SWOT 分析", fields: [
    { id: "fw_swot_s", label: "強み（Strength）", rows: 3 },
    { id: "fw_swot_w", label: "弱み（Weakness）", rows: 3 },
    { id: "fw_swot_o", label: "機会（Opportunity）", rows: 3 },
    { id: "fw_swot_t", label: "脅威（Threat）", rows: 3 },
    { id: "fw_swot_cross", label: "クロスSWOT 示唆", rows: 2, full: true }] },
  "4P": { label: "4P 分析", fields: [
    { id: "fw_4p_product", label: "Product（製品・サービス）", rows: 2 },
    { id: "fw_4p_price", label: "Price（価格戦略）", rows: 2 },
    { id: "fw_4p_place", label: "Place（流通・チャネル）", rows: 2 },
    { id: "fw_4p_promo", label: "Promotion（販促）", rows: 2 },
    { id: "fw_4p_insight", label: "統合示唆", rows: 2, full: true }] },
  "5Forces": { label: "5Forces 分析", fields: [
    { id: "fw_5f_rivalry", label: "業界内競争", rows: 2 },
    { id: "fw_5f_new", label: "新規参入の脅威", rows: 2 },
    { id: "fw_5f_sub", label: "代替品の脅威", rows: 2 },
    { id: "fw_5f_buyer", label: "買い手の交渉力", rows: 2 },
    { id: "fw_5f_supplier", label: "売り手の交渉力", rows: 2 },
    { id: "fw_5f_insight", label: "戦略示唆", rows: 2, full: true }] },
  "ギャップ分析": { label: "ギャップ分析（As-Is / To-Be）", fields: [
    { id: "fw_gap_asis", label: "現状（As-Is）", rows: 2 },
    { id: "fw_gap_tobe", label: "目指す姿（To-Be）", rows: 2 },
    { id: "fw_gap_gap", label: "ギャップ", rows: 2 },
    { id: "fw_gap_cause", label: "ギャップの根本原因", rows: 2 },
    { id: "fw_gap_actions", label: "埋めるための施策", rows: 2, full: true }] },
  "シナリオ": { label: "シナリオ分析", fields: [
